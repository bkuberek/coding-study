{
  "$schema": "../../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "note": "a promise's result is awaited", "ops": ["Inbox", "publish", "publish", "receive"], "args": [[], ["a"], ["b"], [10]], "expected": [null, 1, 2, "a"]},
    {"id": "advance", "level": 1, "note": "@advance moves the clock, and a method's own sleep reads the virtual time", "ops": ["Inbox", "@now", "@advance", "@now", "sleep", "@now"], "args": [[], [], [1500], [], [2500], []], "expected": [null, 0, null, 1500, 2500, 4000]},
    {"id": "spawn-join", "level": 1, "note": "a waiting receive takes a message published while it waits; an empty inbox answers after the wait", "ops": ["Inbox", "@spawn", "@advance", "publish", "@join", "@now", "receive", "@now"], "args": [[], ["r1", "receive", 5000], [1000], ["a"], ["r1"], [], [2000], []], "expected": [null, null, null, 1, "a", 1000, "", 3000]},
    {"id": "chain", "level": 1, "note": "each sleep of a chain starts when the one before it ended", "ops": ["Inbox", "steps", "@now"], "args": [[], [3, 10], []], "expected": [null, [10, 20, 30], 30]},
    {"id": "ties", "level": 1, "note": "four sleeps end at the same instant, in the order they started", "ops": ["Inbox", "race", "@now"], "args": [[], ["abcd"], []], "expected": [null, "abcd", 10]},
    {"id": "deadlock", "level": 1, "note": "the joined call waits on a promise nobody settles while no timer is due", "ops": ["Inbox", "@advance", "@spawn", "@join"], "args": [[], [2000], ["r1", "hold"], ["r1"]], "expected": [null, null, null, ""]},
    {"id": "after-deadlock", "level": 1, "ops": ["Inbox", "@advance", "@now"], "args": [[], [10], []], "expected": [null, null, 10]},
    {"id": "spin", "level": 1, "note": "a loop that never returns blocks the event loop, so the clock stops", "ops": ["Inbox", "spin"], "args": [[], []], "expected": [null, ""]},
    {"id": "leftover", "level": 1, "note": "a promise and a timer still pending when the case ends are dropped", "ops": ["Inbox", "leave", "@now"], "args": [[], [], []], "expected": [null, null, 0]},
    {"id": "last", "level": 1, "ops": ["Inbox", "publish"], "args": [[], ["z"]], "expected": [null, 1]}
  ]
}
