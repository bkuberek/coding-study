{
  "$schema": "../../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "note": "an async method's result is awaited", "ops": ["Inbox", "publish", "publish", "receive"], "args": [[], ["a"], ["b"], [10]], "expected": [null, 1, 2, "a"]},
    {"id": "advance", "visible": true, "level": 1, "note": "@advance moves the clock, and a method's own sleep reads the virtual time", "ops": ["Inbox", "@now", "@advance", "@now", "sleep", "@now"], "args": [[], [], [1500], [], [2500], []], "expected": [null, 0, null, 1500, 2500, 4000]},
    {"id": "spawn-join", "visible": true, "level": 1, "note": "a waiting receive takes a message published while it waits; an empty inbox answers after the wait", "ops": ["Inbox", "@spawn", "@advance", "publish", "@join", "@now", "receive", "@now"], "args": [[], ["r1", "receive", 5000], [1000], ["a"], ["r1"], [], [2000], []], "expected": [null, null, null, 1, "a", 1000, "", 3000]},
    {"id": "chain", "visible": true, "level": 1, "note": "each sleep of a chain starts when the one before it ended", "ops": ["Inbox", "steps", "@now"], "args": [[], [3, 10], []], "expected": [null, [10, 20, 30], 30]},
    {"id": "ties", "visible": true, "level": 1, "note": "four tasks wake at the same instant, in the order they were spawned", "ops": ["Inbox", "race", "@now"], "args": [[], ["abcd"], []], "expected": [null, "abcd", 10]},
    {"id": "deadlock", "level": 1, "note": "the joined call waits on a notification nobody sends while nothing is due", "ops": ["Inbox", "@advance", "@spawn", "@join"], "args": [[], [2000], ["r1", "hold"], ["r1"]], "expected": [null, null, null, ""]},
    {"id": "after-deadlock", "level": 1, "ops": ["Inbox", "@advance", "@now"], "args": [[], [10], []], "expected": [null, null, 10]},
    {"id": "task-error", "level": 1, "note": "a spawned task's panic is the error of its @join", "ops": ["Inbox", "@spawn", "@advance", "@join"], "args": [[], ["r1", "fail"], [10], ["r1"]], "expected": [null, null, null, ""]},
    {"id": "jam", "level": 1, "note": "a parked thread is a wait the clock cannot see, so the clock stops", "ops": ["Inbox", "jam"], "args": [[], []], "expected": [null, ""]},
    {"id": "leftover", "level": 1, "note": "a task still waiting when the case ends is dropped, as a dropped runtime drops it", "ops": ["Inbox", "leave", "@now"], "args": [[], [], []], "expected": [null, null, 0]},
    {"id": "last", "level": 1, "ops": ["Inbox", "publish"], "args": [[], ["z"]], "expected": [null, 1]}
  ]
}
