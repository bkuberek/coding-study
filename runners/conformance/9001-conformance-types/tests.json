{
  "$schema": "../../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "int", "ops": ["TypeEcho", "echoInt", "echoInt", "echoInt"], "args": [["conformance"], [0], [-2147483648], [2147483647]], "expected": [null, 0, -2147483648, 2147483647]},
    {"id": "long", "ops": ["TypeEcho", "echoLong", "echoLong", "echoLong"], "args": [["conformance"], [0], [-9007199254740991], [9007199254740991]], "expected": [null, 0, -9007199254740991, 9007199254740991]},
    {"id": "double", "ops": ["TypeEcho", "echoDouble", "echoDouble", "echoDouble", "echoDouble", "echoDouble"], "args": [["conformance"], [0.1], [-2.5], [1e-09], [3.0], [1.7976931348623157e+308]], "expected": [null, 0.1, -2.5, 1e-09, 3.0, 1.7976931348623157e+308]},
    {"id": "bool", "ops": ["TypeEcho", "echoBool", "echoBool"], "args": [["conformance"], [true], [false]], "expected": [null, true, false]},
    {"id": "string", "ops": ["TypeEcho", "echoString", "echoString", "echoString"], "args": [["conformance"], [""], ["hello world"], ["üñí \"quoted\" \\ line\nbreak\ttab"]], "expected": [null, "", "hello world", "üñí \"quoted\" \\ line\nbreak\ttab"]},
    {"id": "char", "ops": ["TypeEcho", "echoChar", "echoChar", "echoChar"], "args": [["conformance"], ["a"], ["€"], [" "]], "expected": [null, "a", "€", " "]},
    {"id": "int-array", "ops": ["TypeEcho", "echoIntArray", "echoIntArray"], "args": [["conformance"], [[]], [[1, -2, 3]]], "expected": [null, [], [1, -2, 3]]},
    {"id": "long-array", "ops": ["TypeEcho", "echoLongArray"], "args": [["conformance"], [[9007199254740991, -1]]], "expected": [null, [9007199254740991, -1]]},
    {"id": "double-array", "ops": ["TypeEcho", "echoDoubleArray"], "args": [["conformance"], [[0.5, -1.25]]], "expected": [null, [0.5, -1.25]]},
    {"id": "bool-array", "ops": ["TypeEcho", "echoBoolArray"], "args": [["conformance"], [[true, false]]], "expected": [null, [true, false]]},
    {"id": "char-array", "ops": ["TypeEcho", "echoCharArray"], "args": [["conformance"], [["a", "€"]]], "expected": [null, ["a", "€"]]},
    {"id": "string-array", "ops": ["TypeEcho", "echoStringArray"], "args": [["conformance"], [["x", ""]]], "expected": [null, ["x", ""]]},
    {"id": "int-matrix", "ops": ["TypeEcho", "echoIntMatrix", "echoIntMatrix"], "args": [["conformance"], [[]], [[[1, 2], [], [3]]]], "expected": [null, [], [[1, 2], [], [3]]]},
    {"id": "long-matrix", "ops": ["TypeEcho", "echoLongMatrix"], "args": [["conformance"], [[[1], [9007199254740991]]]], "expected": [null, [[1], [9007199254740991]]]},
    {"id": "double-matrix", "ops": ["TypeEcho", "echoDoubleMatrix"], "args": [["conformance"], [[[0.5], [1.5, 2.5]]]], "expected": [null, [[0.5], [1.5, 2.5]]]},
    {"id": "bool-matrix", "ops": ["TypeEcho", "echoBoolMatrix"], "args": [["conformance"], [[[true], [false, true]]]], "expected": [null, [[true], [false, true]]]},
    {"id": "char-matrix", "ops": ["TypeEcho", "echoCharMatrix"], "args": [["conformance"], [[["a"], ["b", "c"]]]], "expected": [null, [["a"], ["b", "c"]]]},
    {"id": "string-matrix", "ops": ["TypeEcho", "echoStringMatrix"], "args": [["conformance"], [[["x"], ["y", "z"]]]], "expected": [null, [["x"], ["y", "z"]]]},
    {"id": "int-list", "ops": ["TypeEcho", "echoIntList", "echoIntList"], "args": [["conformance"], [[]], [[1, 2]]], "expected": [null, [], [1, 2]]},
    {"id": "long-list", "ops": ["TypeEcho", "echoLongList"], "args": [["conformance"], [[9007199254740991]]], "expected": [null, [9007199254740991]]},
    {"id": "double-list", "ops": ["TypeEcho", "echoDoubleList"], "args": [["conformance"], [[0.5]]], "expected": [null, [0.5]]},
    {"id": "bool-list", "ops": ["TypeEcho", "echoBoolList"], "args": [["conformance"], [[false]]], "expected": [null, [false]]},
    {"id": "char-list", "ops": ["TypeEcho", "echoCharList"], "args": [["conformance"], [["z"]]], "expected": [null, ["z"]]},
    {"id": "string-list", "ops": ["TypeEcho", "echoStringList"], "args": [["conformance"], [["a", "b"]]], "expected": [null, ["a", "b"]]},
    {"id": "int-array-list", "ops": ["TypeEcho", "echoIntArrayList"], "args": [["conformance"], [[[1, 2], []]]], "expected": [null, [[1, 2], []]]},
    {"id": "int-list-list", "ops": ["TypeEcho", "echoIntListList"], "args": [["conformance"], [[[1], [2, 3], []]]], "expected": [null, [[1], [2, 3], []]]},
    {"id": "string-list-list", "ops": ["TypeEcho", "echoStringListList"], "args": [["conformance"], [[["a"], []]]], "expected": [null, [["a"], []]]},
    {"id": "int-list-list-list", "ops": ["TypeEcho", "echoIntListListList"], "args": [["conformance"], [[[[1], []], []]]], "expected": [null, [[[1], []], []]]},
    {"id": "list-node", "ops": ["TypeEcho", "echoListNode", "echoListNode"], "args": [["conformance"], [[]], [[1, 2, 3]]], "expected": [null, [], [1, 2, 3]]},
    {"id": "tree-node", "ops": ["TypeEcho", "echoTreeNode", "echoTreeNode", "echoTreeNode"], "args": [["conformance"], [[]], [[3, 9, 20, null, null, 15, 7]], [[1, null, 2]]], "expected": [null, [], [3, 9, 20, null, null, 15, 7], [1, null, 2]]},
    {"id": "graph-node", "ops": ["TypeEcho", "echoGraphNode", "echoGraphNode", "echoGraphNode"], "args": [["conformance"], [[]], [[[]]], [[[2, 4], [1, 3], [2, 4], [1, 3]]]], "expected": [null, [], [[]], [[2, 4], [1, 3], [2, 4], [1, 3]]]},
    {"id": "list-node-array", "ops": ["TypeEcho", "echoListNodeArray"], "args": [["conformance"], [[[1, 2], [], [3]]]], "expected": [null, [[1, 2], [], [3]]]},
    {"id": "tree-node-list", "ops": ["TypeEcho", "echoTreeNodeList"], "args": [["conformance"], [[[1, null, 2], []]]], "expected": [null, [[1, null, 2], []]]},
    {"id": "decimal", "ops": ["TypeEcho", "echoDecimal", "echoDecimal", "echoDecimal", "echoDecimal", "echoDecimal", "echoDecimal"], "args": [["conformance"], ["0"], ["2500"], ["-0.5"], ["1234.0625"], ["-9999999999999999999999999999"], ["0.0000000000000000000000000001"]], "expected": [null, "0", "2500", "-0.5", "1234.0625", "-9999999999999999999999999999", "0.0000000000000000000000000001"]},
    {"id": "date", "ops": ["TypeEcho", "echoDate", "echoDate", "echoDate"], "args": [["conformance"], ["2024-02-29"], ["0001-01-01"], ["9999-12-31"]], "expected": [null, "2024-02-29", "0001-01-01", "9999-12-31"]},
    {"id": "decimal-array", "ops": ["TypeEcho", "echoDecimalArray", "echoDecimalArray"], "args": [["conformance"], [[]], [["1", "2.5", "-3"]]], "expected": [null, [], ["1", "2.5", "-3"]]},
    {"id": "date-array", "ops": ["TypeEcho", "echoDateArray", "echoDateArray"], "args": [["conformance"], [[]], [["2024-01-01", "2023-12-31"]]], "expected": [null, [], ["2024-01-01", "2023-12-31"]]},
    {"id": "decimal-matrix", "ops": ["TypeEcho", "echoDecimalMatrix", "echoDecimalMatrix"], "args": [["conformance"], [[]], [[["1"], [], ["0.01", "100"]]]], "expected": [null, [], [["1"], [], ["0.01", "100"]]]},
    {"id": "date-matrix", "ops": ["TypeEcho", "echoDateMatrix"], "args": [["conformance"], [[["2024-01-01"], []]]], "expected": [null, [["2024-01-01"], []]]},
    {"id": "decimal-list", "ops": ["TypeEcho", "echoDecimalList"], "args": [["conformance"], [["0.01", "10"]]], "expected": [null, ["0.01", "10"]]},
    {"id": "date-list", "ops": ["TypeEcho", "echoDateList"], "args": [["conformance"], [["2024-03-01"]]], "expected": [null, ["2024-03-01"]]},
    {"id": "void", "ops": ["TypeEcho", "noop"], "args": [["conformance"], [5]], "expected": [null, null]}
  ]
}
