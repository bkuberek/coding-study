{
  "$schema": "../../schemas/conformance.schema.json",
  "version": 1,
  "expectations": [
    {"problem": "conformance-types", "approach": "identity", "outcome": {"status": "pass"}},
    {"problem": "conformance-function", "approach": "identity", "outcome": {"status": "pass"}},
    {"problem": "conformance-exception", "approach": "raises", "outcome": {"status": "error"}, "cases": {"ascii": {"status": "error", "message": "conformance failure"}, "unicode": {"status": "error", "message": "üñí failure"}}},
    {"problem": "conformance-op-error", "approach": "counts", "outcome": {"status": "pass"}, "cases": {"fails": {"status": "error", "message": "counter failure", "op_index": 3, "partial_output": [null, 1, 2]}}},
    {"problem": "conformance-non-finite", "approach": "multiplies", "outcome": {"status": "pass"}, "cases": {"overflow": {"status": "invalid_output"}}},
    {"problem": "conformance-cyclic-list", "approach": "identity", "outcome": {"status": "pass"}, "cases": {"cyclic": {"status": "invalid_output"}}},
    {"problem": "conformance-missing-symbol", "approach": "misnamed", "outcome": {"status": "load_error"}},
    {"problem": "conformance-hang", "approach": "spins", "outcome": {"status": "pass"}, "cases": {"hang": {"status": "timeout"}}},
    {"problem": "conformance-stdout", "approach": "prints", "outcome": {"status": "pass", "stdout": "conformance output\n"}},
    {"problem": "conformance-ref-of-list", "approach": "identity", "outcome": {"status": "pass"}},
    {"problem": "conformance-ref-of-list", "approach": "new-node", "outcome": {"status": "invalid_output"}},
    {"problem": "conformance-ref-of-tree", "approach": "identity", "outcome": {"status": "pass"}},
    {"problem": "conformance-output-from", "approach": "sorts", "outcome": {"status": "pass"}},
    {"problem": "conformance-no-alias", "approach": "deep-copy", "outcome": {"status": "pass"}},
    {"problem": "conformance-no-alias", "approach": "returns-input", "outcome": {"status": "invalid_output"}, "cases": {"empty": {"status": "pass"}}},
    {"problem": "conformance-decimal-date", "approach": "arithmetic", "outcome": {"status": "pass"}},
    {"problem": "conformance-stress-counter", "approach": "atomic", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "pass", "runs": 10}}},
    {"problem": "conformance-stress-counter", "approach": "racy", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "fail", "runs": 10, "min_failed": 9}}},
    {"problem": "conformance-stress-stall", "approach": "never-opens", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "stalled", "runs": 1}}},
    {"problem": "conformance-stress-worker-error", "approach": "throws-at", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "error", "runs": 1, "phase": "worker", "op_index": 100, "message": "failed at 100"}}},
    {"problem": "conformance-stress-sections", "approach": "locked", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "pass", "runs": 10}}},
    {"problem": "conformance-stress-sections", "approach": "unlocked", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "fail", "runs": 10, "min_failed": 9}}},
    {"problem": "conformance-stress-async-determinism", "approach": "interleaves", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "pass", "runs": 10, "deterministic": true}}},
    {"problem": "conformance-stress-leak", "approach": "ignores-interrupt", "outcome": {"status": "pass"}, "cases": {"s1": {"status": "error", "runs": 1, "phase": "worker", "restart_requested": true}, "s2": {"status": "pass", "runs": 1}}}
  ]
}
