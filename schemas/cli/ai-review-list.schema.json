{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coding-study AI review list document",
  "description": "`cstudy ai review <slug> --list --json`: every AI review of a rubric problem, newest first, dismissed ones included. Each review is as `ai-review.schema.json` describes it; the record's fields are a public record, additive only (docs/specs/ai.md#the-record). Spec: docs/specs/cli.md#cstudy-ai-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "reviews"],
  "properties": {
    "id": { "description": "The canonical ID, `problem/<slug>`", "$ref": "#/$defs/id" },
    "slug": { "$ref": "#/$defs/slug" },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^problem/[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "review_id",
        "attempt_id",
        "format",
        "created_at",
        "provider",
        "model",
        "prompt_version",
        "rubric_sha256",
        "notes_sha256",
        "notes_changed",
        "criteria",
        "summary",
        "counts",
        "quotes_dropped",
        "usage",
        "dismissed_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "review_id": { "type": "integer", "minimum": 1 },
        "attempt_id": { "type": "integer", "minimum": 1 },
        "format": { "type": "integer", "minimum": 1 },
        "created_at": { "$ref": "#/$defs/instant" },
        "provider": { "enum": ["anthropic", "google", "openai", "openrouter"] },
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "rubric_sha256": { "$ref": "#/$defs/sha256" },
        "notes_sha256": { "$ref": "#/$defs/sha256" },
        "notes_changed": { "type": ["boolean", "null"] },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
        "summary": { "type": "string", "maxLength": 800 },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["met", "partial", "missing", "total"],
          "properties": {
            "met": { "$ref": "#/$defs/count" },
            "partial": { "$ref": "#/$defs/count" },
            "missing": { "$ref": "#/$defs/count" },
            "total": { "$ref": "#/$defs/count" }
          }
        },
        "quotes_dropped": { "$ref": "#/$defs/count" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "cost_usd"],
          "properties": {
            "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "cost_usd": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "dismissed_at": { "anyOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "area", "criterion", "verdict", "evidence", "gaps"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "area": { "type": "string", "minLength": 1 },
        "criterion": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["met", "partial", "missing"] },
        "evidence": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "gaps": { "type": "string", "maxLength": 600 }
      }
    }
  }
}
