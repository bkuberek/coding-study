{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coding-study stats document",
  "description": "`cstudy stats --json`. Spec: docs/specs/cli.md#cstudy-stats",
  "type": "object",
  "additionalProperties": false,
  "required": ["today", "by", "since", "groups", "attempts", "reviews", "bench"],
  "properties": {
    "today": { "$ref": "#/$defs/date", "description": "The local date the values describe" },
    "by": { "description": "The grouping of `--by`", "enum": ["pattern", "track", "lang", "difficulty"] },
    "since": {
      "description": "`--since`, or null without it",
      "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finished", "last_7_days", "streak_days"],
      "properties": {
        "finished": { "$ref": "#/$defs/count" },
        "last_7_days": { "$ref": "#/$defs/count" },
        "streak_days": { "$ref": "#/$defs/count" }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["due_today", "overdue"],
      "properties": {
        "due_today": { "$ref": "#/$defs/count" },
        "overdue": { "$ref": "#/$defs/count" }
      }
    },
    "bench": {
      "description": "Problems by the verdict of their latest bench run",
      "type": "object",
      "additionalProperties": false,
      "required": ["optimal", "near-optimal", "suboptimal", "unknown"],
      "properties": {
        "optimal": { "$ref": "#/$defs/count" },
        "near-optimal": { "$ref": "#/$defs/count" },
        "suboptimal": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "count": { "type": "integer", "minimum": 0 },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "problems",
        "attempted",
        "passed",
        "mastered",
        "recent_attempts",
        "recent_passed",
        "pass_rate",
        "median_solve_s",
        "weakness"
      ],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "problems": { "$ref": "#/$defs/count" },
        "attempted": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "mastered": { "$ref": "#/$defs/count" },
        "recent_attempts": { "$ref": "#/$defs/count" },
        "recent_passed": { "$ref": "#/$defs/count" },
        "pass_rate": {
          "description": "Of the last 10 attempts, to 4 decimals; null without attempts",
          "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "median_solve_s": {
          "description": "Seconds; null without a pass",
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "weakness": { "description": "To 4 decimals", "type": "number", "minimum": 0 }
      }
    }
  }
}
