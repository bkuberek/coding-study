{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coding-study problem meta.yaml",
  "description": "Metadata, signature, comparator, approaches and performance settings of one autograded problem. Spec: docs/specs/problem-format.md#metayaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "title", "status", "difficulty", "track", "kind", "comparator", "approaches"],
  "properties": {
    "id": {
      "description": "4-digit zero-padded id; must match the directory prefix",
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "slug": {
      "description": "Stable key in progress.db; must match the directory suffix",
      "$ref": "#/$defs/slug"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "track": { "enum": ["dsa", "practical", "lld", "concurrency", "debugging"] },
    "kind": { "enum": ["function", "design", "progressive", "concurrent", "project"] },
    "patterns": {
      "description": "The first entry is the primary pattern",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "domains": {
      "description": "What the problem is about (docs/decisions/0020-catalog-labels.md); check S24 requires it, with job_roles and scope, in the catalog, and a workspace problem may leave all three out",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" }
    },
    "job_roles": {
      "description": "Who the problem is for; general is any software engineer",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/job_role" }
    },
    "scope": { "description": "How big the thing you work on is; check S24 ties it to kind", "$ref": "#/$defs/scope" },
    "languages": {
      "description": "Default all six in the catalog (check S13 requires every language that can express the problem, except on the concurrency and debugging tracks and in the security, identity and ai-llm domains) and the core four in a workspace problem, which may list any non-empty subset; a project problem lists exactly one",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/language" }
    },
    "jdk": {
      "description": "The JDK feature releases the Java and Kotlin code runs on, for a problem that lists java or kotlin (check S17). A missing bound is the bound of the supported range; docs/specs/problem-format.md#jdk-range",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "description": "The first release the code runs on, when the supported minimum is too old for it", "type": "integer" },
        "max": { "description": "The last release the problem is known to hold on, or a newer one as an explicit opt-in", "type": "integer" }
      }
    },
    "signature": { "$ref": "#/$defs/signature" },
    "comparator": { "$ref": "#/$defs/comparator" },
    "stub": { "enum": ["generated", "buggy"] },
    "levels": {
      "description": "Progressive and project problems only",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "title"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approaches": {
      "description": "Reference approaches; at least one optimal, at most one oracle",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/approach" },
      "allOf": [
        { "contains": { "type": "object", "required": ["role"], "properties": { "role": { "const": "optimal" } } } },
        {
          "contains": { "type": "object", "required": ["oracle"], "properties": { "oracle": { "const": true } } },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "perf": { "$ref": "#/$defs/perf" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hang_guard_ms": { "description": "Overrides the per-case hang guard (default 10000)", "$ref": "#/$defs/positiveInteger" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leetcode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url"],
          "properties": {
            "number": { "$ref": "#/$defs/positiveInteger" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "links": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "related": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "guides": {
      "description": "Concept guides to read before the problem (docs/specs/guides.md); each must exist (check S25)",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "order": { "description": "Curriculum order within the primary pattern (default 1000)", "type": "integer" },
    "estimate_minutes": { "$ref": "#/$defs/positiveInteger" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "concurrency": { "$ref": "#/$defs/concurrency" },
    "project": { "$ref": "#/$defs/project" }
  },
  "allOf": [
    {
      "if": { "required": ["track"], "properties": { "track": { "const": "dsa" } } },
      "then": { "required": ["patterns"] }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["progressive", "project"] } } },
      "then": { "required": ["levels"] },
      "else": { "not": { "required": ["levels"] } }
    },
    {
      "description": "Project problems: a project block and exactly one language; no stub or perf, even at their defaults (check S14); a concurrency block names one model, since a project lists one language",
      "if": { "required": ["kind"], "properties": { "kind": { "const": "project" } } },
      "then": {
        "required": ["project", "languages"],
        "not": { "anyOf": [{ "required": ["stub"] }, { "required": ["perf"] }] },
        "properties": {
          "languages": { "maxItems": 1 },
          "concurrency": { "properties": { "model": { "$ref": "#/$defs/concurrencyModel" } } }
        }
      },
      "else": { "not": { "required": ["project"] } }
    },
    {
      "description": "A service project (project.grading: http) is judged over HTTP, so it has no signature, no concurrency block and no complexity classes; every other problem has a signature (docs/specs/service-projects.md#manifest-sketch)",
      "if": { "required": ["project"], "properties": { "project": { "required": ["grading"] } } },
      "then": {
        "not": { "anyOf": [{ "required": ["signature"] }, { "required": ["concurrency"] }] },
        "properties": { "kind": { "const": "project" } }
      },
      "else": { "required": ["signature"] }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "function" } } },
      "then": { "properties": { "signature": { "required": ["function"] } } },
      "else": { "properties": { "signature": { "required": ["class"] } } }
    },
    {
      "description": "Concurrent problems: a concurrency block, the ops comparator, no perf block and no complexity classes or oracle; every other kind declares complexity classes, and only a project may also have a concurrency block",
      "if": { "required": ["kind"], "properties": { "kind": { "const": "concurrent" } } },
      "then": {
        "required": ["concurrency"],
        "not": { "required": ["perf"] },
        "properties": {
          "comparator": { "properties": { "type": { "const": "ops" } } },
          "approaches": {
            "items": {
              "not": { "anyOf": [{ "required": ["time_class"] }, { "required": ["space_class"] }, { "required": ["oracle"] }] },
              "properties": { "id": { "not": { "pattern": "^broken-" } } }
            }
          }
        }
      },
      "else": {
        "if": { "required": ["project"], "properties": { "project": { "required": ["grading"] } } },
        "else": {
          "properties": { "approaches": { "items": { "required": ["time_class", "space_class"] } } }
        }
      }
    },
    {
      "description": "A concurrency block belongs to a concurrent problem or a project with stress cases (docs/specs/problem-format.md#stress-cases-in-projects)",
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["concurrent", "project"] } } },
      "else": { "not": { "required": ["concurrency"] } }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "memberName": {
      "description": "lowerCamelCase canonical name",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "className": {
      "description": "PascalCase canonical class name",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "pattern": {
      "enum": [
        "arrays-hashing", "two-pointers", "sliding-window", "stack", "monotonic-stack",
        "binary-search", "linked-list", "trees", "tries", "heap", "backtracking", "graphs",
        "topological-sort", "advanced-graphs", "union-find", "dp-1d", "dp-2d", "greedy",
        "intervals", "prefix-sum", "math-geometry", "bit-manipulation", "segment-tree-fenwick"
      ]
    },
    "domain": { "enum": ["algorithms", "backend", "security", "identity", "ai-llm", "fintech"] },
    "job_role": { "enum": ["general", "backend", "platform", "security-engineer", "ai-engineer", "ml-engineer"] },
    "scope": { "enum": ["function", "project", "system"] },
    "valueType": {
      "description": "Type DSL (docs/specs/problem-format.md#type-dsl); the CLI parser reports syntax errors with positions",
      "type": "string",
      "minLength": 1,
      "examples": [
        "int", "long", "double", "bool", "string", "char", "decimal", "date",
        "int[]", "string[]", "int[][]", "char[][]", "decimal[]", "date[]",
        "list<int>", "list<string>", "list<int[]>", "list<list<int>>", "list<decimal>", "list<date>",
        "ListNode", "TreeNode", "GraphNode", "ListNode[]", "list<TreeNode>"
      ]
    },
    "returnType": {
      "description": "Type DSL or void",
      "type": "string",
      "minLength": 1,
      "examples": ["void", "int", "int[]", "bool", "string", "list<list<int>>", "ListNode", "TreeNode"]
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/memberName" },
        "type": { "$ref": "#/$defs/valueType" },
        "ref_of": {
          "description": "The JSON value is a node value; the runner passes the first node in <param> whose val equals it",
          "$ref": "#/$defs/memberName"
        }
      }
    },
    "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
    "returns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/returnType" },
        "output_from": { "description": "With type void: serialize this parameter after the call", "$ref": "#/$defs/memberName" },
        "as": { "description": "Node-typed returns: serialize the node's value or its index", "enum": ["value", "index"] },
        "of": { "description": "With as: index, the parameter whose traversal order gives the index", "$ref": "#/$defs/memberName" },
        "no_alias_with": { "description": "Fail if a returned node is reachable from this parameter", "$ref": "#/$defs/memberName" }
      },
      "dependentRequired": { "of": ["as"] },
      "if": { "required": ["as"], "properties": { "as": { "const": "index" } } },
      "then": { "required": ["of"] }
    },
    "signature": {
      "description": "Exactly one of function or class",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "params", "returns"],
          "properties": {
            "name": { "$ref": "#/$defs/memberName" },
            "params": { "$ref": "#/$defs/params" },
            "returns": { "$ref": "#/$defs/returns" }
          }
        },
        "class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "constructor", "methods"],
          "properties": {
            "name": { "$ref": "#/$defs/className" },
            "constructor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["params"],
              "properties": { "params": { "$ref": "#/$defs/params" } }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "params", "returns"],
                "properties": {
                  "name": { "$ref": "#/$defs/memberName" },
                  "params": { "$ref": "#/$defs/params" },
                  "returns": { "$ref": "#/$defs/returns" },
                  "level": { "description": "Progressive and project problems: the level that introduces the method", "$ref": "#/$defs/positiveInteger" },
                  "blocking": { "description": "Concurrent problems: the method may wait for another worker", "type": "boolean" },
                  "async": { "description": "Project problems on the virtual clock: the method returns the language's awaitable, and the grader awaits it (docs/specs/problem-format.md#asynchronous-code-and-the-virtual-clock)", "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["exact", "unordered", "unordered-nested", "float", "checker", "ops"] },
        "tolerance": { "description": "Relative tolerance for float comparison (default 1e-6)", "type": "number", "exclusiveMinimum": 0 },
        "per_method": {
          "description": "ops only: a comparator per method name",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/memberName" },
          "additionalProperties": { "enum": ["exact", "unordered", "unordered-nested", "float"] }
        }
      },
      "allOf": [
        {
          "if": { "required": ["tolerance"] },
          "then": { "properties": { "type": { "enum": ["float", "ops"] } } }
        },
        {
          "if": { "required": ["per_method"] },
          "then": { "properties": { "type": { "const": "ops" } } }
        }
      ]
    },
    "complexityClass": {
      "enum": ["1", "log n", "sqrt n", "n", "n log n", "n^2", "n^2 log n", "n^3", "2^n", "n!"]
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "time", "space"],
      "properties": {
        "id": { "description": "Matches solutions/<id>.<ext>", "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["brute", "intermediate", "optimal"] },
        "time": { "description": "Human notation, for example O(n log n)", "type": "string", "minLength": 1 },
        "space": { "type": "string", "minLength": 1 },
        "time_class": { "description": "Required, except in concurrent problems", "$ref": "#/$defs/complexityClass" },
        "space_class": { "description": "Required, except in concurrent problems", "$ref": "#/$defs/complexityClass" },
        "oracle": { "description": "At most one; must exist in Python", "type": "boolean" },
        "languages": {
          "description": "The languages it has references in, a subset of the problem's; default all of them. Concurrency and debugging problems only (check S7)",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        }
      }
    },
    "language": { "enum": ["python", "typescript", "java", "kotlin", "go", "rust"] },
    "concurrencyModel": { "enum": ["threads", "async"] },
    "perturb": {
      "description": "Interleaving widening; a stress case's perturb overrides it field by field",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yield_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_yields": { "type": "integer", "minimum": 1, "maximum": 100 },
        "python_granularity": { "enum": ["line", "instruction", "none"] }
      }
    },
    "concurrency": {
      "description": "Concurrent problems, and project problems with stress cases (docs/specs/problem-format.md#concurrency-block-in-metayaml)",
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "description": "One model for every language, or a model per language",
          "oneOf": [
            { "$ref": "#/$defs/concurrencyModel" },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "python": { "$ref": "#/$defs/concurrencyModel" },
                "typescript": { "$ref": "#/$defs/concurrencyModel" },
                "java": { "$ref": "#/$defs/concurrencyModel" },
                "kotlin": { "$ref": "#/$defs/concurrencyModel" },
                "go": { "$ref": "#/$defs/concurrencyModel" },
                "rust": { "$ref": "#/$defs/concurrencyModel" }
              }
            }
          ]
        },
        "jvm_threads": {
          "description": "Each entry is a separate variant of every stress case for Java and Kotlin (default [platform])",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["platform", "virtual"] }
        },
        "runs": { "description": "Runs per stress case and variant in cstudy test (default 3)", "type": "integer", "minimum": 1, "maximum": 100 },
        "deadline_ms": { "description": "Per run, from gate open (default 5000)", "type": "integer", "minimum": 100, "maximum": 30000 },
        "perturb": { "$ref": "#/$defs/perturb" },
        "broken": {
          "description": "Deliberately wrong references in solutions/broken/<id>.<ext>; required for ready",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "bug", "caught_by"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "name": { "type": "string", "minLength": 1 },
              "bug": { "type": "string", "minLength": 1 },
              "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/language" } },
              "caught_by": {
                "description": "Stress case ids that must catch it",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              }
            }
          }
        }
      }
    },
    "project": {
      "description": "Project problems only (docs/specs/problem-format.md#project-problems); with grading: http, a service project (docs/specs/service-projects.md#manifest-sketch)",
      "type": "object",
      "additionalProperties": false,
      "if": { "required": ["grading"] },
      "then": {
        "required": ["image", "commands", "app", "env", "requires"],
        "not": { "anyOf": [{ "required": ["entry"] }, { "required": ["tests"] }, { "required": ["clock"] }] }
      },
      "else": {
        "required": ["entry"],
        "not": {
          "anyOf": [
            { "required": ["image"] }, { "required": ["commands"] }, { "required": ["app"] }, { "required": ["env"] },
            { "required": ["install_env"] }, { "required": ["mocks"] }, { "required": ["services"] },
            { "required": ["grader_reach"] }, { "required": ["requires"] }, { "required": ["timeouts_s"] }
          ]
        }
      },
      "properties": {
        "entry": {
          "description": "Where the entry class lives: a dotted module in Python (bank.bank), a .ts file relative to the project root in TypeScript (src/bank.ts), the fully qualified class in Java and Kotlin (bank.Bank), the .go file that declares the entry type and its constructor in Go (bank.go)",
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "description": "The directory, relative to the project root, that receives the generated level tests (default tests); in Java and Kotlin a package directory of the test sources (src/test/java/bank)",
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "description": "virtual puts every case of every level on the virtual clock, in grading and in the generated tests; without it the real clock (check S18, docs/specs/problem-format.md#asynchronous-code-and-the-virtual-clock)",
          "const": "virtual"
        },
        "grading": { "description": "http: a service project, run in a Docker sandbox and judged over HTTP", "const": "http" },
        "image": {
          "description": "The toolchain image, pinned by the digest of its multi-architecture index",
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]+$"
        },
        "commands": {
          "description": "The lifecycle commands: names fixed, contents free (docs/specs/service-projects.md#lifecycle-commands)",
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "test"],
          "properties": {
            "install": { "$ref": "#/$defs/argumentList" },
            "bootstrap": { "$ref": "#/$defs/argumentList" },
            "run": { "$ref": "#/$defs/argumentList" },
            "test": { "$ref": "#/$defs/argumentList" },
            "reset": { "$ref": "#/$defs/argumentList" },
            "grade_setup": { "$ref": "#/$defs/argumentList" }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port_env", "port", "health"],
          "properties": {
            "port_env": { "description": "The variable your app reads for its port", "$ref": "#/$defs/environmentName" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "health": { "description": "A path that answers 2xx when the app is ready", "type": "string", "pattern": "^/" },
            "ready_timeout_s": { "description": "How long the app may take to answer health, on the startup clock", "$ref": "#/$defs/positiveInteger" },
            "mem_limit": { "description": "The app container's memory limit, such as 512m", "type": "string", "pattern": "^[0-9]+[mg]$" },
            "install_cache": {
              "description": "true: the app's containers mount the install cache at /cache too, for a toolchain that keeps the dependencies there rather than in the project folder, as Gradle does in its user home and Go in its module and build caches (docs/specs/service-projects.md#mounts)",
              "type": "boolean"
            }
          }
        },
        "env": { "description": "The whole environment of the app; cstudy writes it into the project folder's .env", "$ref": "#/$defs/environment" },
        "install_env": { "description": "What the package manager needs in its install container, such as where its cache is", "$ref": "#/$defs/environment" },
        "mocks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "config"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "config": { "description": "Relative to the problem's directory", "type": "string", "minLength": 1 }
            }
          }
        },
        "services": { "description": "The problem's compose file of backing services, relative to its directory", "type": "string", "minLength": 1 },
        "grader_reach": {
          "description": "Each <name>:<port> of a backing service or a mock server that the grader may reach, published on 127.0.0.1 through the forwarder in a test or graded stack, with the original Host kept (docs/specs/service-projects.md#grader-reach)",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[1-9][0-9]{0,4}$" }
        },
        "requires": {
          "description": "What the problem depends on, checked against its files by S22 (docs/specs/service-projects.md#what-a-problem-depends-on)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lock": { "description": "The lock file at the starter's root, or Gradle's gradle/verification-metadata.xml", "type": "string", "minLength": 1 },
            "services": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "sizes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "install_mb": { "$ref": "#/$defs/positiveInteger" },
                "images_mb": { "type": "object", "additionalProperties": { "$ref": "#/$defs/positiveInteger" } },
                "memory_mb": { "$ref": "#/$defs/positiveInteger" }
              }
            }
          }
        },
        "timeouts_s": {
          "description": "startup is the budget up to ready, whatever it holds; the others are one command's limit, and test starts only once the stack is ready (docs/specs/service-projects.md#two-clocks)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": { "$ref": "#/$defs/positiveInteger" },
            "install": { "$ref": "#/$defs/positiveInteger" },
            "test": { "$ref": "#/$defs/positiveInteger" },
            "reset": { "$ref": "#/$defs/positiveInteger" }
          }
        }
      }
    },
    "argumentList": {
      "description": "An argument list, run with no shell; a script for anything longer",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "environmentName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "environment": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/environmentName" },
      "additionalProperties": { "type": "string" }
    },
    "perf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_param": { "description": "What n means, for display", "type": "string", "minLength": 1 },
        "size_ladder": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/positiveInteger" } },
        "budget_ms": { "$ref": "#/$defs/positiveInteger" },
        "expected_from": { "description": "Python approach that computes expected values for generated cases", "$ref": "#/$defs/slug" },
        "time_limit": {
          "description": "Suggested time limit when limits are enabled",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["factor"],
              "properties": { "factor": { "type": "number", "exclusiveMinimum": 0 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ms"],
              "properties": { "ms": { "type": "number", "exclusiveMinimum": 0 } }
            }
          ]
        }
      }
    }
  }
}
