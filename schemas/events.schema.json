{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coding-study CLI events",
  "description": "One line of `cstudy test --events` on every autograded problem, or of `cstudy submit --events`. Spec: docs/specs/cli.md#event-stream",
  "oneOf": [
    { "$ref": "#/$defs/run_start" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/build" },
    { "$ref": "#/$defs/test_start" },
    { "$ref": "#/$defs/test_result" },
    { "$ref": "#/$defs/case_start" },
    { "$ref": "#/$defs/case_result" },
    { "$ref": "#/$defs/case_revised" },
    { "$ref": "#/$defs/stress_run_start" },
    { "$ref": "#/$defs/stress_run" },
    { "$ref": "#/$defs/stress_result" },
    { "$ref": "#/$defs/diagnostic" },
    { "$ref": "#/$defs/level_result" },
    { "$ref": "#/$defs/level_unlocked" },
    { "$ref": "#/$defs/perf_result" },
    { "$ref": "#/$defs/run_end" }
  ],
  "$defs": {
    "version": { "description": "Changes only when an event changes incompatibly", "const": 1 },
    "level": { "type": "integer", "minimum": 1 },
    "optional_level": { "type": ["integer", "null"], "minimum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "duration_ns": { "type": ["integer", "null"], "minimum": 0 },
    "error": {
      "description": "An exception or load error, as in the runner protocol",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "trace"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "trace": { "type": "string" }
      }
    },
    "run_start": {
      "description": "First: the run's options are checked and its work begins. `kind`, `track`, `timer`, `time_limit` and `planned` are new: a project stream an earlier cstudy wrote lacks them",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "command", "slug", "language", "attempt_id", "mode", "levels"],
      "properties": {
        "type": { "const": "run_start" },
        "version": { "$ref": "#/$defs/version" },
        "command": { "enum": ["test", "submit"] },
        "slug": { "type": "string", "minLength": 1 },
        "language": { "enum": ["python", "typescript", "java", "kotlin", "go", "rust"] },
        "attempt_id": { "type": "integer" },
        "mode": { "enum": ["new", "review", "mock"] },
        "levels": {
          "description": "Null for a kind without levels",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["up_to", "unlocked", "last"],
          "properties": {
            "up_to": { "description": "The last level the run covers", "$ref": "#/$defs/level" },
            "unlocked": { "$ref": "#/$defs/level" },
            "last": { "$ref": "#/$defs/level" }
          }
        },
        "kind": { "enum": ["function", "design", "progressive", "concurrent", "project"] },
        "track": { "type": "string", "minLength": 1 },
        "timer": {
          "description": "The attempt's time box at the start; null without one",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["elapsed_s", "limit_s"],
          "properties": {
            "elapsed_s": { "$ref": "#/$defs/count" },
            "limit_s": { "$ref": "#/$defs/count" }
          }
        },
        "time_limit": {
          "description": "The value in effect (`5x`, `1500ms`); null when time limits are off",
          "type": ["string", "null"]
        },
        "planned": {
          "description": "What a single-file run will report, as its header counts it; null for a project",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["cases", "visible", "hidden", "generated", "oracle_inputs", "stress"],
          "properties": {
            "cases": { "$ref": "#/$defs/count" },
            "visible": { "$ref": "#/$defs/count" },
            "hidden": { "$ref": "#/$defs/count" },
            "generated": { "$ref": "#/$defs/count" },
            "oracle_inputs": { "$ref": "#/$defs/count" },
            "stress": {
              "description": "A concurrent problem's stress cases, variants, and runs per stress case and variant; else null",
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["cases", "variants", "runs"],
              "properties": {
                "cases": { "$ref": "#/$defs/count" },
                "variants": { "$ref": "#/$defs/count" },
                "runs": { "$ref": "#/$defs/count" }
              }
            }
          }
        }
      }
    },
    "output": {
      "description": "A progress notice the report would print; on a service project, a line `commands.test` printed too",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "text"],
      "properties": {
        "type": { "const": "output" },
        "version": { "$ref": "#/$defs/version" },
        "text": { "type": "string" },
        "stack": {
          "description": "A service project: the stage its stack reached with this notice",
          "enum": ["docker", "pulling", "installing", "starting", "ready", "failed", "stopped"]
        },
        "startup_s": {
          "description": "With `ready`: the startup, which no limit or result counts",
          "$ref": "#/$defs/seconds"
        }
      },
      "dependentRequired": { "startup_s": ["stack"] }
    },
    "build": {
      "description": "`cstudy test` on a single-file problem: the build or type check ended, built or not",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "seconds", "note"],
      "properties": {
        "type": { "const": "build" },
        "version": { "$ref": "#/$defs/version" },
        "seconds": { "$ref": "#/$defs/seconds" },
        "note": {
          "description": "`gradle, warm`; null when the build failed",
          "type": ["string", "null"]
        }
      }
    },
    "test_start": {
      "description": "`cstudy test`: the runner started one test of the native suite",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id"],
      "properties": {
        "type": { "const": "test_start" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "test_result": {
      "description": "`cstudy test`: one test of the native suite, as an entry of `cases` in `cstudy test --json`",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id", "status", "duration_ns", "origin", "level"],
      "properties": {
        "type": { "const": "test_result" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "error", "skip", "timeout", "not_run"] },
        "duration_ns": { "$ref": "#/$defs/duration_ns" },
        "origin": { "enum": ["level", "starter", "yours"] },
        "level": { "$ref": "#/$defs/optional_level" },
        "message": { "type": "string" },
        "expected": true,
        "actual": true,
        "error": { "$ref": "#/$defs/error" },
        "stdout": { "type": "string" }
      }
    },
    "case_start": {
      "description": "The runner started one graded case or oracle input; a mock submission has none for hidden cases",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id", "visible", "level"],
      "properties": {
        "type": { "const": "case_start" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "level": { "$ref": "#/$defs/optional_level" },
        "oracle": { "description": "An oracle input of `cstudy test --stress N`", "const": true },
        "seed": { "type": "integer" },
        "n": { "type": "integer", "minimum": 0 }
      },
      "dependentRequired": { "oracle": ["seed", "n"] }
    },
    "case_result": {
      "description": "One graded case or oracle input, as an entry of `cases` (or `oracle.inputs`) in `cstudy submit --json` or `cstudy test --json`; never `tle`. A project case on the virtual clock that deadlocked is `stalled`, with the operation as `op_index`, the operation and the virtual time as `reason`, and `input` up to that operation",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id", "visible", "generated", "status", "duration_ns", "level"],
      "properties": {
        "type": { "const": "case_result" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "generated": { "type": "boolean" },
        "status": { "enum": ["pass", "fail", "error", "timeout", "invalid", "stalled", "not_run"] },
        "duration_ns": { "$ref": "#/$defs/duration_ns" },
        "level": { "$ref": "#/$defs/optional_level" },
        "input": { "type": "object" },
        "expected": true,
        "actual": true,
        "reason": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/error" },
        "op_index": { "type": ["integer", "null"], "minimum": 0 },
        "partial_output": { "type": "array" },
        "hang_guard_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "stderr": { "type": "array", "items": { "type": "string" } },
        "time_limit_ms": { "type": "number", "minimum": 0 },
        "time_limit_basis": { "type": ["string", "null"] },
        "note": { "type": "string" },
        "stdout": { "type": "string" },
        "oracle": { "description": "An oracle input of `cstudy test --stress N`", "const": true },
        "seed": { "type": "integer" },
        "n": { "type": "integer", "minimum": 0 }
      },
      "dependentRequired": { "oracle": ["seed", "n"] }
    },
    "case_revised": {
      "description": "`cstudy test` on a single-file problem: a case whose verdict its time limit changed, its entry again, complete",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "id",
        "visible",
        "generated",
        "status",
        "duration_ns",
        "level",
        "time_limit_ms",
        "time_limit_basis"
      ],
      "properties": {
        "type": { "const": "case_revised" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "generated": { "type": "boolean" },
        "status": { "const": "tle" },
        "duration_ns": { "$ref": "#/$defs/duration_ns" },
        "level": { "$ref": "#/$defs/optional_level" },
        "input": { "type": "object" },
        "expected": true,
        "actual": true,
        "reason": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/error" },
        "op_index": { "type": ["integer", "null"], "minimum": 0 },
        "partial_output": { "type": "array" },
        "hang_guard_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "stderr": { "type": "array", "items": { "type": "string" } },
        "time_limit_ms": { "type": "number", "minimum": 0 },
        "time_limit_basis": { "type": ["string", "null"] },
        "note": { "type": "string" },
        "stdout": { "type": "string" }
      }
    },
    "stress_run_start": {
      "description": "`cstudy test` on a concurrent problem, and `cstudy submit` on a project with stress cases: the runner started one stress run",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "id", "variant", "run", "seed"],
      "properties": {
        "type": { "const": "stress_run_start" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "description": "The stress case", "type": "string", "minLength": 1 },
        "variant": { "$ref": "#/$defs/variant" },
        "run": { "description": "0-based", "$ref": "#/$defs/count" },
        "seed": { "type": "integer" },
        "level": { "description": "`cstudy submit` only: the level of the stress case", "$ref": "#/$defs/level" }
      }
    },
    "stress_run": {
      "description": "`cstudy test` on a concurrent problem, and `cstudy submit` on a project with stress cases: one stress run, judged against its invariants",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "id",
        "variant",
        "run",
        "seed",
        "status",
        "duration_ns",
        "reasons"
      ],
      "properties": {
        "type": { "const": "stress_run" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "description": "The stress case", "type": "string", "minLength": 1 },
        "variant": { "$ref": "#/$defs/variant" },
        "run": { "description": "0-based", "$ref": "#/$defs/count" },
        "seed": { "type": "integer" },
        "status": { "enum": ["pass", "fail", "error", "invalid", "stalled", "timeout", "not_run"] },
        "duration_ns": { "$ref": "#/$defs/duration_ns" },
        "reasons": {
          "description": "As the report prints them; empty on `pass`",
          "type": "array",
          "items": { "type": "string" }
        },
        "level": { "description": "`cstudy submit` only: the level of the stress case", "$ref": "#/$defs/level" }
      }
    },
    "stress_result": {
      "description": "`cstudy test` on a concurrent problem, and `cstudy submit` on a project with stress cases: one stress case and variant, as an entry of `stress` in `cstudy test --json`",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "id",
        "variant",
        "status",
        "runs",
        "runs_passed",
        "median_ms",
        "failures"
      ],
      "properties": {
        "type": { "const": "stress_result" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "minLength": 1 },
        "variant": { "$ref": "#/$defs/variant" },
        "status": { "enum": ["pass", "fail", "error", "invalid", "stalled", "timeout", "not_run"] },
        "runs": { "$ref": "#/$defs/count" },
        "runs_passed": { "$ref": "#/$defs/count" },
        "median_ms": { "type": ["number", "null"], "minimum": 0 },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run", "seed", "status", "reasons"],
            "properties": {
              "run": { "$ref": "#/$defs/count" },
              "seed": { "type": "integer" },
              "status": { "enum": ["fail", "error", "invalid", "stalled", "timeout", "not_run"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "level": { "description": "`cstudy submit` only: the level of the stress case", "$ref": "#/$defs/level" }
      }
    },
    "diagnostic": {
      "description": "Where code does not load, build or type-check (docs/specs/cli.md#diagnostics)",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "source", "severity", "file", "line", "column", "code", "message"],
      "properties": {
        "type": { "const": "diagnostic" },
        "version": { "$ref": "#/$defs/version" },
        "source": { "enum": ["load", "typecheck", "build"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "file": {
          "description": "Relative to the project folder for a project problem, else to the workspace root",
          "type": ["string", "null"]
        },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "code": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "level_result": {
      "description": "`cstudy submit`: one graded level, as an entry of `level_tallies` in `cstudy submit --json` plus its status",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "status",
        "level",
        "total",
        "passed",
        "visible_total",
        "visible_passed",
        "hidden_total",
        "hidden_passed"
      ],
      "properties": {
        "type": { "const": "level_result" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "enum": ["pass", "fail"] },
        "level": { "$ref": "#/$defs/level" },
        "total": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "visible_total": { "$ref": "#/$defs/count" },
        "visible_passed": { "$ref": "#/$defs/count" },
        "hidden_total": { "$ref": "#/$defs/count" },
        "hidden_passed": { "$ref": "#/$defs/count" }
      }
    },
    "level_unlocked": {
      "description": "The level the run opened: by a submission, or by `cstudy test` on a progressive problem",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "level", "title", "methods", "tests", "statement"],
      "properties": {
        "type": { "const": "level_unlocked" },
        "version": { "$ref": "#/$defs/version" },
        "level": { "$ref": "#/$defs/level" },
        "title": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" } },
        "tests": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "count"],
          "properties": {
            "path": { "description": "Relative to the project folder", "type": "string" },
            "count": { "$ref": "#/$defs/count" }
          },
          "description": "Null for a progressive problem, which has no generated test files"
        },
        "statement": { "type": "string" }
      }
    },
    "perf_result": {
      "description": "`cstudy test --perf`: the short bench after every case passed",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "verdict", "confidence", "text", "warnings", "wrong_answer"],
      "properties": {
        "type": { "const": "perf_result" },
        "version": { "$ref": "#/$defs/version" },
        "verdict": { "enum": ["optimal", "near-optimal", "suboptimal", "unknown", null] },
        "confidence": { "enum": ["high", "medium", "low", null] },
        "text": { "description": "The verdict line the report prints", "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "wrong_answer": {
          "description": "The `FAIL wrong answer at n=...` line",
          "type": ["string", "null"]
        }
      }
    },
    "run_end": {
      "description": "Last: the outcome, the exit code and the document `--json` prints",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "outcome", "exit_code", "message", "summary"],
      "properties": {
        "type": { "const": "run_end" },
        "version": { "$ref": "#/$defs/version" },
        "outcome": {
          "enum": ["passed", "failed", "build_failed", "load_failed", "error", "interrupted"]
        },
        "exit_code": { "enum": [0, 1, 2, 3, 4, 5, 70, 130, 143] },
        "message": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] }
      },
      "if": { "properties": { "outcome": { "enum": ["error", "interrupted"] } } },
      "then": { "properties": { "summary": { "type": "null" } } },
      "else": {
        "properties": {
          "summary": { "type": "object", "required": ["outcome", "exit_code"] },
          "message": { "type": "null" }
        }
      }
    },
    "case_status": {
      "enum": ["pass", "fail", "error", "timeout", "tle", "invalid", "stalled", "not_run"]
    },
    "variant": {
      "description": "As `stress` in `cstudy test --json` names it",
      "type": "string",
      "minLength": 1
    },
    "seconds": { "type": "number", "minimum": 0 }
  }
}
