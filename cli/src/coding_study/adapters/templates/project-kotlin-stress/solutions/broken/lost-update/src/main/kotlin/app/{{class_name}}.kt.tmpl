// The reference with `add` across two lock holds: another add between its read and its
// write is lost.
package app

import java.util.concurrent.locks.ReentrantLock
import kotlin.concurrent.withLock

class {{class_name}} {
    private val lock = ReentrantLock()
    private val counts = HashMap<String, Int>()

    fun add(key: String, amount: Int): Int {
        val count = count(key) + amount
        Thread.yield()
        lock.withLock { counts[key] = count }
        return count
    }

    fun count(key: String): Int = lock.withLock { counts.getOrDefault(key, 0) }

    fun take(key: String, amount: Int): Boolean = lock.withLock {
        val count = counts.getOrDefault(key, 0)
        if (count < amount) {
            false
        } else {
            counts[key] = count - amount
            true
        }
    }
}
