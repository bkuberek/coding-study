import asyncio

MILLISECONDS_PER_SECOND = 1000


class {{class_name}}:
    def __init__(self) -> None:
        self._counts: dict[str, int] = {}
        self._changed = asyncio.Event()

    async def add(self, key: str, amount: int) -> int:
        count = self._counts.get(key, 0) + amount
        self._counts[key] = count
        self._changed.set()
        self._changed = asyncio.Event()
        return count

    def count(self, key: str) -> int:
        return self._counts.get(key, 0)

    async def wait_for(self, key: str, at_least: int, wait_ms: int) -> int:
        try:
            async with asyncio.timeout(wait_ms / MILLISECONDS_PER_SECOND):
                while self.count(key) < at_least:
                    await self._changed.wait()
        except TimeoutError:
            pass
        return self.count(key)
