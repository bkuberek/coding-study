# coding-study workspace: commit your practice files, notes, .archive/ and problems/.
# Everything below is generated per machine; `cstudy doctor --fix` recreates it. The marker and
# the record of the IDE files cstudy wrote (.cs/ide.json) stay tracked.
/.cs/*
!/.cs/workspace.toml
!/.cs/ide.json
/.statements/
progress.db
progress.db-wal
progress.db-shm

# Toolchains and build output
node_modules/
.venv/
build/
.gradle/
.kotlin/
target/
__pycache__/
.ruff_cache/
.DS_Store

# Project folders: .venv is a link to python/.venv, which `.venv/` (a directory) does not match;
# a plain `uv run` in a folder writes uv.lock
projects/*/.venv
projects/*/uv.lock

# IntelliJ IDEA: commit .idea/misc.xml, .idea/gradle.xml and .idea/runConfigurations/ (written by
# `cstudy ide`), not the per-user state
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/libraries/
.idea/modules.xml
.idea/dataSources*
.idea/contentModel.xml
*.iml
