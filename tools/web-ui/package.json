{
  "name": "cstudy-web-ui",
  "private": true,
  "description": "Sources of the cstudy serve front end, built into cli/src/coding_study/entrypoints/web/static/",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
