 ordersRouter.get("/v1/orders", requireAuth, async (req, res) => {
+  const page = parseInt(req.query.page as string) || 1;
+  const pageSize = parseInt(req.query.pageSize as string) || DEFAULT_PAGE_SIZE;
+  if (pageSize > MAX_PAGE_SIZE) {
+    return res.status(400).send(`pageSize must be at most ${MAX_PAGE_SIZE}`);
+  }
+  // Support tooling passes customerId to look up a customer's orders.
+  const customerId = (req.query.customerId as string) ?? req.user.customerId;
+
   try {
-    const orders = await db.query<OrderRow>(
