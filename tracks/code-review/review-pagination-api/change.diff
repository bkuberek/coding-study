-        WHERE customer_id = $1
-        ORDER BY created_at DESC
-        LIMIT 500`,
-      [req.user.customerId],
-    );
-    res.json(orders.rows.map(toOrderDto));
+    const [orders, count] = await Promise.all([
+      db.query<OrderRow>(
+        `SELECT id, status, total_cents, currency, created_at
+           FROM orders
+          WHERE customer_id = $1
+          ORDER BY created_at DESC
+          LIMIT $2 OFFSET $3`,
+        [customerId, pageSize, (page - 1) * pageSize],
+      ),
+      db.query<{ count: string }>("SELECT COUNT(*) FROM orders WHERE customer_id = $1", [
+        customerId,
+      ]),
+    ]);
+    res.json({
+      data: orders.rows.map(toOrderDto),
+      page,
+      pageSize,
+      total: Number(count.rows[0].count),
