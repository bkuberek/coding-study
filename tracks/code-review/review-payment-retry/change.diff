diff --git a/src/test/java/com/example/payments/gateway/PspClientTest.java b/src/test/java/com/example/payments/gateway/PspClientTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/com/example/payments/gateway/PspClientTest.java
@@ -0,0 +1,42 @@
+package com.example.payments.gateway;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+
+import org.junit.jupiter.api.Test;
+
+class PspClientTest {
+    private final HttpClient httpClient = mock(HttpClient.class);
+    private final PspClient client =
+            new PspClient(httpClient, URI.create("https://psp.test"), "test-key", new JacksonCodec());
+
+    @Test
+    void retriesUntilTheChargeSucceeds() throws Exception {
+        HttpResponse<String> unavailable = response(503, "");
+        HttpResponse<String> ok = response(200, "{\"id\":\"ch_1\",\"status\":\"succeeded\"}");
+        when(httpClient.send(any(HttpRequest.class), any(HttpResponse.BodyHandler.class)))
+                .thenReturn(unavailable, unavailable, ok);
+
+        ChargeResult result = client.charge(new ChargeRequest("pay_42", 1999, "USD", "tok_visa"));
+
+        assertThat(result.id()).isEqualTo("ch_1");
+        verify(httpClient, times(3)).send(any(HttpRequest.class), any(HttpResponse.BodyHandler.class));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static HttpResponse<String> response(int status, String body) {
+        HttpResponse<String> response = mock(HttpResponse.class);
+        when(response.statusCode()).thenReturn(status);
+        when(response.body()).thenReturn(body);
+        return response;
+    }
+}
