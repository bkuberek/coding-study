+package com.example.reports
+
+import com.example.orders.OrderRepository
+import com.example.refunds.RefundRepository
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.math.BigDecimal
+import java.time.YearMonth
+import java.time.ZoneOffset
+
+data class ReportRow(
+    val orderId: Long,
+    val customerName: String,
+    val itemsTotal: BigDecimal,
+    val refunded: Double,
+    val net: Double,
+)
+
+@Service
+class SalesReportService(
+    private val orders: OrderRepository,
+    private val refunds: RefundRepository,
+) {
+    @Transactional(readOnly = true)
+    fun monthlyReport(merchantId: Long, month: YearMonth): List<ReportRow> {
+        val monthOrders = orders.findAll().filter {
+            it.merchantId == merchantId && YearMonth.from(it.createdAt.atOffset(ZoneOffset.UTC)) == month
+        }
+        val merchantRefunds = refunds.findByMerchantId(merchantId)
+
+        val rows = mutableListOf<ReportRow>()
+        for (order in monthOrders) {
+            val itemsTotal = order.items.sumOf { it.unitPrice * it.quantity.toBigDecimal() }
+            val refunded = merchantRefunds.filter { it.orderId == order.id }.sumOf { it.amount }
+            rows.add(
+                ReportRow(
+                    orderId = order.id,
+                    customerName = order.customer.name,
+                    itemsTotal = itemsTotal,
+                    refunded = refunded,
+                    net = itemsTotal.toDouble() - refunded,
+                )
+            )
+        }
+        return rows.sortedBy { it.orderId }
+    }
+}
