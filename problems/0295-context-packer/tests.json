{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["ContextPacker", "addItem", "addItem", "addItem", "addItem", "pack", "pack", "addItem", "removeItem", "pack"], "args": [[], [1, "a", "user prefers metric units", 30, 90], [2, "b", "user lives in porto", 20, 80], [3, "c", "user asked about trains last week", 50, 80], [4, "d", "user dislikes long answers", 10, 40], [5, 60], [6, 100], [7, "a", "user prefers miles", 5, 99], [8, "b"], [9, 60]], "expected": [null, true, true, true, true, ["a", "b", "d"], ["a", "b", "c"], false, true, ["a", "d"]]},
    {"id": "h1", "level": 1, "note": "an empty packer packs nothing; a budget equal to an item's tokens fits it", "ops": ["ContextPacker", "pack", "addItem", "pack", "pack", "pack", "removeItem", "removeItem", "removeItem", "pack"], "args": [[], [1, 100], [2, "x", "only item", 5, 10], [3, 4], [4, 5], [5, 0], [6, "y"], [7, "x"], [8, "x"], [9, 5]], "expected": [null, [], true, [], ["x"], [], false, true, false, []]},
    {"id": "h2", "level": 1, "note": "equal scores go by fewer tokens, then by id in string order; an item that does not fit is skipped, not the end", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "addItem", "pack", "pack", "pack"], "args": [[], [1, "m2", "second note", 10, 50], [2, "m10", "tenth note", 10, 50], [3, "m3", "third", 5, 50], [4, "top", "most relevant", 40, 99], [5, 100], [6, 20], [7, 39]], "expected": [null, true, true, true, true, ["top", "m3", "m10", "m2"], ["m3", "m10"], ["m3", "m10", "m2"]]},
    {"id": "h3", "level": 1, "note": "a removed id can be added again with new tokens and score; a failed add changes nothing", "ops": ["ContextPacker", "addItem", "addItem", "pack", "removeItem", "addItem", "addItem", "pack", "pack"], "args": [[], [1, "a", "old fact", 10, 10], [2, "a", "new fact", 1, 100], [3, 5], [4, "a"], [5, "a", "new fact", 5, 20], [6, "b", "other fact", 5, 15], [7, 5], [8, 10]], "expected": [null, true, false, [], true, true, true, ["a"], ["a", "b"]]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["ContextPacker", "addItem", "addItem", "addItem", "addItem", "pin", "pin", "pack", "pin", "pack", "pack", "unpin", "pack"], "args": [[], [1, "style", "answer in short bullet points", 15, 30], [2, "name", "user is called rui", 5, 95], [3, "job", "user works night shifts as a nurse", 20, 70], [4, "pet", "user has a cat named miso", 10, 60], [5, "style"], [6, "style"], [7, 40], [8, "pet"], [9, 30], [10, 20], [11, "style"], [12, 20]], "expected": [null, true, true, true, true, true, false, ["style", "name", "job"], true, ["pet", "style", "name"], ["OVER_BUDGET"], true, ["pet", "name"]]},
    {"id": "h4", "level": 2, "note": "pins that use the whole budget pass; one token less fails; removing an item drops its pin", "ops": ["ContextPacker", "addItem", "addItem", "pin", "pack", "pack", "pin", "unpin", "removeItem", "pack", "addItem", "pack", "unpin"], "args": [[], [1, "a", "pinned fact", 10, 1], [2, "b", "ranked fact", 5, 99], [3, "a"], [4, 10], [5, 9], [6, "zz"], [7, "b"], [8, "a"], [9, 9], [10, "a", "pinned fact", 10, 1], [11, 10], [12, "a"]], "expected": [null, true, true, true, ["a"], ["OVER_BUDGET"], false, false, true, ["b"], true, ["b"], false]},
    {"id": "h5", "level": 2, "note": "pins go first whatever their score, ordered among themselves like any items, and never twice", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "pin", "pin", "pack", "pack", "pack", "pack", "unpin", "unpin", "pack"], "args": [[], [1, "low", "low score", 30, 1], [2, "high", "high score", 30, 100], [3, "mid", "middle score", 30, 50], [4, "mid"], [5, "low"], [6, 90], [7, 60], [8, 59], [9, 0], [10, "mid"], [11, "low"], [12, 0]], "expected": [null, true, true, true, true, true, ["mid", "low", "high"], ["mid", "low"], ["OVER_BUDGET"], ["OVER_BUDGET"], true, true, []]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["ContextPacker", "addItem", "addItem", "addItem", "addItem", "setCategory", "setCategory", "setCategory", "pack", "setCap", "pack", "setCategory"], "args": [[], [1, "f1", "likes jazz", 10, 90], [2, "f2", "likes blues", 10, 80], [3, "f3", "likes opera", 10, 70], [4, "t1", "asked about visas", 10, 60], [5, "f1", "taste"], [6, "f2", "taste"], [7, "f3", "taste"], [8, 100], [9, "taste", 2], [10, 100], [11, "zz", "taste"]], "expected": [null, true, true, true, true, true, true, true, ["f1", "f2", "f3", "t1"], null, ["f1", "f2", "t1"], false]},
    {"id": "h6", "level": 3, "note": "pins count toward their category's cap and stay in even past it, down to a cap of 0", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "setCategory", "setCategory", "setCategory", "setCap", "pin", "pack", "setCap", "pack", "unpin", "pack", "setCap", "pack"], "args": [[], [1, "a", "first", 5, 10], [2, "b", "second", 5, 90], [3, "c", "third", 5, 80], [4, "a", "k"], [5, "b", "k"], [6, "c", "k"], [7, "k", 1], [8, "a"], [9, 100], [10, "k", 0], [11, 100], [12, "a"], [13, 100], [14, "k", 2], [15, 100]], "expected": [null, true, true, true, true, true, true, null, true, ["a"], null, ["a"], true, [], null, ["b", "c"]]},
    {"id": "h7", "level": 3, "note": "setCategory moves an item; items without a category, or in one without a cap, are unlimited; removal drops the category", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "setCategory", "setCategory", "setCap", "pack", "setCategory", "pack", "removeItem", "addItem", "setCategory", "pack"], "args": [[], [1, "a", "alpha", 5, 90], [2, "b", "beta", 5, 80], [3, "c", "gamma", 5, 70], [4, "a", "one"], [5, "b", "one"], [6, "one", 1], [7, 100], [8, "a", "two"], [9, 100], [10, "b"], [11, "b", "beta", 5, 80], [12, "c", "one"], [13, 100]], "expected": [null, true, true, true, true, true, null, ["a", "c"], true, ["a", "b", "c"], true, true, true, ["a", "b", "c"]]},
    {"id": "h8", "level": 3, "note": "an item skipped for the budget does not use its category's cap", "ops": ["ContextPacker", "addItem", "addItem", "setCategory", "setCategory", "setCap", "pack", "pack"], "args": [[], [1, "big", "large summary", 50, 90], [2, "small", "short summary", 10, 80], [3, "big", "k"], [4, "small", "k"], [5, "k", 1], [6, 20], [7, 100]], "expected": [null, true, true, true, true, null, ["small"], ["big"]]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["ContextPacker", "addItem", "addItem", "addItem", "pack", "duplicateOf", "duplicateOf", "duplicateOf"], "args": [[], [1, "a", "the user lives in porto with two cats", 12, 90], [2, "b", "the user lives in porto with two cats now", 13, 70], [3, "c", "the user works in porto", 8, 60], [4, 100], [5, "b"], [6, "a"], [7, "zz"]], "expected": [null, true, true, true, ["a", "c"], "a", "", ""]},
    {"id": "h9", "level": 4, "note": "a similarity of exactly 0.8 is not a duplicate; word sets ignore order and repeats", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "pack", "duplicateOf", "duplicateOf"], "args": [[], [1, "a", "user lives in porto portugal", 5, 90], [2, "b", "user lives in porto", 5, 80], [3, "c", "porto in lives user user", 5, 70], [4, 100], [5, "b"], [6, "c"]], "expected": [null, true, true, true, ["a", "b"], "", "b"]},
    {"id": "h10", "level": 4, "note": "collapse runs before the budget: a kept item that does not fit still knocks out its duplicate; duplicates do not chain", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "pack", "pack", "duplicateOf", "duplicateOf", "removeItem", "pack", "duplicateOf"], "args": [[], [1, "x", "user wants short answers with code in python every time", 50, 90], [2, "y", "user wants short answers with code in python every day", 10, 80], [3, "z", "user wants short answers with code in python each day", 10, 70], [4, 100], [5, 40], [6, "y"], [7, "z"], [8, "x"], [9, 100], [10, "z"]], "expected": [null, true, true, true, ["x", "z"], ["z"], "x", "", true, ["y"], "y"]},
    {"id": "h11", "level": 4, "note": "pinned items are never knocked out but knock out unpinned duplicates; equal scores keep the item with fewer tokens", "ops": ["ContextPacker", "addItem", "addItem", "pin", "pack", "duplicateOf", "addItem", "pin", "pack", "duplicateOf", "unpin", "unpin", "pack", "duplicateOf", "addItem", "addItem", "pack", "duplicateOf"], "args": [[], [1, "p", "user likes green tea a lot", 10, 10], [2, "q", "user likes green tea a lot today", 10, 90], [3, "p"], [4, 100], [5, "q"], [6, "r", "user likes green tea a lot", 10, 10], [7, "r"], [8, 100], [9, "r"], [10, "p"], [11, "r"], [12, 100], [13, "r"], [14, "s", "blue sky", 5, 50], [15, "t", "blue sky", 4, 50], [16, 100], [17, "s"]], "expected": [null, true, true, true, ["p"], "p", true, true, ["p", "r"], "", true, true, ["q"], "q", true, true, ["q", "t"], "t"]},
    {"id": "h12", "level": 4, "note": "a knocked-out item uses neither the budget nor its category's cap", "ops": ["ContextPacker", "addItem", "addItem", "addItem", "setCategory", "setCategory", "setCategory", "setCap", "pack", "duplicateOf"], "args": [[], [1, "a", "alpha beta gamma delta epsilon", 10, 90], [2, "b", "alpha beta gamma delta epsilon", 10, 80], [3, "c", "zeta eta theta", 10, 70], [4, "a", "k"], [5, "b", "k"], [6, "c", "k"], [7, "k", 2], [8, 20], [9, "b"]], "expected": [null, true, true, true, true, true, true, null, ["a", "c"], "a"]}
  ]
}
