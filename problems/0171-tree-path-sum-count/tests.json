{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"root": [4, 2, -1, 3, 1, null, 5], "targetSum": 3}, "expected": 3},
    {"id": "ex2", "visible": true, "input": {"root": [0, 0, null, 0], "targetSum": 0}, "expected": 6},
    {"id": "h1", "input": {"root": [], "targetSum": 0}, "expected": 0, "note": "empty tree"},
    {"id": "h2", "input": {"root": [7], "targetSum": 7}, "expected": 1, "note": "single node equal to the target"},
    {"id": "h3", "input": {"root": [7], "targetSum": 0}, "expected": 0, "note": "single node, no answer; the empty path never counts"},
    {"id": "h4", "input": {"root": [1, null, 2, null, 3, null, 4, null, 5], "targetSum": 9}, "expected": 2, "note": "right-leaning chain; one match in the middle and one at the bottom"},
    {"id": "h5", "input": {"root": [-2, -3, 4, -1, null, null, -6], "targetSum": -5}, "expected": 1, "note": "negative values and target"},
    {"id": "h6", "input": {"root": [5, 3, 3, 2, 2, 2, 2], "targetSum": 5}, "expected": 5, "note": "sibling subtrees must not share prefix sums"},
    {"id": "h7", "input": {"root": [1, 1, 1, 1, 1, 1, 1], "targetSum": 2}, "expected": 6, "note": "all values equal"},
    {"id": "h8", "input": {"root": [1000, 1000, null, 1000, null, -1000], "targetSum": 2000}, "expected": 3, "note": "extreme values on a chain"},
    {"id": "h9", "input": {"root": [8, 2, 13, null, null, 9, 4], "targetSum": 100}, "expected": 0, "note": "no path reaches the target"},
    {"id": "h10", "input": {"root": [2, 1, -1, null, 1, 1], "targetSum": 2}, "expected": 3, "note": "paths that end above a leaf"},
    {"id": "h11", "input": {"root": [0, 1, -1, -1, 1, 1, -1], "targetSum": 0}, "expected": 5, "note": "many zero-sum paths of different lengths"},
    {"id": "h12", "input": {"root": [6, -2, 4, 3, 1, null, -4, 2, null, null, 5, null, 7], "targetSum": 7}, "expected": 3, "note": "a mixed tree with answers at several depths"},
    {"id": "g1", "generate": {"n": 3000, "seed": 1}, "note": "large deep tree: walking down from every node is about 2 * 10^6 steps here"},
    {"id": "g2", "generate": {"n": 3000, "seed": 2}, "note": "large deep tree"},
    {"id": "g3", "generate": {"n": 300, "seed": 3}}
  ]
}
