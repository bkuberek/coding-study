{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"s": "bananas", "t": "ana"}, "expected": 4},
    {"id": "ex2", "visible": true, "input": {"s": "abc", "t": "ca"}, "expected": 0},
    {"id": "h1", "input": {"s": "a", "t": "a"}, "expected": 1, "note": "single equal letters"},
    {"id": "h2", "input": {"s": "a", "t": "b"}, "expected": 0, "note": "single different letters"},
    {"id": "h3", "input": {"s": "word", "t": "word"}, "expected": 1, "note": "s equals t"},
    {"id": "h4", "input": {"s": "ab", "t": "abc"}, "expected": 0, "note": "t longer than s"},
    {"id": "h5", "input": {"s": "aaaa", "t": "a"}, "expected": 4, "note": "t is one repeated letter of s"},
    {"id": "h6", "input": {"s": "aaaa", "t": "aa"}, "expected": 6, "note": "choose 2 of 4 equal letters"},
    {"id": "h7", "input": {"s": "xyz", "t": "abc"}, "expected": 0, "note": "no letter in common"},
    {"id": "h8", "input": {"s": "AaAa", "t": "Aa"}, "expected": 3, "note": "upper and lower case are different letters"},
    {"id": "h9", "input": {"s": "aabb", "t": "ab"}, "expected": 4, "note": "every a pairs with every b"},
    {"id": "h10", "input": {"s": "abcabc", "t": "abc"}, "expected": 4, "note": "two copies interleave"},
    {"id": "h11", "input": {"s": "ddcbbaa", "t": "abcd"}, "expected": 0, "note": "the letters appear in reverse order only"},
    {"id": "h12", "input": {"s": "", "t": "aaa"}, "expected": 166167000, "note": "maximum length: C(1000, 3) occurrences"},
    {"id": "h13", "input": {"s": "", "t": "ab"}, "expected": 125250, "note": "maximum length, alternating"},
    {"id": "h14", "input": {"s": "", "t": ""}, "expected": 0, "note": "maximum lengths, nothing matches"},
    {"id": "g1", "generate": {"n": 1000, "seed": 1}, "note": "s of 1000 letters, t of 100 to 250"},
    {"id": "g2", "generate": {"n": 1000, "seed": 4}, "note": "s of 1000 letters, t of 100 to 250"},
    {"id": "g3", "generate": {"n": 200, "seed": 3}}
  ]
}
