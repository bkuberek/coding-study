{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["ReplicaTable", "apply", "apply", "apply", "rows", "apply", "apply", "rows"], "args": [[["id", "name", "city"]], ["insert", ["7", "Ana", "Lisbon"]], ["insert", ["3", "Ben", "Oslo"]], ["update", ["7", "Ana", "Porto"]], [], ["delete", ["3"]], ["insert", ["5", "Cy", "Rome"]], []], "expected": [null, "ok", "ok", "ok", [["3", "Ben", "Oslo"], ["7", "Ana", "Porto"]], "ok", "ok", [["5", "Cy", "Rome"], ["7", "Ana", "Porto"]]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["ReplicaTable", "apply", "apply", "apply", "apply", "apply", "rows"], "args": [[["id", "name", "city"]], ["insert", ["9", "Dee", "Kyiv"]], ["insert", ["10", "Eli", "Cork"]], ["insert", ["9", "Fay", "Riga"]], ["update", ["4", "Gus", "Bern"]], ["delete", ["4"]], []], "expected": [null, "ok", "ok", "duplicate-key", "unknown-key", "unknown-key", [["10", "Eli", "Cork"], ["9", "Dee", "Kyiv"]]]},
    {"id": "h1", "level": 1, "note": "a deleted row can be inserted again, but not updated or deleted again", "ops": ["ReplicaTable", "apply", "apply", "apply", "apply", "apply", "rows"], "args": [[["id", "name", "city"]], ["insert", ["a", "x", "y"]], ["delete", ["a"]], ["update", ["a", "x", "z"]], ["delete", ["a"]], ["insert", ["a", "p", "q"]], []], "expected": [null, "ok", "ok", "unknown-key", "unknown-key", "ok", [["a", "p", "q"]]]},
    {"id": "h2", "level": 1, "note": "keys sort by character codes: capitals before small letters, 10 before 9", "ops": ["ReplicaTable", "apply", "apply", "apply", "apply", "apply", "apply", "rows"], "args": [[["sku", "qty"]], ["insert", ["b", "b!"]], ["insert", ["9", "9!"]], ["insert", ["B", "B!"]], ["insert", ["10", "10!"]], ["insert", ["a", "a!"]], ["insert", ["A-1", "A-1!"]], []], "expected": [null, "ok", "ok", "ok", "ok", "ok", "ok", [["10", "10!"], ["9", "9!"], ["A-1", "A-1!"], ["B", "B!"], ["a", "a!"], ["b", "b!"]]]},
    {"id": "h3", "level": 1, "note": "an update replaces the whole row, and a value can be empty", "ops": ["ReplicaTable", "apply", "apply", "apply", "rows"], "args": [[["id", "name", "city"]], ["insert", ["1", "Hal", "Nice"]], ["update", ["1", "", "Nice"]], ["update", ["1", "Hal", ""]], []], "expected": [null, "ok", "ok", "ok", [["1", "Hal", ""]]]},
    {"id": "h4", "level": 1, "note": "a table whose only column is the key", "ops": ["ReplicaTable", "apply", "apply", "apply", "apply", "apply", "rows"], "args": [[["code"]], ["insert", ["x"]], ["insert", ["y"]], ["update", ["x"]], ["delete", ["y"]], ["insert", ["x"]], []], "expected": [null, "ok", "ok", "ok", "ok", "duplicate-key", [["x"]]]},
    {"id": "h5", "level": 1, "note": "a rejected change leaves the row as it was", "ops": ["ReplicaTable", "apply", "apply", "rows", "apply", "rows"], "args": [[["id", "name", "city"]], ["insert", ["2", "Ivy", "Graz"]], ["insert", ["2", "Jon", "Linz"]], [], ["update", ["8", "Kim", "Wels"]], []], "expected": [null, "ok", "duplicate-key", [["2", "Ivy", "Graz"]], "unknown-key", [["2", "Ivy", "Graz"]]]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "applyAt", "rows", "version", "version", "applyAt", "applyAt", "applyAt", "applyAt", "rows"], "args": [[["id", "name", "city"]], [1, "insert", ["1", "Ana", "Lisbon"]], [2, "insert", ["2", "Ben", "Oslo"]], [3, "update", ["1", "Ana", "Porto"]], [4, "delete", ["2"]], [], ["1"], ["2"], [1, "insert", ["1", "Ana", "Lisbon"]], [2, "insert", ["2", "Ben", "Oslo"]], [3, "update", ["1", "Ana", "Porto"]], [4, "delete", ["2"]], []], "expected": [null, "ok", "ok", "ok", "ok", [["1", "Ana", "Porto"]], 3, 4, "skipped", "skipped", "skipped", "skipped", [["1", "Ana", "Porto"]]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "rows", "version", "version", "applyAt", "rows", "version"], "args": [[["id", "name", "city"]], [10, "insert", ["k", "Lu", "Pisa"]], [12, "delete", ["k"]], [10, "insert", ["k", "Lu", "Pisa"]], [], ["k"], ["q"], [15, "insert", ["k", "Lu", "Bari"]], [], ["k"]], "expected": [null, "ok", "ok", "skipped", [], 12, -1, "ok", [["k", "Lu", "Bari"]], 15]},
    {"id": "h6", "level": 2, "note": "replaying any suffix of the log changes nothing, and new changes still apply", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "applyAt", "applyAt", "applyAt", "applyAt", "applyAt", "applyAt", "rows", "applyAt", "rows"], "args": [[["id", "name", "city"]], [1, "insert", ["a", "1", "x"]], [2, "insert", ["b", "2", "y"]], [3, "update", ["a", "3", "x"]], [4, "delete", ["b"]], [5, "insert", ["c", "5", "z"]], [6, "update", ["c", "6", "z"]], [4, "delete", ["b"]], [5, "insert", ["c", "5", "z"]], [6, "update", ["c", "6", "z"]], [], [7, "insert", ["b", "7", "w"]], []], "expected": [null, "ok", "ok", "ok", "ok", "ok", "ok", "skipped", "skipped", "skipped", [["a", "3", "x"], ["c", "6", "z"]], "ok", [["a", "3", "x"], ["b", "7", "w"], ["c", "6", "z"]]]},
    {"id": "h7", "level": 2, "note": "a change delivered twice in a row is applied once", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "applyAt", "rows", "version"], "args": [[["id", "name", "city"]], [3, "insert", ["m", "Mo", "Bonn"]], [3, "insert", ["m", "Mo", "Bonn"]], [4, "update", ["m", "Mo", "Kiel"]], [4, "update", ["m", "Mo", "Kiel"]], [], ["m"]], "expected": [null, "ok", "skipped", "ok", "skipped", [["m", "Mo", "Kiel"]], 4]},
    {"id": "h8", "level": 2, "note": "changes of different keys may arrive out of order: positions are compared per key", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "rows", "version", "version"], "args": [[["id", "name", "city"]], [5, "insert", ["b", "Bo", "Ulm"]], [3, "insert", ["a", "Al", "Ems"]], [4, "update", ["a", "Al", "Hof"]], [], ["a"], ["b"]], "expected": [null, "ok", "ok", "ok", [["a", "Al", "Hof"], ["b", "Bo", "Ulm"]], 4, 5]},
    {"id": "h9", "level": 2, "note": "a rejected change does not move the version, so it can apply later", "ops": ["ReplicaTable", "applyAt", "version", "applyAt", "applyAt", "rows", "version"], "args": [[["id", "name", "city"]], [3, "update", ["n", "Ned", "Gent"]], ["n"], [2, "insert", ["n", "Ned", "Mons"]], [3, "update", ["n", "Ned", "Gent"]], [], ["n"]], "expected": [null, "unknown-key", -1, "ok", "ok", [["n", "Ned", "Gent"]], 3]},
    {"id": "h10", "level": 2, "note": "an older change that arrives after a newer one for the same key is stale", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "applyAt", "rows", "version"], "args": [[["id", "name", "city"]], [1, "insert", ["p", "Pia", "Como"]], [4, "update", ["p", "Pia", "Bra"]], [3, "update", ["p", "Pia", "Asti"]], [2, "delete", ["p"]], [], ["p"]], "expected": [null, "ok", "ok", "skipped", "skipped", [["p", "Pia", "Bra"]], 4]},
    {"id": "h11", "level": 2, "note": "a delete leaves a tombstone: an old insert stays out, and an unseen key has version -1", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "applyAt", "rows", "version", "version", "applyAt", "applyAt", "rows", "version"], "args": [[["id", "name", "city"]], [1, "insert", ["t", "Tom", "Faro"]], [3, "delete", ["t"]], [1, "insert", ["t", "Tom", "Faro"]], [2, "update", ["t", "Tom", "Beja"]], [], ["t"], ["u"], [3, "insert", ["t", "Tom", "Evora"]], [4, "insert", ["t", "Tom", "Evora"]], [], ["t"]], "expected": [null, "ok", "ok", "skipped", "skipped", [], 3, -1, "skipped", "ok", [["t", "Tom", "Evora"]], 4]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["ReplicaTable", "applyAt", "stage", "stage", "stage", "rows", "commit", "rows", "version", "version", "rollback", "stage", "rows"], "args": [[["id", "name", "city"]], [1, "insert", ["1", "Ana", "Lisbon"]], ["t1", "insert", ["2", "Ben", "Oslo"]], ["t2", "update", ["1", "Ana", "Faro"]], ["t1", "update", ["1", "Ana", "Porto"]], [], [4, "t1"], [], ["1"], ["2"], ["t2"], ["t3", "delete", ["2"]], []], "expected": [null, "ok", null, null, null, [["1", "Ana", "Lisbon"]], "ok", [["1", "Ana", "Porto"], ["2", "Ben", "Oslo"]], 4, 4, null, null, [["1", "Ana", "Porto"], ["2", "Ben", "Oslo"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["ReplicaTable", "loadSnapshot", "version", "applyAt", "stage", "stage", "commit", "applyAt", "commit", "rows", "version"], "args": [[["id", "name", "city"]], [5, [["1", "Ana", "Porto"], ["3", "Cat", "Turku"], ["4", "Dan", "Bern"], ["9", "Ida", "Oulu"]]], ["1"], [2, "insert", ["3", "Cat", "Turku"]], ["a", "insert", ["9", "Ida", "Oulu"]], ["b", "update", ["4", "Dan", "Chur"]], [4, "a"], [6, "update", ["1", "Ana", "Braga"]], [7, "b"], [], ["4"]], "expected": [null, null, 5, "skipped", null, null, "skipped", "ok", "ok", [["1", "Ana", "Braga"], ["3", "Cat", "Turku"], ["4", "Dan", "Chur"], ["9", "Ida", "Oulu"]], 7]},
    {"id": "h12", "level": 3, "note": "a transaction applies all of its changes or none of them", "ops": ["ReplicaTable", "applyAt", "stage", "stage", "stage", "commit", "rows", "version", "version"], "args": [[["id", "name", "city"]], [1, "insert", ["a", "1", "x"]], ["t", "insert", ["b", "2", "y"]], ["t", "update", ["a", "3", "x"]], ["t", "insert", ["a", "4", "x"]], [2, "t"], [], ["a"], ["b"]], "expected": [null, "ok", null, null, null, "duplicate-key", [["a", "1", "x"]], 1, -1]},
    {"id": "h13", "level": 3, "note": "changes inside one transaction see each other, in the order they were staged", "ops": ["ReplicaTable", "stage", "stage", "stage", "stage", "commit", "rows", "version", "stage", "stage", "commit", "rows"], "args": [[["id", "name", "city"]], ["t", "insert", ["k", "Kai", "Ayr"]], ["t", "update", ["k", "Kai", "Elgin"]], ["t", "delete", ["k"]], ["t", "insert", ["k", "Kai", "Oban"]], [3, "t"], [], ["k"], ["u", "insert", ["z", "Zoe", "Perth"]], ["u", "insert", ["z", "Zoe", "Wick"]], [4, "u"], []], "expected": [null, null, null, null, null, "ok", [["k", "Kai", "Oban"]], 3, null, null, "duplicate-key", [["k", "Kai", "Oban"]]]},
    {"id": "h14", "level": 3, "note": "a replayed transaction is skipped, and its keys, deleted ones too, take the commit position", "ops": ["ReplicaTable", "applyAt", "stage", "stage", "commit", "version", "version", "stage", "stage", "commit", "rows"], "args": [[["id", "name", "city"]], [1, "insert", ["d", "Dot", "Lund"]], ["t", "insert", ["e", "Eve", "Gavle"]], ["t", "delete", ["d"]], [6, "t"], ["d"], ["e"], ["t", "insert", ["e", "Eve", "Gavle"]], ["t", "delete", ["d"]], [6, "t"], []], "expected": [null, "ok", null, null, "ok", 6, 6, null, null, "skipped", [["e", "Eve", "Gavle"]]]},
    {"id": "h15", "level": 3, "note": "an open transaction is invisible to everything else, even to another transaction's checks", "ops": ["ReplicaTable", "stage", "stage", "rows", "commit", "commit", "rows", "stage", "rows", "version"], "args": [[["id", "name", "city"]], ["t1", "insert", ["k", "One", "Avr"]], ["t2", "insert", ["k", "Two", "Dax"]], [], [5, "t2"], [6, "t1"], [], ["t3", "update", ["k", "Three", "Pau"]], [], ["k"]], "expected": [null, null, null, [], "ok", "duplicate-key", [["k", "Two", "Dax"]], null, [["k", "Two", "Dax"]], 5]},
    {"id": "h16", "level": 3, "note": "the snapshot covers every change up to its position, so a deleted row is not brought back", "ops": ["ReplicaTable", "loadSnapshot", "applyAt", "applyAt", "applyAt", "rows", "version", "version", "version", "applyAt", "rows"], "args": [[["id", "name", "city"]], [8, [["b", "Bea", "Vigo"], ["c", "Cid", "Jaen"]]], [2, "insert", ["a", "Abe", "Leon"]], [5, "delete", ["a"]], [8, "insert", ["c", "Cid", "Jaen"]], [], ["a"], ["b"], ["c"], [9, "update", ["b", "Bea", "Lugo"]], []], "expected": [null, null, "skipped", "skipped", "skipped", [["b", "Bea", "Vigo"], ["c", "Cid", "Jaen"]], -1, 8, 8, "ok", [["b", "Bea", "Lugo"], ["c", "Cid", "Jaen"]]]},
    {"id": "h17", "level": 3, "note": "a transaction that commits at the snapshot's position is in it; one after it is applied whole", "ops": ["ReplicaTable", "loadSnapshot", "stage", "commit", "stage", "commit", "stage", "stage", "commit", "rows", "version", "version", "version"], "args": [[["id", "name", "city"]], [5, [["x", "Xia", "Uji"], ["y", "Yul", "Nara"]]], ["s", "update", ["x", "Xia", "Uji"]], [5, "s"], ["q", "delete", ["z"]], [5, "q"], ["r", "update", ["y", "Yul", "Ise"]], ["r", "insert", ["w", "Wu", "Tsu"]], [6, "r"], [], ["x"], ["y"], ["w"]], "expected": [null, null, null, "skipped", null, "skipped", null, null, "ok", [["w", "Wu", "Tsu"], ["x", "Xia", "Uji"], ["y", "Yul", "Ise"]], 5, 6, 6]},
    {"id": "h18", "level": 3, "note": "a rollback empties the transaction, and a name can be used again after it ends", "ops": ["ReplicaTable", "stage", "rollback", "stage", "commit", "stage", "commit", "rows"], "args": [[["id", "name", "city"]], ["t", "insert", ["a", "1", "x"]], ["t"], ["t", "insert", ["b", "2", "y"]], [3, "t"], ["t", "insert", ["c", "3", "z"]], [4, "t"], []], "expected": [null, null, null, null, "ok", null, "ok", [["b", "2", "y"], ["c", "3", "z"]]]},
    {"id": "h19", "level": 3, "note": "within a commit, a change to a key that is already newer is skipped and the others apply", "ops": ["ReplicaTable", "applyAt", "applyAt", "stage", "stage", "applyAt", "commit", "rows", "version", "version"], "args": [[["id", "name", "city"]], [1, "insert", ["a", "1", "x"]], [2, "insert", ["b", "2", "y"]], ["t", "update", ["a", "3", "x"]], ["t", "update", ["b", "4", "y"]], [9, "update", ["a", "9", "x"]], [7, "t"], [], ["a"], ["b"]], "expected": [null, "ok", "ok", null, null, "ok", "ok", [["a", "9", "x"], ["b", "4", "y"]], 9, 7]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["ReplicaTable", "applyAt", "applyAt", "alterAt", "rows", "applyAt", "alterAt", "alterAt", "columns", "rows"], "args": [[["id", "name"]], [1, "insert", ["1", "Ana"]], [2, "insert", ["2", "Ben"]], [3, ["add", "city", "unknown"]], [], [4, "insert", ["3", "Cy", "Rome"]], [5, ["rename", "name", "fullName"]], [6, ["drop", "city"]], [], []], "expected": [null, "ok", "ok", "ok", [["1", "Ana", "unknown"], ["2", "Ben", "unknown"]], "ok", "ok", "ok", ["id", "fullName"], [["1", "Ana"], ["2", "Ben"], ["3", "Cy"]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "compare"], "args": [[["id", "name", "city"]], [1, "insert", ["1", "Ana", "Porto"]], [2, "insert", ["2", "Ben", "Oslo"]], [3, "insert", ["4", "Dan", "Bern"]], [["id", "city", "name", "email"], [["1", "Porto", "Ana", "a@x"], ["2", "Bergen", "Ben", "b@x"], ["3", "Rome", "Cy", "c@x"]]]], "expected": [null, "ok", "ok", "ok", [["missing-column", "email"], ["value-differs", "2", "city", "Oslo", "Bergen"], ["missing-row", "3"], ["extra-row", "4"]]]},
    {"id": "h20", "level": 4, "note": "invalid schema changes are rejected and change nothing", "ops": ["ReplicaTable", "applyAt", "alterAt", "alterAt", "alterAt", "alterAt", "alterAt", "alterAt", "columns", "rows", "alterAt", "columns"], "args": [[["id", "name", "city"]], [1, "insert", ["1", "Ana", "Porto"]], [2, ["add", "name", "x"]], [3, ["drop", "zip"]], [4, ["drop", "id"]], [5, ["rename", "city", "name"]], [6, ["rename", "zip", "code"]], [7, ["rename", "city", "city"]], [], [], [8, ["rename", "id", "pk"]], []], "expected": [null, "ok", "duplicate-column", "unknown-column", "key-column", "duplicate-column", "unknown-column", "duplicate-column", ["id", "name", "city"], [["1", "Ana", "Porto"]], "ok", ["pk", "name", "city"]]},
    {"id": "h21", "level": 4, "note": "a replayed schema change is skipped before it is checked, and so is a replayed row change", "ops": ["ReplicaTable", "applyAt", "alterAt", "alterAt", "applyAt", "alterAt", "columns", "rows"], "args": [[["id", "name"]], [1, "insert", ["1", "Ana"]], [2, ["add", "city", "?"]], [2, ["add", "city", "?"]], [1, "insert", ["1", "Ana"]], [1, ["drop", "name"]], [], []], "expected": [null, "ok", "ok", "skipped", "skipped", "skipped", ["id", "name", "city"], [["1", "Ana", "?"]]]},
    {"id": "h22", "level": 4, "note": "after a schema change an insert or update needs one value per new column; a delete needs the key", "ops": ["ReplicaTable", "applyAt", "alterAt", "applyAt", "applyAt", "applyAt", "applyAt", "stage", "stage", "commit", "applyAt", "rows", "version"], "args": [[["id", "name"]], [1, "insert", ["1", "Ana"]], [2, ["add", "city", "-"]], [3, "insert", ["2", "Ben"]], [4, "update", ["1", "Ana"]], [5, "update", ["1", "Ana", "Faro", "extra"]], [6, "insert", ["2", "Ben", "Oslo"]], ["t", "update", ["1", "Ana", "Faro"]], ["t", "insert", ["3", "Cy"]], [7, "t"], [8, "delete", ["2"]], [], ["1"]], "expected": [null, "ok", "ok", "column-count", "column-count", "column-count", "ok", null, null, "column-count", "ok", [["1", "Ana", "-"]], 1]},
    {"id": "h23", "level": 4, "note": "a dropped column's values are gone; adding it again gives the default", "ops": ["ReplicaTable", "applyAt", "applyAt", "alterAt", "rows", "alterAt", "columns", "rows"], "args": [[["id", "name", "note"]], [1, "insert", ["1", "Ana", "vip"]], [2, "insert", ["2", "Ben", "new"]], [3, ["drop", "name"]], [], [4, ["add", "name", "?"]], [], []], "expected": [null, "ok", "ok", "ok", [["1", "vip"], ["2", "new"]], "ok", ["id", "note", "name"], [["1", "vip", "?"], ["2", "new", "?"]]]},
    {"id": "h24", "level": 4, "note": "compare matches columns by name, sorts by key, then by column name", "ops": ["ReplicaTable", "applyAt", "applyAt", "applyAt", "compare", "compare"], "args": [[["id", "a", "b"]], [1, "insert", ["k2", "1", "2"]], [2, "insert", ["k1", "3", "4"]], [3, "insert", ["K9", "5", "6"]], [["id", "b", "a"], [["k1", "4", "3"], ["k2", "9", "8"], ["K9", "6", "5"]]], [["id", "a", "b"], [["k2", "1", "2"], ["k1", "3", "4"], ["K9", "5", "6"]]]], "expected": [null, "ok", "ok", "ok", [["value-differs", "k2", "a", "1", "8"], ["value-differs", "k2", "b", "2", "9"]], []]},
    {"id": "h25", "level": 4, "note": "compare reads the committed table, not open transactions", "ops": ["ReplicaTable", "applyAt", "stage", "stage", "compare", "commit", "compare"], "args": [[["id", "v"]], [1, "insert", ["a", "1"]], ["t", "update", ["a", "2"]], ["t", "insert", ["b", "3"]], [["id", "v"], [["a", "2"], ["b", "3"]]], [2, "t"], [["id", "v"], [["a", "2"], ["b", "3"]]]], "expected": [null, "ok", null, null, [["value-differs", "a", "v", "1", "2"], ["missing-row", "b"]], "ok", []]},
    {"id": "h26", "level": 4, "note": "missing means only in the source and extra means only in the replica, for rows and for columns", "ops": ["ReplicaTable", "applyAt", "applyAt", "alterAt", "alterAt", "compare"], "args": [[["id", "v"]], [1, "insert", ["b", "1"]], [2, "insert", ["d", "2"]], [3, ["add", "z", "0"]], [4, ["add", "c", "0"]], [["id", "v", "y", "a"], [["a", "1", "", ""], ["b", "1", "", ""], ["c", "5", "", ""]]]], "expected": [null, "ok", "ok", "ok", "ok", [["missing-column", "a"], ["extra-column", "c"], ["missing-column", "y"], ["extra-column", "z"], ["missing-row", "a"], ["missing-row", "c"], ["extra-row", "d"]]]},
    {"id": "h27", "level": 4, "note": "a schema change at or below the snapshot's position is already in it", "ops": ["ReplicaTable", "loadSnapshot", "alterAt", "alterAt", "alterAt", "columns", "rows"], "args": [[["id", "v", "w"]], [4, [["a", "1", "x"]]], [3, ["add", "w", "x"]], [4, ["add", "w", "x"]], [5, ["drop", "v"]], [], []], "expected": [null, null, "skipped", "skipped", "ok", ["id", "w"], [["a", "x"]]]}
  ]
}
