{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["CacheService", "put", "put", "get", "put", "get", "get", "stats"], "args": [[2, "LRU"], [1, "a", "1", 0], [2, "b", "2", 0], [3, "a"], [4, "c", "3", 0], [5, "b"], [6, "c"], []], "expected": [null, null, null, "1", null, "", "3", [2, 1, 1, 0]]},
    {"id": "ex2", "visible": true, "ops": ["CacheService", "put", "get", "get", "put", "size", "stats"], "args": [[3, "LRU"], [10, "session", "abc", 5], [14, "session"], [15, "session"], [16, "user", "ana", 0], [17], []], "expected": [null, null, "abc", "", null, 1, [1, 1, 0, 1]]},
    {"id": "h1", "note": "LFU evicts the least used key; equal counts go least recently used first", "ops": ["CacheService", "put", "put", "get", "get", "put", "get", "get", "get", "put", "get", "get", "stats"], "args": [[2, "LFU"], [1, "a", "1", 0], [2, "b", "2", 0], [3, "a"], [4, "a"], [5, "c", "3", 0], [6, "b"], [7, "b"], [8, "c"], [9, "d", "4", 0], [10, "a"], [11, "c"], []], "expected": [null, null, null, "1", "1", null, "", "", "3", null, "1", "", [4, 3, 2, 0]]},
    {"id": "h2", "note": "FIFO ignores reads and updates", "ops": ["CacheService", "put", "put", "get", "put", "put", "get", "get", "stats"], "args": [[2, "FIFO"], [1, "a", "1", 0], [2, "b", "2", 0], [3, "a"], [4, "a", "9", 0], [5, "c", "3", 0], [6, "a"], [7, "b"], []], "expected": [null, null, null, "1", null, null, "", "2", [2, 1, 1, 0]]},
    {"id": "h3", "note": "an update replaces the value, evicts nothing and counts as a use under LRU", "ops": ["CacheService", "put", "put", "put", "size", "put", "get", "get", "stats"], "args": [[2, "LRU"], [1, "a", "1", 0], [2, "b", "2", 0], [3, "a", "10", 0], [4], [5, "c", "3", 0], [6, "a"], [7, "b"], []], "expected": [null, null, null, null, 2, null, "10", "", [1, 1, 1, 0]]},
    {"id": "h4", "note": "expired entries make room before the policy evicts anything", "ops": ["CacheService", "put", "put", "get", "put", "get", "get", "stats"], "args": [[2, "LRU"], [1, "a", "1", 5], [2, "b", "2", 0], [3, "a"], [10, "c", "3", 0], [11, "b"], [12, "c"], []], "expected": [null, null, null, "1", null, "2", "3", [3, 0, 0, 1]]},
    {"id": "h5", "note": "remove works on live keys only; an expired key counts as an expiration", "ops": ["CacheService", "put", "put", "remove", "remove", "remove", "remove", "size", "stats"], "args": [[3, "LFU"], [1, "a", "1", 0], [2, "b", "2", 3], [3, "a"], [4, "a"], [5, "b"], [6, "zz"], [7], []], "expected": [null, null, null, true, false, false, false, 0, [0, 0, 0, 1]]},
    {"id": "h6", "note": "writing a key again replaces its lifetime", "ops": ["CacheService", "put", "put", "get", "put", "get", "get", "stats"], "args": [[2, "LRU"], [1, "a", "1", 5], [3, "a", "2", 0], [100, "a"], [101, "a", "3", 2], [102, "a"], [103, "a"], []], "expected": [null, null, null, "2", null, "3", "", [2, 1, 0, 1]]},
    {"id": "h7", "note": "LFU counts puts as uses; a new key starts at one", "ops": ["CacheService", "put", "put", "put", "put", "get", "put", "get", "put", "get", "get", "stats"], "args": [[3, "LFU"], [1, "a", "1", 0], [2, "a", "1", 0], [3, "b", "2", 0], [4, "c", "3", 0], [5, "b"], [6, "d", "4", 0], [7, "c"], [8, "e", "5", 0], [9, "b"], [10, "d"], []], "expected": [null, null, null, null, null, "2", null, "", null, "2", "", [2, 2, 2, 0]]},
    {"id": "h8", "note": "capacity 1: every new key evicts the previous one", "ops": ["CacheService", "put", "put", "put", "get", "get", "put", "size", "stats"], "args": [[1, "FIFO"], [1, "a", "1", 0], [2, "b", "2", 0], [3, "b", "3", 0], [4, "a"], [5, "b"], [6, "c", "4", 0], [7], []], "expected": [null, null, null, null, "", "3", null, 1, [1, 1, 2, 0]]},
    {"id": "h9", "note": "a put on an expired key counts the expiration and starts a fresh entry", "ops": ["CacheService", "put", "get", "put", "stats", "put", "get", "put", "get", "get", "stats"], "args": [[2, "LFU"], [1, "a", "1", 2], [2, "a"], [4, "a", "3", 0], [], [5, "b", "2", 0], [6, "b"], [7, "c", "4", 0], [8, "a"], [9, "b"], []], "expected": [null, null, "1", null, [1, 0, 0, 1], null, "2", null, "", "2", [3, 1, 1, 1]]},
    {"id": "h10", "note": "a fresh cache reports zeros and misses on every key", "ops": ["CacheService", "stats", "get", "size", "remove", "stats"], "args": [[4, "LRU"], [], [1, "x"], [2], [3, "x"], []], "expected": [null, [0, 0, 0, 0], "", 0, false, [0, 1, 0, 0]]},
    {"id": "h11", "note": "size drops every expired entry at once", "ops": ["CacheService", "put", "put", "put", "put", "size", "size", "stats", "size", "stats"], "args": [[5, "FIFO"], [1, "a", "1", 10], [2, "b", "2", 10], [3, "c", "3", 20], [4, "d", "4", 0], [11], [12], [], [23], []], "expected": [null, null, null, null, null, 3, 2, [0, 0, 0, 2], 1, [0, 0, 0, 3]]}
  ]
}
