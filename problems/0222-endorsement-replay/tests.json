    {"id": "h10", "ops": ["EndorsedPolicy", "endorse", "endorse", "endorse", "premiumOn", "earnedPremium", "earnedPremium", "writtenPremium"], "args": [["2026-01-01", "2027-01-01", "1000"], ["2026-05-01", "1100"], ["2026-05-01", "1200"], ["2026-05-01", "900"], ["2026-05-01"], ["2026-05-01"], ["2026-05-02"], []], "expected": [null, true, true, true, "900", "328.77", "331.23", "932.88"], "note": "three corrections on one date; earned on the endorsement date itself"}
