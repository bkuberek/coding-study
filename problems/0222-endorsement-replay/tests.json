    {"id": "ex3", "visible": true, "ops": ["EndorsedPolicy", "endorse", "endorse", "endorse", "endorse", "premiumOn", "premiumOn", "writtenPremium"], "args": [["2026-01-01", "2027-01-01", "1000"], ["2026-03-01", "3000"], ["2026-03-01", "2000"], ["2027-01-01", "5000"], ["2025-12-31", "5000"], ["2027-01-01"], ["2026-03-01"], []], "expected": [null, true, true, false, false, "-1", "2000", "1838.36"]},
    {"id": "h1", "ops": ["EndorsedPolicy", "writtenPremium", "earnedPremium", "earnedPremium", "earnedPremium", "earnedPremium"], "args": [["2026-01-01", "2027-01-01", "1000.10"], [], ["2025-06-01"], ["2026-01-01"], ["2027-01-01"], ["2030-01-01"]], "expected": [null, "1000.1", "0", "0", "1000.1", "1000.1"], "note": "no endorsements; earned before, on and after the term"},
    {"id": "h2", "ops": ["EndorsedPolicy", "endorse", "premiumOn", "writtenPremium"], "args": [["2026-01-01", "2027-01-01", "1000"], ["2026-01-01", "1500"], ["2026-01-01"], []], "expected": [null, true, "1500", "1500"], "note": "an endorsement on the term start replaces the initial premium"},
    {"id": "h3", "ops": ["EndorsedPolicy", "endorse", "premiumOn", "writtenPremium", "earnedPremium"], "args": [["2026-01-01", "2027-01-01", "1200"], ["2026-04-01", "0"], ["2026-12-31"], [], ["2026-06-01"]], "expected": [null, true, "0", "295.89", "295.89"], "note": "the premium drops to zero mid-term"},
    {"id": "h4", "ops": ["EndorsedPolicy", "endorse", "premiumOn", "premiumOn", "writtenPremium", "earnedPremium"], "args": [["2028-01-01", "2029-01-01", "3660"], ["2028-02-29", "7320"], ["2028-02-28"], ["2028-02-29"], [], ["2028-03-01"]], "expected": [null, true, "3660", "7320", "6730", "610"], "note": "leap-year term; endorsement on the leap day"},
    {"id": "h5", "ops": ["EndorsedPolicy", "endorse", "endorse", "endorse", "endorse", "premiumOn", "premiumOn", "premiumOn", "premiumOn", "premiumOn", "writtenPremium", "earnedPremium"], "args": [["2026-01-01", "2027-01-01", "1200"], ["2026-10-01", "1500"], ["2026-02-01", "1300"], ["2026-06-01", "1100"], ["2026-03-15", "1250.50"], ["2026-01-31"], ["2026-03-14"], ["2026-03-15"], ["2026-09-30"], ["2026-12-31"], [], ["2026-06-01"]], "expected": [null, true, true, true, true, "1200", "1300", "1250.5", "1100", "1500", "1264.49", "518.74"], "note": "endorsements arrive out of date order; each governs until the next later date"},
    {"id": "h6", "ops": ["EndorsedPolicy", "earnedPremium", "endorse", "writtenPremium"], "args": [["2026-03-01", "2026-03-05", "0.10"], ["2026-03-02"], ["2026-03-03", "0.11"], []], "expected": [null, "0.03", true, "0.11"], "note": "half-cent ties: 0.025 -> 0.03 and 0.105 -> 0.11"},
    {"id": "h7", "ops": ["EndorsedPolicy", "endorse", "endorse", "premiumOn", "premiumOn", "writtenPremium"], "args": [["2026-05-10", "2026-05-11", "500"], ["2026-05-10", "600"], ["2026-05-11", "700"], ["2026-05-10"], ["2026-05-11"], []], "expected": [null, true, false, "600", "-1", "600"], "note": "one-day term; the end date is outside the term"},
    {"id": "h8", "ops": ["EndorsedPolicy", "endorse", "premiumOn", "premiumOn", "premiumOn"], "args": [["2026-01-01", "2027-01-01", "2500.00"], ["2026-06-01", "2600.50"], ["2026-01-01"], ["2026-06-01"], ["2025-12-31"]], "expected": [null, true, "2500", "2600.5", "-1"], "note": "premiums come back in canonical form"},
