{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["ApiGateway", "addRoute", "addRoute", "addRoute", "addRoute", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/users/:id", "users"], [2, "GET", "/users/me", "profile"], [3, "GET", "/files/*", "files"], [4, "GET", "/users/:uid", "other"], [5, "c1", "GET", "/users/42"], [6, "c1", "GET", "/users/me"], [7, "c1", "GET", "/files/a/b.txt"], [8, "c1", "GET", "/files"], [9, "c1", "POST", "/users/42"]], "expected": [null, true, true, true, false, "users", "profile", "files", "404", "404"]},
    {"id": "h1", "level": 1, "note": "no routes: everything is 404, and nothing can be removed", "ops": ["ApiGateway", "route", "removeRoute", "route"], "args": [[], [1, "c", "GET", "/"], [2, "GET", "/a"], [3, "c", "GET", "/a"]], "expected": [null, "404", false, "404"]},
    {"id": "h2", "level": 1, "note": "removing the specific route falls back to the general one; parameter names do not matter", "ops": ["ApiGateway", "addRoute", "addRoute", "route", "removeRoute", "route", "removeRoute", "route", "removeRoute", "addRoute", "route"], "args": [[], [1, "GET", "/a/:x", "general"], [2, "GET", "/a/b", "specific"], [3, "c", "GET", "/a/b"], [4, "GET", "/a/b"], [5, "c", "GET", "/a/b"], [6, "GET", "/a/:other"], [7, "c", "GET", "/a/b"], [8, "GET", "/a/:x"], [9, "GET", "/a/:y", "again"], [10, "c", "GET", "/a/z"]], "expected": [null, true, true, "specific", true, "general", true, "404", false, true, "again"]},
    {"id": "h3", "level": 1, "note": "the first differing segment decides: literal, then parameter, then wildcard", "ops": ["ApiGateway", "addRoute", "addRoute", "addRoute", "addRoute", "route", "route", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/a/*", "wild"], [2, "GET", "/a/:x/c", "param"], [3, "GET", "/a/b/*", "litwild"], [4, "GET", "/", "root"], [5, "c", "GET", "/a/b/c"], [6, "c", "GET", "/a/q/c"], [7, "c", "GET", "/a/b/d"], [8, "c", "GET", "/a/q/d/e"], [9, "c", "GET", "/a/b"], [10, "c", "GET", "/"], [11, "c", "GET", "/b"]], "expected": [null, true, true, true, true, "litwild", "param", "litwild", "wild", "wild", "root", "404"]},
    {"id": "h4", "level": 1, "note": "methods have separate route tables; a wildcard route and an exact route can share a prefix", "ops": ["ApiGateway", "addRoute", "addRoute", "addRoute", "addRoute", "route", "route", "route", "route", "removeRoute", "route"], "args": [[], [1, "GET", "/items", "read"], [2, "POST", "/items", "write"], [3, "POST", "/items", "dup"], [4, "GET", "/items/*", "deep"], [5, "c", "POST", "/items"], [6, "c", "GET", "/items"], [7, "c", "GET", "/items/1"], [8, "c", "DELETE", "/items"], [9, "GET", "/items/*"], [10, "c", "GET", "/items/1"]], "expected": [null, true, true, false, true, "write", "read", "deep", "404", true, "404"]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["ApiGateway", "addRoute", "setClientLimit", "route", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/feed", "feed"], [2, "mobile", 2, 1000], [100, "mobile", "GET", "/feed"], [200, "mobile", "GET", "/feed"], [300, "mobile", "GET", "/feed"], [400, "web", "GET", "/feed"], [999, "mobile", "GET", "/feed"], [1000, "mobile", "GET", "/feed"]], "expected": [null, true, null, "feed", "feed", "429", "feed", "429", "feed"]},
    {"id": "h5", "level": 2, "note": "404 and 429 responses do not use up the limit", "ops": ["ApiGateway", "addRoute", "setClientLimit", "route", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 1, 100], [3, "c", "GET", "/missing"], [4, "c", "GET", "/x"], [5, "c", "GET", "/x"], [6, "c", "GET", "/x"], [100, "c", "GET", "/x"], [101, "c", "GET", "/x"]], "expected": [null, true, null, "404", "x", "429", "429", "x", "429"]},
    {"id": "h6", "level": 2, "note": "windows start at multiples of the window length", "ops": ["ApiGateway", "addRoute", "setClientLimit", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 1, 10], [9, "c", "GET", "/x"], [10, "c", "GET", "/x"], [19, "c", "GET", "/x"], [20, "c", "GET", "/x"], [29, "c", "GET", "/x"]], "expected": [null, true, null, "x", "x", "429", "x", "429"]},
    {"id": "h7", "level": 2, "note": "a new limit replaces the old one and starts counting again", "ops": ["ApiGateway", "addRoute", "setClientLimit", "route", "route", "setClientLimit", "route", "route", "route"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 1, 1000], [3, "c", "GET", "/x"], [4, "c", "GET", "/x"], [5, "c", 2, 1000], [6, "c", "GET", "/x"], [7, "c", "GET", "/x"], [8, "c", "GET", "/x"]], "expected": [null, true, null, "x", "429", null, "x", "x", "429"]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["ApiGateway", "addRoute", "setClientSlidingLimit", "route", "route", "route", "route", "setClientQuota", "remainingQuota", "route", "remainingQuota", "route", "remainingQuota"], "args": [[], [1, "GET", "/search", "search"], [2, "bot", 2, 100], [10, "bot", "GET", "/search"], [50, "bot", "GET", "/search"], [90, "bot", "GET", "/search"], [110, "bot", "GET", "/search"], [200, "bot", 1], [201, "bot"], [300, "bot", "GET", "/search"], [301, "bot"], [400, "bot", "GET", "/search"], [402, "human"]], "expected": [null, true, null, "search", "search", "429", "search", null, 1, "search", 0, "429", -1]},
    {"id": "h8", "level": 3, "note": "a sliding limit replaces a fixed one; a request exactly one window old has left it", "ops": ["ApiGateway", "addRoute", "setClientLimit", "route", "setClientSlidingLimit", "route", "route", "route", "route", "route"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 1, 1000], [3, "c", "GET", "/x"], [4, "c", 1, 50], [5, "c", "GET", "/x"], [54, "c", "GET", "/x"], [55, "c", "GET", "/x"], [104, "c", "GET", "/x"], [105, "c", "GET", "/x"]], "expected": [null, true, null, "x", null, "x", "429", "x", "429", "x"]},
    {"id": "h9", "level": 3, "note": "a request rejected by one rule uses neither the rate limit nor the quota", "ops": ["ApiGateway", "addRoute", "setClientSlidingLimit", "setClientQuota", "route", "route", "remainingQuota", "route", "remainingQuota", "route", "route", "remainingQuota"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 1, 100], [3, "c", 2], [4, "c", "GET", "/x"], [5, "c", "GET", "/x"], [6, "c"], [104, "c", "GET", "/x"], [105, "c"], [300, "c", "GET", "/x"], [301, "c", "GET", "/nope"], [302, "c"]], "expected": [null, true, null, null, "x", "429", 1, "x", 0, "429", "404", 0]},
    {"id": "h10", "level": 3, "note": "a new quota replaces the old one; quota 0 rejects every routed request", "ops": ["ApiGateway", "addRoute", "setClientQuota", "route", "route", "setClientQuota", "route", "remainingQuota", "setClientQuota", "remainingQuota", "route", "route"], "args": [[], [1, "GET", "/x", "x"], [2, "c", 0], [3, "c", "GET", "/x"], [4, "c", "GET", "/y"], [5, "c", 3], [6, "c", "GET", "/x"], [7, "c"], [8, "c", 1], [9, "c"], [10, "c", "GET", "/x"], [11, "c", "GET", "/x"]], "expected": [null, true, null, "429", "404", null, "x", 2, null, 1, "x", "429"]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["ApiGateway", "addRoute", "setBreaker", "reportResult", "reportResult", "route", "breakerState", "breakerState", "route", "route", "reportResult", "route"], "args": [[], [1, "POST", "/pay", "billing"], [2, "billing", 2, 1000], [10, "billing", false], [20, "billing", false], [30, "shop", "POST", "/pay"], [1019, "billing"], [1020, "billing"], [1021, "shop", "POST", "/pay"], [1022, "shop", "POST", "/pay"], [1023, "billing", true], [1024, "shop", "POST", "/pay"]], "expected": [null, true, null, "CLOSED", "OPEN", "503", "OPEN", "HALF_OPEN", "billing", "503", "CLOSED", "billing"]},
    {"id": "h11", "level": 4, "note": "a success resets the failure count; reports while open are ignored", "ops": ["ApiGateway", "addRoute", "setBreaker", "reportResult", "reportResult", "reportResult", "route", "reportResult", "reportResult", "breakerState", "breakerState"], "args": [[], [1, "GET", "/x", "svc"], [2, "svc", 2, 100], [3, "svc", false], [4, "svc", true], [5, "svc", false], [6, "c", "GET", "/x"], [7, "svc", false], [50, "svc", true], [106, "svc"], [107, "svc"]], "expected": [null, true, null, "CLOSED", "CLOSED", "CLOSED", "svc", "OPEN", "OPEN", "OPEN", "HALF_OPEN"]},
    {"id": "h12", "level": 4, "note": "a failed trial reopens the circuit with a fresh cooldown", "ops": ["ApiGateway", "addRoute", "setBreaker", "reportResult", "route", "reportResult", "route", "breakerState", "breakerState", "reportResult", "breakerState"], "args": [[], [1, "GET", "/x", "svc"], [2, "svc", 1, 10], [3, "svc", false], [13, "c", "GET", "/x"], [14, "svc", false], [15, "c", "GET", "/x"], [23, "svc"], [24, "svc"], [25, "svc", true], [26, "svc"]], "expected": [null, true, null, "OPEN", "svc", "OPEN", "503", "OPEN", "HALF_OPEN", "CLOSED", "CLOSED"]},
    {"id": "h13", "level": 4, "note": "upstreams without a breaker are unaffected and report nothing", "ops": ["ApiGateway", "addRoute", "addRoute", "setBreaker", "reportResult", "breakerState", "reportResult", "route", "route", "setBreaker", "breakerState", "route"], "args": [[], [1, "GET", "/a", "alpha"], [2, "GET", "/b", "beta"], [3, "alpha", 1, 100], [4, "beta", false], [5, "beta"], [6, "alpha", false], [7, "c", "GET", "/a"], [8, "c", "GET", "/b"], [9, "alpha", 1, 100], [10, "alpha"], [11, "c", "GET", "/a"]], "expected": [null, true, true, null, "", "", "OPEN", "503", "beta", null, "CLOSED", "alpha"]},
    {"id": "h14", "level": 4, "note": "503 uses no quota; a trial rejected with 429 is still available", "ops": ["ApiGateway", "addRoute", "setBreaker", "setClientQuota", "setClientQuota", "reportResult", "route", "remainingQuota", "route", "route", "route", "remainingQuota"], "args": [[], [1, "GET", "/x", "svc"], [2, "svc", 1, 10], [3, "c", 1], [4, "d", 0], [5, "svc", false], [6, "c", "GET", "/x"], [7, "c"], [15, "d", "GET", "/x"], [16, "c", "GET", "/x"], [17, "c", "GET", "/x"], [18, "c"]], "expected": [null, true, null, null, null, "OPEN", "503", 1, "429", "svc", "503", 0]}
  ]
}
