  {"id": "ex1", "visible": true, "level": 1, "ops": ["SqlGuard", "tokenize", "check"], "args": [[], ["SELECT name, 'O''Brien' FROM people WHERE age >= 18; -- adults"], ["SELECT name, 'O''Brien' FROM people WHERE age >= 18; -- adults"]], "expected": [null, [["keyword", "SELECT"], ["identifier", "name"], ["symbol", ","], ["string", "O'Brien"], ["keyword", "FROM"], ["identifier", "people"], ["keyword", "WHERE"], ["identifier", "age"], ["symbol", ">="], ["number", "18"], ["semicolon", ";"], ["comment", "-- adults"]], []]},
  {"id": "ex2", "visible": true, "level": 1, "ops": ["SqlGuard", "check", "check", "check", "check", "check"], "args": [[], ["SELECT 1; SELECT 2"], ["SELECT 1;"], ["SELECT ';' FROM t"], ["SELECT 1 -- ; SELECT 2"], ["SELECT 1 /* ; */"]], "expected": [null, [["multiple-statements", "2"]], [], [], [], []]},
  {"id": "h1", "level": 1, "note": "blank input, comments only and bare semicolons are no statement at all", "ops": ["SqlGuard", "tokenize", "tokenize", "check", "check", "check", "check", "check", "check", "check"], "args": [[], [""], [" ; ;"], [""], ["   \n\t "], ["-- nothing here"], ["/* nothing */"], [";"], [";;"], [" ; -- x\n ;"]], "expected": [null, [], [["semicolon", ";"], ["semicolon", ";"]], [["empty", ""]], [["empty", ""]], [["empty", ""]], [["empty", ""]], [["empty", ""]], [["empty", ""]], [["empty", ""]]]},
  {"id": "h2", "level": 1, "note": "a doubled quote is one quote in the text, a backslash is an ordinary character, and an unfinished string is a lexical error", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "check"], "args": [[], ["'a''b'"], ["''"], ["''''"], ["'\\'"], ["'x' 'y'"], ["'abc"], ["'ab''"], ["SELECT 'a;b'"], ["SELECT 'abc"]], "expected": [null, [["string", "a'b"]], [["string", ""]], [["string", "'"]], [["string", "\\"]], [["string", "x"], ["string", "y"]], [["error", "unterminated-string"]], [["error", "unterminated-string"]], [["keyword", "SELECT"], ["string", "a;b"]], [["lex-error", "unterminated-string"]]]},
  {"id": "h3", "level": 1, "note": "a quoted identifier is an identifier even when its text is a keyword, and its doubled quote is one quote", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize"], "args": [[], ["\"my col\""], ["\"say \"\"hi\"\"\""], ["\"select\""], ["\"\""], ["\"abc"], ["SELECT \"a;b\" FROM \"T\""]], "expected": [null, [["identifier", "my col"]], [["identifier", "say \"hi\""]], [["identifier", "select"]], [["error", "empty-identifier"]], [["error", "unterminated-identifier"]], [["keyword", "SELECT"], ["identifier", "a;b"], ["keyword", "FROM"], ["identifier", "T"]]]},
  {"id": "h4", "level": 1, "note": "keywords ignore case and come out in capitals; a word that only contains a keyword is an identifier", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize"], "args": [[], ["select From wHeRe"], ["updated_at deleted created_at select_ _select selects"], ["Name NAME name"]], "expected": [null, [["keyword", "SELECT"], ["keyword", "FROM"], ["keyword", "WHERE"]], [["identifier", "updated_at"], ["identifier", "deleted"], ["identifier", "created_at"], ["identifier", "select_"], ["identifier", "_select"], ["identifier", "selects"]], [["identifier", "Name"], ["identifier", "NAME"], ["identifier", "name"]]]},
  {"id": "h5", "level": 1, "note": "a line comment stops at the line end, a block comment at the first closing mark, and block comments do not nest", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize"], "args": [[], ["SELECT 1 -- c\n, 2"], ["-- a\r\n-- b"], ["/**/"], ["/*/"], ["/* /* */ */"], ["/* ; */ SELECT 1"], ["SELECT 1 /* x"], ["a--b"], ["a - -b"]], "expected": [null, [["keyword", "SELECT"], ["number", "1"], ["comment", "-- c"], ["symbol", ","], ["number", "2"]], [["comment", "-- a"], ["comment", "-- b"]], [["comment", "/**/"]], [["error", "unterminated-comment"]], [["comment", "/* /* */"], ["symbol", "*"], ["symbol", "/"]], [["comment", "/* ; */"], ["keyword", "SELECT"], ["number", "1"]], [["keyword", "SELECT"], ["number", "1"], ["error", "unterminated-comment"]], [["identifier", "a"], ["comment", "--b"]], [["identifier", "a"], ["symbol", "-"], ["symbol", "-"], ["identifier", "b"]]]},
  {"id": "h6", "level": 1, "note": "numbers are digits with an optional fraction and no sign; a number glued to a word is an error", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize"], "args": [[], ["1 007 3.14 .5 1."], ["1.2.3"], ["-5"], ["1abc"], ["2_"], ["x.5"], ["0x1F"], ["SELECT 1.5e3"]], "expected": [null, [["number", "1"], ["number", "007"], ["number", "3.14"], ["number", ".5"], ["number", "1"], ["symbol", "."]], [["number", "1.2"], ["number", ".3"]], [["symbol", "-"], ["number", "5"]], [["error", "malformed-number"]], [["error", "malformed-number"]], [["identifier", "x"], ["number", ".5"]], [["error", "malformed-number"]], [["keyword", "SELECT"], ["error", "malformed-number"]]]},
  {"id": "h7", "level": 1, "note": "symbols take the longest match; placeholders are ?, $n and :name", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize"], "args": [[], ["<= >= <> != || < > = + - * / % ( ) , ."], ["? $1 $12 :name :x_1"], ["a<=b"], ["a<>b"], ["<<"], [":"], ["$"], ["$a"], ["::x"]], "expected": [null, [["symbol", "<="], ["symbol", ">="], ["symbol", "<>"], ["symbol", "!="], ["symbol", "||"], ["symbol", "<"], ["symbol", ">"], ["symbol", "="], ["symbol", "+"], ["symbol", "-"], ["symbol", "*"], ["symbol", "/"], ["symbol", "%"], ["symbol", "("], ["symbol", ")"], ["symbol", ","], ["symbol", "."]], [["placeholder", "?"], ["placeholder", "$1"], ["placeholder", "$12"], ["placeholder", ":name"], ["placeholder", ":x_1"]], [["identifier", "a"], ["symbol", "<="], ["identifier", "b"]], [["identifier", "a"], ["symbol", "<>"], ["identifier", "b"]], [["symbol", "<"], ["symbol", "<"]], [["error", "unexpected-character"]], [["error", "unexpected-character"]], [["error", "unexpected-character"]], [["error", "unexpected-character"]]]},
  {"id": "h8", "level": 1, "note": "a character outside the subset stops the scan with an error after the tokens before it", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "check"], "args": [[], ["SELECT a ! b"], ["a | b"], ["`a`"], ["[a]"], ["a @b"], ["a # b"], ["SELECT é"], ["a \\ b"], ["SELECT a ! b"]], "expected": [null, [["keyword", "SELECT"], ["identifier", "a"], ["error", "unexpected-character"]], [["identifier", "a"], ["error", "unexpected-character"]], [["error", "unexpected-character"]], [["error", "unexpected-character"]], [["identifier", "a"], ["error", "unexpected-character"]], [["identifier", "a"], ["error", "unexpected-character"]], [["keyword", "SELECT"], ["error", "unexpected-character"]], [["identifier", "a"], ["error", "unexpected-character"]], [["lex-error", "unexpected-character"]]]},
  {"id": "h9", "level": 1, "note": "a one-letter prefix directly before a quote is refused; other words before a quote are fine", "ops": ["SqlGuard", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "tokenize", "check"], "args": [[], ["E'x'"], ["n'x'"], ["X'ff'"], ["b'1'"], ["LIKE'a'"], ["be'x'"], ["E 'x'"], ["e"], ["SELECT E'\\''"]], "expected": [null, [["error", "prefixed-string"]], [["error", "prefixed-string"]], [["error", "prefixed-string"]], [["error", "prefixed-string"]], [["keyword", "LIKE"], ["string", "a"]], [["identifier", "be"], ["string", "x"]], [["identifier", "E"], ["string", "x"]], [["identifier", "e"]], [["lex-error", "prefixed-string"]]]},
  {"id": "h10", "level": 1, "note": "the statement count ignores empty statements, comments and semicolons inside text; a lexical error comes first", "ops": ["SqlGuard", "check", "check", "check", "check", "check", "check", "check", "check"], "args": [[], ["SELECT 1;;"], [";SELECT 1"], ["SELECT 1; -- done"], ["SELECT 1 ; SELECT 2 ; SELECT 3"], ["SELECT 1; SELECT 'x"], ["SELECT 1; /* c */ ; SELECT 2"], ["SELECT \"a;b\"; SELECT 2"], ["-- x\nSELECT 1\n-- y"]], "expected": [null, [], [], [], [["multiple-statements", "3"]], [["lex-error", "unterminated-string"]], [["multiple-statements", "2"]], [["multiple-statements", "2"]], []]},
  {"id": "ex3", "visible": true, "level": 2, "ops": ["SqlGuard", "checkReadOnly", "naiveCheck", "contrast", "contrast", "contrast"], "args": [[], ["SELECT updated_at FROM t"], ["SELECT updated_at FROM t"], ["SELECT updated_at FROM t"], ["SELECT note FROM log WHERE note = 'please delete me'"], ["SELECT 1 -- insert later"]], "expected": [null, [], "reject", "false-alarm", "false-alarm", "false-alarm"]},
  {"id": "ex4", "visible": true, "level": 2, "ops": ["SqlGuard", "checkReadOnly", "checkReadOnly", "contrast", "contrast", "contrast"], "args": [[], ["SELECT 1; DROP TABLE users"], ["DELETE FROM users"], ["SELECT * INTO copy FROM users"], ["DROP TABLE users"], ["SELECT 1"]], "expected": [null, [["multiple-statements", "2"], ["not-select", "DROP"], ["forbidden-keyword", "DROP"]], [["not-select", "DELETE"], ["forbidden-keyword", "DELETE"]], "miss", "agree", "agree"]},
  {"id": "h11", "level": 2, "note": "every write and definition word is refused as a first word and as a forbidden word", "ops": ["SqlGuard", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly"], "args": [[], ["INSERT INTO t VALUES (1)"], ["update t set a = 1"], ["DELETE FROM t"], ["MERGE INTO t USING s ON 1"], ["REPLACE INTO t VALUES (1)"], ["TRUNCATE t"], ["CREATE TABLE t (a)"], ["DROP TABLE t"], ["ALTER TABLE t ADD b"]], "expected": [null, [["not-select", "INSERT"], ["forbidden-keyword", "INSERT"], ["forbidden-keyword", "INTO"]], [["not-select", "UPDATE"], ["forbidden-keyword", "UPDATE"], ["forbidden-keyword", "SET"]], [["not-select", "DELETE"], ["forbidden-keyword", "DELETE"]], [["not-select", "MERGE"], ["forbidden-keyword", "MERGE"], ["forbidden-keyword", "INTO"]], [["not-select", "REPLACE"], ["forbidden-keyword", "REPLACE"], ["forbidden-keyword", "INTO"]], [["not-select", "TRUNCATE"], ["forbidden-keyword", "TRUNCATE"]], [["not-select", "CREATE"], ["forbidden-keyword", "CREATE"]], [["not-select", "DROP"], ["forbidden-keyword", "DROP"]], [["not-select", "ALTER"], ["forbidden-keyword", "ALTER"]]]},
  {"id": "h12", "level": 2, "note": "other statements that are not a read are refused too", "ops": ["SqlGuard", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly"], "args": [[], ["GRANT ALL ON t TO u"], ["REVOKE ALL ON t FROM u"], ["CALL purge()"], ["EXEC purge"], ["EXECUTE p"], ["COPY t TO 'f'"], ["PRAGMA writable_schema = 1"], ["VACUUM"], ["ATTACH 'f' AS g"], ["DETACH g"], ["RENAME TABLE a TO b"], ["SET ROLE admin"], ["EXPLAIN SELECT 1"], ["SHOW TABLES"]], "expected": [null, [["not-select", "GRANT"], ["forbidden-keyword", "GRANT"]], [["not-select", "REVOKE"], ["forbidden-keyword", "REVOKE"]], [["not-select", "CALL"], ["forbidden-keyword", "CALL"]], [["not-select", "EXEC"], ["forbidden-keyword", "EXEC"]], [["not-select", "EXECUTE"], ["forbidden-keyword", "EXECUTE"]], [["not-select", "COPY"], ["forbidden-keyword", "COPY"]], [["not-select", "PRAGMA"], ["forbidden-keyword", "PRAGMA"]], [["not-select", "VACUUM"], ["forbidden-keyword", "VACUUM"]], [["not-select", "ATTACH"], ["forbidden-keyword", "ATTACH"]], [["not-select", "DETACH"], ["forbidden-keyword", "DETACH"]], [["not-select", "RENAME"], ["forbidden-keyword", "RENAME"]], [["not-select", "SET"], ["forbidden-keyword", "SET"]], [["not-select", "EXPLAIN"]], [["not-select", "SHOW"]]]},
  {"id": "h13", "level": 2, "note": "text inside a string, a quoted identifier or a comment is not a keyword", "ops": ["SqlGuard", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly"], "args": [[], ["SELECT 'DROP TABLE x'"], ["SELECT /* delete */ 1"], ["-- drop\nSELECT 1"], ["SELECT \"update\" FROM t"], ["SELECT 1 FROM t WHERE DEL/**/ETE = 1"], ["SELECT updated_at, deleted_at, created_at, inserted FROM t"], ["select 1 from t where note like '%; drop table x; --%'"]], "expected": [null, [], [], [], [], [], [], []]},
