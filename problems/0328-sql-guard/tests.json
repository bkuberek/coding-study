  {"id": "ex5", "visible": true, "level": 3, "ops": ["SqlGuard", "allowTable", "allowTable", "checkAccess", "checkAccess", "checkAccess", "checkAccess", "allowTable"], "args": [[], ["users", ["id", "name", "email"]], ["orders", ["id", "user_id", "total"]], ["SELECT id, name FROM users"], ["SELECT u.name, o.total FROM users u JOIN orders o ON o.user_id = u.id"], ["SELECT password FROM users"], ["SELECT * FROM users"], ["users", ["id"]]], "expected": [null, true, true, [], [], [["column-not-allowed", "password"]], [["wildcard-not-allowed", "*"]], false]},
