  {"id": "h19", "level": 2, "note": "a lexical error or no statement ends the check at once", "ops": ["SqlGuard", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly", "checkReadOnly"], "args": [[], ["SELECT 'a; DROP TABLE x"], [""], ["-- DROP"], ["DROP TABLE x /* open"], ["SELECT 1 ` DROP"]], "expected": [null, [["lex-error", "unterminated-string"]], [["empty", ""]], [["empty", ""]], [["lex-error", "unterminated-comment"]], [["lex-error", "unexpected-character"]]]},
