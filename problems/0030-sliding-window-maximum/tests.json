{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [4, -2, 5, 3, 1, 6, 0], "k": 3}, "expected": [5, 5, 5, 6, 6]},
    {"id": "ex2", "visible": true, "input": {"nums": [8, 6, 4], "k": 2}, "expected": [8, 6]},
    {"id": "h1", "input": {"nums": [5], "k": 1}, "expected": [5], "note": "a single element"},
    {"id": "h2", "input": {"nums": [3, 1, 2], "k": 1}, "expected": [3, 1, 2], "note": "width 1 returns the input"},
    {"id": "h3", "input": {"nums": [3, 1, 2], "k": 3}, "expected": [3], "note": "width n returns one maximum"},
    {"id": "h4", "input": {"nums": [1, 2, 3, 4, 5], "k": 2}, "expected": [2, 3, 4, 5], "note": "rising: the newest element is always the maximum"},
    {"id": "h5", "input": {"nums": [5, 4, 3, 2, 1], "k": 2}, "expected": [5, 4, 3, 2], "note": "falling: the oldest element is always the maximum"},
    {"id": "h6", "input": {"nums": [7, 7, 7, 7], "k": 3}, "expected": [7, 7], "note": "all values equal"},
    {"id": "h7", "input": {"nums": [-5, -1, -3, -4], "k": 2}, "expected": [-1, -1, -3], "note": "all negative"},
    {"id": "h8", "input": {"nums": [-10000, 10000, -10000], "k": 2}, "expected": [10000, 10000], "note": "extreme values"},
    {"id": "h9", "input": {"nums": [4, 2, 4, 1, 1, 1], "k": 3}, "expected": [4, 4, 4, 1], "note": "a duplicate maximum survives when the first copy leaves"},
    {"id": "h10", "input": {"nums": [9, 1, 2, 3, 4], "k": 3}, "expected": [9, 3, 4], "note": "the maximum leaves after the first window"},
    {"id": "h11", "input": {"nums": [1, 3, 1, 2, 0, 5], "k": 3}, "expected": [3, 3, 2, 5], "note": "the maximum changes in the middle"},
    {"id": "h12", "input": {"nums": [2, 2, 1, 2, 2], "k": 2}, "expected": [2, 2, 2, 2], "note": "equal neighbors"},
    {"id": "h13", "input": {"nums": [1, 9, 1, 8, 1, 7, 1, 6, 1, 5], "k": 4}, "expected": [9, 9, 8, 8, 7, 7, 6], "note": "zigzag with falling peaks"},
    {"id": "h14", "input": {"nums": [0, 0, -1, 0, 0, 0, -1], "k": 5}, "expected": [0, 0, 0], "note": "zeros and negatives, wide window"},
    {"id": "h15", "input": {"nums": [6, 5, 4, 3, 2, 1, 10], "k": 6}, "expected": [6, 10], "note": "a new maximum arrives in the last window"},
    {"id": "g1", "generate": {"n": 30000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: scanning every window is about 10^8 steps here"},
    {"id": "g2", "generate": {"n": 30000, "seed": 4}, "hang_guard_ms": 30000, "note": "large falling input: the deque holds many candidates"}
  ]
}
