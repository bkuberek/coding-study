{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"intervals": [[8, 10], [1, 4], [3, 6], [12, 15], [14, 14]]}, "expected": [[1, 6], [8, 10], [12, 15]]},
    {"id": "ex2", "visible": true, "input": {"intervals": [[2, 5], [5, 9]]}, "expected": [[2, 9]]},
    {"id": "h1", "input": {"intervals": [[4, 7]]}, "expected": [[4, 7]], "note": "a single interval"},
    {"id": "h2", "input": {"intervals": [[0, 0]]}, "expected": [[0, 0]], "note": "a single point at zero"},
    {"id": "h3", "input": {"intervals": [[1, 2], [4, 5], [7, 8]]}, "expected": [[1, 2], [4, 5], [7, 8]], "note": "already disjoint and sorted"},
    {"id": "h4", "input": {"intervals": [[7, 8], [4, 5], [1, 2]]}, "expected": [[1, 2], [4, 5], [7, 8]], "note": "disjoint, reverse order"},
    {"id": "h5", "input": {"intervals": [[2, 3], [0, 20], [5, 6], [19, 19]]}, "expected": [[0, 20]], "note": "one interval contains all the others"},
    {"id": "h6", "input": {"intervals": [[3, 6], [3, 6], [3, 6]]}, "expected": [[3, 6]], "note": "identical intervals"},
    {"id": "h7", "input": {"intervals": [[5, 5], [5, 5], [6, 6]]}, "expected": [[5, 5], [6, 6]], "note": "repeated points and an adjacent point that does not touch"},
    {"id": "h8", "input": {"intervals": [[1, 2], [2, 3], [3, 4], [4, 5]]}, "expected": [[1, 5]], "note": "a chain of touching intervals"},
    {"id": "h9", "input": {"intervals": [[1, 4], [5, 8], [3, 6]]}, "expected": [[1, 8]], "note": "the last interval bridges two earlier ones"},
    {"id": "h10", "input": {"intervals": [[0, 1000000000], [1000000000, 1000000000], [0, 0]]}, "expected": [[0, 1000000000]], "note": "extreme endpoints"},
    {"id": "h11", "input": {"intervals": [[0, 1], [999999999, 1000000000]]}, "expected": [[0, 1], [999999999, 1000000000]], "note": "far apart extremes stay separate"},
    {"id": "h12", "input": {"intervals": [[10, 12], [1, 3], [11, 15], [2, 4], [20, 21], [16, 19]]}, "expected": [[1, 4], [10, 15], [16, 19], [20, 21]], "note": "two groups and two loners, shuffled"},
    {"id": "h13", "input": {"intervals": [[1, 10], [2, 3], [4, 5], [6, 7], [8, 9], [11, 12]]}, "expected": [[1, 10], [11, 12]], "note": "a contained run must not shrink the end"},
    {"id": "h14", "input": {"intervals": [[6, 9], [1, 3], [3, 3], [9, 12]]}, "expected": [[1, 3], [6, 12]], "note": "point intervals at shared endpoints"},
    {"id": "g1", "generate": {"n": 10000, "seed": 43}, "note": "large input: about 2500 groups, so absorbing does about 10^7 comparisons"}
  ]
}
