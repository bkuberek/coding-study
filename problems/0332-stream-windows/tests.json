{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["StreamWindows", "add", "add", "add", "add", "add", "tumbling", "tumbling"], "args": [[], [1, 3, 5], [2, 7, 1], [1, 12, 2], [1, 9, 4], [2, 10, 6], [10], [5]], "expected": [null, null, null, null, null, null, [[1, 0, 10, 2, 9], [2, 0, 10, 1, 1], [1, 10, 20, 1, 2], [2, 10, 20, 1, 6]], [[1, 0, 5, 1, 5], [1, 5, 10, 1, 4], [2, 5, 10, 1, 1], [1, 10, 15, 1, 2], [2, 10, 15, 1, 6]]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["StreamWindows", "tumbling", "add", "add", "add", "add", "tumbling"], "args": [[], [10], [7, 20, 3], [7, 0, -2], [7, 19, 4], [7, 10, 1], [10]], "expected": [null, [], null, null, null, null, [[7, 0, 10, 1, -2], [7, 10, 20, 2, 5], [7, 20, 30, 1, 3]]]},
    {"id": "h1", "level": 1, "note": "windows are half-open: an event at a window's end belongs to the next window", "ops": ["StreamWindows", "add", "add", "add", "add", "add", "add", "tumbling"], "args": [[], [1, 0, 1], [1, 4, 2], [1, 5, 3], [1, 9, 4], [1, 10, 5], [1, 15, 6], [5]], "expected": [null, null, null, null, null, null, null, [[1, 0, 5, 2, 3], [1, 5, 10, 2, 7], [1, 10, 15, 1, 5], [1, 15, 20, 1, 6]]]},
    {"id": "h2", "level": 1, "note": "rows are sorted by window start, then by key, whatever the arrival order", "ops": ["StreamWindows", "add", "add", "add", "add", "add", "add", "tumbling"], "args": [[], [30, 25, 1], [9, 21, 1], [10, 2, 1], [9, 3, 1], [30, 4, 2], [2, 27, 7], [10]], "expected": [null, null, null, null, null, null, null, [[9, 0, 10, 1, 1], [10, 0, 10, 1, 1], [30, 0, 10, 1, 2], [2, 20, 30, 1, 7], [9, 20, 30, 1, 1], [30, 20, 30, 1, 1]]]},
    {"id": "h3", "level": 1, "note": "a size of 1 gives every time its own window; a large size puts each key in one window", "ops": ["StreamWindows", "add", "add", "add", "add", "tumbling", "tumbling"], "args": [[], [1, 2, 1], [1, 2, 2], [1, 3, 3], [2, 2, 4], [1], [1000000]], "expected": [null, null, null, null, null, [[1, 2, 3, 2, 3], [2, 2, 3, 1, 4], [1, 3, 4, 1, 3]], [[1, 0, 1000000, 3, 6], [2, 0, 1000000, 1, 4]]]},
    {"id": "h4", "level": 1, "note": "a window whose values add up to zero still has a row, and values can be negative", "ops": ["StreamWindows", "add", "add", "add", "add", "tumbling"], "args": [[], [5, 1, 4], [5, 2, -4], [6, 3, -7], [6, 13, 0], [10]], "expected": [null, null, null, null, null, [[5, 0, 10, 2, 0], [6, 0, 10, 1, -7], [6, 10, 20, 1, 0]]]},
    {"id": "h5", "level": 1, "note": "a view covers every event so far, and the size can change from call to call", "ops": ["StreamWindows", "add", "add", "tumbling", "add", "add", "tumbling", "tumbling"], "args": [[], [1, 1, 1], [1, 6, 1], [5], [1, 11, 1], [2, 4, 9], [5], [3]], "expected": [null, null, null, [[1, 0, 5, 1, 1], [1, 5, 10, 1, 1]], null, null, [[1, 0, 5, 1, 1], [2, 0, 5, 1, 9], [1, 5, 10, 1, 1], [1, 10, 15, 1, 1]], [[1, 0, 3, 1, 1], [2, 3, 6, 1, 9], [1, 6, 9, 1, 1], [1, 9, 12, 1, 1]]]},
    {"id": "h6", "level": 1, "note": "large times and a size that does not divide them", "ops": ["StreamWindows", "add", "add", "add", "add", "tumbling"], "args": [[], [1, 99999999, 3], [1, 99999994, 2], [1, 99999993, 1], [2, 0, 8], [7]], "expected": [null, null, null, null, null, [[2, 0, 7, 1, 8], [1, 99999991, 99999998, 2, 3], [1, 99999998, 100000005, 1, 3]]]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["StreamWindows", "add", "add", "add", "hopping", "tumbling"], "args": [[], [1, 3, 1], [1, 8, 2], [2, 12, 3], [10, 5], [10]], "expected": [null, null, null, null, [[1, -5, 5, 1, 1], [1, 0, 10, 2, 3], [1, 5, 15, 1, 2], [2, 5, 15, 1, 3], [2, 10, 20, 1, 3]], [[1, 0, 10, 2, 3], [2, 10, 20, 1, 3]]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["StreamWindows", "add", "add", "add", "add", "add", "add", "sessions"], "args": [[], [1, 1, 1], [1, 3, 1], [1, 10, 2], [1, 14, 2], [1, 19, 3], [2, 6, 5], [5]], "expected": [null, null, null, null, null, null, null, [[1, 1, 8, 2, 2], [2, 6, 11, 1, 5], [1, 10, 19, 2, 4], [1, 19, 24, 1, 3]]]},
    {"id": "h7", "level": 2, "note": "a slide equal to the size gives the tumbling windows", "ops": ["StreamWindows", "add", "add", "add", "add", "hopping", "tumbling"], "args": [[], [1, 0, 1], [1, 9, 2], [1, 10, 3], [2, 25, 4], [10, 10], [10]], "expected": [null, null, null, null, null, [[1, 0, 10, 2, 3], [1, 10, 20, 1, 3], [2, 20, 30, 1, 4]], [[1, 0, 10, 2, 3], [1, 10, 20, 1, 3], [2, 20, 30, 1, 4]]]},
    {"id": "h8", "level": 2, "note": "a slide larger than the size leaves gaps, and an event in a gap is in no window", "ops": ["StreamWindows", "add", "add", "add", "add", "add", "hopping"], "args": [[], [1, 1, 1], [1, 5, 2], [1, 12, 3], [1, 13, 4], [2, 9, 5], [3, 10]], "expected": [null, null, null, null, null, null, [[1, 0, 3, 1, 1], [1, 10, 13, 1, 3]]]},
    {"id": "h9", "level": 2, "note": "a size that is not a multiple of the slide; windows that start before 0 count", "ops": ["StreamWindows", "add", "add", "hopping"], "args": [[], [1, 0, 1], [1, 9, 2], [10, 4]], "expected": [null, null, null, [[1, -8, 2, 1, 1], [1, -4, 6, 1, 1], [1, 0, 10, 2, 3], [1, 4, 14, 1, 2], [1, 8, 18, 1, 2]]]},
    {"id": "h10", "level": 2, "note": "sessions follow event time, not arrival order", "ops": ["StreamWindows", "add", "add", "add", "sessions"], "args": [[], [1, 10, 1], [1, 1, 2], [1, 5, 4], [5]], "expected": [null, null, null, null, [[1, 1, 10, 2, 6], [1, 10, 15, 1, 1]]]},
    {"id": "h11", "level": 2, "note": "a session grows from its last event, equal times merge, and rows sort by start then key", "ops": ["StreamWindows", "add", "add", "add", "add", "add", "add", "add", "add", "sessions"], "args": [[], [2, 0, 1], [2, 4, 1], [2, 8, 1], [2, 12, 1], [1, 0, 3], [1, 0, 4], [1, 5, 5], [3, 20, 1], [5]], "expected": [null, null, null, null, null, null, null, null, null, [[1, 0, 5, 2, 7], [2, 0, 17, 4, 4], [1, 5, 10, 1, 5], [3, 20, 25, 1, 1]]]},
    {"id": "h12", "level": 2, "note": "a hopping window excludes its end", "ops": ["StreamWindows", "add", "add", "hopping"], "args": [[], [1, 6, 1], [1, 12, 2], [6, 3]], "expected": [null, null, null, [[1, 3, 9, 1, 1], [1, 6, 12, 1, 1], [1, 9, 15, 1, 2], [1, 12, 18, 1, 2]]]},
    {"id": "h13", "level": 2, "note": "the three views read the same events", "ops": ["StreamWindows", "add", "add", "add", "add", "tumbling", "hopping", "sessions", "sessions"], "args": [[], [4, 2, 1], [4, 3, 2], [4, 11, 3], [5, 7, 4], [4], [4, 2], [3], [9]], "expected": [null, null, null, null, null, [[4, 0, 4, 2, 3], [5, 4, 8, 1, 4], [4, 8, 12, 1, 3]], [[4, 0, 4, 2, 3], [4, 2, 6, 2, 3], [5, 4, 8, 1, 4], [5, 6, 10, 1, 4], [4, 8, 12, 1, 3], [4, 10, 14, 1, 3]], [[4, 2, 6, 2, 3], [5, 7, 10, 1, 4], [4, 11, 14, 1, 3]], [[4, 2, 20, 3, 6], [5, 7, 16, 1, 4]]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["StreamWindows", "configure", "add", "add", "add", "watermark", "pending", "poll", "add", "poll", "watermark", "pending"], "args": [[], [10, 0], [1, 2, 5], [1, 7, 1], [2, 9, 3], [], [], [], [1, 11, 4], [], [], []], "expected": [null, null, null, null, null, 9, [[1, 0, 10, 2, 6], [2, 0, 10, 1, 3]], [], null, [[1, 0, 10, 2, 6], [2, 0, 10, 1, 3]], 11, [[1, 10, 20, 1, 4]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["StreamWindows", "configure", "add", "add", "watermark", "add", "add", "pending", "poll", "add", "watermark", "poll", "pending"], "args": [[], [10, 5], [1, 4, 1], [1, 12, 2], [], [1, 8, 3], [2, 6, 1], [], [], [1, 15, 1], [], [], []], "expected": [null, null, null, null, 7, null, null, [[1, 0, 10, 2, 4], [2, 0, 10, 1, 1], [1, 10, 20, 1, 2]], [], null, 10, [[1, 0, 10, 2, 4], [2, 0, 10, 1, 1]], [[1, 10, 20, 2, 3]]]},
    {"id": "h14", "level": 3, "note": "the watermark starts at 0, never goes below it and never goes down when an older event arrives", "ops": ["StreamWindows", "configure", "watermark", "add", "watermark", "add", "watermark", "add", "watermark", "poll", "pending"], "args": [[], [10, 6], [], [1, 3, 1], [], [1, 16, 1], [], [1, 12, 1], [], [], []], "expected": [null, null, 0, null, 0, null, 10, null, 10, [[1, 0, 10, 1, 1]], [[1, 10, 20, 2, 2]]]},
    {"id": "h15", "level": 3, "note": "a window is emitted as soon as the watermark reaches its end", "ops": ["StreamWindows", "configure", "add", "add", "poll", "add", "poll", "pending"], "args": [[], [10, 0], [1, 3, 1], [1, 9, 2], [], [1, 10, 4], [], []], "expected": [null, null, null, null, [], null, [[1, 0, 10, 2, 3]], [[1, 10, 20, 1, 4]]]},
    {"id": "h16", "level": 3, "note": "one jump of the watermark emits many windows, ordered by start and then key", "ops": ["StreamWindows", "configure", "add", "add", "add", "add", "add", "add", "poll", "add", "poll", "pending", "watermark"], "args": [[], [5, 2], [3, 1, 1], [1, 6, 2], [2, 2, 3], [1, 3, 4], [0, 11, 5], [2, 7, 6], [], [9, 40, 1], [], [], []], "expected": [null, null, null, null, null, null, null, null, [[1, 0, 5, 1, 4], [2, 0, 5, 1, 3], [3, 0, 5, 1, 1]], null, [[1, 5, 10, 1, 2], [2, 5, 10, 1, 6], [0, 10, 15, 1, 5]], [[9, 40, 45, 1, 1]], 38]},
    {"id": "h17", "level": 3, "note": "poll hands each result over once", "ops": ["StreamWindows", "configure", "poll", "add", "add", "poll", "poll", "add", "poll"], "args": [[], [4, 0], [], [1, 1, 1], [1, 5, 2], [], [], [1, 9, 3], []], "expected": [null, null, [], null, null, [[1, 0, 4, 1, 1]], [], null, [[1, 4, 8, 1, 2]]]},
    {"id": "h18", "level": 3, "note": "pending lists only the windows not emitted yet, by start and then key", "ops": ["StreamWindows", "configure", "add", "add", "add", "add", "pending", "add", "pending", "poll"], "args": [[], [10, 10], [5, 3, 1], [4, 14, 1], [5, 21, 2], [4, 18, 3], [], [5, 30, 1], [], []], "expected": [null, null, null, null, null, null, [[4, 10, 20, 2, 4], [5, 20, 30, 1, 2]], null, [[5, 20, 30, 1, 2], [5, 30, 40, 1, 1]], [[5, 0, 10, 1, 1], [4, 10, 20, 2, 4]]]},
    {"id": "h19", "level": 3, "note": "the batch views still see every event while the stream emits", "ops": ["StreamWindows", "configure", "add", "add", "add", "poll", "tumbling", "sessions"], "args": [[], [10, 0], [1, 2, 1], [1, 13, 2], [2, 15, 3], [], [10], [20]], "expected": [null, null, null, null, null, [[1, 0, 10, 1, 1]], [[1, 0, 10, 1, 1], [1, 10, 20, 1, 2], [2, 10, 20, 1, 3]], [[1, 2, 33, 2, 3], [2, 15, 35, 1, 3]]]},
    {"id": "h20", "level": 3, "note": "an event behind the watermark joins its window while that window is still open", "ops": ["StreamWindows", "configure", "add", "add", "add", "watermark", "pending", "add", "poll"], "args": [[], [10, 0], [1, 15, 1], [1, 12, 2], [2, 11, 3], [], [], [1, 20, 1], []], "expected": [null, null, null, null, null, 15, [[1, 10, 20, 2, 3], [2, 10, 20, 1, 3]], null, [[1, 10, 20, 2, 3], [2, 10, 20, 1, 3]]]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["StreamWindows", "configure", "add", "add", "poll", "add", "add", "poll", "dropped", "stats", "tumbling"], "args": [[], [10, 0], [1, 5, 1], [1, 12, 1], [], [1, 8, 4], [2, 3, 2], [], [], [], [10]], "expected": [null, null, null, null, [[1, 0, 10, 1, 1]], null, null, [], [[1, 8, 4], [2, 3, 2]], [1, 0, 2], [[1, 0, 10, 2, 5], [2, 0, 10, 1, 2], [1, 10, 20, 1, 1]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["StreamWindows", "configure", "allowUpdates", "add", "add", "poll", "add", "poll", "add", "poll", "add", "poll", "add", "poll", "dropped", "stats"], "args": [[], [10, 0], [10], [1, 5, 2], [1, 13, 1], [], [1, 7, 3], [], [2, 9, 1], [], [1, 21, 1], [], [1, 6, 1], [], [], []], "expected": [null, null, null, null, null, [[1, 0, 10, 1, 2]], null, [[1, 0, 10, -1, -2], [1, 0, 10, 2, 5]], null, [[2, 0, 10, 1, 1]], null, [[1, 10, 20, 1, 1]], null, [], [[1, 6, 1]], [3, 1, 1]]},
    {"id": "h21", "level": 4, "note": "a closed window accepts a late event until the watermark reaches end plus grace", "ops": ["StreamWindows", "configure", "allowUpdates", "add", "add", "add", "poll", "add", "add", "poll", "dropped", "stats"], "args": [[], [10, 0], [5], [1, 1, 1], [1, 14, 1], [1, 2, 1], [], [1, 15, 1], [1, 3, 1], [], [], []], "expected": [null, null, null, null, null, null, [[1, 0, 10, 1, 1], [1, 0, 10, -1, -1], [1, 0, 10, 2, 2]], null, null, [], [[1, 3, 1]], [1, 1, 1]]},
    {"id": "h22", "level": 4, "note": "each correction retracts the result emitted just before it", "ops": ["StreamWindows", "configure", "allowUpdates", "add", "add", "add", "add", "poll", "stats", "pending"], "args": [[], [10, 0], [100], [1, 1, 10], [1, 25, 0], [1, 2, 20], [1, 3, 30], [], [], []], "expected": [null, null, null, null, null, null, null, [[1, 0, 10, 1, 10], [1, 0, 10, -1, -10], [1, 0, 10, 2, 30], [1, 0, 10, -2, -30], [1, 0, 10, 3, 60]], [1, 2, 0], [[1, 20, 30, 1, 0]]]},
    {"id": "h23", "level": 4, "note": "a late event for a window never emitted is a first result, then later events update it", "ops": ["StreamWindows", "configure", "allowUpdates", "add", "add", "poll", "add", "poll", "stats"], "args": [[], [10, 0], [20], [1, 22, 1], [7, 4, 5], [], [7, 6, 1], [], []], "expected": [null, null, null, null, null, [[7, 0, 10, 1, 5]], null, [[7, 0, 10, -1, -5], [7, 0, 10, 2, 6]], [1, 1, 0]]},
    {"id": "h24", "level": 4, "note": "the side output keeps every dropped event, in arrival order, across calls", "ops": ["StreamWindows", "configure", "add", "add", "add", "dropped", "add", "dropped", "dropped", "stats"], "args": [[], [5, 0], [1, 12, 1], [3, 1, 5], [2, 0, 6], [], [1, 3, 7], [], [], []], "expected": [null, null, null, null, null, [[3, 1, 5], [2, 0, 6]], null, [[3, 1, 5], [2, 0, 6], [1, 3, 7]], [[3, 1, 5], [2, 0, 6], [1, 3, 7]], [0, 0, 3]]},
    {"id": "h25", "level": 4, "note": "an event behind the watermark in an open window is not late", "ops": ["StreamWindows", "configure", "add", "add", "add", "dropped", "pending", "stats"], "args": [[], [10, 0], [1, 15, 1], [1, 12, 2], [1, 5, 3], [], [], []], "expected": [null, null, null, null, null, [[1, 5, 3]], [[1, 10, 20, 2, 3]], [0, 0, 1]]},
    {"id": "h26", "level": 4, "note": "lateness and grace together: the watermark trails, and grace runs from the window end", "ops": ["StreamWindows", "configure", "allowUpdates", "add", "add", "watermark", "poll", "add", "add", "watermark", "poll", "add", "poll", "add", "add", "watermark", "poll", "dropped", "stats"], "args": [[], [10, 3], [4], [1, 2, 1], [1, 13, 1], [], [], [1, 9, 1], [1, 16, 1], [], [], [1, 5, 1], [], [1, 17, 1], [1, 6, 1], [], [], [], []], "expected": [null, null, null, null, null, 10, [[1, 0, 10, 1, 1]], null, null, 13, [[1, 0, 10, -1, -1], [1, 0, 10, 2, 2]], null, [[1, 0, 10, -2, -2], [1, 0, 10, 3, 3]], null, null, 14, [], [[1, 6, 1]], [1, 2, 1]]},
    {"id": "h27", "level": 4, "note": "dropped events stay in the batch views, which describe the complete data", "ops": ["StreamWindows", "configure", "add", "add", "add", "add", "tumbling", "hopping", "sessions", "stats"], "args": [[], [10, 0], [1, 1, 2], [1, 30, 1], [1, 4, 3], [2, 5, 1], [10], [20, 10], [5], []], "expected": [null, null, null, null, null, null, [[1, 0, 10, 2, 5], [2, 0, 10, 1, 1], [1, 30, 40, 1, 1]], [[1, -10, 10, 2, 5], [2, -10, 10, 1, 1], [1, 0, 20, 2, 5], [2, 0, 20, 1, 1], [1, 20, 40, 1, 1], [1, 30, 50, 1, 1]], [[1, 1, 9, 2, 5], [2, 5, 10, 1, 1], [1, 30, 35, 1, 1]], [1, 0, 2]]}
