{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["MemoryStore", "write", "version", "version", "write", "write", "get", "write", "get"], "args": [[], ["user-42/preferences", 0, "short answers"], ["user-42/preferences"], ["user-42/preferences"], ["user-42/preferences", 1, "short answers, in Spanish"], ["user-42/preferences", 1, "short answers, metric units"], ["user-42/preferences"], ["user-42/preferences", 2, "short answers, in Spanish, metric units"], ["user-42/preferences"]], "expected": [null, [1, 1], 1, 1, [1, 2], [0, 2], "short answers, in Spanish", [1, 3], "short answers, in Spanish, metric units"]},
    {"id": "ex2", "visible": true, "ops": ["MemoryStore", "write", "forget", "get", "version", "write", "write", "get"], "args": [[], ["trip-plan", 0, "Lisbon in May"], ["trip-plan", 1], ["trip-plan"], ["trip-plan"], ["trip-plan", 0, "Porto in June"], ["trip-plan", 2, "Porto in June"], ["trip-plan"]], "expected": [null, [1, 1], [1, 2], "", 2, [0, 2], [1, 3], "Porto in June"]},
    {"id": "ex3", "visible": true, "ops": ["MemoryStore", "version", "get", "write", "write", "version"], "args": [[], ["tone"], ["tone"], ["tone", 3, "formal"], ["tone", 0, "formal"], ["style"]], "expected": [null, 0, "", [0, 0], [1, 1], 0]},
    {"id": "h1", "ops": ["MemoryStore", "write", "write", "get", "version"], "args": [[], ["notes", 0, "first draft"], ["notes", 0, "rival draft"], ["notes"], ["notes"]], "expected": [null, [1, 1], [0, 1], "first draft", 1], "note": "a second writer that also read version 0 is refused, and the first draft survives"},
    {"id": "h2", "ops": ["MemoryStore", "write", "write", "write", "version", "write"], "args": [[], ["k", 0, "a"], ["k", 0, "b"], ["k", 5, "c"], ["k"], ["k", 1, "d"]], "expected": [null, [1, 1], [0, 1], [0, 1], 1, [1, 2]], "note": "refused writes leave the version at 1"},
    {"id": "h3", "ops": ["MemoryStore", "write", "forget", "write", "get", "version"], "args": [[], ["k", 0, "a"], ["k", 1], ["k", 0, "b"], ["k"], ["k"]], "expected": [null, [1, 1], [1, 2], [0, 2], "", 2], "note": "after a forget the version is 2, not 0, so a writer holding version 0 is refused"},
    {"id": "h4", "ops": ["MemoryStore", "write", "write", "write", "version", "write", "write"], "args": [[], ["a", 0, "x"], ["b", 0, "y"], ["a", 1, "x2"], ["b"], ["b", 2, "y2"], ["b", 1, "y2"]], "expected": [null, [1, 1], [1, 1], [1, 2], 1, [0, 1], [1, 2]], "note": "each key has its own version: b is still at 1 after a changes"},
    {"id": "h5", "ops": ["MemoryStore", "write", "write", "write", "get"], "args": [[], ["k", 0, "kept"], ["k", 2, "ahead"], ["k", 7, "far ahead"], ["k"]], "expected": [null, [1, 1], [0, 1], [0, 1], "kept"], "note": "an expected version ahead of the current one is refused too: only equality is accepted"},
    {"id": "h6", "ops": ["MemoryStore", "write", "write", "write"], "args": [[], ["k", 0, "same"], ["k", 1, "same"], ["k", 1, "other"]], "expected": [null, [1, 1], [1, 2], [0, 2]], "note": "writing the value the key already has is an accepted change and bumps the version"},
    {"id": "h7", "ops": ["MemoryStore", "forget", "get", "version", "forget", "write", "write", "get"], "args": [[], ["ghost", 0], ["ghost"], ["ghost"], ["ghost", 0], ["ghost", 0, "boo"], ["ghost", 1, "boo"], ["ghost"]], "expected": [null, [1, 1], "", 1, [0, 1], [0, 1], [1, 2], "boo"], "note": "forgetting a key with no value is accepted when the version matches, and counts"},
    {"id": "h8", "ops": ["MemoryStore", "write", "version", "write", "get", "get"], "args": [[], ["User", 0, "upper"], ["user"], ["user", 0, "lower"], ["User"], ["user"]], "expected": [null, [1, 1], 0, [1, 1], "upper", "lower"], "note": "keys are compared exactly: User and user are two keys"},
    {"id": "h9", "ops": ["MemoryStore", "write", "version", "version", "version", "write", "write", "write", "get", "write", "write", "get", "version"], "args": [[], ["plan", 0, "v1"], ["plan"], ["plan"], ["plan"], ["plan", 1, "v1+a"], ["plan", 1, "v1+b"], ["plan", 1, "v1+c"], ["plan"], ["plan", 2, "v1+a+b"], ["plan", 2, "v1+a+c"], ["plan"], ["plan"]], "expected": [null, [1, 1], 1, 1, 1, [1, 2], [0, 2], [0, 2], "v1+a", [1, 3], [0, 3], "v1+a+b", 3], "note": "three writers read version 1; one wins, the other two retry from version 2, and one of those must retry again"},
    {"id": "h10", "ops": ["MemoryStore", "write", "write", "forget", "write", "get", "version"], "args": [[], ["k", 0, "a"], ["k", 1, "b"], ["k", 2], ["k", 3, "c"], ["k"], ["k"]], "expected": [null, [1, 1], [1, 2], [1, 3], [1, 4], "c", 4], "note": "a key written again after a forget continues from its version"},
    {"id": "h11", "ops": ["MemoryStore", "get", "version", "forget", "write", "version"], "args": [[], ["x"], ["x"], ["x", 1], ["x", 0, "first"], ["x"]], "expected": [null, "", 0, [0, 0], [1, 1], 1], "note": "reading an unknown key changes nothing, and a forget with the wrong version is refused with version 0"},
    {"id": "h12", "ops": ["MemoryStore", "write", "write", "write", "write"], "args": [[], ["k", 0, "a"], ["k", 1, "b"], ["k", 1, "c"], ["k", 0, "d"]], "expected": [null, [1, 1], [1, 2], [0, 2], [0, 2]], "note": "a refusal reports the current version, 2, not the expected one and not the next"},
    {"id": "h13", "ops": ["MemoryStore", "write", "forget", "get", "version"], "args": [[], ["k", 0, "keep me"], ["k", 0], ["k"], ["k"]], "expected": [null, [1, 1], [0, 1], "keep me", 1], "note": "a refused forget leaves the value in place"},
    {"id": "h14", "ops": ["MemoryStore", "write", "write", "write", "write", "write", "write", "write", "write", "version", "get"], "args": [[], ["log", 0, "entry 1"], ["log", 1, "entry 2"], ["log", 2, "entry 3"], ["log", 3, "entry 4"], ["log", 4, "entry 5"], ["log", 5, "entry 6"], ["log", 6, "entry 7"], ["log", 7, "entry 8"], ["log"], ["log"]], "expected": [null, [1, 1], [1, 2], [1, 3], [1, 4], [1, 5], [1, 6], [1, 7], [1, 8], 8, "entry 8"], "note": "eight accepted writes in a row"}
  ]
}
