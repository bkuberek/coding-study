  {"id": "h21", "level": 4, "note": "an accepted claim ends the run even when the step went over budget; a check with no rows rejects every claim", "ops": ["LoopController", "setCheck", "setBudgets", "run", "tripped", "summary", "setCheck", "run", "summary"], "args": [[], [["x"], ["pass"]], [100, 100], [10, [["final", "{}", "ok", "x", "500", "500"]]], [], [], [[], []], [10, [["final", "{}", "ok", "x", "1", "1"], ["final", "{}", "ok", "x", "1", "1"]]], []], "expected": [null, null, null, "final", [], [["step", "1", "final", "accepted", "500", "500"], ["stop", "final", "1", "500", "500"]], null, "out_of_steps", [["step", "1", "final", "rejected", "1", "1"], ["feedback", "1", "no verdict"], ["step", "2", "final", "rejected", "2", "2"], ["feedback", "2", "no verdict"], ["stop", "out_of_steps", "2", "2", "2"]]]},
  {"id": "h22", "level": 4, "note": "a summary describes the last run only; with no check, a final answer is accepted; a run of zero steps has just its stop row", "ops": ["LoopController", "summary", "run", "summary", "run", "summary", "setCheck", "run", "summary"], "args": [[], [], [0, [["search", "{\"q\": \"rates\"}", "ok", "3 hits", "100", "500"]]], [], [2, [["search", "{\"q\": \"rates\"}", "ok", "3 hits", "100", "500"], ["final", "{}", "ok", "a", "100", "500"], ["search", "{\"q\": \"rates\"}", "ok", "3 hits", "100", "500"]]], [], [["a"], ["fail: wrong"]], [2, [["search", "{\"q\": \"rates\"}", "ok", "3 hits", "100", "500"], ["final", "{}", "ok", "a", "100", "500"], ["search", "{\"q\": \"rates\"}", "ok", "3 hits", "100", "500"]]], []], "expected": [null, [], "max_iterations", [["stop", "max_iterations", "0", "0", "0"]], "final", [["step", "1", "search", "ok", "100", "500"], ["step", "2", "final", "accepted", "200", "1000"], ["stop", "final", "2", "200", "1000"]], null, "max_iterations", [["step", "1", "search", "ok", "100", "500"], ["step", "2", "final", "rejected", "200", "1000"], ["feedback", "2", "fail: wrong"], ["stop", "max_iterations", "2", "200", "1000"]]]},
  {"id": "h23", "level": 4, "note": "only the text pass accepts a claim; the rest is feedback", "ops": ["LoopController", "setCheck", "run", "summary", "setNoProgressLimit", "setBudgets", "setCheck", "run", "summary"], "args": [[], [["done", "PASS", "spaced"], ["pass", "PASS", "pass "]], [5, [["final", "{}", "ok", "PASS", "100", "500"], ["final", "{}", "ok", "spaced", "100", "500"], ["final", "{}", "ok", "done", "100", "500"]]], [], [2], [1000, 5000], [["ready"], ["fail: missing tests"]], [10, [["run_tests", "{\"suite\": \"unit\"}", "error", "1 failed", "100", "800"], ["run_tests", "{\"suite\":\"unit\"}", "error", "7 failed", "100", "800"]]], []], "expected": [null, null, "final", [["step", "1", "final", "rejected", "100", "500"], ["feedback", "1", "PASS"], ["step", "2", "final", "rejected", "200", "1000"], ["feedback", "2", "pass "], ["step", "3", "final", "accepted", "300", "1500"], ["stop", "final", "3", "300", "1500"]], null, null, null, "no_progress", [["step", "1", "run_tests", "error", "100", "800"], ["step", "2", "run_tests", "error", "200", "1600"], ["stop", "no_progress", "2", "200", "1600"]]]},
  {"id": "h24", "level": 4, "note": "a whole run: a failure, a rejected claim, a streak that never builds, and an accepted claim", "ops": ["LoopController", "setCheck", "setNoProgressLimit", "setBudgets", "run", "iterations", "tripped", "summary"], "args": [[], [["ready", "ready now"], ["fail: tests red", "pass"]], [3], [2000, 10000], [20, [["read_file", "{\"path\": \"a.txt\"}", "ok", "file text", "100", "500"], ["run_tests", "{}", "error", "2 failed", "300", "2000"], ["final", "{}", "ok", "ready", "100", "500"], ["run_tests", "{}", "error", "1 failed", "300", "2000"], ["final", "{}", "ok", "ready", "100", "500"], ["edit_file", "{\"path\": \"a.txt\"}", "ok", "saved", "100", "500"], ["final", "{}", "ok", "ready now", "100", "500"]]], [], [], []], "expected": [null, null, null, null, "final", 7, [], [["step", "1", "read_file", "ok", "100", "500"], ["step", "2", "run_tests", "error", "400", "2500"], ["step", "3", "final", "rejected", "500", "3000"], ["feedback", "3", "fail: tests red"], ["step", "4", "run_tests", "error", "800", "5000"], ["step", "5", "final", "rejected", "900", "5500"], ["feedback", "5", "fail: tests red"], ["step", "6", "edit_file", "ok", "1000", "6000"], ["step", "7", "final", "accepted", "1100", "6500"], ["stop", "final", "7", "1100", "6500"]]]}
  ]
