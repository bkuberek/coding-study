  {"id": "h19", "level": 4, "note": "feedback is compared like an error: digits are masked, words are not", "ops": ["LoopController", "setCheck", "setNoProgressLimit", "run", "iterations", "setCheck", "run", "iterations", "summary"], "args": [[], [["x", "y"], ["fail: 2 tests failing", "fail: 5 tests failing"]], [2], [10, [["final", "{}", "ok", "x", "100", "500"], ["final", "{}", "ok", "y", "100", "500"], ["final", "{}", "ok", "x", "100", "500"]]], [], [["x", "y"], ["fail: tests failing", "fail: lint errors"]], [10, [["final", "{}", "ok", "x", "100", "500"], ["final", "{}", "ok", "y", "100", "500"], ["final", "{}", "ok", "x", "100", "500"], ["final", "{}", "ok", "y", "100", "500"]]], [], []], "expected": [null, null, null, "no_progress", 2, null, "out_of_steps", 4, [["step", "1", "final", "rejected", "100", "500"], ["feedback", "1", "fail: tests failing"], ["step", "2", "final", "rejected", "200", "1000"], ["feedback", "2", "fail: lint errors"], ["step", "3", "final", "rejected", "300", "1500"], ["feedback", "3", "fail: tests failing"], ["step", "4", "final", "rejected", "400", "2000"], ["feedback", "4", "fail: lint errors"], ["stop", "out_of_steps", "4", "400", "2000"]]]},
