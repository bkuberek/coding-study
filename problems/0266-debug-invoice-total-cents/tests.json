{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"unitPrices": ["10.00"], "quantities": [2], "taxBasisPoints": 0}, "expected": 2000},
    {"id": "ex2", "visible": true, "input": {"unitPrices": ["12.50"], "quantities": [4], "taxBasisPoints": 800}, "expected": 5400},
    {"id": "h1", "input": {"unitPrices": ["19.99"], "quantities": [1], "taxBasisPoints": 0}, "expected": 1999, "note": "the report: 19.99 * 100 is 1998.9999999999998, and truncating loses a cent"},
    {"id": "h2", "input": {"unitPrices": ["4.35"], "quantities": [1], "taxBasisPoints": 0}, "expected": 435, "note": "4.35 * 100 is 434.99999999999994"},
    {"id": "h3", "input": {"unitPrices": ["1.15"], "quantities": [1], "taxBasisPoints": 1000}, "expected": 127, "note": "115 cents plus an exact 11.5 of tax, which rounds up to 12; in floats the sum sits just below the half, so rounding the total is a cent short"},
    {"id": "h4", "input": {"unitPrices": ["4.35"], "quantities": [1], "taxBasisPoints": 1000}, "expected": 479, "note": "435 plus an exact 43.5; rounding at the end is a cent short again"},
    {"id": "h5", "input": {"unitPrices": ["4.35"], "quantities": [2], "taxBasisPoints": 500}, "expected": 914, "note": "870 plus an exact 43.5; toFixed(2) on the float total rounds the wrong way"},
    {"id": "h6", "input": {"unitPrices": ["1.35"], "quantities": [2], "taxBasisPoints": 500}, "expected": 284, "note": "270 plus an exact 13.5"},
    {"id": "h7", "input": {"unitPrices": ["1.00"], "quantities": [1], "taxBasisPoints": 50}, "expected": 101, "note": "an exact half of a cent of tax rounds up"},
    {"id": "h8", "input": {"unitPrices": ["1.00"], "quantities": [1], "taxBasisPoints": 49}, "expected": 100, "note": "just under a half rounds down"},
    {"id": "h9", "input": {"unitPrices": ["1.00", "1.00"], "quantities": [1, 1], "taxBasisPoints": 50}, "expected": 201, "note": "the tax is rounded once, on the subtotal: per line it would be 102"},
    {"id": "h10", "input": {"unitPrices": ["5.5", "5", "0.05"], "quantities": [1, 1, 1], "taxBasisPoints": 0}, "expected": 1055, "note": "one decimal, no decimals and a leading zero: 550 + 500 + 5"},
    {"id": "h11", "input": {"unitPrices": ["0.29", "8.20", "1.10"], "quantities": [1, 1, 3], "taxBasisPoints": 0}, "expected": 1179, "note": "several lines"},
    {"id": "h12", "input": {"unitPrices": ["9.99"], "quantities": [0], "taxBasisPoints": 800}, "expected": 0, "note": "a quantity of zero"},
    {"id": "h13", "input": {"unitPrices": [], "quantities": [], "taxBasisPoints": 800}, "expected": 0, "note": "an empty invoice"},
    {"id": "h14", "input": {"unitPrices": ["1234.56"], "quantities": [1000], "taxBasisPoints": 825}, "expected": 133641120, "note": "a large invoice"},
    {"id": "h15", "input": {"unitPrices": ["19.99", "4.35", "0.07"], "quantities": [3, 2, 10], "taxBasisPoints": 725}, "expected": 7440, "note": "a realistic mix: 6937 of subtotal plus 502.9325 of tax"}
  ]
}
