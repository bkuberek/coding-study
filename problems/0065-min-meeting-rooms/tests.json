{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"intervals": [[9, 12], [10, 11], [11, 13], [12, 14]]}, "expected": 2},
    {"id": "ex2", "visible": true, "input": {"intervals": [[1, 4], [4, 7], [7, 9]]}, "expected": 1},
    {"id": "h1", "input": {"intervals": [[3, 8]]}, "expected": 1, "note": "a single meeting"},
    {"id": "h2", "input": {"intervals": [[2, 6], [2, 6], [2, 6], [2, 6]]}, "expected": 4, "note": "identical meetings"},
    {"id": "h3", "input": {"intervals": [[0, 100], [10, 20], [30, 40], [50, 60]]}, "expected": 2, "note": "one long meeting with short ones inside"},
    {"id": "h4", "input": {"intervals": [[1, 10], [2, 9], [3, 8], [4, 7]]}, "expected": 4, "note": "fully nested"},
    {"id": "h5", "input": {"intervals": [[7, 9], [1, 4], [4, 7]]}, "expected": 1, "note": "back to back, unsorted"},
    {"id": "h6", "input": {"intervals": [[1, 5], [5, 9], [2, 6], [6, 10]]}, "expected": 2, "note": "two rooms, both reused at a shared time"},
    {"id": "h7", "input": {"intervals": [[1, 3], [2, 4], [3, 5], [4, 6], [5, 7]]}, "expected": 2, "note": "staggered overlaps"},
    {"id": "h8", "input": {"intervals": [[0, 1000000000], [0, 1], [999999999, 1000000000]]}, "expected": 2, "note": "extreme times"},
    {"id": "h9", "input": {"intervals": [[0, 1], [1, 2], [2, 3], [0, 3]]}, "expected": 2, "note": "a chain plus one meeting covering it"},
    {"id": "h10", "input": {"intervals": [[5, 10], [0, 5], [10, 15], [5, 15]]}, "expected": 2, "note": "the peak is at a time where meetings end and start"},
    {"id": "h11", "input": {"intervals": [[1, 2], [3, 4], [5, 6], [7, 8]]}, "expected": 1, "note": "never overlapping"},
    {"id": "h12", "input": {"intervals": [[1, 20], [2, 3], [2, 4], [3, 5], [4, 6]]}, "expected": 3, "note": "the peak is reached twice"},
    {"id": "h13", "input": {"intervals": [[10, 30], [20, 40], [25, 35], [30, 50], [35, 45], [40, 60]]}, "expected": 3, "note": "rooms freed and refilled"},
    {"id": "g1", "generate": {"n": 5000, "seed": 59}, "note": "large input: counting at every start does 2.5 * 10^7 comparisons"}
  ]
}
