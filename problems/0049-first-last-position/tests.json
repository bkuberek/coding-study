{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [1, 3, 3, 3, 6, 8], "target": 3}, "expected": [1, 3]},
    {"id": "ex2", "visible": true, "input": {"nums": [2, 4, 4, 9], "target": 5}, "expected": [-1, -1]},
    {"id": "h1", "input": {"nums": [], "target": 0}, "expected": [-1, -1], "note": "empty array"},
    {"id": "h2", "input": {"nums": [7], "target": 7}, "expected": [0, 0], "note": "single element, present"},
    {"id": "h3", "input": {"nums": [7], "target": 8}, "expected": [-1, -1], "note": "single element, absent"},
    {"id": "h4", "input": {"nums": [4, 4, 4, 4, 4, 4], "target": 4}, "expected": [0, 5], "note": "every element is the target"},
    {"id": "h5", "input": {"nums": [2, 2, 2, 5, 6, 9], "target": 2}, "expected": [0, 2], "note": "block at the start"},
    {"id": "h6", "input": {"nums": [1, 3, 5, 9, 9, 9], "target": 9}, "expected": [3, 5], "note": "block at the end"},
    {"id": "h7", "input": {"nums": [1, 3, 5, 9, 9, 9], "target": 0}, "expected": [-1, -1], "note": "below every value"},
    {"id": "h8", "input": {"nums": [1, 3, 5, 9, 9, 9], "target": 10}, "expected": [-1, -1], "note": "above every value"},
    {"id": "h9", "input": {"nums": [-8, -5, -1, 0, 2, 7], "target": -1}, "expected": [2, 2], "note": "distinct values, single occurrence"},
    {"id": "h10", "input": {"nums": [-3, -3, -2, -2, -2, -2, 0, 0, 5], "target": -2}, "expected": [2, 5], "note": "negative block between other duplicates"},
    {"id": "h11", "input": {"nums": [-1000000000, -1000000000, 0, 1000000000, 1000000000, 1000000000], "target": 1000000000}, "expected": [3, 5], "note": "extreme values"},
    {"id": "h12", "input": {"nums": [-1000000000, -1000000000, 0, 1000000000, 1000000000, 1000000000], "target": -1000000000}, "expected": [0, 1], "note": "extreme values at the start"},
    {"id": "h13", "input": {"nums": [1, 2, 2, 3], "target": 2}, "expected": [1, 2], "note": "block of two in the middle"},
    {"id": "h14", "input": {"nums": [10, 20, 30, 40, 50, 60, 70], "target": 45}, "expected": [-1, -1], "note": "absent, between distinct values"},
    {"id": "g1", "generate": {"n": 100000, "seed": 29}, "note": "large input: the target fills a quarter to a half of the array"}
  ]
}
