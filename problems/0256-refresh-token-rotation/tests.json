{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["RefreshTokenStore", "issue", "rotate", "activeToken", "rotate", "activeToken"], "args": [[3600, 30], ["family-a", "token-a1", 900], ["token-a1", "token-a2", 1000], ["family-a", 1000], ["token-a1", "token-a3", 1010], ["family-a", 1010]], "expected": [null, true, "rotated", "token-a2", "grace-retry", "token-a2"]},
    {"id": "ex2", "visible": true, "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "activeToken"], "args": [[3600, 30], ["family-b", "token-b1", 900], ["token-b1", "token-b2", 1000], ["token-b1", "token-b3", 1030], ["token-b2", "token-b4", 1031], ["family-b", 1031]], "expected": [null, true, "rotated", "reuse-detected", "revoked", ""]},
    {"id": "ex3", "visible": true, "ops": ["RefreshTokenStore", "issue", "activeToken", "rotate", "rotate", "activeToken"], "args": [[100, 10], ["family-c", "token-c1", 0], ["family-c", 99], ["token-c1", "token-c2", 100], ["token-c1", "token-c3", 5000], ["family-c", 100]], "expected": [null, true, "token-c1", "expired", "expired", ""]},
    {"id": "h1", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t1", "x1", 1029], ["t1", "x2", 1030]], "expected": [null, true, "rotated", "grace-retry", "reuse-detected"], "note": "the window closes at spent time + grace"},
    {"id": "h2", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "activeToken"], "args": [[3600, 0], ["f", "t1", 0], ["t1", "t2", 1000], ["t1", "x1", 1000], ["f", 1000]], "expected": [null, true, "rotated", "reuse-detected", ""], "note": "no grace: the same second is already reuse"},
    {"id": "h3", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t2", "t3", 1005], ["t1", "x1", 1010], ["t3", "x2", 1011]], "expected": [null, true, "rotated", "rotated", "reuse-detected", "revoked"], "note": "an older token is reuse inside its own window"},
    {"id": "h4", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "activeToken", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t2", "t3", 1005], ["t2", "x1", 1010], ["f", 1010], ["t3", "t4", 1011]], "expected": [null, true, "rotated", "rotated", "grace-retry", "t3", "rotated"], "note": "the most recently spent token keeps its window after a rotation"},
    {"id": "h5", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "activeToken", "rotate", "rotate", "activeToken"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t1", "x1", 1005], ["f", 1005], ["x1", "x2", 1006], ["t2", "t3", 1007], ["f", 1007]], "expected": [null, true, "rotated", "grace-retry", "t2", "unknown", "rotated", "t3"], "note": "a retry mints nothing, and forgets its new id"},
    {"id": "h6", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t1", "x1", 1025], ["t1", "x2", 1029], ["t1", "x3", 1030]], "expected": [null, true, "rotated", "grace-retry", "grace-retry", "reuse-detected"], "note": "retries do not reopen the window"},
    {"id": "h7", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate"], "args": [[100, 10], ["f", "t1", 0], ["t1", "t2", 50], ["t1", "x1", 5000], ["t2", "x2", 5001]], "expected": [null, true, "rotated", "reuse-detected", "revoked"], "note": "a spent token long past its expiry is reuse, not expired"},
    {"id": "h8", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "activeToken"], "args": [[100, 10], ["f", "t1", 0], ["t1", "t2", 100], ["t1", "t3", 200], ["t2", "t4", 201], ["f", 201]], "expected": [null, true, "expired", "expired", "unknown", ""], "note": "expiry never revokes, and an expired rotation issues nothing"},
    {"id": "h9", "ops": ["RefreshTokenStore", "issue", "rotate", "activeToken", "rotate", "activeToken", "activeToken"], "args": [[100, 10], ["f", "t1", 0], ["t1", "t2", 90], ["f", 189], ["t2", "t3", 189], ["f", 288], ["f", 289]], "expected": [null, true, "rotated", "t2", "rotated", "t3", ""], "note": "each token lives ttl from its own issue"},
    {"id": "h10", "ops": ["RefreshTokenStore", "issue", "issue", "rotate", "rotate", "rotate", "rotate", "activeToken", "activeToken"], "args": [[3600, 30], ["f1", "a1", 0], ["f2", "b1", 0], ["a1", "a2", 1000], ["b1", "b2", 1000], ["a1", "x1", 2000], ["b2", "b3", 2001], ["f2", 2001], ["f1", 2001]], "expected": [null, true, true, "rotated", "rotated", "reuse-detected", "rotated", "b3", ""], "note": "revocation stays in its family"},
    {"id": "h11", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 100], ["t2", "t3", 200], ["t1", "x1", 300], ["t1", "x2", 301], ["t2", "x3", 302], ["t3", "x4", 303]], "expected": [null, true, "rotated", "rotated", "reuse-detected", "revoked", "revoked", "revoked"], "note": "after the alarm every token reports revoked, even the one that tripped it"},
    {"id": "h12", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["nobody", "x1", 1], ["x1", "x2", 2], ["t1", "t2", 100], ["t1", "x3", 500], ["x3", "x4", 501]], "expected": [null, true, "unknown", "unknown", "rotated", "reuse-detected", "unknown"], "note": "only a rotated result issues the new id"},
    {"id": "h13", "ops": ["RefreshTokenStore", "issue", "issue", "issue", "rotate", "issue", "issue", "rotate", "issue", "activeToken"], "args": [[3600, 30], ["f", "t1", 0], ["f", "t9", 1], ["g", "t1", 2], ["t1", "t2", 3], ["g", "t2", 4], ["g", "t8", 5], ["t1", "x1", 500], ["f", "t7", 501], ["f", 501]], "expected": [null, true, false, false, "rotated", false, true, "reuse-detected", false, ""], "note": "issue refuses known families and tokens, spent and revoked ones too"},
    {"id": "h14", "ops": ["RefreshTokenStore", "activeToken", "rotate", "issue", "activeToken", "activeToken"], "args": [[3600, 30], ["nobody", 0], ["nobody", "x", 0], ["f", "t1", 0], ["f", 0], ["g", 0]], "expected": [null, "", "unknown", true, "t1", ""], "note": "unknown family and token"},
    {"id": "h15", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "activeToken", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 1000], ["t1", "x1", 1000], ["t1", "x2", 1000], ["f", 1000], ["t2", "t3", 1000], ["t1", "x3", 1000]], "expected": [null, true, "rotated", "grace-retry", "grace-retry", "t2", "rotated", "reuse-detected"], "note": "calls with the same now take effect in call order"},
    {"id": "h16", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "rotate", "rotate", "rotate", "rotate", "rotate", "rotate"], "args": [[3600, 30], ["f", "t1", 0], ["t1", "t2", 100], ["t2", "t3", 200], ["t3", "t4", 300], ["t4", "t5", 400], ["t5", "t6", 500], ["t6", "t7", 600], ["t2", "x1", 700], ["t7", "x2", 701]], "expected": [null, true, "rotated", "rotated", "rotated", "rotated", "rotated", "rotated", "reuse-detected", "revoked"], "note": "a long chain; the middle of it trips the alarm"},
    {"id": "h17", "ops": ["RefreshTokenStore", "issue", "activeToken", "rotate", "activeToken", "issue", "activeToken"], "args": [[3600, 30], ["same", "same", 0], ["same", 0], ["same", "other", 1], ["same", 1], ["other", "fresh", 2], ["other", 2]], "expected": [null, true, "same", "rotated", "other", true, "fresh"], "note": "family ids and token ids are different namespaces"},
    {"id": "h18", "ops": ["RefreshTokenStore", "issue", "rotate", "activeToken", "rotate", "activeToken"], "args": [[100, 10], ["f", "t1", 0], ["t1", "t2", 99], ["f", 198], ["t2", "t3", 199], ["f", 199]], "expected": [null, true, "rotated", "t2", "expired", ""], "note": "one second before expiry works; the exact second does not"},
    {"id": "h19", "ops": ["RefreshTokenStore", "issue", "rotate", "rotate", "activeToken", "activeToken", "rotate", "rotate", "rotate"], "args": [[10, 10], ["f", "t1", 0], ["t1", "t2", 5], ["t1", "x1", 14], ["f", 14], ["f", 15], ["t2", "t3", 15], ["t1", "x2", 15], ["t2", "t3", 16]], "expected": [null, true, "rotated", "grace-retry", "t2", "", "expired", "reuse-detected", "revoked"], "note": "grace as long as the ttl: the window ends with the successor's life; reuse still beats expiry for the spent token"}
  ]
}
