{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"edges": [[1, 2], [2, 3], [3, 4], [1, 4], [1, 5]]}, "expected": [1, 4]},
    {"id": "ex2", "visible": true, "input": {"edges": [[2, 1], [3, 1], [2, 3]]}, "expected": [2, 3]},
    {"id": "h1", "input": {"edges": [[1, 2], [2, 3], [1, 3]]}, "expected": [1, 3], "note": "a triangle: the last edge closes it"},
    {"id": "h2", "input": {"edges": [[1, 3], [2, 3], [1, 2]]}, "expected": [1, 2], "note": "the same triangle listed in another order"},
    {"id": "h3", "input": {"edges": [[3, 1], [1, 2], [2, 3]]}, "expected": [2, 3], "note": "the answer keeps its listed orientation"},
    {"id": "h4", "input": {"edges": [[1, 2], [2, 3], [3, 1], [3, 4], [4, 5], [5, 6]]}, "expected": [3, 1], "note": "a cycle closed early, followed by a tail"},
    {"id": "h5", "input": {"edges": [[4, 5], [5, 6], [1, 2], [2, 3], [3, 4], [6, 1]]}, "expected": [6, 1], "note": "a cycle through every node, closed by the last edge"},
    {"id": "h6", "input": {"edges": [[1, 2], [1, 3], [1, 4], [1, 5], [3, 5]]}, "expected": [3, 5], "note": "a star plus an edge between two leaves"},
    {"id": "h7", "input": {"edges": [[5, 4], [4, 3], [3, 2], [2, 1], [1, 5]]}, "expected": [1, 5], "note": "a path listed backwards, closed into a ring"},
    {"id": "h8", "input": {"edges": [[1, 2], [3, 4], [5, 6], [2, 3], [4, 5], [6, 7], [7, 8], [8, 3]]}, "expected": [8, 3], "note": "pairs joined into a chain; the cycle is 3, 4, 5, 6, 7, 8"},
    {"id": "h9", "input": {"edges": [[2, 4], [4, 1], [1, 3], [3, 4]]}, "expected": [3, 4], "note": "a triangle hanging off a path"},
    {"id": "h10", "input": {"edges": [[7, 1], [1, 6], [6, 2], [2, 5], [5, 3], [3, 4], [4, 7]]}, "expected": [4, 7], "note": "a seven-node ring with mixed labels"},
    {"id": "g1", "generate": {"n": 1000, "seed": 122}, "note": "a random tree with a large star at the largest size"}
  ]
}
