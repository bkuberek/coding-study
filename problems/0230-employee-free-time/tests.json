{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"schedule": [[[2, 4], [9, 11]], [[3, 6]], [[12, 15]]]}, "expected": [[6, 9], [11, 12]]},
    {"id": "ex2", "visible": true, "input": {"schedule": [[[1, 5]], [[5, 8]], [[8, 10]]]}, "expected": []},
    {"id": "h1", "input": {"schedule": [[[3, 7]]]}, "expected": [], "note": "one employee, one interval"},
    {"id": "h2", "input": {"schedule": [[[1, 2], [4, 5], [8, 9]]]}, "expected": [[2, 4], [5, 8]], "note": "one employee with gaps"},
    {"id": "h3", "input": {"schedule": [[[0, 100000000]], [[50, 60]]]}, "expected": [], "note": "one interval covers the whole range"},
    {"id": "h4", "input": {"schedule": [[[1, 3], [10, 12]], [[1, 3], [10, 12]]]}, "expected": [[3, 10]], "note": "identical schedules"},
    {"id": "h5", "input": {"schedule": [[[5, 6]], [[1, 2]], [[9, 10]]]}, "expected": [[2, 5], [6, 9]], "note": "employees listed out of time order"},
    {"id": "h6", "input": {"schedule": [[[1, 10]], [[2, 3], [4, 5], [6, 7]]]}, "expected": [], "note": "one employee's gaps are covered by another"},
    {"id": "h7", "input": {"schedule": [[[0, 1], [100, 101]], [[50, 51]]]}, "expected": [[1, 50], [51, 100]], "note": "a short interval splits a long gap"},
    {"id": "h8", "input": {"schedule": [[[1, 4], [6, 8]], [[3, 7]], [[10, 11], [13, 15]], [[11, 12]]]}, "expected": [[8, 10], [12, 13]], "note": "overlaps and touches across employees"},
    {"id": "h9", "input": {"schedule": [[[0, 2]], [[2, 4]], [[5, 7]], [[7, 9]]]}, "expected": [[4, 5]], "note": "two touching chains with one gap"},
    {"id": "h10", "input": {"schedule": [[[10, 20], [30, 40]], [[15, 35]]]}, "expected": [], "note": "a gap bridged by another employee"},
    {"id": "h11", "input": {"schedule": [[[99999998, 99999999]], [[0, 1]]]}, "expected": [[1, 99999998]], "note": "extreme times"},
    {"id": "g1", "generate": {"n": 4000, "seed": 230}, "note": "large input: 4000 intervals over 400 employees"}
  ]
}
