{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"numbers": [-4, 1, 3, 5, 9], "target": 8}, "expected": [2, 3]},
    {"id": "ex2", "visible": true, "input": {"numbers": [2, 2, 7], "target": 4}, "expected": [0, 1]},
    {"id": "h1", "input": {"numbers": [-7, 2], "target": -5}, "expected": [0, 1], "note": "minimum length"},
    {"id": "h2", "input": {"numbers": [0, 0, 3, 4], "target": 0}, "expected": [0, 1], "note": "two zeros at the front"},
    {"id": "h3", "input": {"numbers": [1, 2, 3, 4, 4, 9, 56, 90], "target": 8}, "expected": [3, 4], "note": "equal values form the pair"},
    {"id": "h4", "input": {"numbers": [-1000000000, 1000000000], "target": 0}, "expected": [0, 1], "note": "extreme values"},
    {"id": "h5", "input": {"numbers": [-5, -4, -3, -2, -1], "target": -9}, "expected": [0, 1], "note": "all negative, pair at the front"},
    {"id": "h6", "input": {"numbers": [-5, -4, -3, -2, -1], "target": -3}, "expected": [3, 4], "note": "all negative, pair at the back"},
    {"id": "h7", "input": {"numbers": [-3, -1, 0, 2, 7], "target": 7}, "expected": [2, 4], "note": "zero is part of the pair"},
    {"id": "h8", "input": {"numbers": [1, 1, 1, 1, 4, 6], "target": 10}, "expected": [4, 5], "note": "repeated values that are not part of the answer"},
    {"id": "h9", "input": {"numbers": [3, 24, 50, 79, 88, 150, 345], "target": 200}, "expected": [2, 5], "note": "the pair is in the middle"},
    {"id": "h10", "input": {"numbers": [10, 20, 30, 40, 50], "target": 30}, "expected": [0, 1], "note": "the pair is the first two elements"},
    {"id": "h11", "input": {"numbers": [-8, -6, 1, 7, 12], "target": 4}, "expected": [0, 4], "note": "a negative and a positive value"},
    {"id": "h12", "input": {"numbers": [-999999999, 1, 999999999], "target": 1000000000}, "expected": [1, 2], "note": "large magnitudes near the limits"},
    {"id": "h13", "input": {"numbers": [5, 6, 6, 6, 6, 6, 25], "target": 30}, "expected": [0, 6], "note": "a long run of a decoy value"},
    {"id": "h14", "input": {"numbers": [-10, -5, 0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 61], "target": 51}, "expected": [0, 14], "note": "an even spread; the pair is the two ends"},
    {"id": "g1", "generate": {"n": 100000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: checking every pair does about 5 * 10^8 checks here"}
  ]
}
