{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "note": "three writes and an audit entry: 350 ms, and the count is real", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "auditLog", "state"], "args": [[], [["a", "b", "c"]], [], [], [], []], "expected": [null, 3, 350, ["a", "b", "c"], ["imported 3 of 3"], "finished"]},
    {"id": "ex2", "visible": true, "level": 1, "note": "still running at 150 ms, with one write done", "ops": ["BatchImporter", "@spawn", "state", "@advance", "savedSkus", "state", "@join", "@now", "state"], "args": [[], ["r1", "importAll", ["a", "b"]], [], [150], [], [], ["r1"], [], []], "expected": [null, null, "running", null, ["a"], "running", 2, 250, "finished"]},
    {"id": "h1", "level": 1, "note": "before any batch, the importer is idle and empty", "ops": ["BatchImporter", "state", "savedSkus", "auditLog"], "args": [[], [], [], []], "expected": [null, "idle", [], []]},
    {"id": "h2", "level": 1, "note": "one write at a time, in order: at 250 ms two are done, not all three", "ops": ["BatchImporter", "@spawn", "@advance", "savedSkus", "auditLog", "@join", "@now"], "args": [[], ["r1", "importAll", ["a", "b", "c"]], [250], [], [], ["r1"], []], "expected": [null, null, null, ["a", "b"], [], 3, 350]},
    {"id": "h3", "level": 1, "note": "the audit entry comes after the writes and is waited for; finished comes after it", "ops": ["BatchImporter", "@spawn", "@advance", "savedSkus", "auditLog", "state", "@advance", "auditLog", "state", "@advance", "auditLog", "state", "@join", "@now"], "args": [[], ["r1", "importAll", ["a", "b"]], [200], [], [], [], [49], [], [], [1], [], [], ["r1"], []], "expected": [null, null, null, ["a", "b"], [], "running", null, [], "running", null, ["imported 2 of 2"], "finished", 2, 250]},
    {"id": "h4", "level": 1, "note": "an empty batch has no writes, and still its audit entry", "ops": ["BatchImporter", "importAll", "@now", "auditLog", "state"], "args": [[], [[]], [], [], []], "expected": [null, 0, 50, ["imported 0 of 0"], "finished"]},
    {"id": "h5", "level": 1, "note": "a batch of one", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "auditLog"], "args": [[], [["only"]], [], [], []], "expected": [null, 1, 150, ["only"], ["imported 1 of 1"]]},
    {"id": "h6", "level": 1, "note": "batches one after another add up", "ops": ["BatchImporter", "importAll", "@now", "importAll", "@now", "savedSkus", "auditLog", "state"], "args": [[], [["a"]], [], [["b", "c"]], [], [], [], []], "expected": [null, 1, 150, 2, 400, ["a", "b", "c"], ["imported 1 of 1", "imported 2 of 2"], "finished"]},
    {"id": "h7", "level": 1, "note": "the state is running again for a new batch", "ops": ["BatchImporter", "importAll", "state", "@spawn", "state", "@join", "state"], "args": [[], [["a"]], [], ["r1", "importAll", ["b"]], [], ["r1"], []], "expected": [null, 1, "finished", null, "running", 1, "finished"]},
    {"id": "ex3", "visible": true, "level": 2, "note": "a rejected row is skipped, and takes its time", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "failedSkus", "auditLog", "state"], "args": [[], [["a", "bad-1", "c"]], [], [], [], [], []], "expected": [null, 2, 350, ["a", "c"], ["bad-1"], ["imported 2 of 3"], "finished"]},
    {"id": "ex4", "visible": true, "level": 2, "note": "a second call while one is running answers -1 at once and changes nothing", "ops": ["BatchImporter", "@spawn", "@spawn", "@join", "@now", "state", "@join", "@now", "savedSkus", "auditLog"], "args": [[], ["r1", "importAll", ["a", "b"]], ["r2", "importAll", ["c"]], ["r2"], [], [], ["r1"], [], [], []], "expected": [null, null, null, -1, 0, "running", 2, 250, ["a", "b"], ["imported 2 of 2"]]},
    {"id": "h8", "level": 2, "note": "every row rejected: nothing saved, and the batch still finishes", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "failedSkus", "auditLog", "state"], "args": [[], [["bad-1", "bad-2"]], [], [], [], [], []], "expected": [null, 0, 250, [], ["bad-1", "bad-2"], ["imported 0 of 2"], "finished"]},
    {"id": "h9", "level": 2, "note": "the first row rejected: the rest still go in", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "failedSkus"], "args": [[], [["bad-1", "b", "c"]], [], [], []], "expected": [null, 2, 350, ["b", "c"], ["bad-1"]]},
    {"id": "h10", "level": 2, "note": "the last row rejected", "ops": ["BatchImporter", "importAll", "@now", "savedSkus", "failedSkus", "auditLog"], "args": [[], [["a", "bad-1"]], [], [], [], []], "expected": [null, 1, 250, ["a"], ["bad-1"], ["imported 1 of 2"]]},
    {"id": "h11", "level": 2, "note": "failed rows add up across batches, in order; none is reported when none failed", "ops": ["BatchImporter", "importAll", "failedSkus", "importAll", "importAll", "failedSkus", "savedSkus"], "args": [[], [["a"]], [], [["bad-1", "b"]], [["bad-2"]], [], []], "expected": [null, 1, [], 1, 0, ["bad-1", "bad-2"], ["a", "b"]]},
    {"id": "h12", "level": 2, "note": "a finished batch frees the importer, also after failures", "ops": ["BatchImporter", "importAll", "importAll", "@now", "savedSkus", "state"], "args": [[], [["bad-1"]], [["a"]], [], [], []], "expected": [null, 0, 1, 300, ["a"], "finished"]},
    {"id": "h13", "level": 2, "note": "a refused call during a later batch, and a new batch after it", "ops": ["BatchImporter", "importAll", "@spawn", "@advance", "importAll", "state", "@join", "@now", "auditLog", "importAll", "savedSkus"], "args": [[], [["a"]], ["r1", "importAll", ["bad-1", "b"]], [50], [["c"]], [], ["r1"], [], [], [["d"]], []], "expected": [null, 1, null, null, -1, "running", 1, 400, ["imported 1 of 1", "imported 1 of 2"], 1, ["a", "b", "d"]]},
    {"id": "h14", "level": 2, "note": "a refused call writes no audit entry", "ops": ["BatchImporter", "@spawn", "importAll", "importAll", "@join", "auditLog", "@now"], "args": [[], ["r1", "importAll", ["a"]], [["b"]], [[]], ["r1"], [], []], "expected": [null, null, -1, -1, 1, ["imported 1 of 1"], 150]}
  ]
}
