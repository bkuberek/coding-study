  {"id": "h27", "level": 4, "note": "an attempt that would pass the limit is not started: spending exactly the limit is fine, and the cost is checked before the steps", "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report", "setBudget", "run", "report", "setBudget", "run", "report", "setBudget", "run", "report", "setBudget", "run", "report", "setPlan", "setBudget", "run", "report"], "args": [[], [[["a", "1", "5", "S", ""], ["b", "1", "5", "S", ""], ["c", "1", "5", "S", ""]]], [10, -1], [3, 0], [], [15, -1], [3, 0], [], [9, 2], [3, 0], [], [10, 1], [3, 0], [], [9, 1], [3, 0], [], [[["a", "1", "1", "", ""], ["b", "1", "5", "", ""], ["c", "1", "1", "", ""]]], [3, -1], [3, 0], []], "expected": [null, [], null, [["a", "done", "1", "0", "1"], ["b", "done", "1", "0", "1"], ["c", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "10", "2", "1"], ["done", "a", "b"], ["failed"], ["blocked"], ["skipped", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a=", "b="]], null, [["a", "done", "1", "0", "1"], ["b", "done", "1", "0", "1"], ["c", "done", "1", "0", "1"]], [["stopped", "none"], ["spent", "15", "3", "1"], ["done", "a", "b", "c"], ["failed"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "a=", "b=", "c="]], null, [["a", "done", "1", "0", "1"], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "5", "1", "1"], ["done", "a"], ["failed"], ["blocked"], ["skipped", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a="]], null, [["a", "done", "1", "0", "1"], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "steps"], ["spent", "5", "1", "1"], ["done", "a"], ["failed"], ["blocked"], ["skipped", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a="]], null, [["a", "done", "1", "0", "1"], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "5", "1", "1"], ["done", "a"], ["failed"], ["blocked"], ["skipped", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a="]], [], null, [["a", "done", "1", "0", "1"], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "1", "1", "1"], ["done", "a"], ["failed"], ["blocked"], ["skipped", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a="]]]},
  {"id": "h28", "level": 4, "note": "attempts are charged in rounds: first attempts of the wave by id, then second attempts, and the first refusal stops everything", "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report", "setBudget", "run", "report", "setBudget", "run", "report"], "args": [[], [[["a", "2", "1", "FS", ""], ["b", "1", "1", "S", ""], ["c", "1", "1", "FS", ""]]], [-1, 3], [3, 1], [], [-1, 4], [3, 1], [], [-1, 5], [3, 1], []], "expected": [null, [], null, [["a", "failed", "1", "0", "2"], ["b", "done", "1", "0", "1"], ["c", "failed", "1", "0", "1"]], [["stopped", "steps"], ["spent", "3", "3", "2"], ["done", "b"], ["failed", "a", "c"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "b="]], null, [["a", "done", "2", "0", "4"], ["b", "done", "1", "0", "1"], ["c", "failed", "1", "0", "1"]], [["stopped", "steps"], ["spent", "4", "4", "4"], ["done", "a", "b"], ["failed", "c"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "a=", "b="]], null, [["a", "done", "2", "0", "4"], ["b", "done", "1", "0", "1"], ["c", "done", "2", "0", "2"]], [["stopped", "none"], ["spent", "5", "5", "4"], ["done", "a", "b", "c"], ["failed"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "a=", "b=", "c="]]]},
  {"id": "h29", "level": 4, "note": "tasks that never ran are blocked when something they wait for failed or was blocked, and skipped otherwise", "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report", "setBudget", "run", "report"], "args": [[], [[["a", "1", "1", "F", ""], ["b", "1", "1", "S", "", "a"], ["c", "1", "1", "S", ""], ["d", "1", "1", "S", "", "c"], ["e", "1", "1", "S", "", "d", "b"], ["f", "1", "1", "S", "", "c"]]], [-1, 3], [3, 0], [], [-1, 2], [3, 0], []], "expected": [null, [], null, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"], ["d", "done", "1", "1", "2"], ["e", "blocked", "0", "", ""], ["f", "skipped", "0", "", ""]], [["stopped", "steps"], ["spent", "3", "3", "2"], ["done", "c", "d"], ["failed", "a"], ["blocked", "b", "e"], ["skipped", "f"], ["replaced"], ["replans", "0", "0"], ["results", "c=", "d="]], null, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"], ["d", "skipped", "0", "", ""], ["e", "blocked", "0", "", ""], ["f", "skipped", "0", "", ""]], [["stopped", "steps"], ["spent", "2", "2", "1"], ["done", "c"], ["failed", "a"], ["blocked", "b", "e"], ["skipped", "d", "f"], ["replaced"], ["replans", "0", "0"], ["results", "c="]]]},
  {"id": "h30", "level": 4, "note": "a limit of zero steps starts nothing, and a limit of zero cost still lets free tasks run", "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report", "setBudget", "run", "report", "setBudget", "run", "report"], "args": [[], [[["a", "1", "0", "S", ""], ["b", "1", "1", "S", ""], ["c", "1", "0", "S", "", "a"]]], [-1, 0], [2, 0], [], [0, -1], [2, 0], [], [-1, -1], [2, 0], []], "expected": [null, [], null, [["a", "skipped", "0", "", ""], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "steps"], ["spent", "0", "0", "0"], ["done"], ["failed"], ["blocked"], ["skipped", "a", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results"]], null, [["a", "done", "1", "0", "1"], ["b", "skipped", "0", "", ""], ["c", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "0", "1", "1"], ["done", "a"], ["failed"], ["blocked"], ["skipped", "b", "c"], ["replaced"], ["replans", "0", "0"], ["results", "a="]], null, [["a", "done", "1", "0", "1"], ["b", "done", "1", "0", "1"], ["c", "done", "1", "1", "2"]], [["stopped", "none"], ["spent", "1", "3", "2"], ["done", "a", "b", "c"], ["failed"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "a=", "b=", "c="]]]},
  {"id": "h31", "level": 4, "note": "a replan happens before a later stop; after a stop there are no replans, and the report counts applied and rejected replans", "ops": ["PlanRunner", "setPlan", "setReplan", "setReplan", "setBudget", "run", "report", "replanLog", "setBudget", "run", "report", "replanLog", "run", "report", "replanLog"], "args": [[], [[["a", "1", "1", "F", ""], ["b", "1", "1", "S", "", "a"], ["c", "1", "1", "S", ""], ["d", "1", "1", "F", "", "c"]]], ["a", [["a2", "1", "1", "S", "", "c"]]], ["d", [["d2", "1", "1", "S", ""]]], [-1, -1], [2, 0], [], [], [-1, 2], [2, 0], [], [], [2, 1], [], []], "expected": [null, [], true, true, null, [["a", "failed", "1", "0", "1"], ["a2", "done", "1", "1", "2"], ["b", "replaced", "0", "", ""], ["c", "done", "1", "0", "1"], ["d", "replaced", "0", "", ""]], [["stopped", "none"], ["spent", "3", "3", "2"], ["done", "a2", "c"], ["failed", "a"], ["blocked"], ["skipped"], ["replaced", "b", "d"], ["replans", "1", "0"], ["results", "a2=", "c="]], [["1", "a", "applied", "removed 2, added 1"]], null, [["a", "failed", "1", "0", "1"], ["a2", "skipped", "0", "", ""], ["b", "replaced", "0", "", ""], ["c", "done", "1", "0", "1"], ["d", "replaced", "0", "", ""]], [["stopped", "steps"], ["spent", "2", "2", "1"], ["done", "c"], ["failed", "a"], ["blocked"], ["skipped", "a2"], ["replaced", "b", "d"], ["replans", "1", "0"], ["results", "c="]], [["1", "a", "applied", "removed 2, added 1"]], [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"], ["d", "skipped", "0", "", ""]], [["stopped", "steps"], ["spent", "2", "2", "1"], ["done", "c"], ["failed", "a"], ["blocked", "b"], ["skipped", "d"], ["replaced"], ["replans", "0", "0"], ["results", "c="]], []]},
