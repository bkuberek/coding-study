  {"id": "ex5", "visible": true, "level": 3, "ops": ["PlanRunner", "setPlan", "run", "run", "run"], "args": [[], [[["a", "2", "1", "FFS", "A"], ["b", "1", "1", "S", "B", "a"], ["c", "1", "1", "S", "C"]]], [2, 2], [2, 1], [2, 0]], "expected": [null, [], [["a", "done", "3", "0", "6"], ["b", "done", "1", "6", "7"], ["c", "done", "1", "0", "1"]], [["a", "failed", "2", "0", "4"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"]], [["a", "failed", "1", "0", "2"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"]]]},
  {"id": "ex6", "visible": true, "level": 3, "ops": ["PlanRunner", "setPlan", "setReplan", "run", "replanLog"], "args": [[], [[["r", "1", "1", "S", "R"], ["a", "2", "1", "F", "A", "r"], ["b", "1", "1", "S", "B", "a"], ["c", "1", "1", "S", "C", "r"]]], ["a", [["x", "1", "1", "S", "X", "r"], ["y", "1", "1", "S", "Y", "x", "c"]]], [2, 0], []], "expected": [null, [], true, [["a", "failed", "1", "1", "3"], ["b", "replaced", "0", "", ""], ["c", "done", "1", "1", "2"], ["r", "done", "1", "0", "1"], ["x", "done", "1", "3", "4"], ["y", "done", "1", "4", "5"]], [["2", "a", "applied", "removed 1, added 2"]]]},
  {"id": "h16", "level": 3, "note": "a script gives the result of each attempt, the last letter repeats, and an empty script succeeds", "ops": ["PlanRunner", "setPlan", "run", "run", "run"], "args": [[], [[["a", "2", "0", "", ""], ["b", "2", "0", "S", ""], ["c", "2", "0", "F", ""], ["d", "2", "0", "FS", ""], ["e", "2", "0", "SF", ""], ["f", "3", "0", "FFS", ""]]], [6, 0], [6, 1], [6, 3]], "expected": [null, [], [["a", "done", "1", "0", "2"], ["b", "done", "1", "0", "2"], ["c", "failed", "1", "0", "2"], ["d", "failed", "1", "0", "2"], ["e", "done", "1", "0", "2"], ["f", "failed", "1", "0", "3"]], [["a", "done", "1", "0", "2"], ["b", "done", "1", "0", "2"], ["c", "failed", "2", "0", "4"], ["d", "done", "2", "0", "4"], ["e", "done", "1", "0", "2"], ["f", "failed", "2", "0", "6"]], [["a", "done", "1", "0", "2"], ["b", "done", "1", "0", "2"], ["c", "failed", "4", "0", "8"], ["d", "done", "2", "0", "4"], ["e", "done", "1", "0", "2"], ["f", "done", "3", "0", "9"]]]},
  {"id": "h17", "level": 3, "note": "a task that fails for good blocks everything that waits for it, however far, and independent tasks go on", "ops": ["PlanRunner", "setPlan", "run", "run"], "args": [[], [[["a", "1", "0", "F", ""], ["b", "1", "0", "S", "", "a"], ["c", "1", "0", "S", "", "b"], ["d", "1", "0", "S", ""], ["e", "1", "0", "S", "", "d", "a"], ["f", "1", "0", "S", "", "d"]]], [3, 0], [1, 0]], "expected": [null, [], [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""], ["c", "blocked", "0", "", ""], ["d", "done", "1", "0", "1"], ["e", "blocked", "0", "", ""], ["f", "done", "1", "1", "2"]], [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""], ["c", "blocked", "0", "", ""], ["d", "done", "1", "1", "2"], ["e", "blocked", "0", "", ""], ["f", "done", "1", "2", "3"]]]},
