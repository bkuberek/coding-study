  {"id": "h1", "level": 1, "note": "a row that is too short, or has a bad id, duration, cost or script, is malformed; all are listed in row order and nothing else is looked at", "ops": ["PlanRunner", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan"], "args": [[], [[["a", "1", "0", "S"]]], [[["a", "1", "0", "S", "x"], ["B", "1", "0", "S", "x"]]], [[["a", "0", "0", "", ""]]], [[["a", "1001", "0", "", ""]]], [[["a", "x", "0", "", ""]]], [[["a", "1", "-1", "", ""]]], [[["a", "1", "10000", "", ""]]], [[["a", "1", "1001", "", ""]]], [[["a", "1", "0", "s", ""]]], [[["a", "1", "0", "SX", ""]]], [[["a", "1", "0", "", ""], ["a", "1", "0", "", ""], ["b", "1", "0"]]], [[[""]]], [[["", "1", "0", "", ""]]]], "expected": [null, [["malformed-task", "0"]], [["malformed-task", "1"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "2"]], [["malformed-task", "0"]], [["malformed-task", "0"]]]},
  {"id": "h2", "level": 1, "note": "the limits of the fields: 1 to 1000 for a duration, 0 to 1000 for a cost, digits only, up to four of them, and ids of 1 to 20 of a-z, 0-9 and _", "ops": ["PlanRunner", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "order"], "args": [[], [[["a", "1000", "1000", "", ""]]], [[["a", "0001", "0000", "FS", "any text , = ;"]]], [[["a-b", "1", "0", "", ""]]], [[["aaaaaaaaaaaaaaaaaaaa", "1", "0", "", ""]]], [[["aaaaaaaaaaaaaaaaaaaaa", "1", "0", "", ""]]], [[["a b", "1", "0", "", ""]]], [[["a", "+1", "0", "", ""]]], [[["a", "00001", "0", "", ""]]], [[["a", "1", "00000", "", ""]]], [[["a", "1.5", "0", "", ""]]], [[["a", "１", "0", "", ""]]], [[["a", " 1", "0", "", ""]]], [[["_1", "1", "0", "", ""]]], []], "expected": [null, [], [], [["malformed-task", "0"]], [], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [["malformed-task", "0"]], [], ["_1"]]},
  {"id": "h3", "level": 1, "note": "a duplicate id is listed once, in sorted order, and hides the checks after it", "ops": ["PlanRunner", "setPlan", "setPlan", "setPlan", "setPlan"], "args": [[], [[["a", "1", "0", "", ""], ["b", "1", "0", "", ""], ["a", "1", "0", "", ""]]], [[["b", "1", "0", "", ""], ["a", "1", "0", "", ""], ["b", "1", "0", "", ""], ["a", "1", "0", "", ""], ["b", "1", "0", "", ""]]], [[["a", "1", "0", "", "", "ghost"], ["a", "1", "0", "", ""]]], [[["a", "1", "0", "", ""], ["a", "1", "0", "", ""], ["c", "1", "0"]]]], "expected": [null, [["duplicate-id", "a"]], [["duplicate-id", "a"], ["duplicate-id", "b"]], [["duplicate-id", "a"]], [["malformed-task", "2"]]]},
  {"id": "h4", "level": 1, "note": "an unknown dependency is written task>dep, once, and the rows are sorted", "ops": ["PlanRunner", "setPlan", "setPlan", "setPlan", "setPlan"], "args": [[], [[["a", "1", "0", "", "", "z", "y"], ["b", "1", "0", "", "", "a", "z"]]], [[["a", "1", "0", "", "", "ghost", "ghost"]]], [[["b", "1", "0", "", "", "q"], ["a", "1", "0", "", "", "q"]]], [[["a", "1", "0", "", "", "A"]]]], "expected": [null, [["unknown-dependency", "a>y"], ["unknown-dependency", "a>z"], ["unknown-dependency", "b>z"]], [["unknown-dependency", "a>ghost"]], [["unknown-dependency", "a>q"], ["unknown-dependency", "b>q"]], [["unknown-dependency", "a>A"]]]},
  {"id": "h5", "level": 1, "note": "a cycle is reported once per group of tasks that wait for each other, with the ids sorted, and a task that only waits for a cycle is not in it", "ops": ["PlanRunner", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan", "setPlan"], "args": [[], [[["a", "1", "0", "", "", "a"]]], [[["a", "1", "0", "", "", "b"], ["b", "1", "0", "", "", "a"]]], [[["c", "1", "0", "", "", "b"], ["b", "1", "0", "", "", "a"], ["a", "1", "0", "", "", "c"]]], [[["a", "1", "0", "", "", "b"], ["b", "1", "0", "", "", "a"], ["x", "1", "0", "", "", "y"], ["y", "1", "0", "", "", "x"]]], [[["a", "1", "0", "", "", "b"], ["b", "1", "0", "", "", "a"], ["tail", "1", "0", "", "", "a"], ["root", "1", "0", "", ""]]], [[["a", "1", "0", "", "", "b", "c"], ["b", "1", "0", "", "", "a"], ["c", "1", "0", "", "", "a"]]], [[["a", "1", "0", "", "", "b"], ["b", "1", "0", "", "", "a", "zz"]]]], "expected": [null, [["cycle", "a"]], [["cycle", "a,b"]], [["cycle", "a,b,c"]], [["cycle", "a,b"], ["cycle", "x,y"]], [["cycle", "a,b"]], [["cycle", "a,b,c"]], [["cycle", "a,b"], ["unknown-dependency", "b>zz"]]]},
  {"id": "h6", "level": 1, "note": "the order takes the smallest id among the tasks that are ready, which is not the same as sorting the ids", "ops": ["PlanRunner", "setPlan", "order", "setPlan", "order", "setPlan", "order"], "args": [[], [[["z", "1", "0", "", ""], ["m", "1", "0", "", ""], ["a", "1", "0", "", "", "m"]]], [], [[["b", "1", "0", "", ""], ["a", "1", "0", "", ""], ["9", "1", "0", "", ""], ["10", "1", "0", "", ""], ["_x", "1", "0", "", ""]]], [], [[["c", "1", "0", "", "", "a", "b"], ["b", "1", "0", "", ""], ["a", "1", "0", "", ""], ["d", "1", "0", "", "", "c"], ["0", "1", "0", "", ""]]], []], "expected": [null, [], ["m", "a", "z"], [], ["10", "9", "_x", "a", "b"], [], ["0", "a", "b", "c", "d"]]},
  {"id": "h7", "level": 1, "note": "a plan that fails leaves the one before it in place, a good one replaces it, and an empty plan is a plan", "ops": ["PlanRunner", "order", "setPlan", "setPlan", "order", "setPlan", "order", "setPlan", "order", "setPlan", "order"], "args": [[], [], [[["a", "1", "0", "", ""], ["b", "1", "0", "", "", "a"]]], [[["x", "1", "0", "", "", "x"]]], [], [[["q", "1", "0", "", ""]]], [], [[]], [], [[["bad"]]], []], "expected": [null, [], [], [["cycle", "x"]], ["a", "b"], [], ["q"], [], [], [["malformed-task", "0"]], []]},
  {"id": "ex3", "visible": true, "level": 2, "ops": ["PlanRunner", "setPlan", "timeline", "timeline", "makespan", "makespan", "makespan"], "args": [[], [[["d", "2", "3", "S", "D", "c", "b"], ["c", "1", "1", "S", "C", "a"], ["b", "3", "2", "S", "B", "a"], ["a", "2", "1", "S", "A"]]], [2], [1], [2], [1], [9]], "expected": [null, [], [["1", "a", "0", "2"], ["2", "b", "2", "5"], ["2", "c", "2", "3"], ["3", "d", "5", "7"]], [["1", "a", "0", "2"], ["2", "b", "2", "5"], ["3", "c", "5", "6"], ["4", "d", "6", "8"]], 7, 8, 7]},
  {"id": "ex4", "visible": true, "level": 2, "ops": ["PlanRunner", "setPlan", "criticalPath", "makespan", "makespan"], "args": [[], [[["a", "2", "0", "", ""], ["b", "4", "0", "", "", "a"], ["c", "1", "0", "", "", "a"], ["d", "5", "0", "", "", "c"], ["e", "1", "0", "", "", "b", "d"]]], [], [5], [1]], "expected": [null, [], ["a", "c", "d", "e"], 12, 13]},
  {"id": "h8", "level": 2, "note": "a wave takes at most cap of the ready tasks, by id; the rest wait and join the next ones", "ops": ["PlanRunner", "setPlan", "timeline", "timeline", "makespan"], "args": [[], [[["a", "2", "0", "", ""], ["b", "1", "0", "", ""], ["c", "1", "0", "", ""], ["d", "1", "0", "", ""], ["e", "1", "0", "", "", "a"]]], [2], [3], [2]], "expected": [null, [], [["1", "a", "0", "2"], ["1", "b", "0", "1"], ["2", "c", "2", "3"], ["2", "d", "2", "3"], ["3", "e", "3", "4"]], [["1", "a", "0", "2"], ["1", "b", "0", "1"], ["1", "c", "0", "1"], ["2", "d", "2", "3"], ["2", "e", "2", "3"]], 4]},
  {"id": "h9", "level": 2, "note": "a wave ends when its slowest task ends, so a short task that depends on a fast one waits for the slow sibling", "ops": ["PlanRunner", "setPlan", "timeline", "makespan", "criticalPath"], "args": [[], [[["x", "1", "0", "", ""], ["y", "5", "0", "", ""], ["z", "1", "0", "", "", "x"]]], [5], [5], []], "expected": [null, [], [["1", "x", "0", "1"], ["1", "y", "0", "5"], ["2", "z", "5", "6"]], 6, ["y"]]},
  {"id": "h10", "level": 2, "note": "with cap 1 every wave is one task, and the makespan is the sum of the durations", "ops": ["PlanRunner", "setPlan", "timeline", "makespan", "order"], "args": [[], [[["b", "3", "0", "", ""], ["a", "2", "0", "", ""], ["c", "4", "0", "", "", "a"]]], [1], [1], []], "expected": [null, [], [["1", "a", "0", "2"], ["2", "b", "2", "5"], ["3", "c", "5", "9"]], 9, ["a", "b", "c"]]},
