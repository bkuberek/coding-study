  {"id": "h14", "level": 2, "note": "the critical path is the chain with the largest total duration; ties go to the chain that is smaller id by id", "ops": ["PlanRunner", "setPlan", "criticalPath", "setPlan", "criticalPath", "setPlan", "criticalPath", "setPlan", "criticalPath", "setPlan", "criticalPath", "setPlan", "criticalPath"], "args": [[], [[["a", "2", "0", "", ""], ["b", "3", "0", "", "", "a"], ["c", "3", "0", "", "", "a"], ["d", "1", "0", "", "", "b", "c"]]], [], [[["q", "5", "0", "", ""], ["r", "2", "0", "", ""], ["s", "3", "0", "", "", "r"]]], [], [[["b", "3", "0", "", ""], ["a", "1", "0", "", ""], ["c", "2", "0", "", "", "a"]]], [], [[["only", "4", "0", "", ""]]], [], [[["m", "2", "0", "", ""], ["n", "2", "0", "", ""], ["p", "1", "0", "", "", "n", "m"]]], [], [[["a", "1", "0", "", ""], ["b", "1", "0", "", "", "a"], ["c", "1", "0", "", "", "b"], ["z", "3", "0", "", ""]]], []], "expected": [null, [], ["a", "b", "d"], [], ["q"], [], ["a", "c"], [], ["only"], [], ["m", "p"], [], ["a", "b", "c"]]},
