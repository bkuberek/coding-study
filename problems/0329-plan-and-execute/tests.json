  {"id": "h12", "level": 2, "note": "scripts are not read at this level; every task runs once", "ops": ["PlanRunner", "setPlan", "timeline", "makespan"], "args": [[], [[["a", "2", "0", "F", ""], ["b", "1", "0", "FFS", "", "a"]]], [2], [2]], "expected": [null, [], [["1", "a", "0", "2"], ["2", "b", "2", "3"]], 3]},
