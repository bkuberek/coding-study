  {"id": "h19", "level": 3, "note": "a replan that does not validate is rejected with the first error, the plan stays as it was and the replan is not tried again", "ops": ["PlanRunner", "setPlan", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog"], "args": [[], [[["a", "1", "0", "F", ""], ["b", "1", "0", "S", "", "a"]]], ["a", [["n", "1", "0", "S", "", "ghost"]]], [2, 0], [], ["a", [["n", "1", "0", "S", "", "m"], ["m", "1", "0", "S", "", "n"]]], [2, 0], [], ["a", [["bad"]]], [2, 0], [], ["a", [["a", "1", "0", "", ""]]], [2, 0], [], ["a", [["b", "1", "0", "", ""]]], [2, 0], [], ["a", [["n", "1", "0", "", ""], ["n", "1", "0", "", ""]]], [2, 0], []], "expected": [null, [], true, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "unknown-dependency:n>ghost"]], false, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "cycle:m,n"]], false, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "malformed-task:0"]], false, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "duplicate-id:a"]], false, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "duplicate-id:b"]], false, [["a", "failed", "1", "0", "1"], ["b", "blocked", "0", "", ""]], [["1", "a", "rejected", "duplicate-id:n"]]]},
  {"id": "h20", "level": 3, "note": "a replan removes every task that has not run, keeps the ones that are done, and its tasks can wait for them", "ops": ["PlanRunner", "setPlan", "setReplan", "run", "replanLog", "run", "replanLog"], "args": [[], [[["r", "1", "0", "S", "R"], ["a", "1", "0", "F", "", "r"], ["b", "1", "0", "S", "", "a"], ["u", "1", "0", "S", "", "r"], ["v", "1", "0", "S", "", "u"]]], ["a", [["w", "1", "0", "S", "W", "r"], ["x", "1", "0", "S", "X", "w", "u"]]], [1, 0], [], [5, 0], []], "expected": [null, [], true, [["a", "failed", "1", "1", "2"], ["b", "blocked", "0", "", ""], ["r", "done", "1", "0", "1"], ["u", "done", "1", "2", "3"], ["v", "done", "1", "3", "4"]], [["2", "a", "rejected", "unknown-dependency:x>u"]], [["a", "failed", "1", "1", "2"], ["b", "replaced", "0", "", ""], ["r", "done", "1", "0", "1"], ["u", "done", "1", "1", "2"], ["v", "replaced", "0", "", ""], ["w", "done", "1", "2", "3"], ["x", "done", "1", "3", "4"]], [["2", "a", "applied", "removed 2, added 2"]]]},
  {"id": "h21", "level": 3, "note": "one replan is applied per wave: failures are tried in id order, a rejected one does not stop the next, the first one applied does", "ops": ["PlanRunner", "setPlan", "setReplan", "setReplan", "setReplan", "run", "replanLog"], "args": [[], [[["a", "1", "0", "F", ""], ["b", "1", "0", "F", ""], ["c", "1", "0", "F", ""], ["d", "1", "0", "S", "", "a"]]], ["a", [["a2", "1", "0", "S", "", "zzz"]]], ["b", [["b2", "1", "0", "S", ""]]], ["c", [["c2", "1", "0", "S", ""]]], [3, 0], []], "expected": [null, [], true, true, true, [["a", "failed", "1", "0", "1"], ["b", "failed", "1", "0", "1"], ["b2", "done", "1", "1", "2"], ["c", "failed", "1", "0", "1"], ["d", "replaced", "0", "", ""]], [["1", "a", "rejected", "unknown-dependency:a2>zzz"], ["1", "b", "applied", "removed 1, added 1"]]]},
  {"id": "h22", "level": 3, "note": "setReplan says whether the id was new; a second call replaces the first, and a replan for a task that never fails is never used", "ops": ["PlanRunner", "setPlan", "setReplan", "setReplan", "setReplan", "run", "replanLog"], "args": [[], [[["a", "1", "0", "F", ""], ["b", "1", "0", "S", ""]]], ["a", [["x", "1", "0", "S", ""]]], ["a", [["y", "1", "0", "S", ""], ["z", "1", "0", "S", "", "y"]]], ["b", [["never", "1", "0", "", ""]]], [2, 0], []], "expected": [null, [], true, false, true, [["a", "failed", "1", "0", "1"], ["b", "done", "1", "0", "1"], ["y", "done", "1", "1", "2"], ["z", "done", "1", "2", "3"]], [["1", "a", "applied", "removed 0, added 2"]]]},
  {"id": "h23", "level": 3, "note": "a replacement task can fail and be replaced in turn; a replan is used once, and ids of earlier tasks cannot be reused", "ops": ["PlanRunner", "setPlan", "setReplan", "setReplan", "run", "replanLog", "setReplan", "run", "replanLog"], "args": [[], [[["a", "1", "0", "F", ""], ["z", "1", "0", "S", "", "a"]]], ["a", [["a2", "1", "0", "F", ""], ["tail", "1", "0", "S", "", "a2"]]], ["a2", [["a3", "1", "0", "S", ""]]], [2, 0], [], ["a2", [["a", "1", "0", "", ""]]], [2, 0], []], "expected": [null, [], true, true, [["a", "failed", "1", "0", "1"], ["a2", "failed", "1", "1", "2"], ["a3", "done", "1", "2", "3"], ["tail", "replaced", "0", "", ""], ["z", "replaced", "0", "", ""]], [["1", "a", "applied", "removed 1, added 2"], ["2", "a2", "applied", "removed 1, added 1"]], false, [["a", "failed", "1", "0", "1"], ["a2", "failed", "1", "1", "2"], ["tail", "blocked", "0", "", ""], ["z", "replaced", "0", "", ""]], [["1", "a", "applied", "removed 1, added 2"], ["2", "a2", "rejected", "duplicate-id:a"]]]},
  {"id": "h24", "level": 3, "note": "a run can be repeated with other settings and gives the same answer for the same ones; with no plan it is empty", "ops": ["PlanRunner", "replanLog", "run", "setPlan", "run", "run", "run", "replanLog"], "args": [[], [], [2, 1], [[["a", "2", "0", "FS", ""], ["b", "1", "0", "S", "", "a"]]], [2, 1], [2, 1], [2, 0], []], "expected": [null, [], [], [], [["a", "done", "2", "0", "4"], ["b", "done", "1", "4", "5"]], [["a", "done", "2", "0", "4"], ["b", "done", "1", "4", "5"]], [["a", "failed", "1", "0", "2"], ["b", "blocked", "0", "", ""]], []]},
  {"id": "h25", "level": 3, "note": "the tasks of a replan that fail block their own dependents", "ops": ["PlanRunner", "setPlan", "setReplan", "run", "replanLog"], "args": [[], [[["a", "1", "0", "F", ""]]], ["a", [["b", "1", "0", "F", ""], ["c", "1", "0", "S", "", "b"], ["d", "1", "0", "S", ""]]], [1, 1], []], "expected": [null, [], true, [["a", "failed", "2", "0", "2"], ["b", "failed", "2", "2", "4"], ["c", "blocked", "0", "", ""], ["d", "done", "1", "4", "5"]], [["1", "a", "applied", "removed 0, added 3"]]]},
  {"id": "ex7", "visible": true, "level": 4, "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report", "setBudget", "run", "report"], "args": [[], [[["a", "2", "3", "S", "A"], ["b", "1", "4", "S", "B", "a"], ["c", "1", "2", "S", "C", "a"], ["d", "1", "5", "S", "D", "b", "c"]]], [-1, -1], [2, 0], [], [8, -1], [2, 0], []], "expected": [null, [], null, [["a", "done", "1", "0", "2"], ["b", "done", "1", "2", "3"], ["c", "done", "1", "2", "3"], ["d", "done", "1", "3", "4"]], [["stopped", "none"], ["spent", "14", "4", "4"], ["done", "a", "b", "c", "d"], ["failed"], ["blocked"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "a=A", "b=B", "c=C", "d=D"]], null, [["a", "done", "1", "0", "2"], ["b", "done", "1", "2", "3"], ["c", "skipped", "0", "", ""], ["d", "skipped", "0", "", ""]], [["stopped", "cost"], ["spent", "7", "2", "3"], ["done", "a", "b"], ["failed"], ["blocked"], ["skipped", "c", "d"], ["replaced"], ["replans", "0", "0"], ["results", "a=A", "b=B"]]]},
  {"id": "ex8", "visible": true, "level": 4, "ops": ["PlanRunner", "setPlan", "setBudget", "run", "report"], "args": [[], [[["a", "2", "1", "FFS", "A"], ["b", "1", "1", "S", "B", "a"], ["c", "1", "1", "S", "C"]]], [-1, 3], [2, 2], []], "expected": [null, [], null, [["a", "failed", "2", "0", "4"], ["b", "blocked", "0", "", ""], ["c", "done", "1", "0", "1"]], [["stopped", "steps"], ["spent", "3", "3", "4"], ["done", "c"], ["failed", "a"], ["blocked", "b"], ["skipped"], ["replaced"], ["replans", "0", "0"], ["results", "c=C"]]]},
