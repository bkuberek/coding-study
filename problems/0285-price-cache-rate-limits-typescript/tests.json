        "method": "GET",
        "path": "/prices/lamp",
        "headers": {
          "X-Api-Key": "v2"
        }
      },
      "expected": {
        "status": 200,
        "body": {
          "sku": "lamp",
          "amount_cents": 1250,
          "currency": "EUR"
        },
        "headers": {
          "X-Cache": "hit"
        }
      },
      "log": [
        {
          "mock": "pricing",
          "route": "lamp",
          "count": 1
        }
      ]
    },
    {
      "id": "v3",
      "level": 1,
      "visible": true,
      "fresh": true,
      "note": "kettle is good for 1 s, so after anvil, which takes the engine 1.2 s, it is asked again",
      "hang_guard_ms": 15000,
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/prices/kettle",
            "headers": {
              "X-Api-Key": "v3"
            }
          },
          "expected": {
            "status": 200,
            "body": {
              "sku": "kettle",
              "amount_cents": 2900,
              "currency": "EUR"
            },
            "headers": {
              "X-Cache": "miss"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/prices/anvil",
            "headers": {
              "X-Api-Key": "v3"
            }
          },
          "expected": {
            "status": 200
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/prices/kettle",
            "headers": {
              "X-Api-Key": "v3"
            }
          },
          "expected": {
            "status": 200,
            "body": {
              "sku": "kettle",
              "amount_cents": 2900,
              "currency": "EUR"
            },
            "headers": {
              "X-Cache": "miss"
            }
          }
        }
      ],
      "log": [
        {
          "mock": "pricing",
          "route": "kettle",
          "count": 2
        }
      ]
    },
