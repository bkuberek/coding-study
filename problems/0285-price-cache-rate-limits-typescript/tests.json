    {
      "id": "v7",
      "level": 3,
      "visible": true,
      "fresh": true,
      "note": "a price set through the API is fetched again on the next request",
      "mocks": {
        "pricing": "repriced"
      },
      "before": [
        {
          "method": "GET",
          "path": "/prices/lamp",
          "headers": {
            "X-Api-Key": "v7"
          }
        },
        {
          "method": "PUT",
          "path": "/prices/lamp",
          "headers": {
            "X-Api-Key": "v7"
          },
          "json": {
            "amount_cents": 1400
          }
        }
      ],
