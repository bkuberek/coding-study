{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {
      "id": "v1",
      "level": 1,
      "visible": true,
      "fresh": true,
      "note": "the first request for a price asks the engine",
      "request": {
        "method": "GET",
        "path": "/prices/lamp",
        "headers": {
          "X-Api-Key": "v1"
        }
      },
      "expected": {
        "status": 200,
        "body": {
          "sku": "lamp",
          "amount_cents": 1250,
          "currency": "EUR"
        },
        "headers": {
          "X-Cache": "miss"
        }
      },
      "log": [
        {
          "mock": "pricing",
          "route": "lamp",
          "count": 1
        }
      ]
    },
    {
      "id": "v2",
      "level": 1,
      "visible": true,
      "fresh": true,
      "note": "a second request within max-age is answered from the store",
      "before": [
        {
          "method": "GET",
          "path": "/prices/lamp",
          "headers": {
            "X-Api-Key": "v2"
          }
        }
