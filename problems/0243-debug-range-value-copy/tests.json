{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"opening": [100, 2500], "earnings": [[0, 50], [1, 300], [0, 25]], "limit": 5000}, "expected": [[175, 0], [2800, 0]]},
    {"id": "ex2", "visible": true, "input": {"opening": [5000, 0], "earnings": [[1, 4999]], "limit": 5000}, "expected": [[5000, 0], [4999, 0]]},
    {"id": "h1", "input": {"opening": [4000, 100], "earnings": [[0, 1500], [1, 200]], "limit": 5000}, "expected": [[5000, 500], [300, 0]], "note": "one member goes over the cap"},
    {"id": "h2", "input": {"opening": [9000, 3000], "earnings": [], "limit": 5000}, "expected": [[5000, 4000], [3000, 0]], "note": "over the cap before any earnings"},
    {"id": "h3", "input": {"opening": [6000, 7000, 8000], "earnings": [[2, 1]], "limit": 5000}, "expected": [[5000, 1000], [5000, 2000], [5000, 3001]], "note": "every member over the cap"},
    {"id": "h4", "input": {"opening": [10, 0, 3], "earnings": [[1, 7]], "limit": 0}, "expected": [[0, 10], [0, 7], [0, 3]], "note": "cap of zero: every point expires"},
    {"id": "h5", "input": {"opening": [1, 2, 3], "earnings": [], "limit": 100}, "expected": [[1, 0], [2, 0], [3, 0]], "note": "no earnings, all below the cap"},
    {"id": "h6", "input": {"opening": [4990], "earnings": [[0, 4], [0, 6]], "limit": 5000}, "expected": [[5000, 0]], "note": "lands exactly on the cap"},
    {"id": "h7", "input": {"opening": [4990], "earnings": [[0, 4], [0, 7]], "limit": 5000}, "expected": [[5000, 1]], "note": "one point over the cap"},
    {"id": "h8", "input": {"opening": [1000000, 1000000], "earnings": [[0, 100000], [0, 100000], [1, 100000]], "limit": 1000000000}, "expected": [[1200000, 0], [1100000, 0]], "note": "largest values, far below a huge cap"},
    {"id": "h9", "input": {"opening": [1000000], "earnings": [[0, 100000], [0, 100000], [0, 100000], [0, 100000]], "limit": 1050000}, "expected": [[1050000, 350000]], "note": "many earnings for one member"},
    {"id": "h10", "input": {"opening": [0, 0, 0, 0], "earnings": [[3, 5], [3, 5], [0, 1]], "limit": 8}, "expected": [[1, 0], [0, 0], [0, 0], [8, 2]], "note": "members with nothing, one over"},
    {"id": "h11", "input": {"opening": [0], "earnings": [], "limit": 0}, "expected": [[0, 0]], "note": "single empty account, cap zero"}
  ]
}
