{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["DriftDetector", "record", "record", "record", "observe", "observe", "observe", "drift"], "args": [[], ["server.web", "i-100", [["size", "small"], ["zone", "a"], ["image", "base-2"]]], ["disk.data", "vol-7", [["size", "20"]]], ["bucket.logs", "b-1", [["region", "north"]]], ["i-100", "server", [["size", "large"], ["zone", "a"], ["image", "base-2"], ["monitoring", "on"]]], ["b-1", "bucket", [["region", "north"]]], ["i-999", "server", [["size", "small"]]], []], "expected": [null, true, true, true, true, true, true, [["deleted", "disk.data", "vol-7"], ["changed", "server.web", "monitoring", "", "on"], ["changed", "server.web", "size", "small", "large"], ["unmanaged", "i-999", "server"]]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["DriftDetector", "record", "observe", "drift", "record", "drift", "observe", "observe", "drift"], "args": [[], ["vm.a", "i-1", [["size", "s"]]], ["i-1", "vm", [["size", "s"]]], [], ["vm.a", "i-2", [["size", "s"]]], [], ["i-2", "vm", [["size", "m"]]], ["i-1", "vm", [["size", "x"]]], []], "expected": [null, true, true, [], false, [["deleted", "vm.a", "i-2"], ["unmanaged", "i-1", "vm"]], true, false, [["changed", "vm.a", "size", "s", "m"], ["unmanaged", "i-1", "vm"]]]},
    {"id": "h1", "level": 1, "note": "rows by address and unmanaged ids by character code: web10 before web9, digits before _, capitals before lowercase, and never by type", "ops": ["DriftDetector", "record", "record", "record", "observe", "observe", "observe", "observe", "drift"], "args": [[], ["vm.web9", "i-9", [["k", "1"]]], ["vm.web10", "i-10", [["k", "1"]]], ["vm.web_a", "i-a", [["k", "1"]]], ["I-1", "vm", [["k", "1"]]], ["i-0", "vm", [["k", "1"]]], ["i-90", "disk", [["k", "1"]]], ["H-2", "zone", [["k", "1"]]], []], "expected": [null, true, true, true, true, true, true, true, [["deleted", "vm.web10", "i-10"], ["deleted", "vm.web9", "i-9"], ["deleted", "vm.web_a", "i-a"], ["unmanaged", "H-2", "zone"], ["unmanaged", "I-1", "vm"], ["unmanaged", "i-0", "vm"], ["unmanaged", "i-90", "disk"]]]},
    {"id": "h2", "level": 1, "note": "a key on one side only is drift with an empty value on the other; values compare exactly as text", "ops": ["DriftDetector", "record", "observe", "drift"], "args": [[], ["vm.a", "i-1", [["only_rec", "x"], ["size", "Large"], ["count", "010"], ["same", "1"]]], ["i-1", "vm", [["only_obs", "y"], ["size", "large"], ["count", "10"], ["same", "1"]]], []], "expected": [null, true, true, [["changed", "vm.a", "count", "010", "10"], ["changed", "vm.a", "only_obs", "", "y"], ["changed", "vm.a", "only_rec", "x", ""], ["changed", "vm.a", "size", "Large", "large"]]]},
    {"id": "h3", "level": 1, "note": "a second record or observe replaces the attributes instead of merging them; a resource may have no attributes", "ops": ["DriftDetector", "record", "record", "observe", "observe", "record", "observe", "drift", "observe", "drift"], "args": [[], ["vm.a", "i-1", [["size", "s"], ["zone", "a"]]], ["vm.a", "i-1", [["size", "s"]]], ["i-1", "vm", [["size", "s"], ["zone", "a"], ["tag", "t"]]], ["i-1", "vm", [["size", "s"]]], ["vm.e", "i-5", []], ["i-5", "vm", []], [], ["i-5", "vm", [["tag", "t"]]], []], "expected": [null, true, false, true, false, true, true, [], false, [["changed", "vm.e", "tag", "", "t"]]]},
    {"id": "h4", "level": 1, "note": "recorded resources are matched to the scan by id, not by name, and listed by address", "ops": ["DriftDetector", "record", "record", "observe", "observe", "observe", "observe", "drift"], "args": [[], ["app.zeta", "a-1", [["k", "1"]]], ["app.alpha", "z-9", [["k", "1"]]], ["z-9", "app", [["k", "2"]]], ["a-1", "app", [["k", "1"]]], ["m-5", "app", [["k", "1"]]], ["b-3", "zz", [["k", "1"]]], []], "expected": [null, true, true, true, true, true, true, [["changed", "app.alpha", "k", "1", "2"], ["unmanaged", "b-3", "zz"], ["unmanaged", "m-5", "app"]]]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["DriftDetector", "record", "record", "record", "observe", "observe", "observe", "observe", "ignore", "ignore", "ignore", "ignore", "drift"], "args": [[], ["server.web", "i-1", [["size", "s"], ["tags", "a"], ["owner", "ops"]]], ["server.api", "i-2", [["size", "s"]]], ["dns.www", "d-1", [["ttl", "300"]]], ["i-1", "server", [["size", "m"], ["tags", "b"], ["owner", "dev"]]], ["i-2", "server", [["size", "l"]]], ["q-5", "queue", [["depth", "1"]]], ["tmp-1", "server", [["size", "s"]]], ["server.*", "tags"], ["server.api", "*"], ["server.tmp-*", "*"], ["server.*", "tags"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, false, [["deleted", "dns.www", "d-1"], ["changed", "server.web", "owner", "ops", "dev"], ["changed", "server.web", "size", "s", "m"], ["unmanaged", "q-5", "queue"]]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["DriftDetector", "unordered", "defaultValue", "record", "observe", "record", "observe", "record", "observe", "drift", "defaultValue", "drift"], "args": [[], ["group", "rules"], ["server", "monitoring", "off"], ["group.web", "g-1", [["rules", "22,80,443"]]], ["g-1", "group", [["rules", "443,22,80"]]], ["server.a", "i-1", [["size", "s"]]], ["i-1", "server", [["size", "s"], ["monitoring", "off"]]], ["server.b", "i-2", [["size", "s"], ["monitoring", "on"]]], ["i-2", "server", [["size", "s"]]], [], ["server", "monitoring", "on"], []], "expected": [null, true, true, true, true, true, true, true, true, [["changed", "server.b", "monitoring", "on", ""]], false, [["changed", "server.a", "monitoring", "", "off"]]]},
    {"id": "h5", "level": 2, "note": "a star matches any run, empty or across a dot; ? and [ are plain characters; a pattern must cover the whole address", "ops": ["DriftDetector", "record", "record", "record", "record", "record", "record", "observe", "observe", "observe", "observe", "observe", "observe", "ignore", "ignore", "ignore", "ignore", "ignore", "ignore", "ignore", "drift", "ignore", "drift"], "args": [[], ["vm.web", "i-1", [["k", "1"]]], ["vm.web2", "i-2", [["k", "1"]]], ["vm.aab", "i-3", [["k", "1"]]], ["net.mid", "i-4", [["k", "1"]]], ["vm.other", "i-5", [["k", "1"]]], ["disk.x", "i-6", [["k", "1"]]], ["i-1", "vm", [["k", "2"]]], ["i-2", "vm", [["k", "2"]]], ["i-3", "vm", [["k", "2"]]], ["i-4", "net", [["k", "2"]]], ["i-5", "vm", [["k", "2"]]], ["i-6", "disk", [["k", "2"]]], ["vm.web*", "k"], ["disk.?", "*"], ["vm.[o]ther", "*"], ["*ab", "k"], ["n*t.m*d", "k"], ["vm.oth", "*"], ["vm", "*"], [], ["*", "k"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, [["changed", "disk.x", "k", "1", "2"], ["changed", "vm.other", "k", "1", "2"]], true, []]},
    {"id": "h6", "level": 2, "note": "an ignored key never hides a deleted resource; an unmanaged resource is matched as type.id, and only a whole-resource rule hides it", "ops": ["DriftDetector", "record", "record", "record", "observe", "observe", "observe", "observe", "ignore", "ignore", "ignore", "ignore", "ignore", "drift"], "args": [[], ["vm.a", "i-1", [["size", "s"], ["zone", "a"]]], ["vm.b", "i-2", [["size", "s"]]], ["vm.c", "i-3", [["size", "s"]]], ["i-1", "vm", [["size", "m"], ["zone", "b"]]], ["i-3", "vm", [["size", "m"]]], ["i-7", "vm", [["size", "s"]]], ["i-8", "vm", [["size", "s"]]], ["vm.*", "size"], ["vm.i-1", "*"], ["vm.i-7", "size"], ["*.i-8", "*"], ["vm.*", "size"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, false, [["changed", "vm.a", "zone", "a", "b"], ["deleted", "vm.b", "i-2"], ["unmanaged", "i-7", "vm"]]]},
    {"id": "h7", "level": 2, "note": "order-insensitive lists still count repeats, rules belong to their type, a default only fills a missing key, and rows print raw values", "ops": ["DriftDetector", "unordered", "defaultValue", "defaultValue", "record", "observe", "record", "observe", "record", "observe", "unordered", "drift"], "args": [[], ["vm", "tags"], ["vm", "arch", "x86"], ["disk", "kind", "ssd"], ["vm.a", "i-1", [["tags", "a,a,b"], ["ports", "1,2"], ["arch", "arm"]]], ["i-1", "vm", [["tags", "b,a"], ["ports", "2,1"]]], ["vm.b", "i-2", [["tags", "c,b,a"]]], ["i-2", "vm", [["tags", "a,b,c"], ["arch", "x86"], ["kind", "ssd"]]], ["disk.d", "v-1", [["tags", "a,b"]]], ["v-1", "disk", [["tags", "b,a"]]], ["vm", "tags"], []], "expected": [null, true, true, true, true, true, true, true, true, true, false, [["changed", "disk.d", "tags", "a,b", "b,a"], ["changed", "vm.a", "arch", "arm", ""], ["changed", "vm.a", "ports", "1,2", "2,1"], ["changed", "vm.a", "tags", "a,a,b", "b,a"], ["changed", "vm.b", "kind", "", "ssd"]]]},
    {"id": "h8", "level": 2, "note": "normalized values are equal, an extra item is still drift, and a new default replaces the old one", "ops": ["DriftDetector", "unordered", "defaultValue", "record", "observe", "record", "observe", "drift", "defaultValue", "drift"], "args": [[], ["db", "hosts"], ["db", "port", "5432"], ["db.main", "d-1", [["hosts", "b,a"], ["port", "5432"]]], ["d-1", "db", [["hosts", "a,b"]]], ["db.copy", "d-2", [["hosts", "a,b"]]], ["d-2", "db", [["hosts", "b,a,c"], ["port", "6432"]]], [], ["db", "port", "6432"], []], "expected": [null, true, true, true, true, true, true, [["changed", "db.copy", "hosts", "a,b", "b,a,c"], ["changed", "db.copy", "port", "", "6432"]], false, [["changed", "db.copy", "hosts", "a,b", "b,a,c"], ["changed", "db.main", "port", "5432", ""]]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["DriftDetector", "observe", "observe", "record", "observe", "drift", "importResource", "importResource", "importResource", "importResource", "observe", "importResource", "drift", "desire", "desire", "plan"], "args": [[], ["i-7", "server", [["size", "m"], ["zone", "b"]]], ["b-2", "bucket", [["region", "north"]]], ["server.web", "i-1", [["size", "s"]]], ["i-1", "server", [["size", "s"]]], [], ["server.api", "i-7"], ["server.store", "b-2"], ["bucket.logs", "i-404"], ["server.other", "i-7"], ["i-8", "server", [["size", "s"]]], ["server.web", "i-8"], [], ["server.api", [["size", "m"], ["zone", "a"]]], ["server.web", [["size", "s"]]], []], "expected": [null, true, true, true, true, [["unmanaged", "b-2", "bucket"], ["unmanaged", "i-7", "server"]], "imported", "type-mismatch", "not-found", "already-managed", true, "address-taken", [["unmanaged", "b-2", "bucket"], ["unmanaged", "i-8", "server"]], true, true, [["update", "server.api", "zone", "b", "a"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["DriftDetector", "unordered", "observe", "importResource", "record", "desire", "desire", "ignore", "plan", "plan"], "args": [[], ["group", "rules"], ["g-9", "group", [["rules", "80,22"], ["name", "web"]]], ["group.web", "g-9"], ["vm.old", "i-3", [["size", "s"]]], ["group.web", [["rules", "22,80"], ["name", "web"]]], ["vm.new", [["size", "m"]]], ["vm.*", "*"], [], []], "expected": [null, true, true, "imported", true, true, true, true, [["create", "vm.new"], ["delete", "vm.old"]], [["create", "vm.new"], ["delete", "vm.old"]]]},
    {"id": "h9", "level": 3, "note": "import refusals in order: not-found, type-mismatch, already-managed, address-taken; an import copies the attributes, so a later scan can drift", "ops": ["DriftDetector", "record", "observe", "observe", "observe", "importResource", "importResource", "importResource", "importResource", "importResource", "importResource", "importResource", "importResource", "observe", "drift"], "args": [[], ["vm.a", "i-1", [["size", "s"]]], ["i-1", "vm", [["size", "s"]]], ["d-1", "disk", [["size", "9"]]], ["i-2", "vm", [["size", "m"]]], ["vm.a", "i-404"], ["vm.z", "d-1"], ["disk.z", "i-1"], ["vm.b", "i-1"], ["vm.a", "i-1"], ["vm.a", "i-2"], ["vm.c", "i-2"], ["vm.c", "i-2"], ["i-2", "vm", [["size", "l"]]], []], "expected": [null, true, true, true, true, "not-found", "type-mismatch", "type-mismatch", "already-managed", "already-managed", "address-taken", "imported", "already-managed", false, [["changed", "vm.c", "size", "m", "l"], ["unmanaged", "d-1", "disk"]]]},
    {"id": "h10", "level": 3, "note": "the plan compares the desired state with the recorded one, never the scan; rows by address then key, with normalization", "ops": ["DriftDetector", "record", "observe", "desire", "defaultValue", "record", "desire", "record", "desire", "desire", "ignore", "ignore", "plan"], "args": [[], ["vm.a", "i-1", [["size", "s"], ["old_key", "x"]]], ["i-1", "vm", [["size", "xl"], ["old_key", "x"]]], ["vm.a", [["size", "m"], ["new_key", "y"]]], ["vm", "arch", "x86"], ["vm.b", "i-2", [["arch", "x86"]]], ["vm.b", []], ["vm.c", "i-3", [["arch", "arm"]]], ["vm.c", []], ["vm.aa", [["size", "s"]]], ["vm.c", "arch"], ["vm.a", "*"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["update", "vm.a", "new_key", "", "y"], ["update", "vm.a", "old_key", "x", ""], ["update", "vm.a", "size", "s", "m"], ["create", "vm.aa"], ["update", "vm.c", "arch", "arm", ""]]]},
    {"id": "h11", "level": 3, "note": "an ignored unmanaged resource can be imported, after which it is managed, and an import without a desired resource plans a delete", "ops": ["DriftDetector", "observe", "ignore", "drift", "importResource", "observe", "drift", "plan", "desire", "plan"], "args": [[], ["tmp-1", "vm", [["size", "s"]]], ["vm.tmp-*", "*"], [], ["vm.temp", "tmp-1"], ["tmp-1", "vm", [["size", "m"]]], [], [], ["vm.temp", [["size", "s"]]], []], "expected": [null, true, true, [], "imported", false, [["changed", "vm.temp", "size", "s", "m"]], [["delete", "vm.temp"]], true, []]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["DriftDetector", "record", "desire", "record", "desire", "record", "desire", "observe", "observe", "observe", "policy", "policy", "reconcile", "policy", "reconcile"], "args": [[], ["server.web", "i-1", [["size", "s"], ["zone", "a"]]], ["server.web", [["size", "s"], ["zone", "a"]]], ["server.api", "i-2", [["size", "s"]]], ["server.api", [["size", "s"]]], ["dns.www", "d-1", [["ttl", "300"]]], ["dns.www", [["ttl", "300"]]], ["i-1", "server", [["size", "m"], ["zone", "a"]]], ["i-2", "server", [["size", "l"]]], ["x-1", "queue", []], ["server.*", "revert"], ["server.api", "accept"], [], ["server.*", "alert"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["alert-deleted", "dns.www", "d-1"], ["accept", "server.api", "size", "s", "l"], ["revert", "server.web", "size", "m", "s"], ["alert-unmanaged", "x-1", "queue"]], false, [["alert-deleted", "dns.www", "d-1"], ["alert", "server.api", "size", "s", "l"], ["alert", "server.web", "size", "s", "m"], ["alert-unmanaged", "x-1", "queue"]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["DriftDetector", "record", "desire", "observe", "record", "desire", "observe", "record", "desire", "record", "desire", "policy", "policy", "reconcile", "drift"], "args": [[], ["vm.a", "i-1", [["size", "s"]]], ["vm.a", [["size", "m"]]], ["i-1", "vm", [["size", "l"]]], ["vm.b", "i-2", [["size", "s"]]], ["vm.b", [["size", "m"]]], ["i-2", "vm", [["size", "m"]]], ["vm.c", "i-3", [["size", "s"]]], ["vm.c", [["size", "s"]]], ["vm.d", "i-4", [["size", "s"]]], ["vm.d", [["size", "s"]]], ["vm.*", "revert"], ["vm.d", "accept"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, [["revert", "vm.a", "size", "l", "m"], ["recreate", "vm.c"], ["forget", "vm.d"]], [["changed", "vm.a", "size", "s", "l"], ["changed", "vm.b", "size", "s", "m"], ["deleted", "vm.c", "i-3"], ["deleted", "vm.d", "i-4"]]]},
    {"id": "h12", "level": 4, "note": "the newest matching rule wins, a rule declared again moves to the end, and alert is the default", "ops": ["DriftDetector", "record", "desire", "record", "desire", "record", "desire", "record", "desire", "observe", "observe", "observe", "observe", "record", "desire", "record", "desire", "policy", "policy", "policy", "policy", "policy", "policy", "reconcile"], "args": [[], ["vm.a", "i-1", [["k", "1"]]], ["vm.a", [["k", "1"]]], ["vm.b", "i-2", [["k", "1"]]], ["vm.b", [["k", "1"]]], ["db.c", "i-3", [["k", "1"]]], ["db.c", [["k", "1"]]], ["lb.d", "i-4", [["k", "1"]]], ["lb.d", [["k", "1"]]], ["i-1", "vm", [["k", "2"]]], ["i-2", "vm", [["k", "2"]]], ["i-3", "db", [["k", "2"]]], ["i-4", "lb", [["k", "2"]]], ["vm.gone", "i-9", [["k", "1"]]], ["vm.gone", [["k", "1"]]], ["db.gone", "i-8", [["k", "1"]]], ["db.gone", [["k", "1"]]], ["vm.a", "accept"], ["vm.*", "revert"], ["db.*", "accept"], ["*", "revert"], ["db.*", "accept"], ["l*", "alert"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, [["accept", "db.c", "k", "1", "2"], ["forget", "db.gone"], ["alert", "lb.d", "k", "1", "2"], ["revert", "vm.a", "k", "2", "1"], ["revert", "vm.b", "k", "2", "1"], ["recreate", "vm.gone"]]]},
    {"id": "h13", "level": 4, "note": "reconcile acts only on drift left after ignores and normalization, compares the scan with the desired value under the same rules, and prints raw values", "ops": ["DriftDetector", "unordered", "defaultValue", "record", "desire", "observe", "record", "desire", "observe", "ignore", "record", "desire", "observe", "record", "desire", "policy", "policy", "reconcile", "policy", "reconcile"], "args": [[], ["sg", "ports"], ["sg", "proto", "tcp"], ["sg.a", "s-1", [["ports", "1,2"], ["proto", "udp"], ["note", "n"], ["name", "a"]]], ["sg.a", [["ports", "2,1"], ["name", "b"]]], ["s-1", "sg", [["ports", "3,1"], ["proto", "tcp"], ["name", "c"]]], ["sg.b", "s-2", [["ports", "1,2"], ["label", "x"]]], ["sg.b", [["ports", "1,2"], ["label", "x"]]], ["s-2", "sg", [["ports", "2,1,1"], ["label", "y"]]], ["sg.b", "label"], ["fw.x", "f-1", [["k", "1"]]], ["fw.x", [["k", "1"]]], ["f-1", "fw", [["k", "2"]]], ["fw.gone", "f-9", [["k", "1"]]], ["fw.gone", [["k", "1"]]], ["sg.a", "revert"], ["sg.b", "accept"], [], ["sg.a", "accept"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, [["alert-deleted", "fw.gone", "f-9"], ["alert", "fw.x", "k", "1", "2"], ["revert", "sg.a", "name", "c", "b"], ["revert", "sg.a", "ports", "3,1", "2,1"], ["accept", "sg.b", "ports", "1,2", "2,1,1"]], false, [["alert-deleted", "fw.gone", "f-9"], ["alert", "fw.x", "k", "1", "2"], ["accept", "sg.a", "name", "b", "c"], ["accept", "sg.a", "ports", "2,1", "3,1"], ["accept", "sg.b", "ports", "1,2", "2,1,1"]]]},
    {"id": "h14", "level": 4, "note": "unmanaged resources are always only reported, whatever the policies, and policies never change drift", "ops": ["DriftDetector", "record", "desire", "observe", "observe", "observe", "ignore", "policy", "policy", "reconcile", "drift"], "args": [[], ["vm.a", "i-1", [["k", "1"]]], ["vm.a", [["k", "1"]]], ["i-1", "vm", [["k", "2"]]], ["u-1", "vm", [["k", "1"]]], ["u-2", "queue", []], ["queue.*", "*"], ["*", "revert"], ["vm.u-1", "accept"], [], []], "expected": [null, true, true, true, true, true, true, true, true, [["revert", "vm.a", "k", "2", "1"], ["alert-unmanaged", "u-1", "vm"]], [["changed", "vm.a", "k", "1", "2"], ["unmanaged", "u-1", "vm"]]]}
  ]
}
