{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"s": "baaad", "p": "ba*d"}, "expected": true},
    {"id": "ex2", "visible": true, "input": {"s": "cab", "p": ".a"}, "expected": false},
    {"id": "h1", "input": {"s": "", "p": "a*"}, "expected": true, "note": "an empty string matches a starred letter"},
    {"id": "h2", "input": {"s": "", "p": "a"}, "expected": false, "note": "an empty string against a literal"},
    {"id": "h3", "input": {"s": "", "p": ".*b*"}, "expected": true, "note": "an empty string against two stars"},
    {"id": "h4", "input": {"s": "a", "p": "."}, "expected": true, "note": "a dot matches any letter"},
    {"id": "h5", "input": {"s": "abc", "p": ".*"}, "expected": true, "note": "dot-star matches everything"},
    {"id": "h6", "input": {"s": "abc", "p": "a.c"}, "expected": true, "note": "a dot in the middle"},
    {"id": "h7", "input": {"s": "abc", "p": "a.d"}, "expected": false, "note": "the last letter differs"},
    {"id": "h8", "input": {"s": "aaa", "p": "a*a"}, "expected": true, "note": "the star must leave one letter for the literal"},
    {"id": "h9", "input": {"s": "aaa", "p": "aaaa*"}, "expected": true, "note": "the star matches zero letters"},
    {"id": "h10", "input": {"s": "ab", "p": ".*c"}, "expected": false, "note": "dot-star cannot invent a missing letter"},
    {"id": "h11", "input": {"s": "xyz", "p": "x*y*z*"}, "expected": true, "note": "every star matches exactly one letter"},
    {"id": "h12", "input": {"s": "aab", "p": "a*.b"}, "expected": true, "note": "the star and the dot share the a's"},
    {"id": "h13", "input": {"s": "ba", "p": "b*a*b*a*"}, "expected": true, "note": "stars matching zero or one letters"},
    {"id": "h14", "input": {"s": "", "p": "a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*b"}, "expected": false, "note": "maximum lengths: every split fails"},
    {"id": "h15", "input": {"s": "", "p": ".*b"}, "expected": true, "note": "maximum length, dot-star then a literal"},
    {"id": "h16", "input": {"s": "", "p": "*"}, "expected": true, "note": "maximum lengths, mostly literals"},
    {"id": "g1", "generate": {"n": 1000, "seed": 1}, "note": "s of 1000 letters and about 500 .* tokens ended by a letter s lacks"},
    {"id": "g2", "generate": {"n": 99, "seed": 2}, "note": "s of 99 letters and a pattern built from it"},
    {"id": "g3", "generate": {"n": 250, "seed": 3}}
  ]
}
