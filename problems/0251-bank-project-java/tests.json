{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "note": "an id opens one account; a transfer returns the source's new balance", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "deposit"], "args": [[], [1, "rosa"], [2, "tom"], [3, "rosa"], [4, "rosa", 600], [5, "kim", 20], [6, "rosa", "tom", 250], [7, "tom", 50]], "expected": [null, true, true, false, 600, -1, 350, 300]},
    {"id": "ex2", "visible": true, "level": 1, "note": "a transfer the source cannot cover is refused; one of the whole balance empties it", "ops": ["Bank", "createAccount", "createAccount", "deposit", "transfer", "deposit", "transfer", "deposit"], "args": [[], [1, "ada"], [2, "bo"], [3, "ada", 100], [4, "ada", "bo", 150], [5, "bo", 1], [6, "ada", "bo", 100], [7, "ada", 1]], "expected": [null, true, true, 100, -1, 1, 0, 1]},
    {"id": "h1", "level": 1, "note": "transfers to self, to a missing account or from one change nothing; an emptied account sends nothing", "ops": ["Bank", "createAccount", "deposit", "transfer", "transfer", "transfer", "deposit", "createAccount", "transfer", "transfer", "deposit"], "args": [[], [1, "a"], [2, "a", 70], [3, "a", "a", 10], [4, "a", "nobody", 10], [5, "nobody", "a", 10], [6, "a", 5], [7, "b"], [8, "a", "b", 75], [9, "a", "b", 1], [10, "b", 1]], "expected": [null, true, 70, -1, -1, -1, 75, true, 0, -1, 76]},
    {"id": "h2", "level": 1, "note": "a second createAccount of an id keeps the account and its balance; similar ids are different accounts", "ops": ["Bank", "createAccount", "deposit", "createAccount", "deposit", "createAccount", "deposit", "transfer", "deposit", "transfer"], "args": [[], [1, "kai"], [2, "kai", 40], [3, "kai"], [4, "kai", 2], [5, "kai2"], [6, "kai2", 3], [7, "kai", "kai2", 42], [8, "kai2", 1], [9, "kai", "kai2", 1]], "expected": [null, true, 40, false, 42, true, 3, 0, 46, -1]},
    {"id": "h3", "level": 1, "note": "balances go beyond 32-bit integers", "ops": ["Bank", "createAccount", "deposit", "deposit", "deposit", "createAccount", "transfer", "transfer", "transfer", "deposit"], "args": [[], [1, "vault"], [2, "vault", 10000000000], [3, "vault", 10000000000], [4, "vault", 10000000000], [5, "till"], [6, "vault", "till", 10000000000], [7, "till", "vault", 10000000000], [8, "till", "vault", 1], [9, "vault", 1]], "expected": [null, true, 10000000000, 20000000000, 30000000000, true, 20000000000, 0, -1, 30000000001]},
    {"id": "ex3", "visible": true, "level": 2, "note": "accounts rank by money sent; money received never counts", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "nia"], [2, "oz"], [3, "pam"], [4, "nia", 900], [5, "oz", 100], [6, "nia", "oz", 400], [7, "oz", "pam", 450], [8, "nia", "pam", 300], [9, 2], [10, 3]], "expected": [null, true, true, true, 900, 100, 500, 50, 200, ["nia(700)", "oz(450)"], ["nia(700)", "oz(450)", "pam(0)"]]},
    {"id": "ex4", "visible": true, "level": 2, "note": "equal totals go in id order; asking for more accounts than exist returns them all", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "una"], [2, "eli"], [3, "gus"], [4, "una", 50], [5, "eli", 50], [6, "una", "gus", 20], [7, "eli", "gus", 20], [8, 1], [9, 10]], "expected": [null, true, true, true, 50, 50, 30, 30, ["eli(20)"], ["eli(20)", "una(20)", "gus(0)"]]},
    {"id": "h4", "level": 2, "note": "an empty bank ranks nobody; failed transfers do not count", "ops": ["Bank", "topSpenders", "createAccount", "createAccount", "deposit", "transfer", "transfer", "topSpenders", "transfer", "topSpenders"], "args": [[], [1, 3], [2, "p"], [3, "q"], [4, "p", 15], [5, "p", "q", 16], [6, "p", "p", 5], [7, 2], [8, "p", "q", 15], [9, 1]], "expected": [null, [], true, true, 15, -1, -1, ["p(0)", "q(0)"], 0, ["p(15)"]]},
    {"id": "h5", "level": 2, "note": "ids compare as text, so b10 comes before b9", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "topSpenders"], "args": [[], [1, "b9"], [2, "b10"], [3, "a"], [4, "b9", 10], [5, "b10", 10], [6, "b9", "a", 10], [7, "b10", "a", 10], [8, 3]], "expected": [null, true, true, true, 10, 10, 0, 0, ["b10(10)", "b9(10)", "a(0)"]]},
    {"id": "h6", "level": 2, "note": "totals add up over transfers; a large deposit never counts; money passed on counts for each sender", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "transfer", "transfer", "transfer", "transfer", "topSpenders"], "args": [[], [1, "hub"], [2, "x"], [3, "y"], [4, "x", 1000000], [5, "x", "hub", 30], [6, "hub", "y", 30], [7, "x", "hub", 30], [8, "hub", "y", 25], [9, 3]], "expected": [null, true, true, true, 1000000, 999970, 0, 999940, 5, ["x(60)", "hub(55)", "y(0)"]]},
    {"id": "h22", "level": 2, "note": "equal totals go in id order whatever order the accounts were opened or are stored in", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "topSpenders", "transfer", "topSpenders"], "args": [[], [1, "zoe"], [2, "ivy"], [3, "max"], [4, "zoe", 30], [5, "max", 30], [6, "zoe", "ivy", 10], [7, "max", "ivy", 10], [8, "ivy", "zoe", 10], [9, 3], [10, "max", "zoe", 5], [11, 2]], "expected": [null, true, true, true, 30, 30, 20, 20, 10, ["ivy(10)", "max(10)", "zoe(10)"], 15, ["max(15)", "ivy(10)"]]},
    {"id": "ex5", "visible": true, "level": 3, "note": "booked transfers run at their due time, earliest due first, and count as money sent", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "deposit", "deposit", "topSpenders"], "args": [[], [1, "lou"], [2, "max"], [3, "lou", 100], [4, "lou", "max", 30, 20], [5, "lou", "max", 50, 5], [12, "max", 1], [30, "max", 1], [31, 2]], "expected": [null, true, true, 100, "transfer1", "transfer2", 51, 82, ["lou(80)", "max(0)"]]},
    {"id": "ex6", "visible": true, "level": 3, "note": "a transfer the source cannot pay when it falls due is skipped; only its source cancels it", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "cancelTransfer", "cancelTransfer", "deposit", "deposit"], "args": [[], [1, "ann"], [2, "raj"], [3, "ann", 40], [4, "ann", "raj", 50, 6], [5, "raj", "ann", 5, 20], [6, "ann", "transfer2"], [7, "raj", "transfer2"], [10, "ann", 1], [30, "raj", 1]], "expected": [null, true, true, 40, "transfer1", "transfer2", false, true, 41, 1]},
    {"id": "h7", "level": 3, "note": "booking needs two distinct existing accounts but not the funds; failed bookings use no number", "ops": ["Bank", "createAccount", "createAccount", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "deposit", "scheduleTransfer", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", "a", 5, 5], [4, "a", "nope", 5, 5], [5, "nope", "b", 5, 5], [6, "a", "b", 40, 10], [7, "a", 40], [8, "b", "a", 5, 5], [20, "b", 1], [21, 2]], "expected": [null, true, true, "", "", "", "transfer1", 40, "transfer2", 41, ["a(40)", "b(0)"]]},
    {"id": "h8", "level": 3, "note": "transfers due at the same time run in booking order, before the call at that time", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "transfer", "deposit", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "a", 90], [10, "a", "b", 60, 20], [20, "a", "c", 50, 10], [30, "a", "c", 30], [31, "b", 1], [32, "c", 1], [33, 3]], "expected": [null, true, true, true, 90, "transfer1", "transfer2", 0, 61, 31, ["a(90)", "b(0)", "c(0)"]]},
    {"id": "h9", "level": 3, "note": "a transfer due exactly at a call's timestamp lands before that call, and not a millisecond earlier", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "transfer", "transfer", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "a", 25], [5, "a", "b", 25, 15], [19, "b", "c", 25], [20, "b", "c", 25], [21, "c", 1]], "expected": [null, true, true, true, 25, "transfer1", -1, 0, 26]},
    {"id": "h10", "level": 3, "note": "a transfer booked later with a shorter delay runs first and can fund an earlier booking", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "c", 70], [5, "a", "b", 70, 40], [6, "c", "a", 70, 9], [50, "b", 1], [51, 3]], "expected": [null, true, true, true, 70, "transfer1", "transfer2", 71, ["a(70)", "c(70)", "b(0)"]]},
    {"id": "h11", "level": 3, "note": "a skipped transfer is never retried and can no longer be cancelled", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "deposit", "deposit", "cancelTransfer", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", 5], [4, "a", "b", 20, 6], [10, "a", 100], [30, "b", 1], [31, "a", "transfer1"], [32, 2]], "expected": [null, true, true, 5, "transfer1", 105, 1, false, ["a(0)", "b(0)"]]},
    {"id": "h12", "level": 3, "note": "only the source cancels, once, and only while the transfer is pending", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "deposit", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "a", 60], [4, "a", "b", 25, 10], [5, "a", "b", 15, 10], [6, "b", "transfer1"], [7, "a", "transfer3"], [8, "ghost", "transfer1"], [9, "a", "transfer1"], [10, "a", "transfer1"], [15, "a", "transfer2"], [16, "b", 1], [17, "a", 1]], "expected": [null, true, true, 60, "transfer1", "transfer2", false, false, false, true, false, false, 16, 46]},
    {"id": "h13", "level": 3, "note": "read-only calls run the transfers due by their timestamp first", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "topSpenders", "scheduleTransfer", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", 10], [4, "a", "b", 10, 6], [10, 1], [11, "b", "a", 10, 1], [12, 2]], "expected": [null, true, true, 10, "transfer1", ["a(10)"], "transfer2", ["a(10)", "b(10)"]]},
    {"id": "h21", "level": 3, "note": "three transfers due at the same time run in booking order, also after a later booking that falls due before them, so the last of the three is the one the source can no longer pay", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "deposit", "deposit", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "d"], [5, "a", 100], [6, "b", 5], [10, "a", "b", 50, 30], [11, "a", "c", 40, 29], [12, "a", "d", 30, 28], [13, "b", "c", 5, 20], [41, "a", 1], [42, "d", 1], [43, "c", 1], [44, 4]], "expected": [null, true, true, true, true, 100, 5, "transfer1", "transfer2", "transfer3", "transfer4", 11, 1, 46, ["a(90)", "b(5)", "c(0)", "d(0)"]]},
    {"id": "ex7", "visible": true, "level": 4, "note": "a merge adds up balances and totals and takes over the merged account's bookings", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "scheduleTransfer", "mergeAccounts", "deposit", "deposit", "topSpenders"], "args": [[], [1, "home"], [2, "work"], [3, "shop"], [4, "home", 200], [5, "work", 80], [6, "work", "shop", 30], [7, "work", "shop", 40, 13], [8, "home", "work"], [9, "work", 5], [21, "shop", 1], [22, 3]], "expected": [null, true, true, true, 200, 80, 50, "transfer1", true, -1, 71, ["home(70)", "shop(0)"]]},
    {"id": "ex8", "visible": true, "level": 4, "note": "balances at past times, before creation and after a merge", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "deposit", "mergeAccounts", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [5, "joy"], [6, "kip"], [7, "joy", 100], [8, "joy", "kip", 60, 4], [13, "kip", 5], [15, "joy", "kip"], [16, "joy", 4], [17, "joy", 11], [18, "joy", 12], [19, "joy", 15], [20, "kip", 14], [21, "kip", 15]], "expected": [null, true, true, 100, "transfer1", 65, true, -1, 100, 40, 105, 65, -1]},
    {"id": "h14", "level": 4, "note": "history records a scheduled transfer at its due time, not at the call that ran it", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "deposit", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [1, "a"], [2, "b"], [3, "a", 80], [4, "a", "b", 30, 16], [90, "b", 2], [91, "a", 19], [92, "a", 20], [93, "b", 20], [94, "b", 89], [95, "b", 90]], "expected": [null, true, true, 80, "transfer1", 32, 80, 50, 30, 30, 32]},
    {"id": "h15", "level": 4, "note": "a merge hands pending transfers to the kept account, as source and as target", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "mergeAccounts", "cancelTransfer", "cancelTransfer", "deposit", "deposit", "topSpenders"], "args": [[], [1, "k"], [2, "m"], [3, "z"], [4, "m", 50], [5, "z", 50], [6, "m", "z", 5, 200], [7, "z", "m", 15, 200], [8, "m", "z", 25, 200], [9, "k", "m"], [10, "m", "transfer3"], [11, "k", "transfer3"], [300, "k", 1], [301, "z", 1], [302, 3]], "expected": [null, true, true, true, 50, 50, "transfer1", "transfer2", "transfer3", true, false, true, 61, 41, ["z(15)", "k(5)"]]},
    {"id": "h16", "level": 4, "note": "a pending transfer between two merged accounts becomes a self-transfer and is skipped", "ops": ["Bank", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "scheduleTransfer", "mergeAccounts", "deposit", "topSpenders", "getBalance", "cancelTransfer"], "args": [[], [1, "a"], [2, "b"], [3, "a", 30], [4, "b", 70], [5, "a", "b", 10, 20], [6, "b", "a", 20, 20], [7, "b", "a"], [30, "b", 1], [31, 2], [32, "b", 26], [33, "b", "transfer2"]], "expected": [null, true, true, 30, 70, "transfer1", "transfer2", true, 101, ["b(0)"], 100, false]},
    {"id": "h17", "level": 4, "note": "invalid merges change nothing; a merged-away id is missing everywhere and never opened again", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "createAccount", "deposit", "deposit", "transfer", "scheduleTransfer", "scheduleTransfer", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "a", "a"], [5, "a", "nope"], [6, "nope", "a"], [7, "a", "b"], [8, "a", "b"], [9, "b", "c"], [10, "b"], [11, "b", 5], [12, "a", 5], [13, "a", "b", 1], [14, "b", "c", 1, 5], [15, "a", "c", 1, 5], [30, 5]], "expected": [null, true, true, true, false, false, false, true, false, false, false, -1, 5, -1, "", "transfer1", ["a(1)", "c(0)"]]},
    {"id": "h18", "level": 4, "note": "getBalance is -1 before creation, from the merge on and for unknown ids, and answers for times before the merge", "ops": ["Bank", "createAccount", "createAccount", "deposit", "deposit", "mergeAccounts", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [10, "p"], [20, "q"], [30, "p", 4], [40, "q", 9], [50, "p", "q"], [60, "p", 9], [61, "p", 10], [62, "p", 49], [63, "p", 50], [64, "q", 19], [65, "q", 49], [66, "q", 50], [67, "q", 66], [68, "ghost", 30], [69, "p", 69]], "expected": [null, true, true, 4, 9, true, -1, 0, 4, 13, -1, 9, -1, -1, -1, 13]},
    {"id": "h19", "level": 4, "note": "chained merges: a transfer booked by c runs from a once c went into b and b into a", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "transfer", "mergeAccounts", "mergeAccounts", "topSpenders", "cancelTransfer", "cancelTransfer", "deposit", "getBalance", "getBalance", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "d"], [5, "c", 500], [6, "c", "d", 200, 994], [7, "c", "b", 100], [8, "b", "c"], [9, "a", "b"], [10, 4], [11, "c", "transfer1"], [12, "b", "transfer1"], [1500, "d", 1], [1501, "a", 999], [1502, "a", 1000], [1503, 2]], "expected": [null, true, true, true, true, 500, "transfer1", 400, true, true, ["a(100)", "d(0)"], false, false, 201, 500, 300, ["a(300)", "d(0)"]]},
    {"id": "h20", "level": 4, "note": "getBalance at the call's own time sees transfers due then; several changes at one moment answer with the last", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "getBalance", "getBalance", "getBalance"], "args": [[], [1, "a"], [2, "b"], [3, "a", 50], [4, "a", "b", 20, 6], [5, "a", "b", 10, 5], [10, "a", 10], [11, "b", 10], [12, "b", 9]], "expected": [null, true, true, 50, "transfer1", "transfer2", 20, 30, 0]}
  ]
}
