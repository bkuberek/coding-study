{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["password", "reset"], "vectorHits": [2, 1, 0], "vectorScores": [0.91, 0.83, 0.4], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 3}, "expected": [0, 1, 2]},
    {"id": "ex2", "visible": true, "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["retry"], "vectorHits": [1], "vectorScores": [0.7], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 5}, "expected": [1, 3]},
    {"id": "ex3", "visible": true, "input": {"documents": [["cache", "eviction", "policy", "cache", "notes", "on", "every", "other", "subject", "too"], ["cache", "eviction"]], "query": ["cache"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [1, 0]},
    {"id": "h1", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["retry"], "vectorHits": [0, 1], "vectorScores": [0.9, 0.8], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 4}, "expected": [0, 3, 1], "note": "documents without a query term get no keyword rank, so document 2 never appears"},
    {"id": "h2", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["absent"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [], "note": "nothing matches and no hits: an empty result"},
    {"id": "h3", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": [], "vectorHits": [3, 0], "vectorScores": [0.5, 0.2], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [3, 0], "note": "an empty query leaves the vector ranking"},
    {"id": "h4", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["email", "password"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 1}, "expected": [0], "note": "no hits, and topN below the number of matches"},
    {"id": "h5", "input": {"documents": [[], [], []], "query": ["anything"], "vectorHits": [1], "vectorScores": [0.5], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [1], "note": "only empty documents: the average length is 0 and must not be divided by"},
    {"id": "h6", "input": {"documents": [["retry"], [], ["index"]], "query": ["retry", "index", "index"], "vectorHits": [1], "vectorScores": [0.57], "k1": 1.2, "b": 0.75, "rrfK": 10, "topN": 10}, "expected": [0, 1, 2], "note": "a repeated query term counts once"},
    {"id": "h7", "input": {"documents": [[], ["index"], ["index", "index", "cache", "token"]], "query": ["index"], "vectorHits": [0], "vectorScores": [-0.48], "k1": 2.0, "b": 0.5, "rrfK": 60, "topN": 10}, "expected": [0, 1, 2], "note": "the average length covers empty documents too; a negative hit still has a rank"},
    {"id": "h8", "input": {"documents": [["token", "token"], ["token"]], "query": ["token"], "vectorHits": [], "vectorScores": [], "k1": 1.5, "b": 0.0, "rrfK": 60, "topN": 10}, "expected": [0, 1], "note": "df counts documents, not occurrences"},
    {"id": "h9", "input": {"documents": [[], ["index"], ["retry", "shard", "token", "index"], [], []], "query": ["retry", "index"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 1.0, "rrfK": 60, "topN": 10}, "expected": [1, 2], "note": "N and the average cover every document, not only those that match"},
    {"id": "h10", "input": {"documents": [["token"], ["cache", "token"], []], "query": ["token"], "vectorHits": [], "vectorScores": [], "k1": 1.5, "b": 1.0, "rrfK": 2, "topN": 10}, "expected": [0, 1], "note": "a term in most documents still has a positive idf"},
    {"id": "h11", "input": {"documents": [["queue", "retry"], ["queue"]], "query": ["queue"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [1, 0], "note": "a term in every document still separates them, here by length"},
    {"id": "h12", "input": {"documents": [["retry", "retry", "retry", "retry", "retry", "retry", "retry", "retry"], ["retry", "queue", "a", "b", "c", "d", "e", "f"], ["nothing", "to", "see", "here", "at", "all", "today"]], "query": ["retry", "queue"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.0, "rrfK": 60, "topN": 10}, "expected": [1, 0], "note": "saturation: covering both terms beats repeating one"},
    {"id": "h13", "input": {"documents": [["cache"], ["cache", "cache"], []], "query": ["cache"], "vectorHits": [], "vectorScores": [], "k1": 1.5, "b": 0.75, "rrfK": 1, "topN": 10}, "expected": [1, 0], "note": "tf counts: the second mention still adds score"},
    {"id": "h14", "input": {"documents": [["token", "queue", "shard"], ["shard"]], "query": ["shard"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 1.0, "rrfK": 1, "topN": 10}, "expected": [1, 0], "note": "full length normalization: the shorter document wins"},
    {"id": "h15", "input": {"documents": [["cache", "one", "two", "three", "four", "five"], ["cache"]], "query": ["cache"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.0, "rrfK": 60, "topN": 10}, "expected": [0, 1], "note": "b = 0 ignores length, so this is a tie and the lower index wins"},
    {"id": "h16", "input": {"documents": [["queue"], ["queue"], ["queue"], ["other"]], "query": ["queue"], "vectorHits": [3, 1], "vectorScores": [0.4, 0.4], "k1": 1.2, "b": 0.75, "rrfK": 5, "topN": 10}, "expected": [1, 0, 3, 2], "note": "ties in both rankings go to the lower index"},
    {"id": "h17", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": [], "vectorHits": [1, 0, 3], "vectorScores": [0.35, 0.66, 0.5], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [0, 3, 1], "note": "hits arrive in no particular order"},
    {"id": "h18", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": [], "vectorHits": [0, 1, 2], "vectorScores": [-0.2, -0.1, -0.9], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [1, 0, 2], "note": "negative similarity still orders the hits"},
    {"id": "h19", "input": {"documents": [["cache"], ["index", "shard"], ["index"]], "query": ["index"], "vectorHits": [0, 2], "vectorScores": [0.84, 0.46], "k1": 2.0, "b": 0.0, "rrfK": 1, "topN": 10}, "expected": [2, 0, 1], "note": "ranks start at 1: from 0, the top place would outweigh two good places"},
    {"id": "h20", "input": {"documents": [[], ["retry"]], "query": ["retry"], "vectorHits": [0], "vectorScores": [-0.42], "k1": 2.0, "b": 1.0, "rrfK": 2, "topN": 10}, "expected": [0, 1], "note": "fusion ignores the size of the scores: both are first in a ranking"},
    {"id": "h21", "input": {"documents": [["retry"], []], "query": ["retry"], "vectorHits": [1], "vectorScores": [0.9], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [0, 1], "note": "a fused tie goes to the lower index even when it comes from the keyword ranking"},
    {"id": "h22", "input": {"documents": [["reset", "password", "email"], ["password", "policy"], ["rotate", "signing", "key"], ["email", "delivery", "retry", "queue"]], "query": ["email"], "vectorHits": [3, 0], "vectorScores": [0.9, 0.8], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 1}, "expected": [0], "note": "topN of 1"},
    {"id": "h23", "input": {"documents": [["error", "e42", "appears", "after", "a", "failed", "retry"], ["retry", "the", "upload", "after", "the", "quota", "resets"], ["quota", "limits", "for", "shared", "workspaces"], ["how", "to", "read", "a", "billing", "invoice"], ["invoice", "totals", "and", "the", "billing", "period"], ["export", "a", "workspace", "with", "its", "invoices"], ["retry", "retry", "retry", "until", "the", "quota", "frees", "up"], []], "query": ["retry", "quota"], "vectorHits": [3, 1, 2], "vectorScores": [0.99, 0.2, 0.1], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [1, 2, 3, 6, 0], "note": "agreement beats a single high score: a large similarity gives no extra weight"},
    {"id": "h24", "input": {"documents": [["Cache"], ["caches"], ["cache"]], "query": ["cache"], "vectorHits": [], "vectorScores": [], "k1": 1.2, "b": 0.75, "rrfK": 60, "topN": 10}, "expected": [2], "note": "tokens are compared exactly: no case folding and no substrings"},
    {"id": "h25", "input": {"documents": [["error", "e42", "appears", "after", "a", "failed", "retry"], ["retry", "the", "upload", "after", "the", "quota", "resets"], ["quota", "limits", "for", "shared", "workspaces"], ["how", "to", "read", "a", "billing", "invoice"], ["invoice", "totals", "and", "the", "billing", "period"], ["export", "a", "workspace", "with", "its", "invoices"], ["retry", "retry", "retry", "until", "the", "quota", "frees", "up"], []], "query": ["retry", "quota", "invoice", "e42"], "vectorHits": [4, 0, 5, 6, 2], "vectorScores": [0.9, 0.85, 0.7, 0.2, -0.1], "k1": 1.5, "b": 0.6, "rrfK": 20, "topN": 5}, "expected": [0, 4, 6, 2, 1], "note": "a larger corpus with four query terms"},
    {"id": "h26", "input": {"documents": [["error", "e42", "appears", "after", "a", "failed", "retry"], ["retry", "the", "upload", "after", "the", "quota", "resets"], ["quota", "limits", "for", "shared", "workspaces"], ["how", "to", "read", "a", "billing", "invoice"], ["invoice", "totals", "and", "the", "billing", "period"], ["export", "a", "workspace", "with", "its", "invoices"], ["retry", "retry", "retry", "until", "the", "quota", "frees", "up"], []], "query": ["retry"], "vectorHits": [3, 4, 5, 2, 7], "vectorScores": [0.9, 0.8, 0.7, 0.6, 0.5], "k1": 0.1, "b": 0.3, "rrfK": 1, "topN": 4}, "expected": [3, 6, 0, 4], "note": "a small k1 and rrfK: the parameters come from the caller"},
    {"id": "h27", "input": {"documents": [["retry", "retry", "retry", "retry", "retry"], ["retry", "retry", "retry", "retry"], ["retry", "retry", "retry"], ["retry", "retry"], ["retry"], ["other"]], "query": ["retry"], "vectorHits": [5, 1, 2, 3, 4], "vectorScores": [0.9, 0.8, 0.7, 0.6, 0.5], "k1": 1.2, "b": 0.0, "rrfK": 1, "topN": 6}, "expected": [1, 0, 2, 5, 3, 4], "note": "rrfK of 1: the top place is worth as much as two middle places; with 60 it would not be"},
    {"id": "h28", "input": {"documents": [["common", "common", "common"], ["rare"], ["common"], ["common"], ["rare"], ["other"]], "query": ["common", "rare"], "vectorHits": [], "vectorScores": [], "k1": 0.1, "b": 0.0, "rrfK": 60, "topN": 10}, "expected": [1, 4, 0, 2, 3], "note": "k1 near 0: repeats add almost nothing, so the rarer term wins"}
  ]
}
