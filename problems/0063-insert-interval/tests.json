{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"intervals": [[1, 3], [6, 8], [10, 14]], "newInterval": [7, 11]}, "expected": [[1, 3], [6, 14]]},
    {"id": "ex2", "visible": true, "input": {"intervals": [[2, 4], [9, 12]], "newInterval": [5, 7]}, "expected": [[2, 4], [5, 7], [9, 12]]},
    {"id": "h1", "input": {"intervals": [], "newInterval": [4, 8]}, "expected": [[4, 8]], "note": "empty list"},
    {"id": "h2", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [0, 0]}, "expected": [[0, 0], [1, 3], [6, 9], [12, 12], [15, 20]], "note": "before every interval"},
    {"id": "h3", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [21, 30]}, "expected": [[1, 3], [6, 9], [12, 12], [15, 20], [21, 30]], "note": "after every interval"},
    {"id": "h4", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [0, 25]}, "expected": [[0, 25]], "note": "swallows every interval"},
    {"id": "h5", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [7, 8]}, "expected": [[1, 3], [6, 9], [12, 12], [15, 20]], "note": "inside an existing interval: nothing changes"},
    {"id": "h6", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [4, 6]}, "expected": [[1, 3], [4, 9], [12, 12], [15, 20]], "note": "touches the start of an interval"},
    {"id": "h7", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [9, 10]}, "expected": [[1, 3], [6, 10], [12, 12], [15, 20]], "note": "touches the end of an interval"},
    {"id": "h8", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [3, 6]}, "expected": [[1, 9], [12, 12], [15, 20]], "note": "touches two intervals and bridges them"},
    {"id": "h9", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [13, 13]}, "expected": [[1, 3], [6, 9], [12, 12], [13, 13], [15, 20]], "note": "a point in a gap"},
    {"id": "h10", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [12, 12]}, "expected": [[1, 3], [6, 9], [12, 12], [15, 20]], "note": "equal to an existing point interval"},
    {"id": "h11", "input": {"intervals": [[1, 3], [6, 9], [12, 12], [15, 20]], "newInterval": [10, 11]}, "expected": [[1, 3], [6, 9], [10, 11], [12, 12], [15, 20]], "note": "fills a gap without touching"},
    {"id": "h12", "input": {"intervals": [[0, 0], [1000000000, 1000000000]], "newInterval": [1, 999999999]}, "expected": [[0, 0], [1, 999999999], [1000000000, 1000000000]], "note": "extreme endpoints, no touching"},
    {"id": "h13", "input": {"intervals": [[0, 0], [1000000000, 1000000000]], "newInterval": [0, 1000000000]}, "expected": [[0, 1000000000]], "note": "extreme endpoints, everything merges"},
    {"id": "h14", "input": {"intervals": [[5, 7]], "newInterval": [1, 2]}, "expected": [[1, 2], [5, 7]], "note": "one interval, new one before it"},
    {"id": "h15", "input": {"intervals": [[5, 7]], "newInterval": [6, 10]}, "expected": [[5, 10]], "note": "one interval, partial overlap on the right"},
    {"id": "g1", "generate": {"n": 100000, "seed": 47}, "note": "large input: 10^5 existing intervals"}
  ]
}
