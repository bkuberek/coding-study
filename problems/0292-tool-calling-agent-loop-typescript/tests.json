        "body": {
          "answer": "I opened ticket T-3001 for the warehouse team, with high priority.",
          "stop": "answered",
          "steps": 3,
          "calls": [
            {
              "tool": "create_ticket",
              "outcome": "invalid_arguments"
            },
            {
              "tool": "create_ticket",
              "outcome": "ok"
            }
          ]
        }
      },
      "log": [
        {
          "mock": "helpdesk",
          "route": "ticket",
          "count": 1,
          "body": {
            "priority": "high"
          }
        },
        {
          "mock": "model",
          "count": 1,
          "body": {
            "messages": [
              {},
              {},
              {},
              {
                "role": "tool",
                "tool_call_id": "call_aeea2e2b",
                "content": {
                  "error": "invalid_arguments"
                }
              }
            ]
          }
        }
      ]
    },
