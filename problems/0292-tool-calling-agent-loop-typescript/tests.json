{
  "version": 1,
  "cases": [
    {
      "id": "v1",
      "level": 1,
      "visible": true,
      "note": "a lookup the model asks for runs, its result goes back to the model, and the model's next reply is the answer",
      "request": {
        "method": "POST",
        "path": "/assist",
        "json": {
          "role": "support",
          "question": "Where is order A-1042? The customer says it hasn't arrived yet."
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "answer": "Order A-1042 shipped on 2 March 2027 with tracking number PX-55102 and is still in transit.",
          "stop": "answered",
          "steps": 2,
          "calls": [
            {
              "tool": "lookup_order",
              "outcome": "ok"
            }
          ]
        }
      },
      "log": [
        {
          "mock": "model",
          "count": 2,
          "headers": {
            "Authorization": "Bearer cs-fake-llm-key"
          }
        },
        {
          "mock": "orders",
          "route": "order-a1042",
          "count": 1
        }
      ]
    },
    {
      "id": "v2",
      "level": 1,
      "visible": true,
      "note": "a ticket whose priority the schema does not allow is refused and reported to the model, which then asks for a valid one",
      "request": {
        "method": "POST",
        "path": "/assist",
        "json": {
          "role": "support",
          "question": "Order A-1187 arrived damaged. Please open a ticket for the warehouse team."
