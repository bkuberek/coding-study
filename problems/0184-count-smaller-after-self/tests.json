{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [7, 3, 9, 3, 5]}, "expected": [3, 0, 2, 0, 0]},
    {"id": "ex2", "visible": true, "input": {"nums": [8, 6, 4, 2]}, "expected": [3, 2, 1, 0]},
    {"id": "h1", "input": {"nums": [42]}, "expected": [0], "note": "single element"},
    {"id": "h2", "input": {"nums": [5, 5, 5, 5]}, "expected": [0, 0, 0, 0], "note": "all equal: equal values are not smaller"},
    {"id": "h3", "input": {"nums": [1, 2, 3, 4, 5]}, "expected": [0, 0, 0, 0, 0], "note": "sorted ascending: all zeros"},
    {"id": "h4", "input": {"nums": [-1, -2, -3]}, "expected": [2, 1, 0], "note": "negative values, descending"},
    {"id": "h5", "input": {"nums": [1000000000, -1000000000, 1000000000, -1000000000]}, "expected": [2, 0, 1, 0], "note": "extreme values"},
    {"id": "h6", "input": {"nums": [2, 0, 1, 0, 2, 1]}, "expected": [4, 0, 1, 0, 1, 0], "note": "duplicates on both sides"},
    {"id": "h7", "input": {"nums": [0, -1, 1, -1, 0]}, "expected": [2, 0, 2, 0, 0], "note": "zero and its neighbours"},
    {"id": "h8", "input": {"nums": [3, 1]}, "expected": [1, 0], "note": "two elements, inverted"},
    {"id": "h9", "input": {"nums": [1, 3]}, "expected": [0, 0], "note": "two elements, in order"},
    {"id": "h10", "input": {"nums": [6, 1, 5, 2, 4, 3]}, "expected": [5, 0, 3, 0, 1, 0], "note": "zigzag"},
    {"id": "h11", "input": {"nums": [10, 9, 10, 9, 10]}, "expected": [2, 0, 1, 0, 0], "note": "two alternating values"},
    {"id": "g1", "generate": {"n": 5000, "seed": 1}, "note": "largest ladder size: comparing every pair is 1.25 * 10^7 steps here"},
    {"id": "g2", "generate": {"n": 5000, "seed": 2}, "note": "largest ladder size"},
    {"id": "g3", "generate": {"n": 300, "seed": 3}}
  ]
}
