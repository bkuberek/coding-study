{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["ElevatorSystem", "call", "select", "step", "status", "status", "step", "status", "step", "status", "call", "stops"], "args": [[2, 10], [5, "UP"], [1, 3], [1], [0], [1], [2], [1], [2], [0], [4, "DOWN"], [0]], "expected": [null, 0, true, null, "1:UP", "1:UP", null, "3:IDLE", null, "5:IDLE", 0, [4]]},
    {"id": "ex2", "visible": true, "ops": ["ElevatorSystem", "select", "step", "select", "select", "step", "status", "stops", "step", "status", "step", "status"], "args": [[1, 10], [0, 6], [2], [0, 1], [0, 4], [2], [0], [0], [2], [0], [5], [0]], "expected": [null, true, null, true, true, null, "4:UP", [1, 6], null, "6:DOWN", null, "1:IDLE"]},
    {"id": "h1", "note": "invalid floors, directions and cars are rejected", "ops": ["ElevatorSystem", "call", "call", "call", "call", "call", "select", "select", "select", "status", "stops", "call"], "args": [[2, 5], [-1, "UP"], [5, "DOWN"], [2, "SIDEWAYS"], [4, "UP"], [0, "DOWN"], [2, 1], [0, 5], [-1, 0], [2], [7], [4, "DOWN"]], "expected": [null, -1, -1, -1, -1, -1, false, false, false, "", [], 0]},
    {"id": "h2", "note": "a call at an idle car's floor is served at once", "ops": ["ElevatorSystem", "call", "stops", "status", "select", "stops", "step", "status"], "args": [[1, 5], [0, "UP"], [0], [0], [0, 0], [0], [3], [0]], "expected": [null, 0, [], "0:IDLE", true, [], null, "0:IDLE"]},
    {"id": "h3", "note": "nearest car: a moving car is cheap ahead of it and expensive behind it", "ops": ["ElevatorSystem", "select", "step", "call", "call", "stops", "stops", "step", "status", "status"], "args": [[2, 10], [0, 8], [2], [5, "DOWN"], [1, "UP"], [0], [1], [1], [0], [1]], "expected": [null, true, null, 0, 1, [5, 8], [1], null, "3:UP", "1:IDLE"]},
    {"id": "h4", "note": "equal costs go to the lowest car; an idle car with equally near stops goes up", "ops": ["ElevatorSystem", "select", "step", "status", "select", "select", "step", "status", "call", "call", "stops", "stops"], "args": [[3, 10], [2, 5], [5], [2], [2, 3], [2, 7], [1], [2], [6, "UP"], [2, "UP"], [0], [2]], "expected": [null, true, null, "5:IDLE", true, true, null, "6:UP", 2, 0, [2], [3, 6, 7]]},
    {"id": "h5", "note": "round robin ignores distance; invalid calls do not take a turn", "ops": ["ElevatorSystem", "setStrategy", "call", "call", "call", "call", "call", "setStrategy", "call", "stops", "stops", "stops"], "args": [[3, 10], ["ROUND_ROBIN"], [1, "UP"], [9, "UP"], [2, "UP"], [3, "DOWN"], [4, "UP"], ["NEAREST"], [1, "DOWN"], [0], [1], [2]], "expected": [null, true, 0, -1, 1, 2, 0, true, 0, [1, 4], [2], [3]]},
    {"id": "h6", "note": "unknown strategies are refused and the current one stays", "ops": ["ElevatorSystem", "setStrategy", "select", "step", "call", "setStrategy", "call"], "args": [[2, 10], ["RANDOM"], [1, 9], [1], [5, "UP"], ["round_robin"], [6, "UP"]], "expected": [null, false, true, null, 1, false, 1]},
    {"id": "h7", "note": "repeated stops are kept once", "ops": ["ElevatorSystem", "select", "select", "call", "call", "stops", "step", "stops", "step", "status", "stops"], "args": [[1, 10], [0, 4], [0, 4], [4, "UP"], [2, "DOWN"], [0], [2], [0], [2], [0], [0]], "expected": [null, true, true, 0, 0, [2, 4], null, [4], null, "4:IDLE", []]},
    {"id": "h8", "note": "a car without stops stays idle; zero ticks change nothing", "ops": ["ElevatorSystem", "step", "status", "select", "step", "status", "step", "status", "step", "status"], "args": [[2, 4], [10], [0], [1, 3], [0], [1], [3], [1], [1], [1]], "expected": [null, null, "0:IDLE", true, null, "0:IDLE", null, "3:IDLE", null, "3:IDLE"]},
    {"id": "h9", "note": "cars move independently in both directions", "ops": ["ElevatorSystem", "select", "step", "select", "select", "step", "status", "status", "step", "status", "status", "stops"], "args": [[2, 12], [0, 11], [11], [0, 2], [1, 6], [3], [0], [1], [6], [0], [1], [0]], "expected": [null, true, null, true, true, null, "8:DOWN", "3:UP", null, "2:IDLE", "6:IDLE", []]},
    {"id": "h10", "note": "a stop at the floor a moving car is passing waits for its return", "ops": ["ElevatorSystem", "select", "step", "select", "stops", "step", "status", "step", "status", "step", "status", "stops"], "args": [[1, 10], [0, 5], [2], [0, 2], [0], [3], [0], [2], [0], [1], [0], [0]], "expected": [null, true, null, true, [2, 5], null, "5:DOWN", null, "3:DOWN", null, "2:IDLE", []]}
  ]
}
