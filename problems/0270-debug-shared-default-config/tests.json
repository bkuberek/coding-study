{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["TenantSettings", "setRetries", "retries", "retries"], "args": [[], ["blue", 9], ["blue"], ["green"]], "expected": [null, null, 9, 3]},
    {"id": "ex2", "visible": true, "ops": ["TenantSettings", "retries", "requestsPerMinute", "routeLimit", "routeLimit", "channels"], "args": [[], ["green"], ["green"], ["green", "/search"], ["green", "/export"], ["green"]], "expected": [null, 3, 60, 10, -1, ["email"]]},
    {"id": "h1", "ops": ["TenantSettings", "setRequestsPerMinute", "requestsPerMinute", "requestsPerMinute"], "args": [[], ["blue", 500], ["blue"], ["green"]], "expected": [null, null, 500, 60], "note": "the report: limits is a nested object, and a shallow copy shares it"},
    {"id": "h2", "ops": ["TenantSettings", "addChannel", "channels", "channels"], "args": [[], ["blue", "sms"], ["blue"], ["green"]], "expected": [null, null, ["email", "sms"], ["email"]], "note": "the channel list is shared too: copying limits alone is not enough"},
    {"id": "h3", "ops": ["TenantSettings", "setRouteLimit", "routeLimit", "routeLimit"], "args": [[], ["blue", "/search", 99], ["blue", "/search"], ["green", "/search"]], "expected": [null, null, 99, 10], "note": "one level deeper still: copying limits with a spread shares perRoute"},
    {"id": "h4", "ops": ["TenantSettings", "setRouteLimit", "routeLimit", "routeLimit"], "args": [[], ["blue", "/export", 5], ["blue", "/export"], ["green", "/export"]], "expected": [null, null, 5, -1], "note": "a new route on one tenant is on that tenant only"},
    {"id": "h5", "ops": ["TenantSettings", "channels", "addChannel", "channels", "requestsPerMinute", "setRequestsPerMinute", "requestsPerMinute"], "args": [[], ["green"], ["blue", "sms"], ["green"], ["green"], ["blue", 500], ["green"]], "expected": [null, ["email"], null, ["email"], 60, null, 60], "note": "a tenant that has already been read is not touched by a later change to another"},
    {"id": "h6", "ops": ["TenantSettings", "addChannel", "addChannel", "setRequestsPerMinute", "setRetries", "channels", "requestsPerMinute", "retries"], "args": [[], ["blue", "sms"], ["blue", "webhook"], ["blue", 500], ["blue", 7], ["blue"], ["blue"], ["blue"]], "expected": [null, null, null, null, null, ["email", "sms", "webhook"], 500, 7], "note": "changes add up: a copy on every call would lose the earlier ones"},
    {"id": "h7", "ops": ["TenantSettings", "setRequestsPerMinute", "setRequestsPerMinute", "addChannel", "addChannel", "requestsPerMinute", "requestsPerMinute", "channels", "channels"], "args": [[], ["blue", 500], ["green", 700], ["blue", "sms"], ["green", "pager"], ["blue"], ["green"], ["blue"], ["green"]], "expected": [null, null, null, null, null, 500, 700, ["email", "sms"], ["email", "pager"]], "note": "two changed tenants stay apart"},
    {"id": "h8", "ops": ["TenantSettings", "setRequestsPerMinute", "addChannel", "setRouteLimit", "reset", "requestsPerMinute", "channels", "routeLimit"], "args": [[], ["blue", 500], ["blue", "sms"], ["blue", "/search", 99], ["blue"], ["blue"], ["blue"], ["blue", "/search"]], "expected": [null, null, null, null, null, 60, ["email"], 10], "note": "reset means the real defaults: this only holds if nothing ever changed them"},
    {"id": "h9", "ops": ["TenantSettings", "reset", "retries", "channels"], "args": [[], ["never-seen"], ["never-seen"], ["never-seen"]], "expected": [null, null, 3, ["email"]], "note": "resetting a tenant with no changes is harmless"},
    {"id": "h10", "ops": ["TenantSettings", "setRetries", "setRequestsPerMinute", "reset", "setRouteLimit", "retries", "requestsPerMinute", "routeLimit", "routeLimit"], "args": [[], ["blue", 0], ["blue", 0], ["blue"], ["blue", "/a", 0], ["blue"], ["blue"], ["blue", "/a"], ["blue", "/search"]], "expected": [null, null, null, null, null, 3, 60, 0, 10], "note": "a limit of 0 is a limit, not a missing one"}
  ]
}
