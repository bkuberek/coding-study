{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "addTask", "validate", "runOrder"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean", "users"]], ["users", []], ["clean", []], [], []], "expected": [null, true, true, true, true, false, [], ["extract", "clean", "users", "report"]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "addTask", "addTask", "validate", "runOrder"], "args": [[], ["a", ["b"]], ["b", ["c"]], ["c", ["a"]], ["d", ["zzz"]], ["e", ["e"]], ["f", []], [], []], "expected": [null, true, true, true, true, true, true, [["cycle", "a"], ["cycle", "b"], ["cycle", "c"], ["cycle", "e"], ["unknown-dependency", "d", "zzz"]], []]},
    {"id": "h1", "level": 1, "note": "the smallest ready name goes next, by character codes, not level by level", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "addTask", "addTask", "runOrder"], "args": [[], ["a", []], ["c", []], ["b", ["a"]], ["B", []], ["10", []], ["9", []], []], "expected": [null, true, true, true, true, true, true, ["10", "9", "B", "a", "b", "c"]]},
    {"id": "h2", "level": 1, "note": "a task may depend on one added after it", "ops": ["PipelineScheduler", "addTask", "addTask", "validate", "runOrder"], "args": [[], ["load", ["fetch"]], ["fetch", []], [], []], "expected": [null, true, true, [], ["fetch", "load"]]},
    {"id": "h3", "level": 1, "note": "a dependency listed twice counts once, and a second add of a name changes nothing", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "validate", "runOrder"], "args": [[], ["x", ["a", "a"]], ["a", []], ["a", ["x"]], [], []], "expected": [null, true, true, false, [], ["a", "x"]]},
    {"id": "h4", "level": 1, "note": "a task that depends on a cycle is not on it; rows sort by code first, and the order is empty", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "validate", "runOrder"], "args": [[], ["a", ["b"]], ["b", ["a"]], ["c", ["a", "q"]], ["0", ["p", "m"]], [], []], "expected": [null, true, true, true, true, [["cycle", "a"], ["cycle", "b"], ["unknown-dependency", "0", "m"], ["unknown-dependency", "0", "p"], ["unknown-dependency", "c", "q"]], []]},
    {"id": "h5", "level": 1, "note": "a task between two cycles is on neither of them", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "addTask", "validate"], "args": [[], ["A1", ["A2"]], ["A2", ["A1", "X"]], ["X", ["B1"]], ["B1", ["B2"]], ["B2", ["B1"]], []], "expected": [null, true, true, true, true, true, [["cycle", "A1"], ["cycle", "A2"], ["cycle", "B1"], ["cycle", "B2"]]]},
    {"id": "h6", "level": 1, "note": "a task that depends on itself is a cycle of one; an empty pipeline is valid", "ops": ["PipelineScheduler", "validate", "runOrder", "addTask", "addTask", "validate", "runOrder"], "args": [[], [], [], ["e", ["e"]], ["f", ["e"]], [], []], "expected": [null, [], [], true, true, [["cycle", "e"]], []]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "markDone", "markDone", "markDone", "markDone", "markDone", "runnable", "runnable", "markDone", "runnable", "runnable"], "args": [[], ["extract", []], ["clean", ["extract"]], ["weekly", ["clean"]], ["weekly", "clean", 3], ["extract", 1], ["extract", 2], ["extract", 3], ["clean", 2], ["clean", 3], [1], [3], ["clean", 1], [3], [4]], "expected": [null, true, true, true, true, null, null, null, null, null, ["clean"], [], null, ["weekly"], ["extract"]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "setWindow", "markDone", "markDone", "runnable", "markDone", "markDone", "runnable"], "args": [[], ["extract", []], ["clean", ["extract"]], ["weekly", ["clean"]], ["weekly", "clean", 3], ["weekly", "extract", 2], ["extract", 0], ["clean", 0], [1], ["extract", 1], ["clean", 1], [1]], "expected": [null, true, true, true, true, false, null, null, ["extract"], null, null, ["weekly"]]},
    {"id": "h7", "level": 2, "note": "a window of one day is the default: the same day only", "ops": ["PipelineScheduler", "addTask", "addTask", "setWindow", "markDone", "runnable", "runnable"], "args": [[], ["a", []], ["b", ["a"]], ["b", "a", 1], ["a", 4], [4], [5]], "expected": [null, true, true, true, null, ["b"], ["a"]]},
    {"id": "h8", "level": 2, "note": "a window that reaches before day 0 needs only the days from 0 on", "ops": ["PipelineScheduler", "addTask", "addTask", "setWindow", "markDone", "runnable", "markDone", "runnable", "runnable"], "args": [[], ["a", []], ["b", ["a"]], ["b", "a", 7], ["a", 0], [0], ["a", 1], [1], [2]], "expected": [null, true, true, true, null, ["b"], null, ["b"], ["a"]]},
    {"id": "h9", "level": 2, "note": "each dependency has its own window, and the answer is sorted by name", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "setWindow", "markDone", "markDone", "markDone", "runnable", "runnable"], "args": [[], ["m", []], ["n", []], ["z", ["m", "n"]], ["k", ["m"]], ["z", "m", 2], ["m", 5], ["n", 6], ["m", 6], [5], [6]], "expected": [null, true, true, true, true, true, null, null, null, ["k", "n"], ["k", "z"]]},
    {"id": "h10", "level": 2, "note": "a done partition is not runnable, and a task without dependencies is runnable any day", "ops": ["PipelineScheduler", "addTask", "addTask", "markDone", "markDone", "runnable", "runnable", "runnable"], "args": [[], ["a", []], ["b", ["a"]], ["a", 2], ["b", 2], [2], [3], [9000]], "expected": [null, true, true, null, null, [], ["a"], ["a"]]},
    {"id": "h11", "level": 2, "note": "a window can only be set on a real dependency, and a refused one changes nothing", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "setWindow", "setWindow", "markDone", "markDone", "markDone", "runnable"], "args": [[], ["a", []], ["b", ["a"]], ["c", []], ["b", "c", 3], ["a", "b", 2], ["x", "a", 2], ["a", 3], ["c", 1], ["c", 2], [3]], "expected": [null, true, true, true, false, false, false, null, null, null, ["b", "c"]]},
    {"id": "h12", "level": 2, "note": "every day of the window is needed, not just its ends", "ops": ["PipelineScheduler", "addTask", "addTask", "setWindow", "markDone", "markDone", "runnable", "markDone", "runnable", "runnable"], "args": [[], ["a", []], ["b", ["a"]], ["b", "a", 3], ["a", 1], ["a", 3], [3], ["a", 2], [3], [4]], "expected": [null, true, true, true, null, null, [], null, ["b"], ["a"]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setRetries", "script", "run", "status", "script", "run", "status", "status"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean"]], ["clean", 1], ["clean", 1, ["fail", "ok"]], [1], ["clean", 1], ["report", 2, ["fail"]], [2], ["report", 2], ["report", 1]], "expected": [null, true, true, true, null, null, [["extract", "success", "1"], ["clean", "success", "2"], ["report", "success", "1"]], "done", null, [["extract", "success", "1"], ["clean", "success", "1"], ["report", "failed", "1"]], "failed", "done"]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "script", "run", "status", "run", "status", "run"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean"]], ["extract", 3, ["fail"]], [3], ["clean", 3], [3], ["report", 3], [3]], "expected": [null, true, true, true, null, [["extract", "failed", "1"], ["clean", "skipped", "0"], ["report", "skipped", "0"]], "missing", [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]], "done", [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]]]},
    {"id": "h13", "level": 3, "note": "retries are extra attempts: two retries make three attempts", "ops": ["PipelineScheduler", "addTask", "setRetries", "script", "run", "status", "run"], "args": [[], ["a", []], ["a", 2], ["a", 1, ["fail", "fail", "fail", "fail"]], [1], ["a", 1], [1]], "expected": [null, true, null, null, [["a", "failed", "3"]], "failed", [["a", "success", "2"]]]},
    {"id": "h14", "level": 3, "note": "outcomes not used by one run wait for the next run of that partition", "ops": ["PipelineScheduler", "addTask", "script", "run", "run", "run", "run"], "args": [[], ["a", []], ["a", 1, ["fail", "fail", "ok"]], [1], [1], [1], [1]], "expected": [null, true, null, [["a", "failed", "1"]], [["a", "failed", "1"]], [["a", "success", "1"]], [["a", "success", "1"]]]},
    {"id": "h15", "level": 3, "note": "a rerun overwrites: attempts start again, and a failed rerun leaves the partition failed", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setRetries", "script", "run", "run", "script", "run", "status", "status", "status"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean"]], ["clean", 2], ["clean", 1, ["fail", "ok"]], [1], [1], ["clean", 1, ["fail", "fail", "fail"]], [1], ["extract", 1], ["clean", 1], ["report", 1]], "expected": [null, true, true, true, null, null, [["extract", "success", "1"], ["clean", "success", "2"], ["report", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]], null, [["extract", "success", "1"], ["clean", "failed", "3"], ["report", "skipped", "0"]], "done", "failed", "done"]},
    {"id": "h16", "level": 3, "note": "a task is skipped when a partition of an earlier day in its window is not done", "ops": ["PipelineScheduler", "addTask", "addTask", "setWindow", "run", "run", "run"], "args": [[], ["a", []], ["b", ["a"]], ["b", "a", 2], [5], [4], [5]], "expected": [null, true, true, true, [["a", "success", "1"], ["b", "skipped", "0"]], [["a", "success", "1"], ["b", "skipped", "0"]], [["a", "success", "1"], ["b", "success", "1"]]]},
    {"id": "h17", "level": 3, "note": "a run follows the run order, not the names", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "script", "run", "run"], "args": [[], ["a", ["z"]], ["z", []], ["m", ["a"]], ["z", 0, ["fail"]], [0], [0]], "expected": [null, true, true, true, null, [["z", "failed", "1"], ["a", "skipped", "0"], ["m", "skipped", "0"]], [["z", "success", "1"], ["a", "success", "1"], ["m", "success", "1"]]]},
    {"id": "h18", "level": 3, "note": "a new script replaces the unused outcomes; retries belong to one task", "ops": ["PipelineScheduler", "addTask", "addTask", "setRetries", "script", "script", "script", "run"], "args": [[], ["a", []], ["b", []], ["a", 1], ["a", 1, ["fail", "fail", "fail"]], ["a", 1, ["fail"]], ["b", 1, ["fail", "ok"]], [1]], "expected": [null, true, true, null, null, null, null, [["a", "success", "2"], ["b", "failed", "1"]]]},
    {"id": "h19", "level": 3, "note": "a skipped partition keeps its state: missing if it never ran, done if it had", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "run", "script", "script", "run", "run", "status", "status", "status", "status"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean"]], [1], ["extract", 1, ["fail"]], ["extract", 2, ["fail"]], [1], [2], ["clean", 1], ["clean", 2], ["extract", 2], ["report", 7]], "expected": [null, true, true, true, [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]], null, null, [["extract", "failed", "1"], ["clean", "skipped", "0"], ["report", "success", "1"]], [["extract", "failed", "1"], ["clean", "skipped", "0"], ["report", "skipped", "0"]], "done", "missing", "failed", "missing"]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "run", "run", "run", "run", "stale", "stale", "run", "stale", "stale", "plan"], "args": [[], ["extract", []], ["clean", ["extract"]], ["weekly", ["clean"]], ["weekly", "clean", 2], [0], [1], [2], [3], [2], [3], [2], [2], [3], ["extract", 2, 2]], "expected": [null, true, true, true, true, [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [], [], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [], ["weekly"], [["2", "extract"], ["2", "clean"], ["2", "weekly"], ["3", "weekly"]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "run", "run", "run", "plan", "backfill", "stale"], "args": [[], ["extract", []], ["clean", ["extract"]], ["weekly", ["clean"]], ["weekly", "clean", 2], [0], [1], [2], ["clean", 0, 1], ["clean", 0, 1, 2], [2]], "expected": [null, true, true, true, true, [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["extract", "success", "1"], ["clean", "success", "1"], ["weekly", "success", "1"]], [["0", "clean"], ["0", "weekly"], ["1", "clean"], ["1", "weekly"], ["2", "weekly"]], [["1", "0", "clean", "success", "1"], ["1", "1", "clean", "success", "1"], ["2", "0", "weekly", "success", "1"], ["2", "1", "weekly", "success", "1"], ["3", "2", "weekly", "success", "1"]], []]},
    {"id": "h20", "level": 4, "note": "a partition goes stale when an input is written again or is no longer done, and a rerun fixes it", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "run", "stale", "markDone", "stale", "script", "run", "stale", "run", "stale"], "args": [[], ["extract", []], ["clean", ["extract"]], ["report", ["clean"]], [1], [1], ["extract", 1], [1], ["clean", 1, ["fail"]], [1], [1], [1], [1]], "expected": [null, true, true, true, [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]], [], null, ["clean"], null, [["extract", "success", "1"], ["clean", "failed", "1"], ["report", "skipped", "0"]], ["report"], [["extract", "success", "1"], ["clean", "success", "1"], ["report", "success", "1"]], []]},
    {"id": "h21", "level": 4, "note": "a partition marked done without its input goes stale when the input is written", "ops": ["PipelineScheduler", "addTask", "addTask", "markDone", "stale", "markDone", "stale"], "args": [[], ["a", []], ["b", ["a"]], ["b", 1], [1], ["a", 1], [1]], "expected": [null, true, true, null, [], null, ["b"]]},
    {"id": "h22", "level": 4, "note": "a plan follows windows to later days and on downstream, skips what is not done, and sorts by run order", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "addTask", "setWindow", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "plan", "plan", "script", "run", "plan"], "args": [[], ["z0", []], ["b1", ["z0"]], ["a2", ["b1"]], ["x", []], ["b1", "z0", 2], ["z0", 1], ["z0", 2], ["z0", 3], ["z0", 4], ["b1", 2], ["b1", 3], ["b1", 4], ["a2", 2], ["a2", 3], ["x", 2], ["z0", 2, 2], ["z0", 1, 1], ["a2", 4, ["fail"]], [4], ["z0", 3, 3]], "expected": [null, true, true, true, true, true, null, null, null, null, null, null, null, null, null, null, [["2", "z0"], ["2", "b1"], ["2", "a2"], ["3", "b1"], ["3", "a2"]], [["1", "z0"], ["2", "b1"], ["2", "a2"]], null, [["x", "success", "1"], ["z0", "success", "1"], ["b1", "success", "1"], ["a2", "failed", "1"]], [["3", "z0"], ["3", "b1"], ["3", "a2"], ["4", "b1"]]]},
    {"id": "h23", "level": 4, "note": "the cap limits each round, and attempts follow retries and scripts", "ops": ["PipelineScheduler", "addTask", "addTask", "setRetries", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "script", "backfill"], "args": [[], ["a", []], ["b", ["a"]], ["a", 1], ["a", 1], ["b", 1], ["a", 2], ["b", 2], ["a", 3], ["b", 3], ["a", 2, ["fail", "ok"]], ["a", 1, 3, 1]], "expected": [null, true, true, null, null, null, null, null, null, null, null, [["1", "1", "a", "success", "1"], ["2", "1", "b", "success", "1"], ["3", "2", "a", "success", "2"], ["4", "2", "b", "success", "1"], ["5", "3", "a", "success", "1"], ["6", "3", "b", "success", "1"]]]},
    {"id": "h24", "level": 4, "note": "a failure skips the partitions that need it in the next round, while the others go on", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "markDone", "markDone", "markDone", "markDone", "markDone", "markDone", "script", "backfill", "status", "status", "stale", "stale"], "args": [[], ["a", []], ["b", ["a"]], ["c", ["b"]], ["a", 1], ["b", 1], ["c", 1], ["a", 2], ["b", 2], ["c", 2], ["a", 1, ["fail"]], ["a", 1, 2, 5], ["a", 1], ["b", 1], [1], [2]], "expected": [null, true, true, true, null, null, null, null, null, null, null, [["1", "1", "a", "failed", "1"], ["1", "2", "a", "success", "1"], ["2", "1", "b", "skipped", "0"], ["2", "1", "c", "skipped", "0"], ["2", "2", "b", "success", "1"], ["3", "2", "c", "success", "1"]], "failed", "done", ["b"], []]},
    {"id": "h25", "level": 4, "note": "a planned partition whose input outside the plan is not done is skipped at once", "ops": ["PipelineScheduler", "addTask", "addTask", "addTask", "setWindow", "markDone", "markDone", "markDone", "markDone", "backfill"], "args": [[], ["a", []], ["b", ["a"]], ["c", ["b"]], ["b", "a", 2], ["a", 2], ["a", 3], ["b", 3], ["c", 3], ["b", 2, 3, 3]], "expected": [null, true, true, true, true, null, null, null, null, [["1", "2", "b", "skipped", "0"], ["1", "3", "b", "success", "1"], ["2", "3", "c", "success", "1"]]]},
    {"id": "h26", "level": 4, "note": "oldest days first when the cap holds partitions back, and nothing is stale after", "ops": ["PipelineScheduler", "addTask", "backfill", "status", "addTask", "run", "run", "markDone", "stale", "backfill", "stale"], "args": [[], ["a", []], ["a", 3, 6, 2], ["a", 6], ["b", ["a"]], [3], [4], ["a", 3], [3], ["a", 3, 3, 1], [3]], "expected": [null, true, [["1", "3", "a", "success", "1"], ["1", "4", "a", "success", "1"], ["2", "5", "a", "success", "1"], ["2", "6", "a", "success", "1"]], "done", true, [["a", "success", "1"], ["b", "success", "1"]], [["a", "success", "1"], ["b", "success", "1"]], null, ["b"], [["1", "3", "a", "success", "1"], ["2", "3", "b", "success", "1"]], []]}
  ]
}
