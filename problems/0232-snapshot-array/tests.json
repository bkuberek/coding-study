{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["SnapshotArray", "set", "set", "snap", "set", "get", "get", "snap", "get"], "args": [[4], [1, 7], [2, 3], [], [1, 9], [1, 0], [2, 0], [], [1, 1]], "expected": [null, null, null, 0, null, 7, 3, 1, 9]},
    {"id": "ex2", "visible": true, "ops": ["SnapshotArray", "snap", "snap", "get", "set", "snap", "get", "get"], "args": [[2], [], [], [0, 1], [0, 4], [], [0, 1], [0, 2]], "expected": [null, 0, 1, 0, null, 2, 0, 4]},
    {"id": "h1", "ops": ["SnapshotArray", "snap", "get"], "args": [[1], [], [0, 0]], "expected": [null, 0, 0], "note": "one position, never written"},
    {"id": "h2", "ops": ["SnapshotArray", "set", "set", "set", "snap", "get"], "args": [[3], [0, 5], [0, 6], [0, 8], [], [0, 0]], "expected": [null, null, null, null, 0, 8], "note": "the last write before a snapshot wins"},
    {"id": "h3", "ops": ["SnapshotArray", "set", "snap", "set", "get", "get"], "args": [[2], [1, 4], [], [1, 10], [0, 0], [1, 0]], "expected": [null, null, 0, null, 0, 4], "note": "a write after the last snapshot is not in it"},
    {"id": "h4", "ops": ["SnapshotArray", "set", "snap", "snap", "snap", "get", "get", "set", "snap", "get", "get"], "args": [[1], [0, 3], [], [], [], [0, 0], [0, 2], [0, 1], [], [0, 3], [0, 2]], "expected": [null, null, 0, 1, 2, 3, 3, null, 3, 1, 3], "note": "snapshots without changes in between"},
    {"id": "h5", "ops": ["SnapshotArray", "set", "snap", "set", "snap", "get", "get"], "args": [[2], [1, 6], [], [1, 0], [], [1, 0], [1, 1]], "expected": [null, null, 0, null, 1, 6, 0], "note": "writing 0 over a value"},
    {"id": "h6", "ops": ["SnapshotArray", "set", "snap", "get", "get"], "args": [[50000], [49999, 1000000000], [], [49999, 0], [0, 0]], "expected": [null, null, 0, 1000000000, 0], "note": "largest length, index and value"},
    {"id": "h7", "ops": ["SnapshotArray", "set", "snap", "set", "snap", "set", "snap", "get", "get", "get"], "args": [[3], [2, 1], [], [2, 2], [], [2, 3], [], [2, 0], [2, 1], [2, 2]], "expected": [null, null, 0, null, 1, null, 2, 1, 2, 3], "note": "every older snapshot keeps its value"},
    {"id": "h8", "ops": ["SnapshotArray", "set", "set", "snap", "set", "set", "snap", "get", "get", "get", "get"], "args": [[5], [0, 11], [4, 44], [], [0, 12], [3, 33], [], [0, 0], [0, 1], [3, 0], [4, 1]], "expected": [null, null, null, 0, null, null, 1, 11, 12, 0, 44], "note": "several positions interleaved"},
    {"id": "h9", "ops": ["SnapshotArray", "snap", "set", "snap", "snap", "set", "snap", "snap", "get", "get", "get", "get", "get"], "args": [[2], [], [0, 8], [], [], [0, 9], [], [], [0, 0], [0, 1], [0, 2], [0, 3], [0, 4]], "expected": [null, 0, null, 1, 2, null, 3, 4, 0, 8, 8, 9, 9], "note": "writes at only some snapshots"},
    {"id": "h10", "ops": ["SnapshotArray", "snap", "set", "get", "snap", "get"], "args": [[3], [], [1, 2], [1, 0], [], [1, 1]], "expected": [null, 0, null, 0, 1, 2], "note": "a value written after a snapshot appears only in the next one"},
    {"id": "g1", "generate": {"n": 20000, "seed": 232}, "note": "large input: scanning the write log costs about 2 * 10^7 steps"}
  ]
}
