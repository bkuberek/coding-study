{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"rows": [["c-100", "5403", "250000.00", "2026-01-01"], ["C-101", "54O3", "12.345", "2026-02-30"]]}, "expected": ["1:contractorId:invalid", "1:classCode:invalid", "1:payroll:invalid", "1:periodStart:invalid"]},
    {"id": "ex2", "visible": true, "input": {"rows": [["c-100", "5403", "250000.00", "2026-01-01"], ["c-100", "5403", "99.50", "2026-01-01"], ["c-100", "5403", "99.50", "2026-02-01"]]}, "expected": ["1:row:duplicate"]},
    {"id": "ex3", "visible": true, "input": {"rows": [["c-1", "5403", "100"], ["", "", "", ""], ["c-2", "5403", "100", "2026-01-01", "extra"]]}, "expected": ["0:row:column-count", "1:contractorId:missing", "1:classCode:missing", "1:payroll:missing", "1:periodStart:missing", "2:row:column-count"]},
    {"id": "h1", "input": {"rows": []}, "expected": [], "note": "no rows"},
    {"id": "h2", "input": {"rows": [["c-100", "5403", "250000.00", "2026-01-01"], ["c-100", "5645", "1", "2026-01-01"], ["c-101", "5403", "1000000000", "2099-12-31"], ["c-102", "0000", "0.01", "2000-01-01"]]}, "expected": [], "note": "all valid, including every boundary"},
    {"id": "h3", "input": {"rows": [["c-1", "5403", "10", "2027-02-29"], ["c-1", "5403", "10", "2028-02-29"], ["c-1", "5403", "10", "20260101"], ["c-1", "5403", "10", "2026-1-01"], ["c-1", "5403", "10", "2026-04-31"], ["c-1", "5403", "10", "2026-13-01"], ["c-1", "5403", "10", "1999-12-31"], ["c-1", "5403", "10", "2100-01-01"], ["c-1", "5403", "10", "2026-00-10"], ["c-1", "5403", "10", "2026-01-01 "]]}, "expected": ["0:periodStart:invalid", "2:periodStart:invalid", "3:periodStart:invalid", "4:periodStart:invalid", "5:periodStart:invalid", "6:periodStart:out-of-range", "7:periodStart:out-of-range", "8:periodStart:invalid", "9:periodStart:invalid"], "note": "calendar checks: only 2028-02-29 is valid"},
    {"id": "h4", "input": {"rows": [["c-1", "5403", "0", "2026-01-01"], ["c-1", "5403", "0.00", "2026-02-01"], ["c-1", "5403", "1000000000.01", "2026-03-01"], ["c-1", "5403", "1e5", "2026-04-01"], ["c-1", "5403", "-5", "2026-05-01"], ["c-1", "5403", " 5", "2026-06-01"], ["c-1", "5403", "5.", "2026-07-01"], ["c-1", "5403", ".5", "2026-08-01"], ["c-1", "5403", "007.5", "2026-09-01"], ["c-1", "5403", "0.001", "2026-10-01"], ["c-1", "5403", "1,000", "2026-11-01"]]}, "expected": ["0:payroll:out-of-range", "1:payroll:out-of-range", "2:payroll:out-of-range", "3:payroll:invalid", "4:payroll:invalid", "5:payroll:invalid", "6:payroll:invalid", "7:payroll:invalid", "9:payroll:invalid", "10:payroll:invalid"], "note": "payroll format and range"},
    {"id": "h5", "input": {"rows": [["c-100", "5401", "250000.00", "2026-01-01"], ["c-100", "5402", "250000.00", "2026-01-01"], ["c-100", "540", "250000.00", "2026-01-01"], ["c-100", "5404", "250000.00", "2026-01-01"], ["c-100", "5405", "250000.00", "2026-01-01"], ["c-100", "5406", "250000.00", "2026-01-01"], ["c-100", "5407", "250000.00", "2026-01-01"], ["c-100", "5408", "250000.00", "2026-01-01"], ["c-100", "5409", "250000.00", "2026-01-01"], ["c-100", "5410", "250000.00", "2026-01-01"], ["c-100", "x", "250000.00", "2026-01-01"], ["c-100", "", "250000.00", "2026-01-01"]]}, "expected": ["2:classCode:invalid", "10:classCode:invalid", "11:classCode:missing"], "note": "row 10 sorts after row 2 and row 9: numeric order"},
    {"id": "h6", "input": {"rows": [["c-1", "54O3", "10", "2026-01-01"], ["c-1", "54O3", "10", "2026-01-01"], ["c-2", "5403", "abc", "2026-01-01"], ["c-2", "5403", "10", "2026-01-01"], ["c-2", "5403", "-1", "2026-01-01"], ["c-2", "5403", "10", "2026-01-01"]]}, "expected": ["0:classCode:invalid", "1:classCode:invalid", "2:payroll:invalid", "3:row:duplicate", "4:payroll:invalid", "4:row:duplicate", "5:row:duplicate"], "note": "invalid keys never collide; payroll does not matter for duplicates"},
    {"id": "h7", "input": {"rows": [["c-1", "٥٤٠٣", "100", "2026-01-01"], ["c-1", "5403", "١٠٠", "2026-01-01"], ["c-1", "5645", "100", "２０２６-01-01"]]}, "expected": ["0:classCode:invalid", "1:payroll:invalid", "2:periodStart:invalid"], "note": "non-ASCII digits are invalid everywhere"},
    {"id": "h8", "input": {"rows": [["abcdefghij0123456789", "5403", "10", "2026-01-01"], ["abcdefghij0123456789x", "5403", "10", "2026-01-01"], ["C-1", "5403", "10", "2026-01-01"], ["c_1", "5403", "10", "2026-01-01"], [" c-1", "5403", "10", "2026-01-01"], ["-", "5403", "10", "2026-01-01"]]}, "expected": ["1:contractorId:invalid", "2:contractorId:invalid", "3:contractorId:invalid", "4:contractorId:invalid"], "note": "contractor id length, case and characters"},
    {"id": "h9", "input": {"rows": [[], ["c-1", "5403", "10", "2026-01-01", ""], ["c-1", "5403", "10"], ["c-1", "5403", "10", "2026-01-01"], ["c-1", "5403", "10", "2026-01-01"]]}, "expected": ["0:row:column-count", "1:row:column-count", "2:row:column-count", "4:row:duplicate"], "note": "rows with the wrong number of values are skipped entirely, including for duplicates"}
  ]
}
