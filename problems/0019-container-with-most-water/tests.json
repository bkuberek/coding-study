{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"height": [3, 7, 2, 6, 4, 8, 1]}, "expected": 28},
    {"id": "ex2", "visible": true, "input": {"height": [2, 9, 9, 2]}, "expected": 9},
    {"id": "h1", "input": {"height": [3, 9]}, "expected": 3, "note": "two bars: the shorter one sets the level"},
    {"id": "h2", "input": {"height": [0, 0]}, "expected": 0, "note": "two empty bars"},
    {"id": "h3", "input": {"height": [0, 7]}, "expected": 0, "note": "a zero-height bar holds nothing"},
    {"id": "h4", "input": {"height": [5, 5, 5, 5]}, "expected": 15, "note": "equal heights: the outermost pair wins"},
    {"id": "h5", "input": {"height": [1, 2, 3, 4, 5, 6]}, "expected": 9, "note": "strictly rising"},
    {"id": "h6", "input": {"height": [6, 5, 4, 3, 2, 1]}, "expected": 9, "note": "strictly falling"},
    {"id": "h7", "input": {"height": [10000, 1, 1, 1, 10000]}, "expected": 40000, "note": "maximum heights at both ends"},
    {"id": "h8", "input": {"height": [10000, 10000]}, "expected": 10000, "note": "maximum heights, adjacent"},
    {"id": "h9", "input": {"height": [2, 1, 1, 1, 1, 1, 1, 1, 1, 100, 100]}, "expected": 100, "note": "a narrow tall pair beats every wide pair"},
    {"id": "h10", "input": {"height": [1, 8, 2, 1, 1, 1, 1, 1, 9, 3]}, "expected": 56, "note": "the best pair is inside, not at the ends"},
    {"id": "h11", "input": {"height": [4, 0, 0, 0, 0, 0, 4]}, "expected": 24, "note": "empty bars between the walls do not matter"},
    {"id": "h12", "input": {"height": [1, 10000, 1]}, "expected": 2, "note": "a tall bar with short neighbors"},
    {"id": "h13", "input": {"height": [7, 1, 7, 1, 7, 1, 7]}, "expected": 42, "note": "ties between several best pairs"},
    {"id": "h14", "input": {"height": [5, 9, 9, 1]}, "expected": 10, "note": "moving the taller bar inward finds only 3"},
    {"id": "h15", "input": {"height": [3, 1, 2, 4, 2, 1, 3, 9, 9]}, "expected": 24, "note": "the outermost pair wins although taller bars exist"},
    {"id": "g1", "generate": {"n": 10000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: measuring every pair is about 5 * 10^7 steps here"},
    {"id": "g2", "generate": {"n": 10000, "seed": 3}, "hang_guard_ms": 30000, "note": "large input"}
  ]
}
