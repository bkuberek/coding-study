{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["Replicas", "increment", "increment", "value", "merge", "value", "merge", "value", "merge", "value"], "args": [[["a", "b"]], ["a", "likes", 3], ["b", "likes", 2], ["a", "likes"], ["b", "a"], ["a", "likes"], ["a", "b"], ["b", "likes"], ["b", "a"], ["a", "likes"]], "expected": [null, 3, 2, 3, null, 5, null, 5, null, 5]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["Replicas", "increment", "merge", "merge", "decrement", "decrement", "merge", "merge", "value", "merge", "merge", "value"], "args": [[["a", "b", "c"]], ["a", "stock", 10], ["a", "b"], ["a", "c"], ["b", "stock", 3], ["c", "stock", 4], ["b", "a"], ["c", "a"], ["a", "stock"], ["c", "b"], ["a", "b"], ["b", "stock"]], "expected": [null, 10, null, null, 7, 6, null, null, 3, null, null, 3]},
    {"id": "h1", "level": 1, "note": "concurrent increments add up; a single number merged by max loses them", "ops": ["Replicas", "increment", "increment", "increment", "merge", "value", "merge", "value", "decrement", "merge", "value", "merge", "value"], "args": [[["a", "b", "c"]], ["a", "views", 3], ["b", "views", 2], ["c", "views", 7], ["a", "b"], ["b", "views"], ["c", "b"], ["b", "views"], ["a", "views", 1], ["a", "c"], ["c", "views"], ["b", "c"], ["c", "views"]], "expected": [null, 3, 2, 7, null, 5, null, 12, 2, null, 9, null, 11]},
    {"id": "h2", "level": 1, "note": "merging the same state again changes nothing: merge is idempotent", "ops": ["Replicas", "increment", "merge", "merge", "merge", "value", "merge", "value", "decrement", "merge", "merge", "value"], "args": [[["a", "b"]], ["a", "n", 4], ["a", "b"], ["a", "b"], ["a", "b"], ["b", "n"], ["b", "a"], ["a", "n"], ["b", "n", 1], ["b", "a"], ["b", "a"], ["a", "n"]], "expected": [null, 4, null, null, null, 4, null, 4, 3, null, null, 3]},
    {"id": "h3", "level": 1, "note": "a merge passes on what the source learned from others, not only its own slot", "ops": ["Replicas", "increment", "increment", "merge", "merge", "value", "merge", "value", "decrement", "merge", "merge", "merge", "value"], "args": [[["a", "b", "c", "d"]], ["a", "n", 5], ["b", "n", 1], ["a", "b"], ["b", "c"], ["c", "n"], ["c", "d"], ["d", "n"], ["a", "n", 2], ["a", "b"], ["b", "c"], ["c", "d"], ["d", "n"]], "expected": [null, 5, 1, null, null, 6, null, 6, 3, null, null, null, 4]},
    {"id": "h4", "level": 1, "note": "an older copy of a slot must not overwrite a newer one: merge keeps the maximum", "ops": ["Replicas", "increment", "merge", "increment", "value", "merge", "value", "increment", "merge", "value", "merge", "value"], "args": [[["a", "b"]], ["a", "n", 5], ["a", "b"], ["a", "n", 2], ["a", "n"], ["b", "a"], ["a", "n"], ["b", "n", 1], ["b", "a"], ["a", "n"], ["a", "b"], ["b", "n"]], "expected": [null, 5, null, 7, 7, null, 7, 6, null, 8, null, 8]},
    {"id": "h5", "level": 1, "note": "decrements survive a merge and values can go below zero", "ops": ["Replicas", "decrement", "value", "merge", "value", "decrement", "increment", "merge", "value", "merge", "value", "increment", "merge", "value"], "args": [[["a", "b", "c"]], ["a", "temp", 2], ["a", "temp"], ["a", "b"], ["b", "temp"], ["b", "temp", 5], ["c", "temp", 1], ["b", "c"], ["c", "temp"], ["c", "a"], ["a", "temp"], ["a", "temp", 4], ["a", "c"], ["c", "temp"]], "expected": [null, -2, -2, null, -2, -7, 1, null, -6, null, -6, -2, null, -2]},
    {"id": "h6", "level": 1, "note": "counters are independent, and a merge carries every counter", "ops": ["Replicas", "value", "increment", "increment", "decrement", "merge", "value", "value", "value", "increment", "merge", "value", "value"], "args": [[["x1", "y2"]], ["x1", "missing"], ["x1", "red", 1], ["x1", "blue", 9], ["y2", "red", 4], ["x1", "y2"], ["y2", "red"], ["y2", "blue"], ["y2", "missing"], ["y2", "blue", 1000], ["y2", "x1"], ["x1", "blue"], ["x1", "red"]], "expected": [null, 0, 1, 9, -4, null, -3, 9, 0, 1009, null, 1009, -3]},
    {"id": "h7", "level": 1, "note": "different merge orders reach the same value once every update is seen", "ops": ["Replicas", "increment", "increment", "decrement", "increment", "merge", "merge", "merge", "merge", "value", "value", "value", "value", "merge", "merge", "merge", "value", "value", "value", "value"], "args": [[["a", "b", "c", "d"]], ["a", "n", 1], ["b", "n", 10], ["c", "n", 100], ["d", "n", 1000], ["a", "b"], ["c", "d"], ["b", "c"], ["d", "a"], ["a", "n"], ["b", "n"], ["c", "n"], ["d", "n"], ["c", "a"], ["a", "b"], ["a", "d"], ["a", "n"], ["b", "n"], ["c", "n"], ["d", "n"]], "expected": [null, 1, 10, -100, 1000, null, null, null, null, 901, 11, -89, 900, null, null, null, 911, 911, -89, 911]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["Replicas", "write", "write", "read", "merge", "read", "merge", "read"], "args": [[["a", "b"]], ["a", "color", "red", 10], ["b", "color", "blue", 12], ["a", "color"], ["b", "a"], ["a", "color"], ["a", "b"], ["b", "color"]], "expected": [null, true, true, "red", null, "blue", null, "blue"]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["Replicas", "write", "write", "merge", "read", "merge", "read", "write", "write", "read"], "args": [[["a", "b"]], ["a", "mode", "dark", 5], ["b", "mode", "light", 5], ["a", "b"], ["b", "mode"], ["b", "a"], ["a", "mode"], ["a", "mode", "dim", 4], ["a", "mode", "dim", 6], ["a", "mode"]], "expected": [null, true, true, null, "light", null, "light", false, true, "dim"]},
    {"id": "h8", "level": 2, "note": "the higher timestamp wins whatever order the merges arrive in", "ops": ["Replicas", "write", "write", "merge", "merge", "read", "merge", "read", "merge", "read"], "args": [[["a", "b", "c"]], ["a", "k", "new", 20], ["b", "k", "old", 3], ["a", "c"], ["b", "c"], ["c", "k"], ["b", "a"], ["a", "k"], ["c", "b"], ["b", "k"]], "expected": [null, true, true, null, null, "new", null, "new", null, "new"]},
    {"id": "h9", "level": 2, "note": "equal timestamps are broken by the greater replica id, the same at every replica", "ops": ["Replicas", "write", "write", "write", "merge", "read", "merge", "read", "merge", "read", "merge", "read", "merge", "read"], "args": [[["m", "n", "o"]], ["n", "k", "from-n", 7], ["m", "k", "from-m", 7], ["o", "k", "from-o", 7], ["m", "n"], ["n", "k"], ["n", "m"], ["m", "k"], ["o", "m"], ["m", "k"], ["m", "n"], ["n", "k"], ["n", "o"], ["o", "k"]], "expected": [null, true, true, true, null, "from-n", null, "from-n", null, "from-o", null, "from-o", null, "from-o"]},
    {"id": "h10", "level": 2, "note": "a write that does not beat the current stamp is ignored and returns false", "ops": ["Replicas", "write", "write", "read", "write", "read", "write", "merge", "write", "read", "write", "read", "merge", "read"], "args": [[["a", "b"]], ["a", "k", "one", 5], ["a", "k", "two", 5], ["a", "k"], ["a", "k", "three", 4], ["a", "k"], ["b", "k", "remote", 9], ["b", "a"], ["a", "k", "late", 8], ["a", "k"], ["a", "k", "next", 9], ["a", "k"], ["a", "b"], ["b", "k"]], "expected": [null, true, false, "one", false, "one", true, null, false, "remote", false, "remote", null, "remote"]},
    {"id": "h11", "level": 2, "note": "registers are independent of each other and of the counters", "ops": ["Replicas", "read", "write", "write", "increment", "merge", "read", "read", "value", "read", "write", "read", "read"], "args": [[["a", "b"]], ["a", "nothing"], ["a", "x", "1", 1], ["a", "y", "2", 1], ["a", "c", 3], ["a", "b"], ["b", "x"], ["b", "y"], ["b", "c"], ["b", "z"], ["b", "x", "3", 2], ["b", "y"], ["a", "x"]], "expected": [null, "", true, true, 3, null, "1", "2", 3, "", true, "2", "1"]},
    {"id": "h12", "level": 2, "note": "a fast clock wins later writes: last writer wins means highest timestamp, not latest in real time", "ops": ["Replicas", "write", "write", "merge", "read", "write", "read", "write", "merge", "read", "merge", "read", "merge", "read"], "args": [[["a", "b", "c"]], ["c", "owner", "carol", 900], ["a", "owner", "alice", 100], ["c", "a"], ["a", "owner"], ["a", "owner", "anna", 150], ["a", "owner"], ["b", "owner", "bob", 901], ["a", "b"], ["b", "owner"], ["b", "c"], ["c", "owner"], ["c", "a"], ["a", "owner"]], "expected": [null, true, true, null, "carol", false, "carol", true, null, "bob", null, "bob", null, "bob"]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["Replicas", "add", "add", "elements", "remove", "contains", "elements", "add", "elements", "remove"], "args": [[["a"]], ["a", "cart", "milk"], ["a", "cart", "eggs"], ["a", "cart"], ["a", "cart", "milk"], ["a", "cart", "milk"], ["a", "cart"], ["a", "cart", "milk"], ["a", "cart"], ["a", "cart", "tea"]], "expected": [null, "a:1", "a:2", ["eggs", "milk"], 1, false, ["eggs"], "a:3", ["eggs", "milk"], 0]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["Replicas", "add", "merge", "remove", "add", "contains", "merge", "merge", "contains", "elements"], "args": [[["a", "b"]], ["a", "cart", "milk"], ["a", "b"], ["b", "cart", "milk"], ["a", "cart", "milk"], ["b", "cart", "milk"], ["b", "a"], ["a", "b"], ["a", "cart", "milk"], ["b", "cart"]], "expected": [null, "a:1", null, 1, "a:2", false, null, null, true, ["milk"]]},
    {"id": "h13", "level": 3, "note": "a remove only removes the adds it has seen, so a concurrent add survives it", "ops": ["Replicas", "remove", "add", "remove", "merge", "contains", "merge", "contains", "remove", "merge", "contains", "add", "merge", "remove", "add", "merge", "contains", "merge", "elements"], "args": [[["a", "b"]], ["b", "s", "x"], ["a", "s", "x"], ["b", "s", "x"], ["a", "b"], ["b", "s", "x"], ["b", "a"], ["a", "s", "x"], ["b", "s", "x"], ["b", "a"], ["a", "s", "x"], ["a", "s", "z"], ["a", "b"], ["b", "s", "z"], ["a", "s", "z"], ["b", "a"], ["a", "s", "z"], ["a", "b"], ["b", "s"]], "expected": [null, 0, "a:1", 0, null, true, null, true, 1, null, false, "a:2", null, 1, "a:3", null, true, null, ["z"]]},
    {"id": "h14", "level": 3, "note": "an element can be added again after a remove, at any replica", "ops": ["Replicas", "add", "remove", "add", "contains", "merge", "contains", "remove", "add", "merge", "elements", "remove", "merge", "elements"], "args": [[["a", "b"]], ["a", "s", "x"], ["a", "s", "x"], ["a", "s", "x"], ["a", "s", "x"], ["a", "b"], ["b", "s", "x"], ["b", "s", "x"], ["b", "s", "x"], ["b", "a"], ["a", "s"], ["a", "s", "x"], ["a", "b"], ["b", "s"]], "expected": [null, "a:1", 1, "a:2", true, null, true, 1, "b:1", null, ["x"], 1, null, []]},
    {"id": "h15", "level": 3, "note": "a merge carries removes as well as adds", "ops": ["Replicas", "add", "add", "merge", "merge", "remove", "merge", "elements", "merge", "elements", "merge", "elements"], "args": [[["a", "b", "c"]], ["a", "s", "p"], ["a", "s", "q"], ["a", "b"], ["a", "c"], ["a", "s", "p"], ["a", "b"], ["b", "s"], ["b", "c"], ["c", "s"], ["c", "a"], ["a", "s"]], "expected": [null, "a:1", "a:2", null, null, 1, null, ["q"], null, ["q"], null, ["q"]]},
    {"id": "h16", "level": 3, "note": "remove takes away every observed tag; concurrent removes of the same tags agree", "ops": ["Replicas", "add", "add", "merge", "merge", "remove", "merge", "remove", "merge", "merge", "contains", "add", "merge", "elements"], "args": [[["a", "b", "c"]], ["a", "s", "x"], ["b", "s", "x"], ["a", "c"], ["b", "c"], ["c", "s", "x"], ["a", "b"], ["b", "s", "x"], ["b", "a"], ["c", "a"], ["a", "s", "x"], ["a", "s", "y"], ["a", "c"], ["c", "s"]], "expected": [null, "a:1", "b:1", null, null, 2, null, 2, null, null, false, "a:2", null, ["y"]]},
    {"id": "h17", "level": 3, "note": "sets are independent, listed sorted once each, and tags count adds across sets", "ops": ["Replicas", "add", "add", "add", "add", "add", "merge", "elements", "elements", "elements", "contains", "contains", "remove", "elements"], "args": [[["a", "b"]], ["a", "fruit", "pear"], ["a", "veg", "kale"], ["b", "fruit", "pear"], ["a", "fruit", "apple"], ["b", "fruit", "fig"], ["b", "a"], ["a", "fruit"], ["a", "veg"], ["a", "none"], ["a", "none", "pear"], ["a", "veg", "pear"], ["a", "fruit", "pear"], ["a", "fruit"]], "expected": [null, "a:1", "a:2", "b:1", "a:3", "b:2", null, ["apple", "fig", "pear"], ["kale"], [], false, false, 2, ["apple", "fig"]]},
    {"id": "h18", "level": 3, "note": "each replica numbers its own adds; merging does not move the count", "ops": ["Replicas", "add", "add", "merge", "add", "add", "remove", "merge", "elements", "add", "merge", "elements"], "args": [[["a", "b"]], ["a", "s", "x"], ["a", "s", "y"], ["a", "b"], ["b", "s", "z"], ["b", "s", "x"], ["a", "s", "x"], ["a", "b"], ["b", "s"], ["a", "s", "w"], ["b", "a"], ["a", "s"]], "expected": [null, "a:1", "a:2", null, "b:1", "b:2", 1, null, ["x", "y", "z"], "a:3", null, ["w", "x", "y", "z"]]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["Replicas", "increment", "increment", "write", "add", "stateSize", "sync", "increment", "sync", "stateSize", "value", "sync"], "args": [[["a", "b"]], ["a", "likes", 2], ["a", "views", 5], ["a", "title", "hello", 1], ["a", "tags", "news"], ["a"], ["a", "b"], ["a", "views", 1], ["a", "b"], ["a"], ["b", "views"], ["a", "b"]], "expected": [null, 2, 5, true, "a:1", 4, 4, 6, 1, 4, 6, 0]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["Replicas", "increment", "increment", "increment", "sync", "value", "decrement", "sync", "value", "sync"], "args": [[["a", "b"]], ["a", "n", 1], ["a", "n", 1], ["a", "n", 1], ["a", "b"], ["b", "n"], ["b", "n", 1], ["b", "a"], ["a", "n"], ["b", "a"]], "expected": [null, 1, 2, 3, 1, 3, 2, 2, 2, 0]},
    {"id": "h19", "level": 4, "note": "each target has its own acknowledgement", "ops": ["Replicas", "increment", "write", "sync", "sync", "value", "read", "increment", "sync", "sync", "sync", "value"], "args": [[["a", "b", "c"]], ["a", "n", 3], ["a", "r", "v", 1], ["a", "b"], ["a", "c"], ["c", "n"], ["c", "r"], ["a", "n", 1], ["a", "b"], ["a", "b"], ["a", "c"], ["c", "n"]], "expected": [null, 3, true, 2, 2, 3, "v", 4, 1, 0, 1, 4]},
    {"id": "h20", "level": 4, "note": "a sync passes on what the source received, not only its own updates", "ops": ["Replicas", "increment", "sync", "increment", "sync", "value", "increment", "sync", "sync", "value", "stateSize"], "args": [[["a", "b", "c"]], ["a", "n", 3], ["a", "b"], ["b", "n", 2], ["b", "c"], ["c", "n"], ["a", "n", 1], ["a", "b"], ["b", "c"], ["c", "n"], ["c"]], "expected": [null, 3, 1, 5, 2, 5, 4, 1, 1, 6, 2]},
    {"id": "h21", "level": 4, "note": "changes merged into the source are sent; a merge into the target changes nothing the source sends", "ops": ["Replicas", "increment", "sync", "increment", "increment", "merge", "sync", "value", "value", "increment", "merge", "sync", "merge", "sync"], "args": [[["a", "b", "c"]], ["a", "n", 1], ["a", "c"], ["b", "n", 4], ["b", "m", 1], ["b", "a"], ["a", "c"], ["c", "n"], ["c", "m"], ["c", "n", 2], ["c", "a"], ["a", "c"], ["b", "c"], ["a", "c"]], "expected": [null, 1, 1, 4, 1, null, 2, 5, 1, 7, null, 1, null, 0]},
    {"id": "h22", "level": 4, "note": "tags, tombstones, registers and both halves of a counter slot are entries", "ops": ["Replicas", "add", "add", "write", "decrement", "increment", "stateSize", "sync", "remove", "write", "stateSize", "sync", "elements", "read", "value", "stateSize"], "args": [[["a", "b"]], ["a", "s", "x"], ["a", "s", "y"], ["a", "r", "v1", 1], ["a", "c", 2], ["a", "c", 1], ["a"], ["a", "b"], ["a", "s", "x"], ["a", "r", "v2", 2], ["a"], ["a", "b"], ["b", "s"], ["b", "r"], ["b", "c"], ["b"]], "expected": [null, "a:1", "a:2", true, -2, -1, 5, 5, 1, true, 6, 2, ["y"], "v2", -1, 6]},
    {"id": "h23", "level": 4, "note": "an entry the target already has a newer value of is still sent and changes nothing", "ops": ["Replicas", "increment", "sync", "increment", "merge", "increment", "sync", "value", "value", "sync", "value"], "args": [[["a", "b"]], ["a", "n", 1], ["a", "b"], ["b", "n", 5], ["b", "a"], ["b", "n", 5], ["a", "b"], ["b", "n"], ["a", "n"], ["b", "a"], ["a", "n"]], "expected": [null, 1, 1, 6, null, 11, 1, 11, 6, 2, 11]},
    {"id": "h24", "level": 4, "note": "syncs in a ring end in the same state as full merges", "ops": ["Replicas", "increment", "add", "write", "sync", "sync", "sync", "remove", "write", "sync", "sync", "sync", "sync", "sync", "elements", "read", "read", "value", "stateSize", "stateSize", "stateSize"], "args": [[["a", "b", "c"]], ["a", "n", 1], ["b", "s", "x"], ["c", "r", "c1", 3], ["a", "b"], ["b", "c"], ["c", "a"], ["a", "s", "x"], ["b", "r", "b1", 3], ["a", "c"], ["b", "a"], ["c", "b"], ["a", "b"], ["b", "c"], ["c", "s"], ["a", "r"], ["c", "r"], ["c", "n"], ["a"], ["b"], ["c"]], "expected": [null, 1, "b:1", true, 1, 2, 3, 1, true, 4, 3, 4, 3, 2, [], "c1", "c1", 1, 4, 4, 4]},
    {"id": "h25", "level": 4, "note": "many changes to one entry are sent as one entry with its latest value", "ops": ["Replicas", "sync", "stateSize", "increment", "increment", "decrement", "decrement", "write", "write", "sync", "sync", "value", "read"], "args": [[["a", "b"]], ["a", "b"], ["a"], ["a", "n", 1], ["a", "n", 1], ["a", "n", 1], ["a", "n", 1], ["a", "r", "p", 1], ["a", "r", "q", 2], ["a", "b"], ["a", "b"], ["b", "n"], ["b", "r"]], "expected": [null, 0, 0, 1, 2, 1, 0, true, true, 3, 0, 0, "q"]}
  ]
}
