{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [4, 9, 2, 8], "target": 11}, "expected": [1, 2]},
    {"id": "ex2", "visible": true, "input": {"nums": [5, 5], "target": 10}, "expected": [0, 1]},
    {"id": "h1", "input": {"nums": [-3, 8, 0, 3], "target": 0}, "expected": [0, 3], "note": "negatives and zero"},
    {"id": "h2", "input": {"nums": [-7, 2], "target": -5}, "expected": [0, 1], "note": "minimum length with a negative target"},
    {"id": "h3", "input": {"nums": [0, 4, 0], "target": 0}, "expected": [0, 2], "note": "two zeros form the pair"},
    {"id": "h4", "input": {"nums": [3, 3, 1, 6], "target": 7}, "expected": [2, 3], "note": "duplicates that are not part of the answer"},
    {"id": "h5", "input": {"nums": [-4, -4], "target": -8}, "expected": [0, 1], "note": "all values equal"},
    {"id": "h6", "input": {"nums": [1, 2, 4, 8, 16, 32], "target": 33}, "expected": [0, 5], "note": "sorted ascending, pair at both ends"},
    {"id": "h7", "input": {"nums": [90, 70, 45, 31, 12, 5], "target": 76}, "expected": [2, 3], "note": "sorted descending, pair in the middle"},
    {"id": "h8", "input": {"nums": [1000000000, -1000000000], "target": 0}, "expected": [0, 1], "note": "extreme values"},
    {"id": "h9", "input": {"nums": [1000000000, 999999998, 7, 2], "target": 1000000000}, "expected": [1, 3], "note": "large magnitudes; the largest value is a decoy"},
    {"id": "h10", "input": {"nums": [4, 3, 5], "target": 8}, "expected": [1, 2], "note": "4 + 4 would reuse one index"},
    {"id": "h11", "input": {"nums": [7, 15, -6, 23], "target": 1}, "expected": [0, 2], "note": "a negative partner"},
    {"id": "h12", "input": {"nums": [14, -3, 27, 8, -11, 30, 5, 19, -26, 2, 41, -7, 16, 23], "target": 39}, "expected": [12, 13], "note": "the pair is the last two elements"},
    {"id": "h13", "input": {"nums": [-1000000000, 1, 999999999], "target": -999999999}, "expected": [0, 1], "note": "target near the lower bound"},
    {"id": "g1", "generate": {"n": 100000, "seed": 3}, "hang_guard_ms": 30000, "note": "large input: an O(n^2) scan does about 9 * 10^8 checks here"}
  ]
}
