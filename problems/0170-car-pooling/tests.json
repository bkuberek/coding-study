{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"trips": [[2, 1, 6], [3, 2, 4], [1, 3, 8]], "capacity": 5}, "expected": false},
    {"id": "ex2", "visible": true, "input": {"trips": [[4, 0, 5], [4, 5, 9], [2, 3, 7]], "capacity": 6}, "expected": true},
    {"id": "h1", "input": {"trips": [[3, 0, 1]], "capacity": 3}, "expected": true, "note": "single trip that exactly fills the shuttle"},
    {"id": "h2", "input": {"trips": [[4, 0, 1]], "capacity": 3}, "expected": false, "note": "single trip too large"},
    {"id": "h3", "input": {"trips": [[5, 2, 5], [5, 5, 8]], "capacity": 5}, "expected": true, "note": "drop-off and pickup at the same location"},
    {"id": "h4", "input": {"trips": [[5, 5, 8], [5, 2, 5]], "capacity": 5}, "expected": true, "note": "the same touching trips in reverse order"},
    {"id": "h5", "input": {"trips": [[2, 0, 10], [2, 0, 10], [2, 0, 10]], "capacity": 5}, "expected": false, "note": "identical trips"},
    {"id": "h6", "input": {"trips": [[1, 0, 2], [1, 1, 3], [1, 2, 4], [1, 3, 5]], "capacity": 2}, "expected": true, "note": "a chain of overlapping trips, two on board at a time"},
    {"id": "h7", "input": {"trips": [[100, 0, 100000], [100, 99999, 100000]], "capacity": 199}, "expected": false, "note": "extreme locations and passenger counts"},
    {"id": "h8", "input": {"trips": [[3, 7, 9], [3, 1, 2], [3, 4, 6]], "capacity": 3}, "expected": true, "note": "disjoint trips in no particular order"},
    {"id": "h9", "input": {"trips": [[1, 0, 5], [2, 1, 4], [3, 2, 3]], "capacity": 6}, "expected": true, "note": "nested trips; the peak is in the innermost one"},
    {"id": "h10", "input": {"trips": [[1, 0, 5], [2, 1, 4], [3, 2, 3]], "capacity": 5}, "expected": false, "note": "nested trips, one seat short"},
    {"id": "h11", "input": {"trips": [[9, 3, 4], [1, 0, 3], [1, 4, 6]], "capacity": 9}, "expected": true, "note": "the peak is a short trip in the middle"},
    {"id": "h12", "input": {"trips": [[2, 0, 3], [3, 3, 6], [4, 6, 9], [1, 0, 9]], "capacity": 5}, "expected": true, "note": "back-to-back trips under one long trip"},
    {"id": "g1", "generate": {"n": 5000, "seed": 1}, "note": "large input: checking every pickup is 2.5 * 10^7 steps here"},
    {"id": "g2", "generate": {"n": 5000, "seed": 2}, "note": "large input"},
    {"id": "g3", "generate": {"n": 500, "seed": 3}}
  ]
}
