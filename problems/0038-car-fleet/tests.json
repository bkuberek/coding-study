{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"target": 20, "position": [14, 10, 4, 0, 18], "speed": [3, 5, 1, 4, 1]}, "expected": 2},
    {"id": "ex2", "visible": true, "input": {"target": 12, "position": [0, 4, 8], "speed": [3, 3, 3]}, "expected": 3},
    {"id": "h1", "input": {"target": 5, "position": [0], "speed": [1]}, "expected": 1, "note": "a single car is one fleet"},
    {"id": "h2", "input": {"target": 12, "position": [0, 6, 9], "speed": [4, 2, 1]}, "expected": 1, "note": "every car would arrive at the same hour"},
    {"id": "h3", "input": {"target": 100, "position": [10, 20, 30], "speed": [1, 2, 3]}, "expected": 3, "note": "faster cars ahead: nobody is caught"},
    {"id": "h4", "input": {"target": 100, "position": [0, 50, 90], "speed": [100, 10, 1]}, "expected": 1, "note": "a slow leader holds everyone back"},
    {"id": "h5", "input": {"target": 10, "position": [0, 5], "speed": [2, 1]}, "expected": 1, "note": "catching up exactly at the destination still merges"},
    {"id": "h6", "input": {"target": 12, "position": [0, 7], "speed": [2, 1]}, "expected": 2, "note": "the car behind arrives one hour too late to merge"},
    {"id": "h7", "input": {"target": 50, "position": [40, 0, 30, 10, 20], "speed": [1, 5, 2, 3, 3]}, "expected": 2, "note": "positions given out of order"},
    {"id": "h8", "input": {"target": 1000000, "position": [999999, 0], "speed": [1, 1000]}, "expected": 2, "note": "extreme positions and speeds"},
    {"id": "h9", "input": {"target": 10, "position": [0, 5], "speed": [6, 3]}, "expected": 1, "note": "equal fractional arrival times (5/3 hours)"},
    {"id": "h10", "input": {"target": 30, "position": [0, 2, 4, 10, 20, 25], "speed": [6, 7, 1, 2, 5, 1]}, "expected": 3, "note": "several fleets, each absorbing faster cars behind"},
    {"id": "h11", "input": {"target": 10, "position": [5, 0], "speed": [5, 1]}, "expected": 2, "note": "the car behind is slower"},
    {"id": "h12", "input": {"target": 9, "position": [8, 7, 6, 5, 4, 3, 2, 1, 0], "speed": [1, 1, 1, 1, 1, 1, 1, 1, 1]}, "expected": 9, "note": "every car at the same speed, listed from the front"},
    {"id": "h13", "input": {"target": 7, "position": [1, 4], "speed": [3, 1]}, "expected": 1, "note": "the faster car catches up with a car whose time is a whole number"},
    {"id": "g1", "generate": {"n": 5000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: comparing every pair of cars is quadratic here"},
    {"id": "g2", "generate": {"n": 5000, "seed": 2}, "hang_guard_ms": 30000, "note": "large input"},
    {"id": "g3", "generate": {"n": 1000, "seed": 3}}
  ]
}
