{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"grid": [[0, 3], [2, 1]]}, "expected": 2},
    {"id": "ex2", "visible": true, "input": {"grid": [[0, 5, 4], [6, 8, 3], [7, 1, 2]]}, "expected": 5},
    {"id": "h1", "input": {"grid": [[0]]}, "expected": 0, "note": "one cell: already at the goal"},
    {"id": "h2", "input": {"grid": [[3, 0], [1, 2]]}, "expected": 3, "note": "the start cell is the highest floor"},
    {"id": "h3", "input": {"grid": [[0, 1], [2, 3]]}, "expected": 3, "note": "the goal cell is the highest floor"},
    {"id": "h4", "input": {"grid": [[0, 1, 2, 3], [7, 6, 5, 4], [8, 9, 10, 11], [15, 14, 13, 12]]}, "expected": 12, "note": "heights rise along a snake that ends at the goal"},
    {"id": "h5", "input": {"grid": [[0, 1, 2, 3], [15, 14, 13, 4], [9, 10, 11, 5], [8, 7, 6, 12]]}, "expected": 12, "note": "a high band in the second row with a gap at the right end"},
    {"id": "h6", "input": {"grid": [[0, 8, 1], [7, 3, 2], [6, 5, 4]]}, "expected": 7, "note": "both neighbors of the start are high, and the lower one decides"},
    {"id": "h7", "input": {"grid": [[1, 2, 3], [0, 8, 4], [7, 6, 5]]}, "expected": 5, "note": "the route goes around the high center"},
    {"id": "h8", "input": {"grid": [[0, 2, 4, 6], [1, 3, 5, 7], [8, 10, 12, 14], [9, 11, 13, 15]]}, "expected": 15, "note": "heights grow toward the goal in every direction"},
    {"id": "h9", "input": {"grid": [[24, 1, 2, 3, 4], [23, 22, 21, 20, 5], [10, 11, 12, 19, 6], [9, 14, 13, 18, 7], [8, 15, 16, 17, 0]]}, "expected": 24, "note": "the start is the highest cell, so it decides the answer"},
    {"id": "h10", "input": {"grid": [[0, 1, 2, 3, 4], [24, 23, 22, 21, 5], [12, 13, 14, 15, 6], [11, 18, 17, 16, 7], [10, 9, 8, 19, 20]]}, "expected": 20, "note": "a winding low path through a 5 by 5 pool"},
    {"id": "h11", "input": {"grid": [[2, 3], [0, 1]]}, "expected": 2, "note": "the lowest floor is not on the way"},
    {"id": "h12", "input": {"grid": [[0, 7, 6], [1, 8, 5], [2, 3, 4]]}, "expected": 4, "note": "down the left side and along the bottom"},
    {"id": "g1", "generate": {"n": 2500, "seed": 1}, "note": "50 by 50 pool"},
    {"id": "g2", "generate": {"n": 2500, "seed": 2}, "note": "50 by 50 pool, another layout"},
    {"id": "g3", "generate": {"n": 900, "seed": 3}}
  ]
}
