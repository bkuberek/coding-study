{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["BankingSystem", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "transfer"], "args": [[], [1, "alice"], [2, "bob"], [3, "alice"], [4, "alice", 500], [5, "carol", 100], [6, "alice", "bob", 200], [7, "alice", "bob", 400], [8, "alice", "alice", 10], [9, "bob", "carol", 50]], "expected": [null, true, true, false, 500, -1, 300, -1, -1, -1]},
    {"id": "h1", "level": 1, "note": "a transfer may empty the source exactly; the target's balance grows", "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "transfer", "transfer", "transfer", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "a", 70], [4, "a", "b", 70], [5, "a", "b", 1], [6, "b", "a", 30], [7, "b", 1]], "expected": [null, true, true, 70, 0, -1, 40, 41]},
    {"id": "h2", "level": 1, "note": "balances go beyond 32-bit integers", "ops": ["BankingSystem", "createAccount", "deposit", "deposit", "deposit", "createAccount", "transfer", "deposit"], "args": [[], [1, "big"], [2, "big", 1000000000], [3, "big", 1000000000], [4, "big", 1000000000], [5, "small"], [6, "big", "small", 2500000000], [7, "small", 1]], "expected": [null, true, 1000000000, 2000000000, 3000000000, true, 500000000, 2500000001]},
    {"id": "h3", "level": 1, "note": "nothing works on accounts that were never created", "ops": ["BankingSystem", "deposit", "transfer", "createAccount", "deposit", "transfer", "transfer", "createAccount", "transfer"], "args": [[], [1, "x", 5], [2, "x", "y", 1], [3, "x"], [4, "x", 5], [5, "x", "y", 1], [6, "y", "x", 1], [7, "y"], [8, "x", "y", 5]], "expected": [null, -1, -1, true, 5, -1, -1, true, 0]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["BankingSystem", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "acc1"], [2, "acc2"], [3, "acc3"], [4, "acc1", 1000], [5, "acc2", 1000], [6, "acc1", "acc2", 300], [7, "acc2", "acc3", 500], [8, "acc1", "acc3", 100], [9, 2], [10, 5]], "expected": [null, true, true, true, 1000, 1000, 700, 800, 600, ["acc2(500)", "acc1(400)"], ["acc2(500)", "acc1(400)", "acc3(0)"]]},
    {"id": "h4", "level": 2, "note": "ties are broken by account id in ascending order", "ops": ["BankingSystem", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "zed"], [2, "amy"], [3, "kim"], [4, "zed", 100], [5, "amy", 100], [6, "zed", "kim", 40], [7, "amy", "kim", 40], [8, 3], [9, 1]], "expected": [null, true, true, true, 100, 100, 60, 60, ["amy(40)", "zed(40)", "kim(0)"], ["amy(40)"]]},
    {"id": "h5", "level": 2, "note": "failed transfers and deposits never count as spending", "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "transfer", "deposit", "topSpenders", "transfer", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", 10], [4, "a", "b", 50], [5, "b", 999], [6, 2], [7, "a", "b", 10], [8, 2]], "expected": [null, true, true, 10, -1, 999, ["a(0)", "b(0)"], 0, ["a(10)", "b(0)"]]},
    {"id": "h6", "level": 2, "note": "no accounts means an empty ranking", "ops": ["BankingSystem", "topSpenders", "createAccount", "topSpenders"], "args": [[], [1, 3], [2, "solo"], [3, 3]], "expected": [null, [], true, ["solo(0)"]]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["BankingSystem", "createAccount", "deposit", "pay", "paymentStatus", "deposit", "paymentStatus", "deposit"], "args": [[], [1000, "ana"], [2000, "ana", 1000], [3000, "ana", 300], [4000, "ana", "payment1"], [5000, "ana", 1], [86403000, "ana", "payment1"], [86403001, "ana", 1]], "expected": [null, true, 1000, "payment1", "IN_PROGRESS", 701, "CASHBACK_RECEIVED", 708]},
    {"id": "h7", "level": 3, "note": "failed payments return \"\" and use no payment number", "ops": ["BankingSystem", "createAccount", "pay", "pay", "deposit", "pay", "pay", "deposit", "pay"], "args": [[], [1, "a"], [2, "a", 1], [3, "b", 1], [4, "a", 100], [5, "a", 100], [6, "a", 1], [7, "a", 50], [8, "a", 50]], "expected": [null, true, "", "", 100, "payment1", "", 50, "payment2"]},
    {"id": "h8", "level": 3, "note": "a cashback due at time t lands before the call at time t uses the balance", "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "pay", "transfer", "transfer", "paymentStatus"], "args": [[], [10, "a"], [11, "b"], [12, "a", 500], [20, "a", 500], [86400019, "a", "b", 10], [86400020, "a", "b", 10], [86400021, "a", "payment1"]], "expected": [null, true, true, 500, "payment1", -1, 0, "CASHBACK_RECEIVED"]},
    {"id": "h9", "level": 3, "note": "status needs the right account; cashback rounds down and does not reduce spending", "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "pay", "pay", "paymentStatus", "paymentStatus", "paymentStatus", "topSpenders", "deposit", "topSpenders", "paymentStatus"], "args": [[], [1, "a"], [2, "b"], [3, "a", 1000], [4, "a", 49], [5, "a", 151], [6, "b", "payment1"], [7, "a", "payment9"], [8, "c", "payment1"], [9, 2], [86400005, "a", 1], [86400006, 1], [86400007, "a", "payment2"]], "expected": [null, true, true, 1000, "payment1", "payment2", "", "", "", ["a(200)", "b(0)"], 804, ["a(200)"], "CASHBACK_RECEIVED"]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "deposit", "transfer", "mergeAccounts", "deposit", "topSpenders", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [1, "main"], [2, "side"], [3, "main", 100], [4, "side", 50], [5, "side", "main", 20], [6, "main", "side"], [7, "side", 10], [8, 2], [9, "main", 5], [10, "main", 6], [11, "side", 5], [12, "side", 6], [13, "main", 0]], "expected": [null, true, true, 100, 50, 30, true, -1, ["main(20)"], 120, 150, 30, -1, -1]},
    {"id": "h10", "level": 4, "note": "invalid merges change nothing", "ops": ["BankingSystem", "createAccount", "createAccount", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "a", "a"], [4, "a", "zz"], [5, "zz", "a"], [6, "b", "a"], [7, "a", "b"], [8, "b", "a"], [9, "b", 3]], "expected": [null, true, true, false, false, false, true, false, false, 3]},
    {"id": "h11", "level": 4, "note": "a pending cashback follows the merge and shows up in history at its due time", "ops": ["BankingSystem", "createAccount", "createAccount", "deposit", "pay", "mergeAccounts", "paymentStatus", "paymentStatus", "getBalance", "getBalance", "paymentStatus"], "args": [[], [1, "a"], [2, "b"], [3, "b", 1000], [4, "b", 500], [5, "a", "b"], [6, "a", "payment1"], [7, "b", "payment1"], [86400010, "a", 86400003], [86400011, "a", 86400004], [86400012, "a", "payment1"]], "expected": [null, true, true, 1000, "payment1", true, "IN_PROGRESS", "", 500, 510, "CASHBACK_RECEIVED"]},
    {"id": "h12", "level": 4, "note": "balances before creation are -1; history records every change", "ops": ["BankingSystem", "createAccount", "deposit", "deposit", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [10, "a"], [20, "a", 5], [30, "a", 7], [40, "a", 9], [41, "a", 10], [42, "a", 25], [43, "a", 30], [44, "a", 44], [45, "nobody", 44]], "expected": [null, true, 5, 12, -1, 0, 5, 12, 12, -1]},
    {"id": "h13", "level": 4, "note": "chained merges: a payment from c is reachable through a after c into b and b into a", "ops": ["BankingSystem", "createAccount", "createAccount", "createAccount", "deposit", "pay", "transfer", "mergeAccounts", "mergeAccounts", "topSpenders", "paymentStatus", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "c", 300], [5, "c", 100], [6, "c", "a", 50], [7, "b", "c"], [8, "a", "b"], [9, 3], [10, "a", "payment1"], [11, "a", 11], [86400005, "a", 86400005], [86400006, "b", 7], [86400007, "c", 6]], "expected": [null, true, true, true, 300, "payment1", 150, true, true, ["a(150)"], "IN_PROGRESS", 200, 202, 150, 150]}
  ]
}
