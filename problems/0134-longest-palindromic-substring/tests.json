{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"s": "xabacabay"}, "expected": "abacaba"},
    {"id": "ex2", "visible": true, "input": {"s": "noon42"}, "expected": "noon"},
    {"id": "ex3", "visible": true, "input": {"s": "cdef"}, "expected": "c"},
    {"id": "h1", "input": {"s": "z"}, "expected": "z", "note": "single character"},
    {"id": "h2", "input": {"s": "aa"}, "expected": "aa", "note": "two equal characters"},
    {"id": "h3", "input": {"s": "ab"}, "expected": "a", "note": "two different characters: either one is accepted"},
    {"id": "h4", "input": {"s": ""}, "expected": "", "note": "maximum length, one repeated character: the whole string"},
    {"id": "h5", "input": {"s": "abcdefg"}, "expected": "a", "note": "all distinct"},
    {"id": "h6", "input": {"s": "xyyz"}, "expected": "yy", "note": "even palindrome in the middle"},
    {"id": "h7", "input": {"s": "pqrsrqpx"}, "expected": "pqrsrqp", "note": "palindrome at the start"},
    {"id": "h8", "input": {"s": "a1b2b1a"}, "expected": "a1b2b1a", "note": "digits and letters, the whole string"},
    {"id": "h9", "input": {"s": "ABBA"}, "expected": "ABBA", "note": "upper case"},
    {"id": "h10", "input": {"s": "Aa"}, "expected": "A", "note": "comparison is case-sensitive"},
    {"id": "h11", "input": {"s": "abaxcdc"}, "expected": "cdc", "note": "two longest palindromes of equal length"},
    {"id": "h12", "input": {"s": ""}, "expected": "", "note": "maximum length, alternating: length 999"},
    {"id": "h13", "input": {"s": "1qwertytrewq"}, "expected": "qwertytrewq", "note": "palindrome at the end"},
    {"id": "h14", "input": {"s": "aabaaab"}, "expected": "baaab", "note": "overlapping palindromes"},
    {"id": "h15", "input": {"s": "aaaabaaa"}, "expected": "aaabaaa", "note": "the longest one is off-center: aaabaaa"},
    {"id": "g1", "generate": {"n": 1000, "seed": 2}, "note": "longest string"},
    {"id": "g2", "generate": {"n": 99, "seed": 3}, "note": "random text below the ladder sizes"},
    {"id": "g3", "generate": {"n": 500, "seed": 7}}
  ]
}
