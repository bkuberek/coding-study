  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["FactMemory", "remember", "remember", "recall", "recall", "remember", "recall", "listFacts", "listFacts"], "args": [[], [1, "ana", "home", "city", "lisbon"], [2, "ana", "pet", "name", "rex"], [3, "ana", "home", "city"], [4, "ana", "home", "zip"], [5, "ana", "home", "city", "porto"], [6, "ana", "home", "city"], [7, "ana"], [8, "bo"]], "expected": [null, "f1", "f2", "lisbon", "", "f3", "porto", ["home.city=porto", "pet.name=rex"], []]},
    {"id": "h1", "level": 1, "note": "users are separate, but ids count over the whole store", "ops": ["FactMemory", "remember", "remember", "recall", "recall", "recall", "listFacts", "remember", "recall"], "args": [[], [1, "ana", "tea", "kind", "green"], [2, "bo", "tea", "kind", "black"], [3, "ana", "tea", "kind"], [4, "bo", "tea", "kind"], [5, "cy", "tea", "kind"], [6, "bo"], [7, "ana", "tea", "kind", "oolong"], [8, "bo", "tea", "kind"]], "expected": [null, "f1", "f2", "green", "black", "", ["tea.kind=black"], "f3", "black"]},
    {"id": "h2", "level": 1, "note": "listFacts orders by subject, then attribute, in string order: a10 before a9", "ops": ["FactMemory", "remember", "remember", "remember", "remember", "remember", "listFacts"], "args": [[], [1, "u", "work", "desk", "d9"], [2, "u", "home", "zip", "1000"], [3, "u", "home", "city", "faro"], [4, "u", "a9", "x", "two"], [5, "u", "a10", "x", "one"], [6, "u"]], "expected": [null, "f1", "f2", "f3", "f4", "f5", ["a10.x=one", "a9.x=two", "home.city=faro", "home.zip=1000", "work.desk=d9"]]},
    {"id": "h3", "level": 1, "note": "calls may share a timestamp and the later one wins; the same value again still gets a new id", "ops": ["FactMemory", "remember", "remember", "recall", "remember", "listFacts", "recall"], "args": [[], [5, "u", "s", "a", "x"], [5, "u", "s", "a", "y"], [5, "u", "s", "a"], [6, "u", "s", "a", "y"], [7, "u"], [7, "u", "a", "s"]], "expected": [null, "f1", "f2", "y", "f3", ["s.a=y"], ""]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["FactMemory", "remember", "remember", "remember", "remember", "recallAt", "recallAt", "recallAt", "recallAt", "history", "recall"], "args": [[], [1, "ana", "home", "city", "lisbon"], [4, "ana", "home", "city", "porto"], [6, "ana", "job", "title", "nurse"], [9, "ana", "home", "city", "braga"], [10, "ana", "home", "city", 0], [11, "ana", "home", "city", 4], [12, "ana", "home", "city", 8], [13, "ana", "job", "title", 5], [14, "ana", "home", "city"], [15, "ana", "home", "city"]], "expected": [null, "f1", "f2", "f3", "f4", "", "porto", "porto", "", ["f1@1=lisbon", "f2@4=porto", "f4@9=braga"], "braga"]},
    {"id": "h4", "level": 2, "note": "a fact is in force from its own time on; before the first one there is nothing", "ops": ["FactMemory", "remember", "remember", "recallAt", "recallAt", "recallAt", "recallAt", "recallAt", "recallAt", "history", "history"], "args": [[], [10, "u", "k", "v", "one"], [20, "u", "k", "v", "two"], [21, "u", "k", "v", 9], [22, "u", "k", "v", 10], [23, "u", "k", "v", 19], [24, "u", "k", "v", 20], [25, "u", "k", "v", 1000000000], [26, "nobody", "k", "v", 25], [27, "nobody", "k", "v"], [28, "u", "k", "missing"]], "expected": [null, "f1", "f2", "", "one", "one", "two", "two", "", [], []]},
    {"id": "h5", "level": 2, "note": "two facts share time 3, and the later of them is the one in force at 3", "ops": ["FactMemory", "remember", "remember", "remember", "recallAt", "recallAt", "history"], "args": [[], [3, "u", "k", "v", "one"], [3, "u", "k", "v", "two"], [5, "u", "k", "v", "three"], [6, "u", "k", "v", 3], [7, "u", "k", "v", 4], [8, "u", "k", "v"]], "expected": [null, "f1", "f2", "f3", "two", "two", ["f1@3=one", "f2@3=two", "f3@5=three"]]},
