    {"id": "ex5", "visible": true, "level": 4, "ops": ["FactMemory", "remember", "remember", "remember", "exportFacts", "importFacts", "recall", "history", "remember"], "args": [[], [1, "phone", "home", "city", "lisbon"], [2, "phone", "trip", "origin", "@f1"], [3, "phone", "home", "city", "porto"], [4, "phone"], [5, "tablet", ["f1 1 home city lisbon", "f2 2 trip origin @f1", "f3 3 home city porto"]], [6, "tablet", "trip", "origin"], [7, "tablet", "home", "city"], [8, "tablet", "pet", "name", "rex"]], "expected": [null, "f1", "f2", "f3", ["f1 1 home city lisbon", "f2 2 trip origin @f1", "f3 3 home city porto"], ["f4", "f5", "f6"], "@f4", ["f4@1=lisbon", "f6@3=porto"], "f7"]},
    {"id": "h11", "level": 4, "note": "lines from another store: every id is replaced, f1 is not a prefix of f12, and a reference may name a later line", "ops": ["FactMemory", "remember", "remember", "importFacts", "recall", "recall", "exportFacts", "exportFacts"], "args": [[], [1, "me", "a", "b", "c"], [2, "me", "d", "e", "f"], [10, "dev", ["f1 3 car color red", "f2 4 note about @f12", "f11 5 note see @f1", "f12 6 car model z4"]], [11, "dev", "note", "about"], [12, "dev", "note", "see"], [13, "dev"], [14, "me"]], "expected": [null, "f1", "f2", ["f3", "f4", "f5", "f6"], "@f6", "@f3", ["f3 3 car color red", "f4 4 note about @f6", "f5 5 note see @f3", "f6 6 car model z4"], ["f1 1 a b c", "f2 2 d e f"]]},
    {"id": "h12", "level": 4, "note": "an export is ordered by the number in the id, so f9 comes before f10", "ops": ["FactMemory", "remember", "remember", "remember", "remember", "remember", "remember", "remember", "remember", "remember", "remember", "exportFacts", "importFacts", "history", "recall"], "args": [[], [1, "u", "ka", "x", "one"], [2, "z", "s2", "a", "v"], [3, "z", "s3", "a", "v"], [4, "z", "s4", "a", "v"], [5, "z", "s5", "a", "v"], [6, "z", "s6", "a", "v"], [7, "z", "s7", "a", "v"], [8, "z", "s8", "a", "v"], [9, "u", "kb", "x", "two"], [10, "u", "ka", "x", "three"], [11, "u"], [12, "w", ["f1 1 ka x one", "f9 9 kb x two", "f10 10 ka x three"]], [13, "w", "ka", "x"], [14, "w", "kb", "x"]], "expected": [null, "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", ["f1 1 ka x one", "f9 9 kb x two", "f10 10 ka x three"], ["f11", "f12", "f13"], ["f11@1=one", "f13@10=three"], "two"]},
    {"id": "h13", "level": 4, "note": "an import into a user with facts does nothing; a plain value that looks like an id is no reference; an empty import uses no ids", "ops": ["FactMemory", "remember", "importFacts", "exportFacts", "importFacts", "recall", "recall", "importFacts", "remember"], "args": [[], [1, "a", "code", "name", "f1"], [2, "a", ["f1 1 x y z"]], [3, "a"], [4, "b", ["f7 1 code name f7", "f9 2 ref to @f7"]], [5, "b", "code", "name"], [6, "b", "ref", "to"], [7, "c", []], [8, "c", "x", "y", "z"]], "expected": [null, "f1", [], ["f1 1 code name f1"], ["f2", "f3"], "f7", "@f2", [], "f4"]},
    {"id": "h14", "level": 4, "note": "imported facts keep their times, the exporting user is untouched, and merges still work after an import", "ops": ["FactMemory", "remember", "remember", "importFacts", "recallAt", "exportFacts", "remember", "merge", "history"], "args": [[], [1, "a", "home", "city", "lisbon"], [2, "a", "home", "city", "porto"], [3, "b", ["f1 1 home city lisbon", "f2 2 home city porto"]], [4, "b", "home", "city", 1], [5, "a"], [6, "b", "home", "city", "faro"], [7, "b", "a"], [8, "a", "home", "city"]], "expected": [null, "f1", "f2", ["f3", "f4"], "lisbon", ["f1 1 home city lisbon", "f2 2 home city porto"], "f5", 1, ["f1@1=lisbon", "f2@2=porto", "f6@6=faro"]]},
