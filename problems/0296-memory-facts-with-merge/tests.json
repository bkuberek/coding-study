    {"id": "h9", "level": 3, "note": "copies get their ids in subject and attribute order; an unknown fromUser or a merge into itself takes nothing", "ops": ["FactMemory", "remember", "remember", "remember", "remember", "merge", "history", "history", "history", "history", "merge", "merge", "remember", "listFacts"], "args": [[], [1, "a", "zeta", "x", "one"], [2, "a", "alpha", "y", "two"], [3, "a", "mid", "z", "three"], [4, "a", "alpha", "b", "four"], [5, "a", "b"], [6, "b", "alpha", "b"], [7, "b", "alpha", "y"], [8, "b", "mid", "z"], [9, "b", "zeta", "x"], [10, "nobody", "b"], [11, "b", "b"], [12, "b", "new", "k", "v"], [13, "b"]], "expected": [null, "f1", "f2", "f3", "f4", 4, ["f5@4=four"], ["f6@2=two"], ["f7@3=three"], ["f8@1=one"], 0, 0, "f9", ["alpha.b=four", "alpha.y=two", "mid.z=three", "new.k=v", "zeta.x=one"]]},
