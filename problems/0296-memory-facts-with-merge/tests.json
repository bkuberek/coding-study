    {"id": "ex3", "visible": true, "level": 3, "ops": ["FactMemory", "remember", "remember", "remember", "remember", "merge", "listFacts", "history", "listFacts"], "args": [[], [1, "phone", "home", "city", "lisbon"], [2, "laptop", "home", "city", "porto"], [3, "laptop", "pet", "name", "rex"], [4, "phone", "diet", "type", "vegan"], [5, "laptop", "phone"], [6, "phone"], [7, "phone", "home", "city"], [8, "laptop"]], "expected": [null, "f1", "f2", "f3", "f4", 2, ["diet.type=vegan", "home.city=porto", "pet.name=rex"], ["f1@1=lisbon", "f5@2=porto"], ["home.city=porto", "pet.name=rex"]]},
    {"id": "ex4", "visible": true, "level": 3, "ops": ["FactMemory", "remember", "remember", "merge", "setPriority", "merge", "recall"], "args": [[], [7, "phone", "tea", "kind", "green"], [7, "laptop", "tea", "kind", "black"], [8, "laptop", "phone"], [9, "laptop", 1], [10, "laptop", "phone"], [11, "phone", "tea", "kind"]], "expected": [null, "f1", "f2", 0, null, 1, "black"]},
