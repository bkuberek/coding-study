{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"instructions": [3, 8, 5]}, "expected": 1},
    {"id": "ex2", "visible": true, "input": {"instructions": [4, 4, 1, 9, 4, 2]}, "expected": 2},
    {"id": "h1", "input": {"instructions": [7]}, "expected": 0, "note": "a single value"},
    {"id": "h2", "input": {"instructions": [1, 2, 3, 4, 5]}, "expected": 0, "note": "ascending"},
    {"id": "h3", "input": {"instructions": [5, 4, 3, 2, 1]}, "expected": 0, "note": "descending"},
    {"id": "h4", "input": {"instructions": [2, 2, 2, 2]}, "expected": 0, "note": "all equal"},
    {"id": "h5", "input": {"instructions": [1, 100000, 50000, 25000, 75000]}, "expected": 3, "note": "extreme values"},
    {"id": "h6", "input": {"instructions": [1, 3, 2, 1, 3, 2, 1, 3, 2]}, "expected": 6, "note": "repeating pattern"},
    {"id": "h7", "input": {"instructions": [5, 1, 9, 3, 7, 2, 8, 4, 6]}, "expected": 10, "note": "distinct, mixed order"},
    {"id": "h8", "input": {"instructions": [100000, 1, 100000, 1, 50000, 50000]}, "expected": 4, "note": "repeated extreme values"},
    {"id": "h9", "input": {"instructions": [3, 3, 1, 1, 2, 2]}, "expected": 4, "note": "pairs of equal values"},
    {"id": "h10", "input": {"instructions": [10, 9, 1, 2, 8, 3, 7, 4, 6, 5]}, "expected": 19, "note": "closing in on the middle"},
    {"id": "g1", "generate": {"n": 100000, "seed": 239}, "note": "large input: the total passes 10^9 + 7, so the modulus matters"}
  ]
}
