    {"id": "h1", "input": {"ids": [11, 12, 13], "impressions": [400, 0, 80], "clicks": [20, 0, 8]}, "expected": [13, 11, 12], "note": "one creative that was never shown"},
    {"id": "h2", "input": {"ids": [30, 10, 20], "impressions": [0, 0, 0], "clicks": [0, 0, 0]}, "expected": [10, 20, 30], "note": "no creative was shown yet"},
    {"id": "h3", "input": {"ids": [5], "impressions": [0], "clicks": [0]}, "expected": [5], "note": "a single creative that was never shown"},
    {"id": "h4", "input": {"ids": [6, 2], "impressions": [500, 0], "clicks": [0, 0]}, "expected": [2, 6], "note": "shown without clicks ties with never shown"},
