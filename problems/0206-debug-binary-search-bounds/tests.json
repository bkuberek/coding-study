{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 12}, "expected": 3},
    {"id": "ex2", "visible": true, "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 7}, "expected": -1},
    {"id": "h1", "input": {"nums": [], "target": 4}, "expected": -1, "note": "empty array"},
    {"id": "h2", "input": {"nums": [7], "target": 7}, "expected": 0, "note": "single element, present"},
    {"id": "h3", "input": {"nums": [7], "target": 3}, "expected": -1, "note": "single element, target smaller"},
    {"id": "h4", "input": {"nums": [7], "target": 9}, "expected": -1, "note": "single element, target larger"},
    {"id": "h5", "input": {"nums": [1, 3], "target": 3}, "expected": 1, "note": "two elements, target last"},
    {"id": "h6", "input": {"nums": [1, 3], "target": 1}, "expected": 0, "note": "two elements, target first"},
    {"id": "h7", "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 38}, "expected": 6, "note": "target is the last element"},
    {"id": "h8", "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 2}, "expected": 0, "note": "target is the first element"},
    {"id": "h9", "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 40}, "expected": -1, "note": "target larger than every element"},
    {"id": "h10", "input": {"nums": [2, 5, 8, 12, 16, 23, 38], "target": 1}, "expected": -1, "note": "target smaller than every element"},
    {"id": "h11", "input": {"nums": [1, 2, 3, 4, 5, 6], "target": 5}, "expected": 4, "note": "even length, second to last"},
    {"id": "h12", "input": {"nums": [-9, -4, 0, 3], "target": -4}, "expected": 1, "note": "negatives"},
    {"id": "h13", "input": {"nums": [-9, -4, 0, 3], "target": 3}, "expected": 3, "note": "negatives, target last"},
    {"id": "h14", "input": {"nums": [-2147483648, 0, 2147483647], "target": 2147483647}, "expected": 2, "note": "int extremes, target last"},
    {"id": "h15", "input": {"nums": [-2147483648, 0, 2147483647], "target": -2147483648}, "expected": 0, "note": "int extremes, target first"}
  ]
}
