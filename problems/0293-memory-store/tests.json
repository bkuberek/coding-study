{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["MemoryStore", "add", "add", "add", "get", "update", "get", "get", "remove", "remove", "update", "get"], "args": [[], [1, "u1", "m1", "likes green tea"], [2, "u1", "m2", "lives in lisbon"], [3, "u1", "m1", "likes coffee"], [4, "u1", "m1"], [5, "u1", "m1", "likes black coffee"], [6, "u1", "m1"], [7, "u2", "m1"], [8, "u1", "m2"], [9, "u1", "m2"], [10, "u1", "m2", "lives in porto"], [11, "u1", "m2"]], "expected": [null, true, true, false, "likes green tea", true, "likes black coffee", "", true, false, false, ""]},
    {"id": "h1", "level": 1, "note": "an empty store: reads find nothing, update and remove report false", "ops": ["MemoryStore", "get", "update", "remove", "get"], "args": [[], [1, "a", "b"], [2, "a", "b", "some text"], [3, "a", "b"], [4, "a", "b"]], "expected": [null, "", false, false, ""]},
    {"id": "h2", "level": 1, "note": "users are independent even when they use the same memory id", "ops": ["MemoryStore", "add", "add", "update", "get", "get", "remove", "get", "get"], "args": [[], [1, "u1", "m1", "plays chess"], [2, "u2", "m1", "plays go"], [3, "u2", "m1", "plays poker"], [4, "u1", "m1"], [5, "u2", "m1"], [6, "u1", "m1"], [7, "u2", "m1"], [8, "u1", "m1"]], "expected": [null, true, true, true, "plays chess", "plays poker", true, "plays poker", ""]},
    {"id": "h3", "level": 1, "note": "a removed id can be added again, calls may share a timestamp, and a failed update creates nothing", "ops": ["MemoryStore", "add", "remove", "add", "get", "update", "get", "add", "get"], "args": [[], [1, "u", "m1", "first text"], [1, "u", "m1"], [1, "u", "m1", "second text"], [1, "u", "m1"], [2, "u", "m2", "never stored"], [3, "u", "m2"], [4, "u", "m2", "now stored"], [5, "u", "m2"]], "expected": [null, true, true, true, "second text", false, "", true, "now stored"]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["MemoryStore", "add", "add", "add", "add", "add", "search", "search", "search"], "args": [[], [1, "u1", "m1", "likes green tea in the morning"], [2, "u1", "m2", "drinks coffee in the morning"], [3, "u1", "m3", "allergic to peanuts"], [4, "u1", "m4", "green tea and coffee are both fine"], [5, "u2", "m5", "green tea"], [6, "u1", "green tea morning", 3], [7, "u1", "coffee", 5], [8, "u1", "peanut", 5]], "expected": [null, true, true, true, true, true, ["m1", "m4", "m2"], ["m4", "m2"], []]},
    {"id": "h4", "level": 2, "note": "a word repeated in the text or in the query counts once; top-k cuts after sorting", "ops": ["MemoryStore", "add", "add", "add", "search", "search", "search"], "args": [[], [1, "u", "a", "red red car"], [2, "u", "b", "red apple"], [3, "u", "c", "blue car"], [4, "u", "red", 1], [5, "u", "red red car", 3], [6, "u", "red red car", 2]], "expected": [null, true, true, true, ["b"], ["a", "c", "b"], ["a", "c"]]},
    {"id": "h5", "level": 2, "note": "equal score and write time go by id in string order; an update makes a memory newer and changes its words", "ops": ["MemoryStore", "add", "add", "search", "update", "search", "update", "search", "search", "search"], "args": [[], [5, "u", "m9", "blue sea"], [5, "u", "m10", "blue sky"], [6, "u", "blue", 2], [7, "u", "m9", "blue sea again"], [8, "u", "blue", 2], [9, "u", "m10", "grey sky"], [10, "u", "blue", 2], [11, "u", "sky", 2], [12, "v", "blue", 3]], "expected": [null, true, true, ["m10", "m9"], true, ["m9", "m10"], true, ["m9"], ["m10"], []]},
    {"id": "h6", "level": 2, "note": "terms match whole words only; removed memories leave search; k may exceed the matches", "ops": ["MemoryStore", "add", "add", "add", "remove", "search", "add", "search"], "args": [[], [1, "u", "a", "cat food"], [2, "u", "b", "category list"], [3, "u", "c", "dog food"], [4, "u", "c"], [5, "u", "cat food", 10], [6, "u", "c", "cat"], [7, "u", "cat food", 10]], "expected": [null, true, true, true, true, ["a"], true, ["a", "c"]]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["MemoryStore", "add", "addWithTtl", "get", "search", "get", "search", "update", "addWithTtl", "get"], "args": [[], [1, "u1", "m1", "prefers dark mode"], [2, "u1", "m2", "is travelling this week", 5], [6, "u1", "m2"], [6, "u1", "travelling mode", 5], [7, "u1", "m2"], [7, "u1", "travelling mode", 5], [8, "u1", "m2", "is back home"], [9, "u1", "m2", "is back home", 10], [9, "u1", "m2"]], "expected": [null, true, true, "is travelling this week", ["m2", "m1"], "", ["m1"], false, true, "is back home"]},
    {"id": "h7", "level": 3, "note": "a ttl of 1 is visible only at its own timestamp; an expired id is free again", "ops": ["MemoryStore", "addWithTtl", "get", "search", "get", "remove", "add", "get"], "args": [[], [10, "u", "a", "keep alive", 1], [10, "u", "a"], [10, "u", "alive", 1], [11, "u", "a"], [11, "u", "a"], [12, "u", "a", "now forever"], [1000000000, "u", "a"]], "expected": [null, true, "keep alive", ["a"], "", false, true, "now forever"]},
    {"id": "h8", "level": 3, "note": "update keeps the expiry; add fails while the memory is live and succeeds once it expired", "ops": ["MemoryStore", "addWithTtl", "add", "update", "get", "get", "search", "add", "get"], "args": [[], [1, "u", "a", "old text", 10], [5, "u", "a", "other text"], [5, "u", "a", "new text"], [10, "u", "a"], [11, "u", "a"], [11, "u", "new", 1], [11, "u", "a", "fresh text"], [12, "u", "a"]], "expected": [null, true, false, true, "new text", "", [], true, "fresh text"]},
    {"id": "h9", "level": 3, "note": "search drops an expired memory even when nothing read it since it expired", "ops": ["MemoryStore", "add", "addWithTtl", "search", "search", "update", "get", "addWithTtl", "search"], "args": [[], [1, "u", "a", "tea time"], [2, "u", "b", "tea party", 3], [4, "u", "tea", 2], [5, "u", "tea", 2], [5, "u", "b", "tea again"], [5, "u", "b"], [6, "v", "b", "tea party", 100], [7, "v", "tea", 2]], "expected": [null, true, true, ["b", "a"], ["a"], false, "", true, ["b"]]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["MemoryStore", "add", "update", "update", "history", "rollback", "get", "history", "rollback", "history"], "args": [[], [1, "u1", "m1", "likes tea"], [2, "u1", "m1", "likes coffee"], [3, "u1", "m1", "likes cocoa"], [4, "u1", "m1"], [5, "u1", "m1", 1], [6, "u1", "m1"], [7, "u1", "m1"], [8, "u1", "m1", 4], [9, "u1", "m9"]], "expected": [null, true, true, true, ["likes tea", "likes coffee", "likes cocoa"], true, "likes tea", ["likes tea", "likes coffee", "likes cocoa", "likes tea"], false, []]},
    {"id": "ex5", "visible": true, "level": 4, "ops": ["MemoryStore", "add", "add", "add", "setQuota", "get", "add", "get", "get", "get"], "args": [[], [1, "u1", "m1", "likes tea"], [2, "u1", "m2", "lives in oslo"], [3, "u1", "m3", "works nights"], [4, "u1", 2], [5, "u1", "m2"], [6, "u1", "m4", "has two kids"], [7, "u1", "m3"], [8, "u1", "m2"], [9, "u1", "m4"]], "expected": [null, true, true, true, ["m1"], "lives in oslo", true, "", "lives in oslo", "has two kids"]},
    {"id": "h10", "level": 4, "note": "rollback accepts versions 1 to current minus 1, records a new version and makes the memory newer for search", "ops": ["MemoryStore", "add", "add", "update", "search", "rollback", "search", "rollback", "rollback", "history", "rollback", "rollback", "rollback", "history"], "args": [[], [1, "u", "a", "blue car"], [2, "u", "b", "blue bike"], [3, "u", "a", "red car"], [4, "u", "blue", 2], [5, "u", "a", 1], [6, "u", "blue", 2], [7, "u", "a", 3], [7, "u", "a", 2], [8, "u", "a"], [9, "u", "a", 5], [9, "u", "zz", 1], [9, "u", "b", 1], [10, "u", "b"]], "expected": [null, true, true, true, ["b"], true, ["a", "b"], false, true, ["blue car", "red car", "blue car", "red car"], false, false, false, ["blue bike"]]},
    {"id": "h11", "level": 4, "note": "expired memories never count toward the quota; search and history do not count as uses", "ops": ["MemoryStore", "setQuota", "add", "addWithTtl", "add", "get", "get", "search", "add", "get", "get", "history", "add", "get", "get"], "args": [[], [1, "u", 2], [2, "u", "b", "long lived"], [3, "u", "a", "short lived", 2], [6, "u", "c", "third one"], [7, "u", "b"], [8, "u", "c"], [9, "u", "lived", 5], [10, "u", "d", "fourth one"], [11, "u", "b"], [12, "u", "c"], [13, "u", "d"], [14, "u", "e", "fifth one"], [15, "u", "d"], [16, "u", "c"]], "expected": [null, [], true, true, true, "long lived", "third one", ["b"], true, "", "third one", ["fourth one"], true, "", "third one"]},
    {"id": "h12", "level": 4, "note": "uses at the same timestamp keep their call order; setQuota evicts least recently used first; an evicted id starts a new history", "ops": ["MemoryStore", "add", "add", "add", "update", "get", "setQuota", "get", "add", "history", "get", "setQuota"], "args": [[], [1, "u", "a", "one"], [1, "u", "b", "two"], [1, "u", "c", "three"], [2, "u", "b", "two again"], [2, "u", "a"], [3, "u", 1], [4, "u", "a"], [5, "u", "b", "new two"], [6, "u", "b"], [7, "u", "a"], [8, "u", 3]], "expected": [null, true, true, true, true, "one", ["c", "b"], "one", true, ["new two"], "", []]},
    {"id": "h13", "level": 4, "note": "a rollback counts as a use; quotas are per user; a failed add evicts nothing", "ops": ["MemoryStore", "setQuota", "add", "update", "add", "add", "rollback", "add", "get", "get", "add", "add", "add", "get"], "args": [[], [1, "u", 2], [2, "u", "a", "alpha"], [3, "u", "a", "alpha two"], [4, "u", "b", "beta"], [5, "u", "b", "beta again"], [6, "u", "a", 1], [7, "u", "c", "gamma"], [8, "u", "b"], [9, "u", "a"], [10, "v", "x", "other user"], [11, "v", "y", "still fine"], [12, "v", "z", "no quota here"], [13, "v", "x"]], "expected": [null, [], true, true, true, false, true, true, "", "alpha", true, true, true, "other user"]},
    {"id": "h14", "level": 4, "note": "an expired memory has no history and cannot be rolled back; its id starts over", "ops": ["MemoryStore", "addWithTtl", "update", "history", "rollback", "history", "add", "history", "search"], "args": [[], [1, "u", "a", "version one", 5], [2, "u", "a", "version two"], [5, "u", "a"], [6, "u", "a", 1], [6, "u", "a"], [7, "u", "a", "fresh start"], [8, "u", "a"], [9, "u", "version", 3]], "expected": [null, true, true, ["version one", "version two"], false, [], true, ["fresh start"], []]}
  ]
}
