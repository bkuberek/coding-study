{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"grid": [[6, 1, 2, 1], [3, 9, 2, 6], [1, 2, 4, 7]]}, "expected": 22},
    {"id": "ex2", "visible": true, "input": {"grid": [[5, 2, 9]]}, "expected": 16},
    {"id": "h1", "input": {"grid": [[0]]}, "expected": 0, "note": "a single cell is the whole route"},
    {"id": "h2", "input": {"grid": [[3], [0], [4]]}, "expected": 7, "note": "a single column has only one route"},
    {"id": "h3", "input": {"grid": [[0, 0, 0], [0, 0, 0], [0, 0, 0]]}, "expected": 0, "note": "all tolls are zero"},
    {"id": "h4", "input": {"grid": [[7, 7], [7, 7]]}, "expected": 21, "note": "equal tolls: both routes cost the same"},
    {"id": "h5", "input": {"grid": [[100, 100], [100, 100]]}, "expected": 300, "note": "largest tolls"},
    {"id": "h6", "input": {"grid": [[1, 2, 100], [5, 100, 1], [1, 1, 1]]}, "expected": 9, "note": "the cheaper next step leads into an expensive stretch"},
    {"id": "h7", "input": {"grid": [[1, 9, 1, 9, 1], [1, 1, 1, 1, 1]]}, "expected": 6, "note": "two rows: the route dips to the cheap row"},
    {"id": "h8", "input": {"grid": [[1, 1], [9, 1], [9, 1], [9, 1]]}, "expected": 5, "note": "four rows and two columns: the cheap column wins"},
    {"id": "h9", "input": {"grid": [[4, 1, 8], [2, 100, 3], [9, 0, 0]]}, "expected": 15, "note": "the best route bends around a costly middle"},
    {"id": "h10", "input": {"grid": [[0, 5, 0, 5], [5, 0, 5, 0], [0, 5, 0, 5]]}, "expected": 15, "note": "checkerboard of zeros and fives"},
    {"id": "h11", "input": {"grid": [[3, 2, 1], [4, 5, 0]]}, "expected": 6, "note": "the route runs along the top row and then down"},
    {"id": "h12", "input": {"grid": [[50, 0, 0], [0, 0, 50]]}, "expected": 100, "note": "the start and goal tolls are paid too"},
    {"id": "h13", "input": {"grid": [[1, 2, 3, 4, 5, 6, 7, 8]]}, "expected": 36, "note": "a single row has only one route"},
    {"id": "g1", "generate": {"n": 40000, "seed": 1}, "note": "200 by 200 grid"},
    {"id": "g2", "generate": {"n": 40000, "seed": 2}, "note": "about 40000 cells"},
    {"id": "g3", "generate": {"n": 1000, "seed": 3}}
  ]
}
