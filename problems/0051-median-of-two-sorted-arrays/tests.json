{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums1": [1, 4, 9], "nums2": [2, 7]}, "expected": 4.0},
    {"id": "ex2", "visible": true, "input": {"nums1": [3, 8], "nums2": [5, 6]}, "expected": 5.5},
    {"id": "h1", "input": {"nums1": [], "nums2": [5]}, "expected": 5.0, "note": "first array empty, one value"},
    {"id": "h2", "input": {"nums1": [-3], "nums2": []}, "expected": -3.0, "note": "second array empty, one value"},
    {"id": "h3", "input": {"nums1": [], "nums2": [1, 2]}, "expected": 1.5, "note": "first array empty, even total"},
    {"id": "h4", "input": {"nums1": [1, 2], "nums2": [3, 4]}, "expected": 2.5, "note": "every value of the first array is smaller"},
    {"id": "h5", "input": {"nums1": [10, 20, 30], "nums2": [1, 2]}, "expected": 10.0, "note": "every value of the second array is smaller"},
    {"id": "h6", "input": {"nums1": [2], "nums2": [1, 3, 4, 5, 6, 7, 8, 9, 10]}, "expected": 5.5, "note": "very different lengths"},
    {"id": "h7", "input": {"nums1": [4, 4, 4], "nums2": [4, 4]}, "expected": 4.0, "note": "all values equal"},
    {"id": "h8", "input": {"nums1": [1, 3, 3, 7], "nums2": [3, 3, 5]}, "expected": 3.0, "note": "duplicates across both arrays"},
    {"id": "h9", "input": {"nums1": [-9, -5, -2], "nums2": [-8, -7, -1, 0]}, "expected": -5.0, "note": "negative values, odd total"},
    {"id": "h10", "input": {"nums1": [-1000000, 1000000], "nums2": [-1000000, 1000000]}, "expected": 0.0, "note": "extreme values"},
    {"id": "h11", "input": {"nums1": [999999], "nums2": [1000000]}, "expected": 999999.5, "note": "average of two large values"},
    {"id": "h12", "input": {"nums1": [1, 5, 9, 13], "nums2": [2, 6, 10, 14]}, "expected": 7.5, "note": "perfectly interleaved"},
    {"id": "h13", "input": {"nums1": [0, 0, 0, 0, 1], "nums2": [0]}, "expected": 0.0, "note": "median among zeros"},
    {"id": "h14", "input": {"nums1": [7, 8, 9, 10, 11, 12], "nums2": []}, "expected": 9.5, "note": "second array empty, even total"},
    {"id": "g1", "generate": {"n": 100000, "seed": 37}, "note": "large input: 10^5 values split at random between the arrays"}
  ]
}
