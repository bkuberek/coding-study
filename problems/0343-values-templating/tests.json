    {"id": "h9", "level": 2, "note": "numbers and booleans print as their text; positions count lines and columns from 1 at the {{ that opens the failing tag", "ops": ["ValuesRenderer", "setLayer", "render", "render", "render", "render", "render"], "args": [[], ["v", [["/n", "number", "42"], ["/t", "boolean", "true"], ["/s", "string", "ok"]]], ["line one\nline two {{ n }}\n\n{{ t }}{{ s }}"], ["first\nsecond\n   {{ nope }}"], ["{{ s }}\n\n{{ s }} {{ s"], ["{{ n }}{{ t }}\n{{zz}}"], ["a\n{{ s }}\nb {{ s }} {{ missing.deep }}"]], "expected": [null, true, ["ok", "line one\nline two 42\n\ntrueok"], ["error", "missing_value", "3:4", "nope"], ["error", "unclosed_tag", "3:9", ""], ["error", "missing_value", "2:1", "zz"], ["error", "missing_value", "3:11", "missing.deep"]]},
