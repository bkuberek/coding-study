    {"id": "h11", "level": 2, "note": "a changed value travels through references, so a resource whose own text did not change is updated", "ops": ["PlanEngine", "desire", "observe", "desire", "observe", "desire", "observe", "observe", "plan"], "args": [[], ["db.main", [["port", "6432"], ["host", "db"]]], ["db.main", [["port", "5432"], ["host", "db"]]], ["app.web", [["db_port", "${db.main.port}"], ["db_host", "${db.main.host}"]]], ["app.web", [["db_port", "5432"], ["db_host", "db"]]], ["aaa.first", [["k", "1"]]], ["aaa.first", [["k", "0"]]], ["aa.gone", [["k", "1"]]], []], "expected": [null, true, true, true, true, true, true, true, [["update", "aaa.first"], ["~", "k", "0", "1"], ["update", "db.main"], ["~", "port", "5432", "6432"], ["update", "app.web"], ["~", "db_port", "5432", "6432"], ["delete", "aa.gone"], ["-", "k", "1"]]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["PlanEngine", "computed", "computed", "computed", "desire", "desire", "desire", "desire", "observe", "observe", "plan"], "args": [[], ["network", "id"], ["server", "id"], ["server", "id"], ["network.main", [["range", "10.0.0.0/16"]]], ["server.web", [["network", "${network.main.id}"], ["size", "small"]]], ["server.db", [["network", "${network.vpc.id}"], ["size", "large"]]], ["network.vpc", [["range", "10.9.0.0/16"]]], ["network.vpc", [["range", "10.9.0.0/16"], ["id", "net-7"]]], ["server.db", [["network", "net-7"], ["size", "medium"], ["id", "srv-3"]]], []], "expected": [null, true, true, false, true, true, true, true, true, true, [["create", "network.main"], ["+", "id", "<unknown>"], ["+", "range", "10.0.0.0/16"], ["no-op", "network.vpc"], ["update", "server.db"], ["~", "size", "medium", "large"], ["create", "server.web"], ["+", "id", "<unknown>"], ["+", "network", "<unknown>"], ["+", "size", "small"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["PlanEngine", "computed", "computed", "forceReplacement", "forceReplacement", "desire", "desire", "desire", "observe", "observe", "observe", "observeDependency", "observeDependency", "plan", "createBeforeDestroy", "plan"], "args": [[], ["network", "id"], ["subnet", "id"], ["network", "range"], ["subnet", "network"], ["network.main", [["range", "10.1.0.0/16"]]], ["subnet.a", [["network", "${network.main.id}"], ["range", "10.1.1.0/24"]]], ["server.web", [["subnet", "${subnet.a.id}"], ["size", "small"]]], ["network.main", [["id", "net-1"], ["range", "10.0.0.0/16"]]], ["subnet.a", [["id", "sub-1"], ["network", "net-1"], ["range", "10.1.1.0/24"]]], ["server.web", [["subnet", "sub-1"], ["size", "small"]]], ["subnet.a", "network.main"], ["server.web", "subnet.a"], [], ["subnet.a"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, [["delete", "subnet.a", "replace"], ["delete", "network.main", "replace"], ["create", "network.main", "replace"], ["~", "id", "net-1", "<unknown>"], ["~", "range", "10.0.0.0/16", "10.1.0.0/16", "forces-replacement"], ["create", "subnet.a", "replace"], ["~", "id", "sub-1", "<unknown>"], ["~", "network", "net-1", "<unknown>", "forces-replacement"], ["update", "server.web"], ["~", "subnet", "sub-1", "<unknown>"]], true, [["create", "network.main", "replace"], ["~", "id", "net-1", "<unknown>"], ["~", "range", "10.0.0.0/16", "10.1.0.0/16", "forces-replacement"], ["create", "subnet.a", "replace"], ["~", "id", "sub-1", "<unknown>"], ["~", "network", "net-1", "<unknown>", "forces-replacement"], ["update", "server.web"], ["~", "subnet", "sub-1", "<unknown>"], ["delete", "subnet.a", "replace"], ["delete", "network.main", "replace"]]]},
    {"id": "h12", "level": 3, "note": "computed keys sit among the others in key order on a create, are never compared, a delete lists them, and an unchanged or updated target lends its actual value", "ops": ["PlanEngine", "computed", "desire", "desire", "observe", "desire", "observe", "observe", "desire", "observe", "desire", "observe", "plan"], "args": [[], ["vm", "id"], ["vm.new", [["size", "s"], ["a_zone", "1"]]], ["vm.kept", [["size", "m"]]], ["vm.kept", [["size", "m"], ["id", "vm-1"]]], ["vm.grown", [["size", "l"]]], ["vm.grown", [["id", "vm-2"], ["size", "m"]]], ["vm.gone", [["id", "vm-3"], ["size", "s"]]], ["ref.kept", [["vm", "${vm.kept.id}"]]], ["ref.kept", [["vm", "vm-1"]]], ["ref.grown", [["vm", "${vm.grown.id}"]]], ["ref.grown", [["vm", "vm-0"]]], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["update", "vm.grown"], ["~", "size", "m", "l"], ["update", "ref.grown"], ["~", "vm", "vm-0", "vm-2"], ["no-op", "vm.kept"], ["no-op", "ref.kept"], ["create", "vm.new"], ["+", "a_zone", "1"], ["+", "id", "<unknown>"], ["+", "size", "s"], ["delete", "vm.gone"], ["-", "id", "vm-3"], ["-", "size", "s"]]]},
    {"id": "h13", "level": 3, "note": "adding or removing a forcing key forces a replace too; only forcing rows are marked; a key forces only on its own type", "ops": ["PlanEngine", "forceReplacement", "forceReplacement", "forceReplacement", "desire", "observe", "desire", "observe", "desire", "observe", "desire", "observe", "plan"], "args": [[], ["disk", "kind"], ["disk", "kind"], ["vm", "zone"], ["disk.add", [["kind", "ssd"], ["size", "10"]]], ["disk.add", [["size", "10"]]], ["disk.drop", [["size", "10"]]], ["disk.drop", [["kind", "hdd"], ["size", "10"]]], ["disk.mixed", [["kind", "ssd"], ["size", "20"], ["tag", "t"]]], ["disk.mixed", [["kind", "hdd"], ["size", "10"]]], ["vm.kind", [["kind", "big"], ["zone", "a"]]], ["vm.kind", [["kind", "small"], ["zone", "a"]]], []], "expected": [null, true, false, true, true, true, true, true, true, true, true, true, [["update", "vm.kind"], ["~", "kind", "small", "big"], ["delete", "disk.add", "replace"], ["create", "disk.add", "replace"], ["+", "kind", "ssd", "forces-replacement"], ["delete", "disk.drop", "replace"], ["create", "disk.drop", "replace"], ["-", "kind", "hdd", "forces-replacement"], ["delete", "disk.mixed", "replace"], ["create", "disk.mixed", "replace"], ["~", "kind", "hdd", "ssd", "forces-replacement"], ["~", "size", "10", "20"], ["+", "tag", "t"]]]},
