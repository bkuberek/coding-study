    {"id": "h2", "level": 1, "note": "a second desire or observe of an address replaces its attributes; nothing is merged", "ops": ["PlanEngine", "desire", "desire", "observe", "observe", "plan"], "args": [[], ["disk.data", [["size", "10"], ["kind", "ssd"]]], ["disk.data", [["size", "20"]]], ["disk.data", [["size", "10"], ["kind", "ssd"], ["iops", "300"]]], ["disk.data", [["size", "20"], ["kind", "hdd"]]], []], "expected": [null, true, false, true, false, [["update", "disk.data"], ["-", "kind", "hdd"]]]},
