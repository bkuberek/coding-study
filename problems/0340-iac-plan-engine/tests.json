    {"id": "h8", "level": 2, "note": "unknown references: a target that is only actual, a key the target does not declare, rows by address then key; an unknown reference closes no cycle", "ops": ["PlanEngine", "desire", "observe", "desire", "desire", "plan", "desire", "desire", "desire", "plan"], "args": [[], ["web.a", [["db", "${db.x.host}"], ["cache", "${cache.c.size}"], ["port", "${web.a.port}"]]], ["db.x", [["host", "h"]]], ["cache.c", [["mem", "1"]]], ["api.b", [["db", "${db.x.host}"]]], [], ["web.a", [["port", "1"]]], ["loop.p", [["to", "${loop.q.k}"]]], ["loop.q", [["k", "1"], ["back", "${loop.p.nope}"]]], []], "expected": [null, true, true, true, true, [["error", "unknown-reference", "api.b", "db", "db.x.host"], ["error", "unknown-reference", "web.a", "cache", "cache.c.size"], ["error", "unknown-reference", "web.a", "db", "db.x.host"], ["error", "cycle", "web.a"]], false, true, true, [["error", "unknown-reference", "api.b", "db", "db.x.host"], ["error", "unknown-reference", "loop.q", "back", "loop.p.nope"]]]},
    {"id": "h9", "level": 2, "note": "one row per group that depends on itself, a self-reference is a group of one, a resource that only reaches a cycle is in no group, and unknown references come first", "ops": ["PlanEngine", "desire", "desire", "desire", "desire", "desire", "desire", "desire", "desire", "plan", "desire", "plan"], "args": [[], ["svc.loop", [["me", "${svc.loop.name}"], ["name", "x"]]], ["ring.c", [["next", "${ring.a.id}"], ["id", "c"]]], ["ring.a", [["next", "${ring.b.id}"], ["id", "a"]]], ["ring.b", [["next", "${ring.c.id}"], ["id", "b"]]], ["pair.x", [["other", "${pair.y.id}"], ["id", "x"]]], ["pair.y", [["other", "${pair.x.id}"], ["id", "y"]]], ["fan.in", [["a", "${ring.a.id}"], ["x", "${pair.x.id}"]]], ["lone.ok", [["k", "v"]]], [], ["fan.in", [["a", "${ring.a.id}"], ["x", "${pair.x.missing}"]]], []], "expected": [null, true, true, true, true, true, true, true, true, [["error", "cycle", "pair.x", "pair.y"], ["error", "cycle", "ring.a", "ring.b", "ring.c"], ["error", "cycle", "svc.loop"]], false, [["error", "unknown-reference", "fan.in", "x", "pair.x.missing"], ["error", "cycle", "pair.x", "pair.y"], ["error", "cycle", "ring.a", "ring.b", "ring.c"], ["error", "cycle", "svc.loop"]]]},
