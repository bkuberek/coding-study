{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"target": 10, "nums": [3, 1, 4, 1, 5, 9, 2]}, "expected": 2},
    {"id": "ex2", "visible": true, "input": {"target": 50, "nums": [10, 20, 5]}, "expected": 0},
    {"id": "h1", "input": {"target": 5, "nums": [5]}, "expected": 1, "note": "single element equal to the target"},
    {"id": "h2", "input": {"target": 6, "nums": [5]}, "expected": 0, "note": "single element below the target"},
    {"id": "h3", "input": {"target": 1, "nums": [1, 1, 1]}, "expected": 1, "note": "the smallest target"},
    {"id": "h4", "input": {"target": 3, "nums": [1, 1, 1]}, "expected": 3, "note": "the whole array is needed"},
    {"id": "h5", "input": {"target": 4, "nums": [1, 1, 1]}, "expected": 0, "note": "the whole array falls short"},
    {"id": "h6", "input": {"target": 15, "nums": [1, 2, 3, 4, 5]}, "expected": 5, "note": "the total equals the target exactly"},
    {"id": "h7", "input": {"target": 11, "nums": [1, 2, 3, 4, 5]}, "expected": 3, "note": "the best window is at the end"},
    {"id": "h8", "input": {"target": 100, "nums": [1, 100, 1]}, "expected": 1, "note": "one large element suffices"},
    {"id": "h9", "input": {"target": 1000000000, "nums": [10000, 10000]}, "expected": 0, "note": "the largest target"},
    {"id": "h10", "input": {"target": 9, "nums": [4, 1, 1, 6, 2, 3]}, "expected": 3, "note": "a sum exactly at the target in the middle"},
    {"id": "h11", "input": {"target": 8, "nums": [8, 1, 8]}, "expected": 1, "note": "valid single elements at both ends"},
    {"id": "h12", "input": {"target": 20, "nums": [3, 3, 3, 3, 3, 3, 3]}, "expected": 7, "note": "all values equal"},
    {"id": "h13", "input": {"target": 12, "nums": [5, 1, 3, 5, 10, 7, 4, 9, 2, 8]}, "expected": 2, "note": "several windows of the best length"},
    {"id": "h14", "input": {"target": 10, "nums": [1, 2, 3, 4, 10]}, "expected": 1, "note": "the last element alone wins"},
    {"id": "h15", "input": {"target": 30000, "nums": [10000, 10000, 1, 10000, 10000, 10000]}, "expected": 3, "note": "a small value breaks the first run of maxima"},
    {"id": "g1", "generate": {"n": 10000, "seed": 5}, "hang_guard_ms": 30000, "note": "large input: extending from every start is about 10^7 steps here"},
    {"id": "g2", "generate": {"n": 10000, "seed": 3}, "hang_guard_ms": 30000, "note": "large input with tiny values"}
  ]
}
