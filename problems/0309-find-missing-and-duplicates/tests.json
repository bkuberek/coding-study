{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [3, 1, 3, 5, 5]}, "expected": [[2, 4], [3, 5]]},
    {"id": "ex2", "visible": true, "input": {"nums": [2, 2]}, "expected": [[1], [2]]},
    {"id": "h1", "input": {"nums": [1]}, "expected": [[], []], "note": "one value: nothing is missing or repeated"},
    {"id": "h2", "input": {"nums": [1, 1]}, "expected": [[2], [1]], "note": "smallest array with a repeat: the other value is missing"},
    {"id": "h3", "input": {"nums": [2, 1, 4, 3, 6, 5]}, "expected": [[], []], "note": "a permutation: both lists are empty"},
    {"id": "h4", "input": {"nums": [4, 4, 4, 4]}, "expected": [[1, 2, 3], [4]], "note": "one value fills the whole array and is listed once"},
    {"id": "h5", "input": {"nums": [2, 3, 2, 2, 5, 5, 5]}, "expected": [[1, 4, 6, 7], [2, 5]], "note": "values that occur three times are listed once"},
    {"id": "h6", "input": {"nums": [10, 10, 10, 1, 1, 1, 5, 5, 5, 5]}, "expected": [[2, 3, 4, 6, 7, 8, 9], [1, 5, 10]], "note": "the largest value n is repeated, and so is 1"},
    {"id": "h7", "input": {"nums": [1, 2, 3, 4, 5, 6, 7, 7]}, "expected": [[8], [7]], "note": "sorted input with a repeat of the last value"},
    {"id": "h8", "input": {"nums": [8, 8, 6, 5, 5, 3, 2, 1]}, "expected": [[4, 7], [5, 8]], "note": "reverse sorted input"},
    {"id": "h9", "input": {"nums": [1, 1, 3, 3, 2]}, "expected": [[4, 5], [1, 3]], "note": "the repeated values are found in the order of the missing slots (3 before 1), but must be listed sorted"},
    {"id": "h10", "input": {"nums": [7, 3, 9, 3, 12, 5, 7, 1, 11, 5, 2, 12]}, "expected": [[4, 6, 8, 10], [3, 5, 7, 12]], "note": "a shuffled array with four repeats and four gaps"},
    {"id": "g1", "generate": {"n": 100000, "seed": 309}, "note": "largest generated size"}
  ]
}
