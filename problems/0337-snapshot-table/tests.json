{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["SnapshotTable", "currentSnapshot", "scan", "append", "currentSnapshot", "scan", "append", "scan", "manifest", "manifest", "manifest"], "args": [[], [], [], [[["d/b.data", "2026-01", "100"], ["d/a.data", "2026-01", "50"]], 1000], [], [], [[["d/c.data", "2026-02", "70"]], 2000], [], [2], [1], [3]], "expected": [null, 0, [], 1, 1, ["d/a.data", "d/b.data"], 2, ["d/a.data", "d/b.data", "d/c.data"], [["d/a.data", "2026-01", "50", "existing"], ["d/b.data", "2026-01", "100", "existing"], ["d/c.data", "2026-02", "70", "added"]], [["d/a.data", "2026-01", "50", "added"], ["d/b.data", "2026-01", "100", "added"]], []]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["SnapshotTable", "append", "append", "append", "append", "currentSnapshot", "manifest"], "args": [[], [[], 10], [[["x", "p", "1"], ["x", "p", "2"]], 10], [[["x", "p", "1"]], 10], [[["x", "p", "5"]], 20], [], [0]], "expected": [null, -1, -1, 1, -1, 1, []]},
    {"id": "h1", "level": 1, "note": "an empty table has snapshot 0, no files and no manifests", "ops": ["SnapshotTable", "currentSnapshot", "scan", "manifest", "manifest", "manifest"], "args": [[], [], [], [0], [1], [-1]], "expected": [null, 0, [], [], [], []]},
    {"id": "h2", "level": 1, "note": "paths are sorted by character code, in scans and manifests", "ops": ["SnapshotTable", "append", "scan", "append", "manifest"], "args": [[], [[["a", "p", "10"], ["B", "p", "10"], ["9", "p", "10"], ["10", "p", "10"]], 5], [], [[["b", "p", "10"], ["A", "p", "10"]], 6], [2]], "expected": [null, 1, ["10", "9", "B", "a"], 2, [["10", "p", "10", "existing"], ["9", "p", "10", "existing"], ["A", "p", "10", "added"], ["B", "p", "10", "existing"], ["a", "p", "10", "existing"], ["b", "p", "10", "added"]]]},
    {"id": "h3", "level": 1, "note": "a refused append adds nothing and uses no snapshot id, even when only one path is bad", "ops": ["SnapshotTable", "append", "append", "append", "currentSnapshot", "scan", "append", "currentSnapshot", "append", "manifest"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 1], [[["c", "p", "10"], ["a", "p", "10"]], 2], [[["c", "p", "10"], ["d", "p", "10"], ["c", "p", "10"]], 3], [], [], [[["c", "p", "10"]], 4], [], [[["e", "p", "10"]], 4], [3]], "expected": [null, 1, -1, -1, 1, ["a", "b"], 2, 2, 3, [["a", "p", "10", "existing"], ["b", "p", "10", "existing"], ["c", "p", "10", "existing"], ["e", "p", "10", "added"]]]},
    {"id": "h4", "level": 1, "note": "an older manifest lists only the files of its time, each added by that snapshot or existing from before", "ops": ["SnapshotTable", "append", "append", "append", "manifest", "manifest", "manifest", "manifest"], "args": [[], [[["f1", "a", "1"]], 1], [[["f2", "b", "2"], ["f3", "a", "3"]], 2], [[["f4", "c", "4"]], 3], [1], [2], [3], [4]], "expected": [null, 1, 2, 3, [["f1", "a", "1", "added"]], [["f1", "a", "1", "existing"], ["f2", "b", "2", "added"], ["f3", "a", "3", "added"]], [["f1", "a", "1", "existing"], ["f2", "b", "2", "existing"], ["f3", "a", "3", "existing"], ["f4", "c", "4", "added"]], []]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["SnapshotTable", "append", "deleteFiles", "scan", "scanAt", "overwrite", "scan", "manifest", "history"], "args": [[], [[["a", "p1", "10"], ["b", "p1", "10"], ["c", "p2", "10"]], 100], [["a"], 200], [], [1], ["p2", [["d", "p2", "10"]], 300], [], [3], []], "expected": [null, 1, 2, ["b", "c"], ["a", "b", "c"], 3, ["b", "d"], [["b", "p1", "10", "existing"], ["c", "p2", "10", "deleted"], ["d", "p2", "10", "added"]], [["1", "0", "100", "append", "3", "0"], ["2", "1", "200", "delete", "0", "1"], ["3", "2", "300", "overwrite", "1", "1"]]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["SnapshotTable", "append", "append", "append", "deleteFiles", "snapshotAsOf", "snapshotAsOf", "snapshotAsOf", "snapshotAsOf", "snapshotAsOf", "scanAt", "scanAt"], "args": [[], [[["a", "p", "10"]], 100], [[["b", "p", "10"]], 200], [[["c", "p", "10"]], 200], [["a", "b"], 400], [50], [100], [199], [200], [1000], [3], [4]], "expected": [null, 1, 2, 3, 4, 0, 1, 1, 3, 4, ["a", "b", "c"], ["c"]]},
    {"id": "h5", "level": 2, "note": "deleting a file that is not live, twice in one call, or nothing at all is refused", "ops": ["SnapshotTable", "append", "deleteFiles", "deleteFiles", "deleteFiles", "deleteFiles", "currentSnapshot", "deleteFiles", "deleteFiles", "scan", "currentSnapshot"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 1], [["z"], 2], [["a", "a"], 2], [[], 2], [["a", "z"], 2], [], [["a"], 3], [["a"], 4], [], []], "expected": [null, 1, -1, -1, -1, -1, 1, 2, -1, ["b"], 2]},
    {"id": "h6", "level": 2, "note": "overwrite replaces exactly one partition; it refuses files of another partition and a change of nothing", "ops": ["SnapshotTable", "append", "overwrite", "overwrite", "overwrite", "overwrite", "scan", "overwrite", "overwrite", "history"], "args": [[], [[["a1", "a", "10"], ["a2", "a", "10"], ["b1", "b", "10"]], 1], ["a", [["a3", "b", "10"]], 2], ["c", [], 2], ["a", [["b1", "a", "10"]], 2], ["a", [["a3", "a", "10"], ["a4", "a", "10"]], 3], [], ["b", [], 4], ["c", [["c1", "c", "10"]], 5], []], "expected": [null, 1, -1, -1, -1, 2, ["a3", "a4", "b1"], 3, 4, [["1", "0", "1", "append", "3", "0"], ["2", "1", "3", "overwrite", "2", "2"], ["3", "2", "4", "delete", "0", "1"], ["4", "3", "5", "append", "1", "0"]]]},
    {"id": "h7", "level": 2, "note": "a deleted entry appears only in the manifest of the snapshot that removed the file", "ops": ["SnapshotTable", "append", "deleteFiles", "append", "manifest", "manifest", "manifest"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 1], [["a"], 2], [[["c", "p", "10"]], 3], [2], [3], [1]], "expected": [null, 1, 2, 3, [["a", "p", "10", "deleted"], ["b", "p", "10", "existing"]], [["b", "p", "10", "existing"], ["c", "p", "10", "added"]], [["a", "p", "10", "added"], ["b", "p", "10", "added"]]]},
    {"id": "h8", "level": 2, "note": "time travel picks the last commit at or before the time; scanAt of 0 or an unknown id is empty", "ops": ["SnapshotTable", "append", "append", "append", "snapshotAsOf", "snapshotAsOf", "snapshotAsOf", "snapshotAsOf", "scanAt", "scanAt", "scanAt"], "args": [[], [[["a", "p", "10"]], 10], [[["b", "p", "10"]], 10], [[["c", "p", "10"]], 30], [9], [10], [29], [30], [0], [4], [2]], "expected": [null, 1, 2, 3, 0, 2, 2, 3, [], [], ["a", "b"]]},
    {"id": "h9", "level": 2, "note": "a path is never used again, even after its file was deleted", "ops": ["SnapshotTable", "append", "deleteFiles", "append", "overwrite", "scan", "currentSnapshot", "history"], "args": [[], [[["a", "p", "10"]], 1], [["a"], 2], [[["a", "p", "10"]], 3], ["p", [["a", "p", "10"]], 3], [], [], []], "expected": [null, 1, 2, -1, -1, [], 2, [["1", "0", "1", "append", "1", "0"], ["2", "1", "2", "delete", "0", "1"]]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["SnapshotTable", "append", "commit", "commit", "commit", "commit", "scan", "history"], "args": [[], [[["a", "p1", "10"], ["b", "p2", "10"]], 100], [1, [["c", "p1", "10"]], [], 110], [1, [["d", "p3", "10"]], [], 120], [1, [], ["b"], 130], [1, [["a2", "p1", "10"]], ["a"], 140], [], []], "expected": [null, 1, ["committed", "2"], ["rebased", "3"], ["rebased", "4"], ["conflict", "2"], ["a", "c", "d"], [["1", "0", "100", "append", "2", "0"], ["2", "1", "110", "append", "1", "0"], ["3", "2", "120", "append", "1", "0"], ["4", "3", "130", "delete", "0", "1"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["SnapshotTable", "append", "commit", "commit", "commit", "commit", "commit", "commit", "scan"], "args": [[], [[["a", "p1", "10"], ["b", "p2", "10"]], 100], [1, [], ["a"], 110], [1, [], ["a"], 120], [1, [["b2", "p2", "10"]], ["b"], 130], [9, [["x", "p", "10"]], [], 140], [1, [], ["zzz"], 140], [1, [], [], 140], []], "expected": [null, 1, ["committed", "2"], ["conflict", "2"], ["rebased", "3"], ["invalid", ""], ["invalid", ""], ["invalid", ""], ["b2"]]},
    {"id": "h10", "level": 3, "note": "a rebased commit is applied to the current files, so a concurrent append survives it", "ops": ["SnapshotTable", "append", "commit", "commit", "scan", "scanAt", "manifest"], "args": [[], [[["a", "x", "10"], ["b", "y", "10"]], 1], [1, [["c", "z", "10"]], [], 2], [1, [["b2", "y", "10"]], ["b"], 3], [], [2], [3]], "expected": [null, 1, ["committed", "2"], ["rebased", "3"], ["a", "b2", "c"], ["a", "b", "c"], [["a", "x", "10", "existing"], ["b", "y", "10", "deleted"], ["b2", "y", "10", "added"], ["c", "z", "10", "existing"]]]},
    {"id": "h11", "level": 3, "note": "the parent of a rebased snapshot is the snapshot it was applied to, not the base", "ops": ["SnapshotTable", "append", "append", "append", "commit", "commit", "history"], "args": [[], [[["a", "p", "10"]], 1], [[["b", "p", "10"]], 2], [[["c", "p", "10"]], 3], [1, [["d", "p", "10"]], [], 4], [4, [["e", "p", "10"]], [], 5], []], "expected": [null, 1, 2, 3, ["rebased", "4"], ["committed", "5"], [["1", "0", "1", "append", "1", "0"], ["2", "1", "2", "append", "1", "0"], ["3", "2", "3", "append", "1", "0"], ["4", "3", "4", "append", "1", "0"], ["5", "4", "5", "append", "1", "0"]]]},
    {"id": "h12", "level": 3, "note": "the first conflicting snapshot after the base is reported", "ops": ["SnapshotTable", "append", "append", "commit", "commit", "commit", "commit", "currentSnapshot"], "args": [[], [[["a", "p", "10"], ["b", "q", "10"]], 1], [[["c", "r", "10"]], 2], [2, [["p2", "p", "10"]], [], 3], [3, [], ["b"], 4], [1, [], ["a", "b"], 5], [2, [], ["b"], 5], []], "expected": [null, 1, 2, ["committed", "3"], ["committed", "4"], ["conflict", "3"], ["conflict", "4"], 4]},
    {"id": "h13", "level": 3, "note": "a concurrent delete of another file in the same partition is no conflict, nor is an append to another partition", "ops": ["SnapshotTable", "append", "deleteFiles", "append", "commit", "scan", "history"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"], ["c", "q", "10"]], 1], [["a"], 2], [[["d", "q", "10"]], 3], [1, [["e", "p", "10"]], ["b"], 4], [], []], "expected": [null, 1, 2, 3, ["rebased", "4"], ["c", "d", "e"], [["1", "0", "1", "append", "3", "0"], ["2", "1", "2", "delete", "0", "1"], ["3", "2", "3", "append", "1", "0"], ["4", "3", "4", "overwrite", "1", "1"]]]},
    {"id": "h14", "level": 3, "note": "a file live at the base but removed since is a conflict; a file that was not live at the base is invalid", "ops": ["SnapshotTable", "append", "append", "deleteFiles", "commit", "commit", "commit", "history"], "args": [[], [[["a", "p", "10"]], 1], [[["b", "q", "10"]], 2], [["a"], 3], [1, [], ["a"], 4], [1, [], ["b"], 4], [2, [], ["b"], 4], []], "expected": [null, 1, 2, 3, ["conflict", "3"], ["invalid", ""], ["rebased", "4"], [["1", "0", "1", "append", "1", "0"], ["2", "1", "2", "append", "1", "0"], ["3", "2", "3", "delete", "0", "1"], ["4", "3", "4", "delete", "0", "1"]]]},
    {"id": "h15", "level": 3, "note": "base 0 is the empty table: appends rebase onto anything, removals from it are invalid", "ops": ["SnapshotTable", "commit", "commit", "commit", "commit", "commit", "commit", "commit", "commit", "history"], "args": [[], [0, [["a", "p", "10"]], [], 1], [0, [["b", "p", "10"]], [], 2], [0, [], ["a"], 3], [-1, [["c", "p", "10"]], [], 3], [2, [["c", "p", "10"]], ["a", "b"], 4], [3, [["a", "p", "10"]], [], 5], [3, [["d", "p", "10"], ["d", "p", "10"]], [], 5], [3, [], ["c", "c"], 5], []], "expected": [null, ["committed", "1"], ["rebased", "2"], ["invalid", ""], ["invalid", ""], ["committed", "3"], ["invalid", ""], ["invalid", ""], ["invalid", ""], [["1", "0", "1", "append", "1", "0"], ["2", "1", "2", "append", "1", "0"], ["3", "2", "4", "overwrite", "1", "2"]]]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["SnapshotTable", "append", "deleteFiles", "append", "overwrite", "expireSnapshots", "history", "scanAt", "snapshotAsOf", "snapshotAsOf", "commit", "expireSnapshots", "history"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 100], [["a"], 200], [[["c", "p", "10"]], 300], ["p", [["d", "p", "10"]], 400], [250, 1], [], [2], [250], [300], [2, [["e", "p", "10"]], [], 500], [1000, 1], []], "expected": [null, 1, 2, 3, 4, ["a"], [["3", "2", "300", "append", "1", "0"], ["4", "3", "400", "overwrite", "1", "2"]], [], 0, 3, ["invalid", ""], ["b", "c"], [["4", "3", "400", "overwrite", "1", "2"]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["SnapshotTable", "append", "compact", "scan", "manifest", "compact", "history"], "args": [[], [[["p/1", "p", "10"], ["p/2", "p", "20"], ["p/3", "p", "500"], ["q/1", "q", "5"]], 100], ["p", 100, 200], [], [2], ["p", 100, 300], []], "expected": [null, 1, 2, ["p/3", "p/compacted-2", "q/1"], [["p/1", "p", "10", "deleted"], ["p/2", "p", "20", "deleted"], ["p/3", "p", "500", "existing"], ["p/compacted-2", "p", "30", "added"], ["q/1", "q", "5", "existing"]], -1, [["1", "0", "100", "append", "4", "0"], ["2", "1", "200", "replace", "1", "2"]]]},
    {"id": "h16", "level": 4, "note": "the newest snapshots stay however old they are; a snapshot exactly at the cutoff stays", "ops": ["SnapshotTable", "append", "deleteFiles", "append", "deleteFiles", "expireSnapshots", "history", "expireSnapshots", "history", "expireSnapshots", "history"], "args": [[], [[["a", "p", "10"]], 10], [["a"], 20], [[["b", "p", "10"]], 30], [["b"], 40], [1000, 3], [], [30, 1], [], [31, 1], []], "expected": [null, 1, 2, 3, 4, ["a"], [["2", "1", "20", "delete", "0", "1"], ["3", "2", "30", "append", "1", "0"], ["4", "3", "40", "delete", "0", "1"]], [], [["3", "2", "30", "append", "1", "0"], ["4", "3", "40", "delete", "0", "1"]], ["b"], [["4", "3", "40", "delete", "0", "1"]]]},
    {"id": "h17", "level": 4, "note": "a file live in a retained snapshot is never returned; one removed by a retained snapshot is", "ops": ["SnapshotTable", "append", "append", "deleteFiles", "append", "expireSnapshots", "scan", "manifest", "expireSnapshots"], "args": [[], [[["keep", "p", "10"], ["old", "p", "10"]], 1], [[["x", "p", "10"]], 2], [["old"], 3], [[["y", "p", "10"]], 4], [3, 1], [], [3], [100, 1]], "expected": [null, 1, 2, 3, 4, ["old"], ["keep", "x", "y"], [["keep", "p", "10", "existing"], ["old", "p", "10", "deleted"], ["x", "p", "10", "existing"]], []]},
    {"id": "h18", "level": 4, "note": "a file already returned by one expiration is not returned again", "ops": ["SnapshotTable", "append", "deleteFiles", "deleteFiles", "append", "expireSnapshots", "expireSnapshots", "expireSnapshots", "expireSnapshots"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 1], [["a"], 2], [["b"], 3], [[["c", "p", "10"]], 4], [3, 1], [4, 1], [5, 1], [5, 1]], "expected": [null, 1, 2, 3, 4, ["a", "b"], [], [], []]},
    {"id": "h19", "level": 4, "note": "after an expiration, base 0 and expired bases are invalid, and time travel to an expired snapshot finds nothing", "ops": ["SnapshotTable", "append", "append", "append", "expireSnapshots", "commit", "commit", "commit", "snapshotAsOf", "snapshotAsOf", "manifest", "scanAt"], "args": [[], [[["a", "p", "10"]], 10], [[["b", "p", "10"]], 20], [[["c", "p", "10"]], 30], [25, 1], [0, [["d", "p", "10"]], [], 40], [1, [["d", "p", "10"]], [], 40], [2, [["d", "p", "10"]], [], 40], [15], [25], [1], [3]], "expected": [null, 1, 2, 3, [], ["invalid", ""], ["invalid", ""], ["invalid", ""], 0, 0, [], ["a", "b", "c"]]},
    {"id": "h20", "level": 4, "note": "compaction takes only files below the limit in the one partition, needs two of them, and names the file after the new snapshot", "ops": ["SnapshotTable", "append", "compact", "compact", "compact", "compact", "scan", "manifest", "history"], "args": [[], [[["a1", "a", "99"], ["a2", "a", "100"], ["b1", "b", "1"], ["b2", "b", "2"]], 1], ["a", 100, 2], ["a", 101, 2], ["c", 100, 3], ["b", 3, 3], [], [3], []], "expected": [null, 1, -1, 2, -1, 3, ["a/compacted-2", "b/compacted-3"], [["a/compacted-2", "a", "199", "existing"], ["b/compacted-3", "b", "3", "added"], ["b1", "b", "1", "deleted"], ["b2", "b", "2", "deleted"]], [["1", "0", "1", "append", "4", "0"], ["2", "1", "2", "replace", "1", "2"], ["3", "2", "3", "replace", "1", "2"]]]},
    {"id": "h21", "level": 4, "note": "a compaction does not count as a concurrent append, but removing a file it rewrote still conflicts", "ops": ["SnapshotTable", "append", "compact", "commit", "commit", "scan", "history"], "args": [[], [[["s1", "p", "1"], ["s2", "p", "2"], ["big", "p", "900"]], 1], ["p", 100, 2], [1, [["new", "p", "5"]], ["big"], 3], [1, [], ["s1"], 4], [], []], "expected": [null, 1, 2, ["rebased", "3"], ["conflict", "2"], ["new", "p/compacted-2"], [["1", "0", "1", "append", "3", "0"], ["2", "1", "2", "replace", "1", "2"], ["3", "2", "3", "overwrite", "1", "1"]]]},
    {"id": "h22", "level": 4, "note": "the small files a compaction replaced can be deleted once no retained snapshot has them", "ops": ["SnapshotTable", "append", "compact", "append", "expireSnapshots", "expireSnapshots", "scan", "manifest"], "args": [[], [[["s1", "p", "1"], ["s2", "p", "2"], ["t", "q", "3"]], 1], ["p", 100, 2], [[["u", "q", "4"]], 3], [2, 1], [3, 1], [], [3]], "expected": [null, 1, 2, 3, ["s1", "s2"], [], ["p/compacted-2", "t", "u"], [["p/compacted-2", "p", "3", "existing"], ["t", "q", "3", "existing"], ["u", "q", "4", "added"]]]},
    {"id": "h23", "level": 4, "note": "nothing to expire returns nothing; the current snapshot always stays", "ops": ["SnapshotTable", "expireSnapshots", "append", "expireSnapshots", "deleteFiles", "expireSnapshots", "expireSnapshots", "history", "scan", "currentSnapshot"], "args": [[], [100, 1], [[["a", "p", "10"]], 10], [100, 1], [["a"], 20], [100, 5], [100, 1], [], [], []], "expected": [null, [], 1, [], 2, [], ["a"], [["2", "1", "20", "delete", "0", "1"]], [], 2]},
    {"id": "h24", "level": 4, "note": "a file removed by the current snapshot is still read by an older retained one, so it stays", "ops": ["SnapshotTable", "append", "append", "deleteFiles", "expireSnapshots", "scanAt", "expireSnapshots", "history"], "args": [[], [[["a", "p", "10"], ["b", "p", "10"]], 1], [[["c", "p", "10"]], 2], [["a"], 3], [2, 1], [2], [3, 1], []], "expected": [null, 1, 2, 3, [], ["a", "b", "c"], ["a"], [["3", "2", "3", "delete", "0", "1"]]]}
  ]
}
