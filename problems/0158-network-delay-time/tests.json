{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"times": [[2, 1, 3], [2, 3, 1], [3, 4, 2], [1, 4, 1]], "n": 4, "k": 2}, "expected": 3},
    {"id": "ex2", "visible": true, "input": {"times": [[1, 2, 5], [3, 2, 1]], "n": 3, "k": 1}, "expected": -1},
    {"id": "h1", "input": {"times": [], "n": 1, "k": 1}, "expected": 0, "note": "a single node already has the signal"},
    {"id": "h2", "input": {"times": [[1, 2, 7]], "n": 2, "k": 2}, "expected": -1, "note": "the link points the wrong way"},
    {"id": "h3", "input": {"times": [[1, 2, 0], [2, 3, 0]], "n": 3, "k": 1}, "expected": 0, "note": "zero travel times"},
    {"id": "h4", "input": {"times": [[1, 2, 10], [1, 3, 1], [3, 4, 1], [4, 2, 1]], "n": 4, "k": 1}, "expected": 3, "note": "more links but less time beats the direct link"},
    {"id": "h5", "input": {"times": [[1, 2, 4], [2, 3, 4], [3, 1, 4]], "n": 3, "k": 2}, "expected": 8, "note": "a cycle"},
    {"id": "h6", "input": {"times": [[1, 2, 100], [2, 3, 100], [3, 4, 100], [4, 5, 100], [5, 6, 100], [6, 7, 100], [7, 8, 100], [8, 9, 100], [9, 10, 100], [10, 11, 100], [11, 12, 100], [12, 13, 100], [13, 14, 100], [14, 15, 100], [15, 16, 100], [16, 17, 100], [17, 18, 100], [18, 19, 100], [19, 20, 100], [20, 21, 100], [21, 22, 100], [22, 23, 100], [23, 24, 100], [24, 25, 100], [25, 26, 100], [26, 27, 100], [27, 28, 100], [28, 29, 100], [29, 30, 100]], "n": 30, "k": 1}, "expected": 2900, "note": "a chain of 29 slow links"},
    {"id": "h7", "input": {"times": [[1, 2, 100], [2, 3, 100], [3, 4, 100], [4, 5, 100], [5, 6, 100], [6, 7, 100], [7, 8, 100], [8, 9, 100], [9, 10, 100], [10, 11, 100], [11, 12, 100], [12, 13, 100], [13, 14, 100], [14, 15, 100], [15, 16, 100], [16, 17, 100], [17, 18, 100], [18, 19, 100], [19, 20, 100], [20, 21, 100], [21, 22, 100], [22, 23, 100], [23, 24, 100], [24, 25, 100], [25, 26, 100], [26, 27, 100], [27, 28, 100], [28, 29, 100], [29, 30, 100]], "n": 30, "k": 30}, "expected": -1, "note": "the source is the end of the chain"},
    {"id": "h8", "input": {"times": [[3, 1, 2], [3, 2, 2], [3, 4, 2], [3, 5, 2]], "n": 5, "k": 3}, "expected": 2, "note": "a star: everyone at the same time"},
    {"id": "h9", "input": {"times": [[1, 2, 1], [2, 1, 1], [1, 3, 50], [2, 3, 48]], "n": 3, "k": 1}, "expected": 49, "note": "links in both directions between two nodes"},
    {"id": "h10", "input": {"times": [[1, 2, 100], [2, 3, 100], [1, 3, 100]], "n": 3, "k": 1}, "expected": 100, "note": "maximum travel times"},
    {"id": "h11", "input": {"times": [[2, 3, 5], [3, 4, 5], [4, 2, 5]], "n": 4, "k": 1}, "expected": -1, "note": "the source has no outgoing links"},
    {"id": "h12", "input": {"times": [[1, 3, 9], [1, 2, 2], [2, 3, 2], [3, 4, 3], [2, 4, 9], [4, 5, 1], [3, 5, 6]], "n": 5, "k": 1}, "expected": 8, "note": "the last node settles through a chain of updates"},
    {"id": "g1", "generate": {"n": 2000, "seed": 1}, "note": "2000 nodes and 10^4 links"},
    {"id": "g2", "generate": {"n": 2000, "seed": 2}},
    {"id": "g3", "generate": {"n": 300, "seed": 4}}
  ]
}
