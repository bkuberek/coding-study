{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"unitPrices": [499, 1250, 99], "quantities": [3, 2, 10]}, "expected": 4987},
    {"id": "ex2", "visible": true, "input": {"unitPrices": [250000, 1], "quantities": [40, 7]}, "expected": 10000007},
    {"id": "h1", "input": {"unitPrices": [], "quantities": []}, "expected": 0, "note": "empty invoice"},
    {"id": "h2", "input": {"unitPrices": [100], "quantities": [1]}, "expected": 100, "note": "one line, one unit"},
    {"id": "h3", "input": {"unitPrices": [0, 500], "quantities": [1000, 0]}, "expected": 0, "note": "zero price and zero quantity"},
    {"id": "h4", "input": {"unitPrices": [1000000, 483647], "quantities": [2147, 1]}, "expected": 2147483647, "note": "total exactly 2^31 - 1"},
    {"id": "h5", "input": {"unitPrices": [1000000, 483648], "quantities": [2147, 1]}, "expected": 2147483648, "note": "total 2^31: the running sum overflows, each line fits"},
    {"id": "h6", "input": {"unitPrices": [1000000], "quantities": [100000]}, "expected": 100000000000, "note": "one line whose product exceeds 2^31 - 1"},
    {"id": "h7", "input": {"unitPrices": [1000000, 1000000, 1000000], "quantities": [1000, 1000, 1000]}, "expected": 3000000000, "note": "three lines of 10^9, sum overflows"},
    {"id": "h8", "input": {"unitPrices": [1000000, 1000000, 1000000, 1000000], "quantities": [100000, 100000, 100000, 100000]}, "expected": 400000000000, "note": "largest lines"},
    {"id": "h9", "input": {"unitPrices": [1000000, 1000000, 1000000, 1000000, 294967, 1], "quantities": [1000, 1000, 1000, 1000, 1000, 301]}, "expected": 4294967301, "note": "total 2^32 + 5 wraps to a plausible 5"},
    {"id": "h10", "input": {"unitPrices": [1999, 45000, 120, 89900, 15], "quantities": [12, 3, 250, 1, 4000]}, "expected": 338888, "note": "ordinary invoice"},
    {"id": "h11", "input": {"unitPrices": [3000, 1000000], "quantities": [1000000, 1]}, "expected": 3001000000, "note": "large quantity times small price"}
  ]
}
