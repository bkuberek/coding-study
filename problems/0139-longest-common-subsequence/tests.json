{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"text1": "harbor", "text2": "arbiter"}, "expected": 4},
    {"id": "ex2", "visible": true, "input": {"text1": "abc", "text2": "xyz"}, "expected": 0},
    {"id": "h1", "input": {"text1": "q", "text2": "q"}, "expected": 1, "note": "single equal characters"},
    {"id": "h2", "input": {"text1": "q", "text2": "z"}, "expected": 0, "note": "single different characters"},
    {"id": "h3", "input": {"text1": "pattern", "text2": "pattern"}, "expected": 7, "note": "identical strings"},
    {"id": "h4", "input": {"text1": "bdf", "text2": "abcdef"}, "expected": 3, "note": "the shorter string is a subsequence of the longer"},
    {"id": "h5", "input": {"text1": "stressed", "text2": "desserts"}, "expected": 4, "note": "a string and its reverse"},
    {"id": "h6", "input": {"text1": "aaaa", "text2": "aa"}, "expected": 2, "note": "one repeated letter"},
    {"id": "h7", "input": {"text1": "ab", "text2": "ba"}, "expected": 1, "note": "two letters in opposite order"},
    {"id": "h8", "input": {"text1": "kitchen", "text2": "thicken"}, "expected": 4, "note": "anagrams"},
    {"id": "h9", "input": {"text1": "zzzzzzzzzza", "text2": "azzzzzzzzzz"}, "expected": 10, "note": "greedily matching the first a loses"},
    {"id": "h10", "input": {"text1": "mississippi", "text2": "missouri"}, "expected": 5, "note": "repeated letters on both sides"},
    {"id": "h11", "input": {"text1": "", "text2": ""}, "expected": 1000, "note": "maximum length, identical"},
    {"id": "h12", "input": {"text1": "", "text2": ""}, "expected": 999, "note": "maximum length, shifted by one"},
    {"id": "g1", "generate": {"n": 2000, "seed": 1}, "note": "two strings of about 1000 characters"},
    {"id": "g2", "generate": {"n": 2000, "seed": 2}, "note": "two strings of about 1000 characters"},
    {"id": "g3", "generate": {"n": 500, "seed": 3}}
  ]
}
