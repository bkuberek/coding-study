{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true,
     "ops": ["TokenBucket", "tryAcquire", "tryAcquire", "tryAcquire", "available"],
     "args": [[5, 1], [0, 3], [0, 2], [0, 1], [0]],
     "expected": [null, true, true, false, 0]},
    {"id": "ex2", "visible": true,
     "ops": ["TokenBucket", "tryAcquire", "available", "available", "tryAcquire", "available"],
     "args": [[10, 2], [1, 10], [3], [100], [100, 7], [100]],
     "expected": [null, true, 4, 10, true, 3]},
    {"id": "h1", "note": "a request larger than the balance takes nothing",
     "ops": ["TokenBucket", "tryAcquire", "tryAcquire", "available"],
     "args": [[4, 1], [0, 5], [0, 4], [0]],
     "expected": [null, false, true, 0]},
    {"id": "h2", "note": "a timestamp earlier than the last refill adds nothing",
     "ops": ["TokenBucket", "tryAcquire", "available", "tryAcquire", "available"],
     "args": [[10, 1], [8, 10], [5], [6, 1], [9]],
     "expected": [null, true, 0, false, 1]},
    {"id": "h3", "note": "rate zero never refills",
     "ops": ["TokenBucket", "tryAcquire", "available", "tryAcquire"],
     "args": [[3, 0], [0, 3], [1000000], [1000000, 1]],
     "expected": [null, true, 0, false]},
    {"id": "h4", "note": "refill stops at the capacity",
     "ops": ["TokenBucket", "tryAcquire", "available", "available"],
     "args": [[6, 4], [0, 6], [1], [50]],
     "expected": [null, true, 4, 6]},
    {"id": "h5", "note": "repeated calls at the same timestamp share one refill",
     "ops": ["TokenBucket", "tryAcquire", "tryAcquire", "tryAcquire", "tryAcquire", "available"],
     "args": [[2, 1], [0, 2], [3, 1], [3, 1], [3, 1], [3]],
     "expected": [null, true, true, true, false, 0]},
    {"id": "h6", "note": "large values in the long range",
     "ops": ["TokenBucket", "tryAcquire", "available", "tryAcquire"],
     "args": [[1000000000000, 1000000], [0, 1000000000000], [500000], [500000, 500000000000]],
     "expected": [null, true, 500000000000, true]},
    {"id": "h7", "note": "available refills too, so a later call with an earlier timestamp adds nothing",
     "ops": ["TokenBucket", "tryAcquire", "available", "available", "tryAcquire", "available"],
     "args": [[100, 1], [0, 100], [10], [5], [7, 10], [8]],
     "expected": [null, true, 10, 10, true, 0]},
    {"id": "s1", "note": "4 clients drain a bucket that refills 1 token per second while 4 observers read it",
     "stress": {
       "seed": 1000,
       "setup": {"ops": ["TokenBucket", "tryAcquire"], "args": [[1000000, 1], [0, 999990]]},
       "workers": [
         {"group": "client", "count": 4, "repeat": 1500,
          "steps": [{"op": "tryAcquire", "args": [{"$seq": {"start": 1, "worker_stride": 1, "step": 8}}, 1]}]},
         {"group": "observer", "count": 4, "repeat": 1500,
          "steps": [{"op": "available", "args": [{"$seq": {"start": 5, "worker_stride": 1, "step": 8}}]}]}
       ],
       "final": {"ops": ["available"], "args": [[0]]},
       "invariants": [
         {"type": "bounds", "values": {"op": "available"}, "min": 0, "max": 1000000},
         {"type": "checker", "name": "conserved"}
       ]
     }},
    {"id": "s2", "note": "8 workers drain a full bucket of 300 tokens at one instant",
     "stress": {
       "seed": 2000,
       "setup": {"ops": ["TokenBucket"], "args": [[300, 1]]},
       "workers": [
         {"group": "client", "count": 8, "repeat": 100,
          "steps": [{"op": "tryAcquire", "args": [5, 1]}]}
       ],
       "final": {"ops": ["available"], "args": [[5]], "expected": [0]},
       "invariants": [
         {"type": "checker", "name": "burst"}
       ]
     }}
  ]
}
