{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"intervals": [[1, 4], [2, 3], [3, 6], [5, 8]]}, "expected": 2},
    {"id": "ex2", "visible": true, "input": {"intervals": [[0, 5], [5, 10], [10, 15]]}, "expected": 0},
    {"id": "h1", "input": {"intervals": [[3, 9]]}, "expected": 0, "note": "a single interval"},
    {"id": "h2", "input": {"intervals": [[1, 2], [1, 2], [1, 2]]}, "expected": 2, "note": "identical intervals"},
    {"id": "h3", "input": {"intervals": [[1, 100], [2, 3], [4, 5], [6, 7]]}, "expected": 1, "note": "one long interval covers several short ones"},
    {"id": "h4", "input": {"intervals": [[1, 3], [5, 7], [9, 11]]}, "expected": 0, "note": "already separate"},
    {"id": "h5", "input": {"intervals": [[9, 11], [5, 7], [1, 3], [3, 5]]}, "expected": 0, "note": "touching chain in reverse order"},
    {"id": "h6", "input": {"intervals": [[1, 10], [2, 9], [3, 8], [4, 7]]}, "expected": 3, "note": "fully nested"},
    {"id": "h7", "input": {"intervals": [[-10, -5], [-7, -2], [-3, 0], [-1, 4]]}, "expected": 2, "note": "negative endpoints, a chain of overlaps"},
    {"id": "h8", "input": {"intervals": [[-1000000000, 1000000000], [-1000000000, 0], [0, 1000000000]]}, "expected": 1, "note": "extreme endpoints"},
    {"id": "h9", "input": {"intervals": [[1, 5], [2, 3], [3, 4], [4, 6]]}, "expected": 1, "note": "keeping the earliest start is wrong"},
    {"id": "h10", "input": {"intervals": [[1, 2], [2, 3], [1, 3], [3, 4]]}, "expected": 1, "note": "a long interval that covers two touching ones"},
    {"id": "h11", "input": {"intervals": [[0, 2], [1, 3], [2, 4], [3, 5], [4, 6]]}, "expected": 2, "note": "sliding overlaps"},
    {"id": "h12", "input": {"intervals": [[5, 6], [5, 7], [5, 8], [5, 9]]}, "expected": 3, "note": "same start, different ends"},
    {"id": "h13", "input": {"intervals": [[1, 9], [2, 9], [3, 9], [8, 9]]}, "expected": 3, "note": "same end, different starts"},
    {"id": "h14", "input": {"intervals": [[-1000000000, -999999999], [999999999, 1000000000]]}, "expected": 0, "note": "far apart extremes"},
    {"id": "g1", "generate": {"n": 5000, "seed": 53}, "note": "large input: the chain dynamic program checks about 1.25 * 10^7 pairs"}
  ]
}
