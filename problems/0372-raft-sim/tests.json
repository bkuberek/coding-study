    {"id": "h18", "level": 3, "note": "a late AppendEntries whose entries are already in the log must not cut the log short", "ops": ["RaftCluster", "timeout", "deliver", "deliver", "deliver", "deliver", "propose", "propose", "heartbeat", "propose", "heartbeat", "deliver", "deliver", "log", "deliver", "commitIndex", "deliver", "commitIndex", "heartbeat", "deliver", "commitIndex", "log"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [3], [4], [6], ["s1", "x"], ["s1", "y"], ["s1"], ["s1", "z"], ["s1"], [9], [7], ["s2"], [12], ["s1"], [11], ["s1"], ["s1"], [13], ["s2"], ["s2"]], "expected": [null, [1, 2], [3], [4, 5], [6], [], 1, 2, [7, 8], 3, [9, 10], [11], [12], ["1:x", "1:y", "1:z"], [], 2, [], 3, [13, 14], [15], 3, ["1:x", "1:y", "1:z"]]},
