    {"id": "ex1", "visible": true, "level": 1, "ops": ["RaftCluster", "requestVote", "votedFor", "status", "requestVote", "requestVote", "requestVote", "votedFor", "status"], "args": [[["s1", "s2", "s3"]], ["s2", "s1", 1, 0, 0], ["s2"], [], ["s2", "s3", 1, 0, 0], ["s2", "s1", 1, 0, 0], ["s2", "s3", 2, 0, 0], ["s2"], []], "expected": [null, "granted", "s1", ["s1 follower 0", "s2 follower 1", "s3 follower 0"], "already-voted", "granted", "granted", "s3", ["s1 follower 0", "s2 follower 2", "s3 follower 0"]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["RaftCluster", "load", "requestVote", "status", "votedFor", "requestVote", "votedFor", "requestVote"], "args": [[["s1", "s2", "s3"]], ["s2", 3, "", ["1:x", "3:y"]], ["s2", "s1", 4, 5, 2], [], ["s2"], ["s2", "s3", 4, 2, 3], ["s2"], ["s2", "s1", 3, 9, 3]], "expected": [null, null, "stale-log", ["s1 follower 0", "s2 follower 4", "s3 follower 0"], "", "granted", "s3", "stale-term"]},
    {"id": "h1", "level": 1, "note": "a stale term is refused, a vote is given once per term, and the same candidate may ask again", "ops": ["RaftCluster", "load", "requestVote", "votedFor", "requestVote", "requestVote", "status", "requestVote", "votedFor", "status"], "args": [[["s1", "s2", "s3"]], ["s1", 5, "s2", []], ["s1", "s3", 4, 10, 4], ["s1"], ["s1", "s2", 5, 0, 0], ["s1", "s3", 5, 3, 5], [], ["s1", "s3", 6, 0, 0], ["s1"], []], "expected": [null, null, "stale-term", "s2", "granted", "already-voted", ["s1 follower 5", "s2 follower 0", "s3 follower 0"], "granted", "s3", ["s1 follower 6", "s2 follower 0", "s3 follower 0"]]},
    {"id": "h2", "level": 1, "note": "the last term decides first; the length decides only between equal last terms", "ops": ["RaftCluster", "load", "load", "load", "load", "requestVote", "requestVote", "requestVote", "requestVote", "requestVote", "status"], "args": [[["a", "b", "c", "d", "e"]], ["b", 2, "", ["1:p", "1:q", "2:r"]], ["c", 2, "", ["1:p", "1:q", "2:r"]], ["d", 2, "", ["1:p", "1:q", "2:r"]], ["e", 2, "", ["1:p", "1:q", "2:r"]], ["b", "a", 3, 2, 2], ["c", "a", 3, 1, 3], ["d", "a", 3, 3, 2], ["e", "a", 3, 9, 1], ["b", "a", 3, 4, 2], []], "expected": [null, null, null, null, null, "stale-log", "granted", "granted", "stale-log", "granted", ["a follower 0", "b follower 3", "c follower 3", "d follower 3", "e follower 3"]]},
    {"id": "h3", "level": 1, "note": "a higher term clears the vote even when the request is refused", "ops": ["RaftCluster", "load", "requestVote", "votedFor", "status", "requestVote", "votedFor", "requestVote"], "args": [[["s1", "s2", "s3"]], ["s1", 2, "s2", ["2:a"]], ["s1", "s3", 3, 0, 0], ["s1"], [], ["s1", "s2", 3, 1, 2], ["s1"], ["s1", "s3", 3, 5, 3]], "expected": [null, null, "stale-log", "", ["s1 follower 3", "s2 follower 0", "s3 follower 0"], "granted", "s2", "already-voted"]},
    {"id": "h4", "level": 1, "note": "the checks run in order: stale term, then the vote, then the log", "ops": ["RaftCluster", "load", "requestVote", "requestVote", "requestVote", "requestVote", "requestVote", "status"], "args": [[["s1", "s2", "s3"]], ["s1", 4, "s2", ["4:a"]], ["s1", "s3", 4, 0, 0], ["s1", "s3", 3, 0, 0], ["s1", "s2", 4, 0, 0], ["s3", "s1", 1, 0, 0], ["s3", "s2", 1, 0, 0], []], "expected": [null, null, "already-voted", "stale-term", "stale-log", "granted", "already-voted", ["s1 follower 4", "s2 follower 0", "s3 follower 1"]]},
    {"id": "h5", "level": 1, "note": "the log comparison uses the candidate's last log term, not its current term", "ops": ["RaftCluster", "load", "requestVote", "status", "requestVote", "votedFor", "load", "requestVote", "requestVote"], "args": [[["s1", "s2", "s3"]], ["s1", 5, "", ["2:a", "4:b"]], ["s1", "s2", 7, 1, 3], [], ["s1", "s3", 7, 2, 4], ["s1"], ["s2", 5, "", ["2:a", "4:b"]], ["s2", "s3", 5, 1, 4], ["s2", "s1", 6, 3, 4]], "expected": [null, null, "stale-log", ["s1 follower 7", "s2 follower 0", "s3 follower 0"], "granted", "s3", null, "stale-log", "granted"]},
    {"id": "h6", "level": 1, "note": "load replaces the node's term, vote and log", "ops": ["RaftCluster", "load", "votedFor", "status", "requestVote", "load", "requestVote", "votedFor", "load", "status"], "args": [[["s1", "s2", "s3"]], ["s1", 3, "s1", ["1:a"]], ["s1"], [], ["s1", "s2", 3, 1, 1], ["s1", 3, "", ["1:a"]], ["s1", "s2", 3, 1, 1], ["s1"], ["s3", 7, "s2", []], []], "expected": [null, null, "s1", ["s1 follower 3", "s2 follower 0", "s3 follower 0"], "already-voted", null, "granted", "s2", null, ["s1 follower 3", "s2 follower 0", "s3 follower 7"]]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["RaftCluster", "timeout", "deliver", "status", "deliver", "status", "deliver", "status", "deliver", "deliver", "votedFor"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [], [3], [], [5], [], [2], [7], ["s3"]], "expected": [null, [1, 2], [3], ["s1 candidate 1", "s2 follower 1", "s3 follower 0"], [4, 5], ["s1 leader 1", "s2 follower 1", "s3 follower 0"], [6], ["s1 leader 1", "s2 follower 1", "s3 follower 1"], [7], [], "s1"]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["RaftCluster", "timeout", "timeout", "deliver", "deliver", "deliver", "deliver", "deliver", "deliver", "status", "timeout", "deliver", "deliver", "deliver", "deliver", "status"], "args": [[["s1", "s2", "s3", "s4"]], ["s1"], ["s2"], [2], [6], [7], [8], [1], [9], [], ["s1"], [10], [11], [13], [14], []], "expected": [null, [1, 2, 3], [4, 5, 6], [7], [8], [], [], [9], [], ["s1 candidate 1", "s2 candidate 1", "s3 follower 1", "s4 follower 1"], [10, 11, 12], [13], [14], [], [15, 16, 17], ["s1 leader 2", "s2 follower 2", "s3 follower 2", "s4 follower 1"]]},
    {"id": "h7", "level": 2, "note": "a leader ignores its election timeout and only a leader sends heartbeats", "ops": ["RaftCluster", "timeout", "deliver", "deliver", "timeout", "heartbeat", "heartbeat", "deliver", "status", "heartbeat"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [3], ["s1"], ["s2"], ["s1"], [6], [], ["s1"]], "expected": [null, [1, 2], [3], [4, 5], [], [], [6, 7], [8], ["s1 leader 1", "s2 follower 1", "s3 follower 0"], [9, 10]]},
    {"id": "h8", "level": 2, "note": "a candidate that hears from the leader of its own term becomes its follower", "ops": ["RaftCluster", "timeout", "timeout", "deliver", "deliver", "deliver", "status", "deliver", "deliver", "deliver", "deliver", "status", "votedFor", "votedFor"], "args": [[["s1", "s2", "s3"]], ["s1"], ["s2"], [2], [5], [6], [], [3], [9], [4], [10], [], ["s3"], ["s2"]], "expected": [null, [1, 2], [3, 4], [5], [6, 7], [8], ["s1 leader 1", "s2 follower 1", "s3 follower 1"], [9], [], [10], [], ["s1 leader 1", "s2 follower 1", "s3 follower 1"], "s1", "s2"]},
    {"id": "h9", "level": 2, "note": "a leader that sees a higher term in a reply steps down", "ops": ["RaftCluster", "timeout", "deliver", "deliver", "lose", "lose", "timeout", "lose", "lose", "timeout", "lose", "lose", "heartbeat", "deliver", "status", "deliver", "status", "deliver", "deliver", "status"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [3], [2], [5], ["s3"], [6], [7], ["s3"], [8], [9], ["s1"], [11], [], [12], [], [10], [13], []], "expected": [null, [1, 2], [3], [4, 5], null, null, [6, 7], null, null, [8, 9], null, null, [10, 11], [12], ["s1 leader 1", "s2 follower 1", "s3 candidate 2"], [], ["s1 follower 2", "s2 follower 1", "s3 candidate 2"], [13], [], ["s1 follower 2", "s2 follower 1", "s3 candidate 2"]]},
    {"id": "h10", "level": 2, "note": "a vote granted for an earlier term does not count", "ops": ["RaftCluster", "timeout", "timeout", "deliver", "deliver", "status", "deliver", "deliver", "status"], "args": [[["s1", "s2", "s3"]], ["s1"], ["s1"], [1], [5], [], [3], [6], []], "expected": [null, [1, 2], [3, 4], [5], [], ["s1 candidate 2", "s2 follower 1", "s3 follower 0"], [6], [7, 8], ["s1 leader 2", "s2 follower 2", "s3 follower 0"]]},
    {"id": "h11", "level": 2, "note": "five nodes need three votes", "ops": ["RaftCluster", "timeout", "deliver", "deliver", "status", "deliver", "deliver", "status", "deliver", "deliver", "status"], "args": [[["s1", "s2", "s3", "s4", "s5"]], ["s1"], [1], [5], [], [2], [6], [], [3], [11], []], "expected": [null, [1, 2, 3, 4], [5], [], ["s1 candidate 1", "s2 follower 1", "s3 follower 0", "s4 follower 0", "s5 follower 0"], [6], [7, 8, 9, 10], ["s1 leader 1", "s2 follower 1", "s3 follower 1", "s4 follower 0", "s5 follower 0"], [11], [], ["s1 leader 1", "s2 follower 1", "s3 follower 1", "s4 follower 1", "s5 follower 0"]]},
    {"id": "h12", "level": 2, "note": "four nodes need three votes: two are not a majority", "ops": ["RaftCluster", "timeout", "deliver", "deliver", "status", "timeout", "deliver", "deliver", "deliver", "deliver", "status", "deliver", "deliver", "status"], "args": [[["s1", "s2", "s3", "s4"]], ["s1"], [1], [4], [], ["s2"], [5], [6], [8], [9], [], [7], [10], []], "expected": [null, [1, 2, 3], [4], [], ["s1 candidate 1", "s2 follower 1", "s3 follower 0", "s4 follower 0"], [5, 6, 7], [8], [9], [], [10, 11, 12], ["s1 follower 2", "s2 leader 2", "s3 follower 2", "s4 follower 0"], [13], [14], ["s1 follower 2", "s2 leader 2", "s3 follower 2", "s4 follower 2"]]},
    {"id": "h13", "level": 2, "note": "a cluster of one elects itself at once", "ops": ["RaftCluster", "timeout", "status", "heartbeat", "timeout", "votedFor", "status"], "args": [[["solo"]], ["solo"], [], ["solo"], ["solo"], ["solo"], []], "expected": [null, [], ["solo leader 1"], [], [], "solo", ["solo leader 1"]]},
    {"id": "h14", "level": 2, "note": "a lost message stays lost, and the next timeout starts a new election", "ops": ["RaftCluster", "timeout", "lose", "lose", "deliver", "status", "timeout", "deliver", "deliver", "status", "deliver"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [2], [1], [], ["s1"], [4], [5], [], [3]], "expected": [null, [1, 2], null, null, [], ["s1 candidate 1", "s2 follower 0", "s3 follower 0"], [3, 4], [5], [6, 7], ["s1 leader 2", "s2 follower 0", "s3 follower 2"], [8]]},
