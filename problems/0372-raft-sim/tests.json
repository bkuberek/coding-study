    {"id": "ex5", "visible": true, "level": 3, "ops": ["RaftCluster", "timeout", "deliver", "deliver", "deliver", "deliver", "propose", "propose", "heartbeat", "deliver", "commitIndex", "deliver", "commitIndex", "commitIndex", "log", "heartbeat", "deliver", "commitIndex", "log"], "args": [[["s1", "s2", "s3"]], ["s1"], [1], [3], [4], [6], ["s1", "x"], ["s2", "y"], ["s1"], [7], ["s1"], [9], ["s1"], ["s2"], ["s2"], ["s1"], [10], ["s2"], ["s3"]], "expected": [null, [1, 2], [3], [4, 5], [6], [], 1, -1, [7, 8], [9], 0, [], 1, 0, ["1:x"], [10, 11], [12], 1, []]},
