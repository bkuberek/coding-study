{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"temperatures": [12, 13, 10, 9, 10, 14, 8, 11]}, "expected": [1, 4, 3, 1, 1, 0, 1, 0]},
    {"id": "ex2", "visible": true, "input": {"temperatures": [-3, -3, -3, 2, 1]}, "expected": [3, 2, 1, 0, 0]},
    {"id": "h1", "input": {"temperatures": [7]}, "expected": [0], "note": "a single day never sees a warmer one"},
    {"id": "h2", "input": {"temperatures": [5, 5, 5, 5]}, "expected": [0, 0, 0, 0], "note": "all readings equal: equal is not warmer"},
    {"id": "h3", "input": {"temperatures": [-2, -1, 0, 1, 2]}, "expected": [1, 1, 1, 1, 0], "note": "strictly rising"},
    {"id": "h4", "input": {"temperatures": [9, 7, 4, 0, -6]}, "expected": [0, 0, 0, 0, 0], "note": "strictly falling: nobody is answered"},
    {"id": "h5", "input": {"temperatures": [-50, 50, -50, 50]}, "expected": [1, 0, 1, 0], "note": "extreme readings"},
    {"id": "h6", "input": {"temperatures": [8, 6, 4, 2, 9]}, "expected": [4, 3, 2, 1, 0], "note": "one warm day answers every earlier day"},
    {"id": "h7", "input": {"temperatures": [0, -1, -1, 0, 1]}, "expected": [4, 2, 1, 1, 0], "note": "zero and negative readings with repeats"},
    {"id": "h8", "input": {"temperatures": [1, 2]}, "expected": [1, 0], "note": "two days, rising"},
    {"id": "h9", "input": {"temperatures": [2, 1]}, "expected": [0, 0], "note": "two days, falling"},
    {"id": "h10", "input": {"temperatures": [3, 1, 3, 1, 4]}, "expected": [4, 1, 2, 1, 0], "note": "sawtooth: an equal reading does not answer"},
    {"id": "h11", "input": {"temperatures": [10, 10, 10, 10, 10, 10, 11]}, "expected": [6, 5, 4, 3, 2, 1, 0], "note": "a long plateau waits for the last day"},
    {"id": "h12", "input": {"temperatures": [5, 3, 1, 2, 4, 6, 0]}, "expected": [5, 3, 1, 1, 1, 0, 0], "note": "nested waits resolved in different orders"},
    {"id": "g1", "generate": {"n": 10000, "seed": 1}, "hang_guard_ms": 30000, "note": "large log with a long cold spell: scanning ahead is quadratic here"},
    {"id": "g2", "generate": {"n": 10000, "seed": 5}, "hang_guard_ms": 30000, "note": "large log with a long cold spell"},
    {"id": "g3", "generate": {"n": 1000, "seed": 2}}
  ]
}
