{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["Twitter", "follow", "postTweet", "postTweet", "postTweet", "getNewsFeed", "follow", "getNewsFeed", "unfollow", "getNewsFeed"], "args": [[], [1, 2], [2, 101], [1, 102], [3, 103], [1], [1, 3], [1], [1, 2], [1]], "expected": [null, null, null, null, null, [102, 101], null, [103, 102, 101], null, [103, 102]]},
    {"id": "ex2", "visible": true, "ops": ["Twitter", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "getNewsFeed"], "args": [[], [3, 500], [3, 501], [3, 502], [3, 503], [3, 504], [3, 505], [3, 506], [3, 507], [3, 508], [3, 509], [3, 510], [3, 511], [3]], "expected": [null, null, null, null, null, null, null, null, null, null, null, null, null, [511, 510, 509, 508, 507, 506, 505, 504, 503, 502]]},
    {"id": "h1", "ops": ["Twitter", "getNewsFeed"], "args": [[], [7]], "expected": [null, []], "note": "a user nobody has seen has an empty feed"},
    {"id": "h2", "ops": ["Twitter", "postTweet", "follow", "getNewsFeed", "unfollow", "getNewsFeed"], "args": [[], [1, 5], [1, 1], [1], [1, 1], [1]], "expected": [null, null, null, [5], null, [5]], "note": "following or unfollowing yourself changes nothing"},
    {"id": "h3", "ops": ["Twitter", "postTweet", "postTweet", "unfollow", "getNewsFeed"], "args": [[], [1, 10], [2, 20], [1, 2], [1]], "expected": [null, null, null, null, [10]], "note": "unfollowing someone you never followed is a no-op"},
    {"id": "h4", "ops": ["Twitter", "postTweet", "follow", "follow", "getNewsFeed", "unfollow", "getNewsFeed"], "args": [[], [2, 77], [1, 2], [1, 2], [1], [1, 2], [1]], "expected": [null, null, null, null, [77], null, []], "note": "a second follow does not need a second unfollow"},
    {"id": "h5", "ops": ["Twitter", "follow", "follow", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "getNewsFeed"], "args": [[], [1, 2], [1, 3], [2, 1], [3, 2], [1, 3], [2, 4], [3, 5], [1, 6], [2, 7], [3, 8], [1, 9], [2, 10], [3, 11], [1, 12], [1]], "expected": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, [12, 11, 10, 9, 8, 7, 6, 5, 4, 3]], "note": "three interleaved timelines, more than ten tweets in total"},
    {"id": "h6", "ops": ["Twitter", "postTweet", "postTweet", "follow", "getNewsFeed"], "args": [[], [4, 40], [4, 41], [5, 4], [5]], "expected": [null, null, null, null, [41, 40]], "note": "tweets posted before the follow still appear"},
    {"id": "h7", "ops": ["Twitter", "follow", "postTweet", "postTweet", "getNewsFeed", "getNewsFeed"], "args": [[], [1, 2], [1, 11], [2, 22], [1], [2]], "expected": [null, null, null, null, [22, 11], [22]], "note": "following is one-directional"},
    {"id": "h8", "ops": ["Twitter", "postTweet", "postTweet", "postTweet", "getNewsFeed"], "args": [[], [6, 900], [6, 5], [6, 300], [6]], "expected": [null, null, null, null, [300, 5, 900]], "note": "recency decides the order, not the tweet id"},
    {"id": "h9", "ops": ["Twitter", "postTweet", "postTweet", "follow", "getNewsFeed"], "args": [[], [1000, 0], [999, 1000000], [1000, 999], [1000]], "expected": [null, null, null, null, [1000000, 0]], "note": "extreme user and tweet ids"},
    {"id": "h10", "ops": ["Twitter", "postTweet", "follow", "postTweet", "unfollow", "postTweet", "getNewsFeed", "follow", "getNewsFeed"], "args": [[], [2, 1], [1, 2], [2, 2], [1, 2], [1, 3], [1], [1, 2], [1]], "expected": [null, null, null, null, null, null, [3], null, [3, 2, 1]], "note": "unfollow hides a timeline, a new follow brings all of it back"},
    {"id": "h11", "ops": ["Twitter", "follow", "follow", "follow", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "postTweet", "getNewsFeed", "getNewsFeed"], "args": [[], [9, 1], [9, 2], [9, 3], [1, 31], [1, 32], [1, 33], [1, 34], [1, 35], [1, 36], [1, 37], [1, 38], [1, 39], [1, 40], [1, 41], [2, 42], [3, 43], [9], [3]], "expected": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, [43, 42, 41, 40, 39, 38, 37, 36, 35, 34], [43]], "note": "one followee floods the feed; the newest tweets of the others still win"},
    {"id": "g1", "generate": {"n": 30000, "seed": 1}, "hang_guard_ms": 30000, "note": "30000 calls: scanning one global timeline for every feed is slow here"},
    {"id": "g2", "generate": {"n": 1000, "seed": 2}}
  ]
}
