    {"id": "ex2", "visible": true, "input": {"contractorIds": ["plumbing-co", "plumbing-co", "paving-co"], "expiryDates": ["2026-10-15", "2027-10-15", "2026-10-20"], "asOfDate": "2026-11-01", "windowDays": 30}, "expected": [["paving-co", "2026-10-20", "expired"]]},
    {"id": "ex3", "visible": true, "input": {"contractorIds": ["crane-a", "crane-b", "crane-c"], "expiryDates": ["2026-11-01", "2026-12-01", "2026-12-02"], "asOfDate": "2026-11-01", "windowDays": 30}, "expected": [["crane-a", "2026-11-01", "expired"], ["crane-b", "2026-12-01", "expiring"]]},
