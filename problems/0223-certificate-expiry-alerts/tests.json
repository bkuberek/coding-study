    {"id": "h3", "input": {"contractorIds": ["sub-9", "sub-10", "sub-1"], "expiryDates": ["2026-11-20", "2026-11-20", "2026-11-20"], "asOfDate": "2026-11-01", "windowDays": 30}, "expected": [["sub-1", "2026-11-20", "expiring"], ["sub-10", "2026-11-20", "expiring"], ["sub-9", "2026-11-20", "expiring"]], "note": "equal dates order by id as text: sub-1, sub-10, sub-9"},
    {"id": "h4", "input": {"contractorIds": ["drywall", "drywall", "drywall"], "expiryDates": ["2026-11-10", "2026-11-10", "2026-11-10"], "asOfDate": "2026-11-01", "windowDays": 30}, "expected": [["drywall", "2026-11-10", "expiring"]], "note": "the same certificate filed three times gives one row"},
    {"id": "h5", "input": {"contractorIds": ["p", "q", "r"], "expiryDates": ["2028-03-02", "2028-02-29", "2028-03-01"], "asOfDate": "2028-02-20", "windowDays": 10}, "expected": [["q", "2028-02-29", "expiring"], ["r", "2028-03-01", "expiring"]], "note": "the window crosses the leap day; the horizon is 2028-03-01"},
    {"id": "h6", "input": {"contractorIds": ["x", "y"], "expiryDates": ["2030-01-01", "2029-06-30"], "asOfDate": "2026-11-01", "windowDays": 365}, "expected": [], "note": "nothing within the window"},
    {"id": "h7", "input": {"contractorIds": ["glazing", "glazing", "masonry", "masonry"], "expiryDates": ["2026-11-03", "2028-01-01", "2026-01-01", "2026-06-01"], "asOfDate": "2026-11-01", "windowDays": 30}, "expected": [["masonry", "2026-06-01", "expired"]], "note": "an older expiring certificate is covered by a renewal; the newest of two expired ones counts"},
    {"id": "h8", "input": {"contractorIds": ["inside", "outside"], "expiryDates": ["2036-10-29", "2036-10-30"], "asOfDate": "2026-11-01", "windowDays": 3650}, "expected": [["inside", "2036-10-29", "expiring"]], "note": "a ten-year window ends on 2036-10-29"},
    {"id": "h9", "input": {"contractorIds": ["e1", "e2", "s1", "s2"], "expiryDates": ["2026-12-15", "2025-01-01", "2026-11-02", "2026-10-31"], "asOfDate": "2026-11-01", "windowDays": 60}, "expected": [["e2", "2025-01-01", "expired"], ["s2", "2026-10-31", "expired"], ["s1", "2026-11-02", "expiring"], ["e1", "2026-12-15", "expiring"]], "note": "expired rows come first because their dates are earlier"},
    {"id": "h10", "input": {"contractorIds": ["late", "early", "late"], "expiryDates": ["2026-11-30", "2026-11-04", "2026-11-25"], "asOfDate": "2026-11-01", "windowDays": 29}, "expected": [["early", "2026-11-04", "expiring"], ["late", "2026-11-30", "expiring"]], "note": "input order does not matter; 2026-11-30 is exactly the horizon"}
