{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [2, -1, 8, 5, -3, 4, 6], "k": 4}, "expected": 3.5},
    {"id": "ex2", "visible": true, "input": {"nums": [-6, -2, -9, -4], "k": 2}, "expected": -4.0},
    {"id": "h1", "input": {"nums": [5], "k": 1}, "expected": 5.0, "note": "one number, one window"},
    {"id": "h2", "input": {"nums": [1, 2, 3, 4], "k": 4}, "expected": 2.5, "note": "the window is the whole array"},
    {"id": "h3", "input": {"nums": [3, -1, 9, 4], "k": 1}, "expected": 9.0, "note": "k = 1: the answer is the largest number"},
    {"id": "h4", "input": {"nums": [7, 7, 7, 7, 7], "k": 3}, "expected": 7.0, "note": "all numbers equal"},
    {"id": "h5", "input": {"nums": [-5, -1, -8, -3], "k": 3}, "expected": -4.0, "note": "all negative: the answer is negative"},
    {"id": "h6", "input": {"nums": [1, 2, 3, 4, 5, 6], "k": 3}, "expected": 5.0, "note": "ascending: the best window is the last"},
    {"id": "h7", "input": {"nums": [9, 7, 5, 3, 1], "k": 2}, "expected": 8.0, "note": "descending: the best window is the first"},
    {"id": "h8", "input": {"nums": [0, 0, 0, 0], "k": 2}, "expected": 0.0, "note": "all zeros"},
    {"id": "h9", "input": {"nums": [3, 3, 4, 1], "k": 3}, "expected": 3.3333333333333335, "note": "an average that is not a whole number"},
    {"id": "h10", "input": {"nums": [10000, 10000, 10000, 10000, 10000], "k": 5}, "expected": 10000.0, "note": "largest values"},
    {"id": "h11", "input": {"nums": [-10000, -10000, -10000], "k": 2}, "expected": -10000.0, "note": "smallest values"},
    {"id": "h12", "input": {"nums": [1, 1, 100, 1, 1, 1], "k": 2}, "expected": 50.5, "note": "a spike: two windows contain it"},
    {"id": "h13", "input": {"nums": [-10000, 10000, -10000, 10000], "k": 2}, "expected": 0.0, "note": "every window averages to zero"},
    {"id": "h14", "input": {"nums": [-3, -4, -1, -2], "k": 2}, "expected": -1.5, "note": "all negative: a best that starts at 0 would never be beaten"},
    {"id": "g1", "generate": {"n": 10000, "seed": 7}, "note": "10,000 numbers and a window of 5,000"},
    {"id": "g2", "generate": {"n": 2000, "seed": 3}}
  ]
}
