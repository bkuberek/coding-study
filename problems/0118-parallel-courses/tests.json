{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"n": 5, "relations": [[1, 2], [1, 3], [3, 4], [2, 5], [4, 5]]}, "expected": 4},
    {"id": "ex2", "visible": true, "input": {"n": 3, "relations": [[1, 2], [2, 3], [3, 1]]}, "expected": -1},
    {"id": "h1", "input": {"n": 1, "relations": []}, "expected": 1, "note": "one course takes one semester"},
    {"id": "h2", "input": {"n": 6, "relations": []}, "expected": 1, "note": "no prerequisites: everything in the first semester"},
    {"id": "h3", "input": {"n": 4, "relations": [[3, 4], [2, 3], [1, 2]]}, "expected": 4, "note": "a single chain, listed backwards"},
    {"id": "h4", "input": {"n": 2, "relations": [[1, 2], [2, 1]]}, "expected": -1, "note": "two courses waiting on each other"},
    {"id": "h5", "input": {"n": 4, "relations": [[1, 2], [1, 3], [2, 4], [3, 4]]}, "expected": 3, "note": "a diamond: the middle courses share a semester"},
    {"id": "h6", "input": {"n": 4, "relations": [[1, 2], [2, 3], [1, 3], [3, 4]]}, "expected": 4, "note": "a shortcut pair does not shorten the longest chain"},
    {"id": "h7", "input": {"n": 7, "relations": [[1, 2], [2, 3], [3, 4], [5, 6], [6, 7], [7, 5]]}, "expected": -1, "note": "a valid chain next to a cycle"},
    {"id": "h8", "input": {"n": 6, "relations": [[1, 6], [2, 6], [3, 6], [4, 6], [5, 6]]}, "expected": 2, "note": "one course needs all the others"},
    {"id": "h9", "input": {"n": 6, "relations": [[1, 2], [2, 3], [4, 5]]}, "expected": 3, "note": "chains of different lengths and a free course"},
    {"id": "h10", "input": {"n": 5, "relations": [[1, 2], [2, 3], [3, 4], [4, 2], [1, 5]]}, "expected": -1, "note": "a cycle behind a free course"},
    {"id": "h11", "input": {"n": 8, "relations": [[2, 1], [3, 2], [4, 3], [5, 4], [6, 5], [7, 6], [8, 7]]}, "expected": 8, "note": "a chain through every course from 8 down to 1"},
    {"id": "g1", "generate": {"n": 1000, "seed": 118}, "note": "long chains at the largest size"}
  ]
}
