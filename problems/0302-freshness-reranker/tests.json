{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"candidates": [["a1", "A", "blog"], ["b1", "B", "docs"], ["c1", "C", "forum"], ["d1", "D", "docs"]], "relevance": [0.9, 0.8, 0.7, 0.3], "ageHours": [48, 0, 24, 0], "halfLifeHours": 24, "boostSources": ["docs"], "boostFactors": [1.5], "poolSize": 3}, "expected": ["b1", "c1", "a1"]},
    {"id": "ex2", "visible": true, "input": {"candidates": [["n1", "news-7", "wire"], ["n2", "news-7", "mirror"], ["n3", "news-9", "wire"]], "relevance": [0.9, 0.8, 0.6], "ageHours": [24, 0, 12], "halfLifeHours": 12, "boostSources": [], "boostFactors": [], "poolSize": 3}, "expected": ["n2", "n3"]},
    {"id": "ex3", "visible": true, "input": {"candidates": [["x1", "X", "kb"], ["x2", "X", "kb"], ["y1", "Y", "kb"], ["z1", "Z", "kb"]], "relevance": [0.9, 0.85, 0.8, 0.75], "ageHours": [0, 0, 0, 0], "halfLifeHours": 10, "boostSources": [], "boostFactors": [], "poolSize": 3}, "expected": ["x1", "y1"]},
    {"id": "h1", "input": {"candidates": [["old", "O", "kb"], ["new", "N", "kb"]], "relevance": [1.0, 0.4], "ageHours": [24, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 2}, "expected": ["old", "new"], "note": "one half-life halves the score: 0.5 beats 0.4, where exp(-1) = 0.37 would not"},
    {"id": "h2", "input": {"candidates": [["stale", "S", "kb"], ["mid", "M", "kb"], ["fresh", "F", "kb"]], "relevance": [0.9, 0.8, 0.5], "ageHours": [48, 24, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 2}, "expected": ["mid", "stale"], "note": "the pool is the 2 most relevant; fresh is outside it and stays out, though its new score would be the best"},
    {"id": "h3", "input": {"candidates": [["v1", "doc", "kb"], ["v2", "doc", "kb"]], "relevance": [0.9, 0.6], "ageHours": [48, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 2}, "expected": ["v2"], "note": "the copy with the best new score stays, not the first or the most relevant one"},
    {"id": "h4", "input": {"candidates": [["a", "A", "kb"], ["b", "B", "kb"], ["a-copy", "A", "kb"], ["c", "C", "kb"], ["d", "D", "kb"]], "relevance": [0.9, 0.8, 0.7, 0.6, 0.5], "ageHours": [0, 0, 0, 0, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 3}, "expected": ["a", "b"], "note": "a dropped copy does not free a place in the pool for candidate c"},
    {"id": "h5", "input": {"candidates": [["a", "A", "forum"], ["b", "B", "docs"], ["c", "C", "other"]], "relevance": [0.5, 0.4, 0.45], "ageHours": [0, 0, 0], "halfLifeHours": 24, "boostSources": ["docs", "forum"], "boostFactors": [1.5, 0.5], "poolSize": 3}, "expected": ["b", "c", "a"], "note": "boosts multiply, a factor below 1 demotes, and an unlisted source keeps its score"},
    {"id": "h6", "input": {"candidates": [["p0", "P0", "kb"], ["p1", "P1", "kb"], ["p2", "P2", "kb"]], "relevance": [0.5, 0.7, 0.5], "ageHours": [0, 24, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 2}, "expected": ["p0", "p1"], "note": "p0 and p2 tie on relevance for the last place in the pool; the lower index gets it"},
    {"id": "h7", "input": {"candidates": [["p", "P", "kb"], ["q", "Q", "kb"], ["r", "P", "kb"]], "relevance": [0.6, 0.6, 0.6], "ageHours": [0, 0, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 3}, "expected": ["p", "q"], "note": "every score ties: the lower index wins between copies and in the final order"},
    {"id": "h8", "input": {"candidates": [["one", "1", "kb"], ["two", "2", "kb"]], "relevance": [0.2, 0.3], "ageHours": [5, 5], "halfLifeHours": 5, "boostSources": [], "boostFactors": [], "poolSize": 10}, "expected": ["two", "one"], "note": "the pool is larger than the candidate list"},
    {"id": "h9", "input": {"candidates": [], "relevance": [], "ageHours": [], "halfLifeHours": 24, "boostSources": ["docs"], "boostFactors": [2.0], "poolSize": 5}, "expected": [], "note": "no candidates"},
    {"id": "h10", "input": {"candidates": [["q1", "Q1", "kb"], ["q2", "Q2", "kb"], ["q3", "Q3", "kb"]], "relevance": [0.8, 0.7, 0.9], "ageHours": [6, 0, 30], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 3}, "expected": ["q2", "q1", "q3"], "note": "ages that are not whole half-lives: 0.5^(6/24) = 0.84"},
    {"id": "h11", "input": {"candidates": [["z", "Z", "kb"], ["w", "W", "kb"]], "relevance": [0.0, 0.2], "ageHours": [0, 100], "halfLifeHours": 10, "boostSources": [], "boostFactors": [], "poolSize": 2}, "expected": ["w", "z"], "note": "a score of 0 is still a candidate, ranked last"},
    {"id": "h12", "input": {"candidates": [["m1", "M", "mirror"], ["m2", "M", "docs"], ["k1", "K", "blog"]], "relevance": [0.7, 0.6, 0.65], "ageHours": [0, 0, 0], "halfLifeHours": 24, "boostSources": ["docs"], "boostFactors": [1.5], "poolSize": 3}, "expected": ["m2", "k1"], "note": "the boosted copy of M beats the more relevant one, and its own id is returned"},
    {"id": "h13", "input": {"candidates": [["only", "O", "kb"], ["other", "X", "kb"]], "relevance": [0.4, 0.9], "ageHours": [0, 96], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 1}, "expected": ["other"], "note": "a pool of one is the single most relevant candidate"},
    {"id": "h14", "input": {"candidates": [["r1", "release-notes", "docs"], ["r2", "release-notes", "forum"], ["g1", "guide", "docs"], ["t1", "thread-12", "forum"], ["t2", "thread-12", "mirror"], ["f1", "faq", "kb"], ["b1", "blog-3", "blog"], ["g2", "guide", "mirror"]], "relevance": [0.92, 0.88, 0.85, 0.8, 0.79, 0.7, 0.66, 0.6], "ageHours": [720, 2, 240, 6, 1, 48, 3, 0], "halfLifeHours": 72, "boostSources": ["docs", "forum", "mirror"], "boostFactors": [1.25, 0.8, 0.9], "poolSize": 6}, "expected": ["t2", "r2", "f1", "g1"], "note": "a realistic pool: copies, boosts, demotions and a week of age"},
    {"id": "h15", "input": {"candidates": [["a", "A", "kb"], ["b", "B", "kb"], ["c", "C", "kb"], ["d", "D", "kb"]], "relevance": [1.0, 0.65, 0.9, 0.2], "ageHours": [12, 0, 48, 0], "halfLifeHours": 24, "boostSources": [], "boostFactors": [], "poolSize": 4}, "expected": ["a", "b", "c", "d"], "note": "half a half-life keeps 0.71 of the score and two keep 0.25; e-folding decay would keep 0.61 and 0.14"}
  ]
}
