  {"id": "ex1", "visible": true, "level": 1, "ops": ["KnowledgeBase", "add", "add", "add", "add", "types", "instances", "superClasses", "closure", "closure"], "args": [[], ["Dog", "rdfs:subClassOf", "Mammal"], ["Mammal", "rdfs:subClassOf", "Animal"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Dog"], ["rex"], ["Animal"], ["Dog"], ["Dog", "rdfs:subClassOf", "?"], ["rex", "?", "?"]], "expected": [null, true, true, true, false, ["Animal", "Dog", "Mammal"], ["rex"], ["Animal", "Mammal"], [["Dog", "rdfs:subClassOf", "Animal"], ["Dog", "rdfs:subClassOf", "Mammal"]], [["rex", "rdf:type", "Animal"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Mammal"]]]},
  {"id": "ex2", "visible": true, "level": 1, "ops": ["KnowledgeBase", "add", "add", "add", "add", "superClasses", "closure", "types", "types", "closure", "closure"], "args": [[], ["Cat", "rdfs:subClassOf", "Pet"], ["Pet", "rdfs:subClassOf", "Cat"], ["tom", "rdf:type", "Cat"], ["tom", "likes", "milk"], ["Cat"], ["Cat", "rdfs:subClassOf", "?"], ["tom"], ["milk"], ["tom", "likes", "milk"], ["tom", "likes", "tea"]], "expected": [null, true, true, true, true, ["Pet"], [["Cat", "rdfs:subClassOf", "Cat"], ["Cat", "rdfs:subClassOf", "Pet"]], ["Cat", "Pet"], [], [["tom", "likes", "milk"]], []]},
  {"id": "h1", "level": 1, "note": "an empty base answers with empty lists; a class nobody uses has no instances and no superclasses", "ops": ["KnowledgeBase", "types", "instances", "superClasses", "closure", "add", "closure", "closure", "closure", "closure"], "args": [[], ["x"], ["C"], ["C"], ["?", "?", "?"], ["a", "b", "c"], ["?", "?", "?"], ["?", "?", "z"], ["a", "b", "c"], ["a", "b", "d"]], "expected": [null, [], [], [], [], true, [["a", "b", "c"]], [], [["a", "b", "c"]], []]},
  {"id": "h2", "level": 1, "note": "a diamond lists every superclass once; plain string order puts capitals before lower case and 10 before 9", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "add", "types", "instances", "instances", "superClasses", "superClasses", "types", "instances", "closure"], "args": [[], ["Cat", "rdfs:subClassOf", "Pet"], ["Cat", "rdfs:subClassOf", "Mammal"], ["Pet", "rdfs:subClassOf", "Thing"], ["Mammal", "rdfs:subClassOf", "Thing"], ["a9", "rdfs:subClassOf", "a10"], ["a10", "rdfs:subClassOf", "b"], ["b", "rdfs:subClassOf", "B"], ["felix", "rdf:type", "Cat"], ["odd", "rdf:type", "a9"], ["felix"], ["Thing"], ["Pet"], ["Cat"], ["a9"], ["odd"], ["B"], ["?", "rdfs:subClassOf", "Thing"]], "expected": [null, true, true, true, true, true, true, true, true, true, ["Cat", "Mammal", "Pet", "Thing"], ["felix"], ["felix"], ["Mammal", "Pet", "Thing"], ["B", "a10", "b"], ["B", "a10", "a9", "b"], ["odd"], [["Cat", "rdfs:subClassOf", "Thing"], ["Mammal", "rdfs:subClassOf", "Thing"], ["Pet", "rdfs:subClassOf", "Thing"]]]},
  {"id": "h3", "level": 1, "note": "a chain of 30 classes: every instance has every class above its own; the order of the adds does not matter", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "types", "superClasses", "superClasses", "instances", "instances", "closure"], "args": [[], ["x", "rdf:type", "K0"], ["K29", "rdfs:subClassOf", "K30"], ["K28", "rdfs:subClassOf", "K29"], ["K27", "rdfs:subClassOf", "K28"], ["K26", "rdfs:subClassOf", "K27"], ["K25", "rdfs:subClassOf", "K26"], ["K24", "rdfs:subClassOf", "K25"], ["K23", "rdfs:subClassOf", "K24"], ["K22", "rdfs:subClassOf", "K23"], ["K21", "rdfs:subClassOf", "K22"], ["K20", "rdfs:subClassOf", "K21"], ["K19", "rdfs:subClassOf", "K20"], ["K18", "rdfs:subClassOf", "K19"], ["K17", "rdfs:subClassOf", "K18"], ["K16", "rdfs:subClassOf", "K17"], ["K15", "rdfs:subClassOf", "K16"], ["K14", "rdfs:subClassOf", "K15"], ["K13", "rdfs:subClassOf", "K14"], ["K12", "rdfs:subClassOf", "K13"], ["K11", "rdfs:subClassOf", "K12"], ["K10", "rdfs:subClassOf", "K11"], ["K9", "rdfs:subClassOf", "K10"], ["K8", "rdfs:subClassOf", "K9"], ["K7", "rdfs:subClassOf", "K8"], ["K6", "rdfs:subClassOf", "K7"], ["K5", "rdfs:subClassOf", "K6"], ["K4", "rdfs:subClassOf", "K5"], ["K3", "rdfs:subClassOf", "K4"], ["K2", "rdfs:subClassOf", "K3"], ["K1", "rdfs:subClassOf", "K2"], ["K0", "rdfs:subClassOf", "K1"], ["x"], ["K0"], ["K29"], ["K30"], ["K15"], ["K28", "?", "?"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, ["K0", "K1", "K10", "K11", "K12", "K13", "K14", "K15", "K16", "K17", "K18", "K19", "K2", "K20", "K21", "K22", "K23", "K24", "K25", "K26", "K27", "K28", "K29", "K3", "K30", "K4", "K5", "K6", "K7", "K8", "K9"], ["K1", "K10", "K11", "K12", "K13", "K14", "K15", "K16", "K17", "K18", "K19", "K2", "K20", "K21", "K22", "K23", "K24", "K25", "K26", "K27", "K28", "K29", "K3", "K30", "K4", "K5", "K6", "K7", "K8", "K9"], ["K30"], ["x"], ["x"], [["K28", "rdfs:subClassOf", "K29"], ["K28", "rdfs:subClassOf", "K30"]]]},
  {"id": "h4", "level": 1, "note": "a class can be an instance too: being a subclass gives a class no types, and being typed gives it no superclass", "ops": ["KnowledgeBase", "add", "add", "add", "types", "types", "instances", "instances", "superClasses", "closure"], "args": [[], ["Dog", "rdfs:subClassOf", "Animal"], ["Dog", "rdf:type", "Species"], ["Animal", "rdf:type", "Kingdom"], ["Dog"], ["Animal"], ["Species"], ["Animal"], ["Species"], ["Dog", "?", "?"]], "expected": [null, true, true, true, ["Species"], ["Kingdom"], ["Dog"], [], [], [["Dog", "rdf:type", "Species"], ["Dog", "rdfs:subClassOf", "Animal"]]]},
  {"id": "h5", "level": 1, "note": "adding a triple that is already inferred is still new: add reports on what was asserted", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "closure", "types"], "args": [[], ["Dog", "rdfs:subClassOf", "Animal"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Animal"], ["rex", "rdf:type", "Animal"], ["Dog", "rdfs:subClassOf", "Animal"], ["rex", "rdf:type", "?"], ["rex"]], "expected": [null, true, true, true, false, false, [["rex", "rdf:type", "Animal"], ["rex", "rdf:type", "Dog"]], ["Animal", "Dog"]]},
  {"id": "h6", "level": 1, "note": "two chains meet in one class; an instance of the middle class has the classes above it but not the ones below", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "instances", "instances", "instances", "types", "superClasses", "superClasses", "closure"], "args": [[], ["P", "rdfs:subClassOf", "M"], ["Q", "rdfs:subClassOf", "M"], ["M", "rdfs:subClassOf", "T"], ["p1", "rdf:type", "P"], ["q1", "rdf:type", "Q"], ["m1", "rdf:type", "M"], ["M"], ["P"], ["T"], ["m1"], ["M"], ["P"], ["?", "rdf:type", "T"]], "expected": [null, true, true, true, true, true, true, ["m1", "p1", "q1"], ["p1"], ["m1", "p1", "q1"], ["M", "T"], ["T"], ["M", "T"], [["m1", "rdf:type", "T"], ["p1", "rdf:type", "T"], ["q1", "rdf:type", "T"]]]},
  {"id": "h7", "level": 1, "note": "a cycle of three classes makes each one a subclass of every class on it, itself included, while superClasses never lists the class itself", "ops": ["KnowledgeBase", "add", "add", "add", "add", "superClasses", "superClasses", "superClasses", "types", "instances", "closure"], "args": [[], ["A", "rdfs:subClassOf", "B"], ["B", "rdfs:subClassOf", "C"], ["C", "rdfs:subClassOf", "A"], ["x", "rdf:type", "B"], ["A"], ["B"], ["C"], ["x"], ["A"], ["?", "rdfs:subClassOf", "A"]], "expected": [null, true, true, true, true, ["B", "C"], ["A", "C"], ["A", "B"], ["A", "B", "C"], ["x"], [["A", "rdfs:subClassOf", "A"], ["B", "rdfs:subClassOf", "A"], ["C", "rdfs:subClassOf", "A"]]]},
  {"id": "ex3", "visible": true, "level": 2, "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "types", "types", "ask", "ask", "ask", "ask", "ask"], "args": [[], ["worksFor", "rdfs:domain", "Person"], ["worksFor", "rdfs:range", "Organization"], ["Organization", "rdfs:subClassOf", "Agent"], ["ada", "worksFor", "acme"], ["ada", "rdf:type", "Robot"], ["ada"], ["acme"], ["ada", "rdf:type", "Person"], ["ada", "rdf:type", "Robot"], ["ada", "rdf:type", "Plant"], ["acme", "worksFor", "ada"], ["zed", "rdf:type", "Person"]], "expected": [null, true, true, true, true, true, ["Person", "Robot"], ["Agent", "Organization"], "entailed", "entailed", "unknown", "unknown", "unknown"]},
  {"id": "ex4", "visible": true, "level": 2, "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "types", "types", "instances", "closure", "ask"], "args": [[], ["teaches", "rdfs:domain", "Teacher"], ["teaches", "rdfs:domain", "Adult"], ["teaches", "rdfs:range", "Student"], ["Teacher", "rdfs:subClassOf", "Person"], ["Student", "rdfs:subClassOf", "Person"], ["mia", "teaches", "leo"], ["mia"], ["leo"], ["Person"], ["?", "rdf:type", "Person"], ["leo", "rdf:type", "Adult"]], "expected": [null, true, true, true, true, true, true, ["Adult", "Person", "Teacher"], ["Person", "Student"], ["leo", "mia"], [["leo", "rdf:type", "Person"], ["mia", "rdf:type", "Person"]], "unknown"]},
  {"id": "h8", "level": 2, "note": "a domain or range that comes after the facts still applies; a property without facts infers nothing", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "types", "types", "types", "types", "instances", "instances", "instances", "instances", "instances"], "args": [[], ["a", "knows", "b"], ["c", "likes", "d"], ["knows", "rdfs:domain", "Person"], ["knows", "rdfs:domain", "Adult"], ["knows", "rdfs:range", "Friend"], ["knows", "rdfs:range", "Contact"], ["owns", "rdfs:domain", "Owner"], ["a"], ["b"], ["c"], ["d"], ["Owner"], ["Person"], ["Adult"], ["Friend"], ["Contact"]], "expected": [null, true, true, true, true, true, true, true, ["Adult", "Person"], ["Contact", "Friend"], [], [], [], ["a"], ["a"], ["b"], ["b"]]},
  {"id": "h9", "level": 2, "note": "domain applies to the subject and range to the object, and a term can be both; a self-referring fact is both", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "types", "types", "types", "instances", "instances"], "args": [[], ["knows", "rdfs:domain", "Knower"], ["knows", "rdfs:range", "Known"], ["x", "knows", "x"], ["x", "knows", "y"], ["y", "knows", "z"], ["x"], ["y"], ["z"], ["Knower"], ["Known"]], "expected": [null, true, true, true, true, true, ["Knower", "Known"], ["Knower", "Known"], ["Known"], ["x", "y"], ["x", "y", "z"]]},
  {"id": "h10", "level": 2, "note": "inferred types are climbed through the subclass chain, and a range class that is a subclass inherits too", "ops": ["KnowledgeBase", "add", "add", "add", "add", "types", "types", "superClasses", "instances", "ask", "ask"], "args": [[], ["Puppy", "rdfs:subClassOf", "Dog"], ["Dog", "rdfs:subClassOf", "Animal"], ["adopts", "rdfs:range", "Puppy"], ["sam", "adopts", "pip"], ["pip"], ["sam"], ["Puppy"], ["Animal"], ["pip", "rdf:type", "Animal"], ["pip", "rdf:type", "Puppy"]], "expected": [null, true, true, true, true, ["Animal", "Dog", "Puppy"], [], ["Animal", "Dog"], ["pip"], "entailed", "entailed"]},
  {"id": "h11", "level": 2, "note": "ask separates entailed from unknown: an asserted fact is entailed, a fact about unseen terms is unknown, and nothing here is ever answered with no", "ops": ["KnowledgeBase", "add", "add", "ask", "ask", "ask", "ask", "ask", "ask", "ask", "ask"], "args": [[], ["p", "rdfs:domain", "D"], ["s", "p", "o"], ["s", "p", "o"], ["s", "p", "q"], ["s", "rdf:type", "D"], ["s", "rdf:type", "E"], ["p", "rdfs:domain", "D"], ["p", "rdfs:domain", "E"], ["o", "rdf:type", "D"], ["none", "none", "none"]], "expected": [null, true, true, "entailed", "unknown", "entailed", "unknown", "entailed", "unknown", "unknown", "unknown"]},
  {"id": "h12", "level": 2, "note": "the rules apply to the vocabulary too: a range on rdf:type and a domain on rdfs:subClassOf type the classes, until nothing new appears", "ops": ["KnowledgeBase", "add", "add", "add", "add", "types", "types", "types", "instances", "ask"], "args": [[], ["rdf:type", "rdfs:range", "Class"], ["rdfs:subClassOf", "rdfs:domain", "Class"], ["Dog", "rdfs:subClassOf", "Animal"], ["rex", "rdf:type", "Dog"], ["Dog"], ["Class"], ["Animal"], ["Class"], ["Animal", "rdf:type", "Class"]], "expected": [null, true, true, true, true, ["Class"], ["Class"], ["Class"], ["Animal", "Class", "Dog"], "entailed"]},
  {"id": "h13", "level": 2, "note": "a domain stated on a property that is used with itself as its own object keeps terminating", "ops": ["KnowledgeBase", "add", "add", "add", "add", "types", "instances", "closure"], "args": [[], ["p", "p", "p"], ["p", "rdfs:domain", "C"], ["p", "rdfs:range", "C"], ["C", "rdfs:subClassOf", "D"], ["p"], ["D"], ["p", "?", "?"]], "expected": [null, true, true, true, true, ["C", "D"], ["p"], [["p", "p", "p"], ["p", "rdf:type", "C"], ["p", "rdf:type", "D"], ["p", "rdfs:domain", "C"], ["p", "rdfs:range", "C"]]]},
  {"id": "ex5", "visible": true, "level": 3, "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "closure", "closure", "closure"], "args": [[], ["ancestorOf", "rdf:type", "owl:TransitiveProperty"], ["parentOf", "owl:inverseOf", "childOf"], ["ann", "ancestorOf", "bea"], ["bea", "ancestorOf", "cy"], ["cy", "ancestorOf", "dee"], ["ann", "parentOf", "bea"], ["ann", "ancestorOf", "?"], ["bea", "childOf", "?"], ["?", "ancestorOf", "dee"]], "expected": [null, true, true, true, true, true, true, [["ann", "ancestorOf", "bea"], ["ann", "ancestorOf", "cy"], ["ann", "ancestorOf", "dee"]], [["bea", "childOf", "ann"]], [["ann", "ancestorOf", "dee"], ["bea", "ancestorOf", "dee"], ["cy", "ancestorOf", "dee"]]]},
  {"id": "ex6", "visible": true, "level": 3, "ops": ["KnowledgeBase", "add", "add", "add", "add", "inconsistencies", "add", "inconsistencies", "ask", "ask", "ask", "ask", "ask", "types"], "args": [[], ["Robot", "owl:disjointWith", "Person"], ["worksFor", "rdfs:domain", "Person"], ["r2", "rdf:type", "Robot"], ["kim", "rdf:type", "Person"], [], ["r2", "worksFor", "acme"], [], ["kim", "rdf:type", "Robot"], ["kim", "rdf:type", "Plant"], ["r2", "rdf:type", "Person"], ["r2", "rdf:type", "Robot"], ["kim", "likes", "Robot"], ["r2"]], "expected": [null, true, true, true, true, [], true, [["r2", "Person", "Robot"]], "contradicted", "unknown", "entailed", "entailed", "unknown", ["Person", "Robot"]]},
  {"id": "h14", "level": 3, "note": "a cycle in a transitive property gives each node on it a link to itself; a node leading into the cycle does not get one", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "closure", "closure", "closure", "closure"], "args": [[], ["next", "rdf:type", "owl:TransitiveProperty"], ["a", "next", "b"], ["b", "next", "c"], ["c", "next", "a"], ["d", "next", "a"], ["a", "next", "?"], ["d", "next", "?"], ["?", "next", "d"], ["c", "next", "c"]], "expected": [null, true, true, true, true, true, [["a", "next", "a"], ["a", "next", "b"], ["a", "next", "c"]], [["d", "next", "a"], ["d", "next", "b"], ["d", "next", "c"]], [], [["c", "next", "c"]]]},
  {"id": "h15", "level": 3, "note": "the declaration may come last, and a property that is not declared transitive stays one step", "ops": ["KnowledgeBase", "add", "add", "add", "add", "closure", "add", "closure"], "args": [[], ["a", "partOf", "b"], ["b", "partOf", "c"], ["a", "near", "b"], ["b", "near", "c"], ["a", "?", "c"], ["partOf", "rdf:type", "owl:TransitiveProperty"], ["a", "?", "c"]], "expected": [null, true, true, true, true, [], true, [["a", "partOf", "c"]]]},
  {"id": "h16", "level": 3, "note": "owl:inverseOf works both ways whichever side is declared, and a property can be its own inverse", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "closure", "closure", "closure", "closure"], "args": [[], ["hasPart", "owl:inverseOf", "partOf"], ["x", "partOf", "y"], ["z", "hasPart", "w"], ["married", "owl:inverseOf", "married"], ["u", "married", "v"], ["y", "hasPart", "?"], ["w", "partOf", "?"], ["v", "married", "?"], ["?", "hasPart", "?"]], "expected": [null, true, true, true, true, true, [["y", "hasPart", "x"]], [["w", "partOf", "z"]], [["v", "married", "u"]], [["y", "hasPart", "x"], ["z", "hasPart", "w"]]]},
  {"id": "h17", "level": 3, "note": "inverse and transitive together: the inferred links are chained, and domain and range see inferred links", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "closure", "closure", "instances", "types", "types"], "args": [[], ["below", "owl:inverseOf", "above"], ["above", "rdf:type", "owl:TransitiveProperty"], ["a", "below", "b"], ["b", "below", "c"], ["c", "below", "d"], ["above", "rdfs:domain", "Upper"], ["d", "above", "?"], ["a", "above", "?"], ["Upper"], ["a"], ["d"]], "expected": [null, true, true, true, true, true, true, [["d", "above", "a"], ["d", "above", "b"], ["d", "above", "c"]], [], ["b", "c", "d"], [], ["Upper"]]},
  {"id": "h18", "level": 3, "note": "a clash is listed once even when the axiom is stated both ways, with the two classes in plain string order; a class disjoint with itself clashes with any member", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "inconsistencies", "types"], "args": [[], ["B", "owl:disjointWith", "A"], ["A", "owl:disjointWith", "B"], ["C", "owl:disjointWith", "C"], ["x", "rdf:type", "A"], ["x", "rdf:type", "B"], ["y", "rdf:type", "C"], ["z", "rdf:type", "A"], [], ["x"]], "expected": [null, true, true, true, true, true, true, true, [["x", "A", "B"], ["y", "C", "C"]], ["A", "B"]]},
  {"id": "h19", "level": 3, "note": "disjointness is seen through subclasses and through inferred types, and rows are sorted by resource then classes", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "inconsistencies", "instances"], "args": [[], ["Animal", "owl:disjointWith", "Plant"], ["Dog", "rdfs:subClassOf", "Animal"], ["Tree", "rdfs:subClassOf", "Plant"], ["Pet", "rdfs:subClassOf", "Thing"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Tree"], ["fern", "rdf:type", "Plant"], ["owns", "rdfs:range", "Animal"], ["fern", "owns", "fern"], ["Plant", "owl:disjointWith", "Mineral"], ["fern", "rdf:type", "Mineral"], [], ["Animal"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["fern", "Animal", "Plant"], ["fern", "Mineral", "Plant"], ["rex", "Animal", "Plant"]], ["fern", "rex"]]},
  {"id": "h20", "level": 3, "note": "ask says contradicted for a type that a disjoint class rules out, also through a superclass of the asked class, but never for other predicates and never for what is entailed", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "ask", "ask", "ask", "ask", "ask", "ask", "ask", "ask", "add", "ask", "ask", "ask"], "args": [[], ["Animal", "owl:disjointWith", "Plant"], ["Dog", "rdfs:subClassOf", "Animal"], ["Tree", "rdfs:subClassOf", "Plant"], ["Oak", "rdfs:subClassOf", "Tree"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Plant"], ["rex", "rdf:type", "Tree"], ["rex", "rdf:type", "Oak"], ["rex", "rdf:type", "Animal"], ["rex", "rdf:type", "Dog"], ["rex", "rdf:type", "Cat"], ["rex", "likes", "Plant"], ["nobody", "rdf:type", "Plant"], ["fern", "rdf:type", "Oak"], ["fern", "rdf:type", "Dog"], ["fern", "rdf:type", "Animal"], ["fern", "rdf:type", "Plant"]], "expected": [null, true, true, true, true, true, "contradicted", "contradicted", "contradicted", "entailed", "entailed", "unknown", "unknown", "unknown", true, "contradicted", "contradicted", "entailed"]},
  {"id": "h21", "level": 3, "note": "a base that is inconsistent keeps answering, and a class on both sides of a disjoint pair is a clash only for resources in both", "ops": ["KnowledgeBase", "add", "add", "add", "add", "inconsistencies", "types", "instances", "ask", "ask", "ask", "ask"], "args": [[], ["A", "owl:disjointWith", "B"], ["x", "rdf:type", "A"], ["x", "rdf:type", "B"], ["y", "rdf:type", "A"], [], ["x"], ["A"], ["y", "rdf:type", "B"], ["x", "rdf:type", "A"], ["x", "rdf:type", "B"], ["x", "rdf:type", "C"]], "expected": [null, true, true, true, true, [["x", "A", "B"]], ["A", "B"], ["x", "y"], "contradicted", "entailed", "entailed", "unknown"]},
  {"id": "h22", "level": 3, "note": "a transitive declaration can itself be inferred from a range, and the links it allows are then chained", "ops": ["KnowledgeBase", "add", "add", "add", "add", "types", "closure"], "args": [[], ["declares", "rdfs:range", "owl:TransitiveProperty"], ["lib", "declares", "reaches"], ["a", "reaches", "b"], ["b", "reaches", "c"], ["reaches"], ["a", "reaches", "?"]], "expected": [null, true, true, true, true, ["owl:TransitiveProperty"], [["a", "reaches", "b"], ["a", "reaches", "c"]]]},
  {"id": "h23", "level": 3, "note": "disjointness holds both ways though it is stated one way, and the closure does not add the mirrored axiom", "ops": ["KnowledgeBase", "add", "add", "add", "add", "inconsistencies", "closure"], "args": [[], ["Even", "owl:disjointWith", "Odd"], ["n", "rdf:type", "Even"], ["n", "rdf:type", "Odd"], ["m", "rdf:type", "Odd"], [], ["?", "owl:disjointWith", "?"]], "expected": [null, true, true, true, true, [["n", "Even", "Odd"]], [["Even", "owl:disjointWith", "Odd"]]]},
  {"id": "ex7", "visible": true, "level": 4, "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "addShape", "addProperty", "addProperty", "validate"], "args": [[], ["Employee", "rdfs:subClassOf", "Person"], ["ada", "rdf:type", "Employee"], ["bob", "rdf:type", "Person"], ["cy", "rdf:type", "Robot"], ["acme", "rdf:type", "Organization"], ["ada", "email", "ada@x.org"], ["ada", "worksFor", "acme"], ["ada", "worksFor", "beta"], ["PersonShape", "Person"], ["PersonShape", "email", 1, 1, ""], ["PersonShape", "worksFor", 0, 1, "Organization"], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["ada", "PersonShape", "worksFor", "sh:ClassConstraintComponent", "beta"], ["ada", "PersonShape", "worksFor", "sh:MaxCountConstraintComponent", ""], ["bob", "PersonShape", "email", "sh:MinCountConstraintComponent", ""]]]},
  {"id": "ex8", "visible": true, "level": 4, "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "addShape", "addProperty", "addProperty", "validate", "contrast", "ask", "ask"], "args": [[], ["hasChild", "owl:inverseOf", "hasParent"], ["worksFor", "rdfs:range", "Organization"], ["worksFor", "rdfs:domain", "Person"], ["ada", "rdf:type", "Person"], ["kim", "rdf:type", "Person"], ["zed", "worksFor", "acme"], ["ada", "hasChild", "kim"], ["ada", "worksFor", "acme"], ["PersonShape", "Person"], ["PersonShape", "hasParent", 1, -1, ""], ["PersonShape", "worksFor", 1, 1, "Organization"], [], [], ["zed", "rdf:type", "Person"], ["kim", "hasParent", "ada"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["ada", "PersonShape", "hasParent", "sh:MinCountConstraintComponent", ""], ["ada", "PersonShape", "worksFor", "sh:ClassConstraintComponent", "acme"], ["kim", "PersonShape", "hasParent", "sh:MinCountConstraintComponent", ""], ["kim", "PersonShape", "worksFor", "sh:MinCountConstraintComponent", ""]], [["ada", "PersonShape", "hasParent", "sh:MinCountConstraintComponent", "", "unknown"], ["ada", "PersonShape", "worksFor", "sh:ClassConstraintComponent", "acme", "entailed"], ["kim", "PersonShape", "hasParent", "sh:MinCountConstraintComponent", "", "entailed"], ["kim", "PersonShape", "worksFor", "sh:MinCountConstraintComponent", "", "unknown"]], "entailed", "entailed"]},
  {"id": "h24", "level": 4, "note": "without shapes there is nothing to report; the shape must exist before it gets properties, and a path appears once per shape", "ops": ["KnowledgeBase", "add", "validate", "contrast", "addShape", "addShape", "addProperty", "addProperty", "addProperty", "validate", "contrast"], "args": [[], ["x", "rdf:type", "C"], [], [], ["S", "C"], ["S", "D"], ["T", "p", 1, 1, ""], ["S", "p", 1, 1, ""], ["S", "p", 0, 5, ""], [], []], "expected": [null, true, [], [], true, false, false, true, false, [["x", "S", "p", "sh:MinCountConstraintComponent", ""]], [["x", "S", "p", "sh:MinCountConstraintComponent", "", "unknown"]]]},
  {"id": "h25", "level": 4, "note": "a minimum of 0 and a limit of -1 never complain; a limit of 0 forbids every value; a class check ignores a missing value", "ops": ["KnowledgeBase", "add", "add", "add", "addShape", "addProperty", "addProperty", "addProperty", "validate", "contrast"], "args": [[], ["x", "rdf:type", "C"], ["y", "rdf:type", "C"], ["y", "q", "v"], ["S", "C"], ["S", "p", 0, -1, ""], ["S", "q", 0, 0, ""], ["S", "r", 0, -1, "K"], [], []], "expected": [null, true, true, true, true, true, true, true, [["y", "S", "q", "sh:MaxCountConstraintComponent", ""]], [["y", "S", "q", "sh:MaxCountConstraintComponent", "", "no-error"]]]},
  {"id": "h26", "level": 4, "note": "targets and value classes follow the asserted subclass chain only: a node that a domain makes an animal is no target, and a value that a range makes an animal is no animal here", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "add", "add", "add", "add", "add", "addShape", "addProperty", "addProperty", "validate", "contrast", "types", "types"], "args": [[], ["Puppy", "rdfs:subClassOf", "Dog"], ["Dog", "rdfs:subClassOf", "Animal"], ["p1", "rdf:type", "Puppy"], ["friend", "rdfs:domain", "Animal"], ["friend", "rdfs:range", "Animal"], ["a1", "friend", "ghost"], ["p1", "friend", "ghost"], ["p1", "friend", "p1"], ["q", "friend", "p1"], ["q", "rdf:type", "Animal"], ["AnimalShape", "Animal"], ["AnimalShape", "friend", 1, -1, "Animal"], ["AnimalShape", "name", 1, 1, ""], [], [], ["ghost"], ["a1"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, [["p1", "AnimalShape", "friend", "sh:ClassConstraintComponent", "ghost"], ["p1", "AnimalShape", "name", "sh:MinCountConstraintComponent", ""], ["q", "AnimalShape", "name", "sh:MinCountConstraintComponent", ""]], [["p1", "AnimalShape", "friend", "sh:ClassConstraintComponent", "ghost", "entailed"], ["p1", "AnimalShape", "name", "sh:MinCountConstraintComponent", "", "unknown"], ["q", "AnimalShape", "name", "sh:MinCountConstraintComponent", "", "unknown"]], ["Animal"], ["Animal"]]},
  {"id": "h27", "level": 4, "note": "more than the limit and fewer than the minimum are two separate results of two components; rows sort by node, shape, path, component, value", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "addShape", "addShape", "addProperty", "addProperty", "addProperty", "add", "validate", "contrast"], "args": [[], ["n2", "rdf:type", "C"], ["n1", "rdf:type", "C"], ["n1", "p", "a"], ["n1", "p", "b"], ["n2", "p", "z"], ["T", "C"], ["S", "C"], ["S", "p", 3, 1, "K"], ["T", "p", 1, 1, ""], ["T", "q", 1, 1, ""], ["a", "rdf:type", "K"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["n1", "S", "p", "sh:ClassConstraintComponent", "b"], ["n1", "S", "p", "sh:MaxCountConstraintComponent", ""], ["n1", "S", "p", "sh:MinCountConstraintComponent", ""], ["n1", "T", "p", "sh:MaxCountConstraintComponent", ""], ["n1", "T", "q", "sh:MinCountConstraintComponent", ""], ["n2", "S", "p", "sh:ClassConstraintComponent", "z"], ["n2", "S", "p", "sh:MinCountConstraintComponent", ""], ["n2", "T", "q", "sh:MinCountConstraintComponent", ""]], [["n1", "S", "p", "sh:ClassConstraintComponent", "b", "unknown"], ["n1", "S", "p", "sh:MaxCountConstraintComponent", "", "no-error"], ["n1", "S", "p", "sh:MinCountConstraintComponent", "", "unknown"], ["n1", "T", "p", "sh:MaxCountConstraintComponent", "", "no-error"], ["n1", "T", "q", "sh:MinCountConstraintComponent", "", "unknown"], ["n2", "S", "p", "sh:ClassConstraintComponent", "z", "unknown"], ["n2", "S", "p", "sh:MinCountConstraintComponent", "", "unknown"], ["n2", "T", "q", "sh:MinCountConstraintComponent", "", "unknown"]]]},
  {"id": "h28", "level": 4, "note": "counts are of distinct asserted values: inferred links do not fill a minimum, and the reasoner says entailed when they would", "ops": ["KnowledgeBase", "add", "add", "add", "add", "add", "addShape", "addProperty", "addProperty", "validate", "contrast", "closure"], "args": [[], ["loves", "owl:inverseOf", "lovedBy"], ["a", "rdf:type", "P"], ["b", "rdf:type", "P"], ["a", "loves", "b"], ["c", "lovedBy", "b"], ["S", "P"], ["S", "lovedBy", 1, 1, ""], ["S", "loves", 2, 2, ""], [], [], ["b", "lovedBy", "?"]], "expected": [null, true, true, true, true, true, true, true, true, [["a", "S", "lovedBy", "sh:MinCountConstraintComponent", ""], ["a", "S", "loves", "sh:MinCountConstraintComponent", ""], ["b", "S", "lovedBy", "sh:MinCountConstraintComponent", ""], ["b", "S", "loves", "sh:MinCountConstraintComponent", ""]], [["a", "S", "lovedBy", "sh:MinCountConstraintComponent", "", "unknown"], ["a", "S", "loves", "sh:MinCountConstraintComponent", "", "unknown"], ["b", "S", "lovedBy", "sh:MinCountConstraintComponent", "", "entailed"], ["b", "S", "loves", "sh:MinCountConstraintComponent", "", "unknown"]], [["b", "lovedBy", "a"]]]},
  {"id": "h29", "level": 4, "note": "a node typed through two classes of the chain is one focus node, and two shapes on one class report separately", "ops": ["KnowledgeBase", "add", "add", "add", "addShape", "addShape", "addProperty", "addProperty", "validate", "contrast"], "args": [[], ["A", "rdfs:subClassOf", "B"], ["x", "rdf:type", "A"], ["x", "rdf:type", "B"], ["S1", "B"], ["S2", "A"], ["S1", "p", 1, 1, ""], ["S2", "p", 1, 1, ""], [], []], "expected": [null, true, true, true, true, true, true, true, [["x", "S1", "p", "sh:MinCountConstraintComponent", ""], ["x", "S2", "p", "sh:MinCountConstraintComponent", ""]], [["x", "S1", "p", "sh:MinCountConstraintComponent", "", "unknown"], ["x", "S2", "p", "sh:MinCountConstraintComponent", "", "unknown"]]]},
  {"id": "h30", "level": 4, "note": "the base can keep changing after shapes exist; add reports on the asserted triple only", "ops": ["KnowledgeBase", "addShape", "addProperty", "validate", "add", "validate", "add", "validate", "add", "validate", "contrast", "add", "add", "validate"], "args": [[], ["S", "C"], ["S", "p", 1, 1, ""], [], ["x", "rdf:type", "C"], [], ["x", "p", "v"], [], ["x", "p", "w"], [], [], ["D", "rdfs:subClassOf", "C"], ["y", "rdf:type", "D"], []], "expected": [null, true, true, [], true, [["x", "S", "p", "sh:MinCountConstraintComponent", ""]], true, [], true, [["x", "S", "p", "sh:MaxCountConstraintComponent", ""]], [["x", "S", "p", "sh:MaxCountConstraintComponent", "", "no-error"]], true, true, [["x", "S", "p", "sh:MaxCountConstraintComponent", ""], ["y", "S", "p", "sh:MinCountConstraintComponent", ""]]]}
