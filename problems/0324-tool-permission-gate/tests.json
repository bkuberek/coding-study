  {"id": "h21", "level": 4, "note": "each ask gets a number; an answer settles a pending request once; unknown numbers are not pending", "ops": ["PermissionGate", "check", "check", "check", "receive", "receive", "receive", "receive", "receive", "receive", "status", "status", "status", "status", "status", "auditLog"], "args": [[], ["shell", [["cmd", "ls"]]], ["shell", [["cmd", "pwd"]]], ["shell", [["cmd", "whoami"]]], ["user", "no 1"], ["user", "yes 3"], ["user", "yes 1"], ["user", "no 7"], ["user", "yes 2"], ["user", "no 2"], [1], [2], [3], [4], [0], []], "expected": [null, "ask", "ask", "ask", "applied", "applied", "ignored", "ignored", "applied", "ignored", "deny", "allow", "allow", "unknown", "unknown", [["1", "check", "shell", "cmd=ls", "ask", "default", "1"], ["2", "check", "shell", "cmd=pwd", "ask", "default", "2"], ["3", "check", "shell", "cmd=whoami", "ask", "default", "3"], ["4", "receive", "user", "no 1", "applied", "answered", "1"], ["5", "receive", "user", "yes 3", "applied", "answered", "3"], ["6", "receive", "user", "yes 1", "ignored", "not-pending", "1"], ["7", "receive", "user", "no 7", "ignored", "not-pending", "7"], ["8", "receive", "user", "yes 2", "applied", "answered", "2"], ["9", "receive", "user", "no 2", "ignored", "not-pending", "2"]]]},
  {"id": "h22", "level": 4, "note": "answers can remember for the tool or for the exact call; the audit log tells which memory decided", "ops": ["PermissionGate", "addRisk", "check", "receive", "check", "check", "receive", "check", "check", "receive", "check", "check", "receive", "check", "check", "status", "status", "status", "status", "auditLog"], "args": [[], ["shell", "cmd", "rm "], ["shell", [["cmd", "ls"]]], ["user", "yes-tool 1"], ["shell", [["cmd", "pwd"]]], ["shell", [["cmd", "rm -rf /"]]], ["user", "no-exact 2"], ["shell", [["cmd", "rm -rf /"]]], ["shell", [["cmd", "rm -rf /tmp"]]], ["user", "yes-exact 3"], ["shell", [["cmd", "rm -rf /tmp"]]], ["shell", [["cmd", "rm -rf /var"]]], ["user", "no-tool 4"], ["shell", [["cmd", "pwd"]]], ["shell", [["cmd", "rm -rf /tmp"]]], [1], [2], [3], [4], []], "expected": [null, true, "ask", "applied", "allow", "ask", "applied", "deny", "ask", "applied", "allow", "ask", "applied", "deny", "allow", "allow", "deny", "allow", "deny", [["1", "check", "shell", "cmd=ls", "ask", "default", "1"], ["2", "receive", "user", "yes-tool 1", "applied", "answered:tool", "1"], ["3", "check", "shell", "cmd=pwd", "allow", "remembered:tool", ""], ["4", "check", "shell", "cmd=rm -rf /", "ask", "risk:cmd", "2"], ["5", "receive", "user", "no-exact 2", "applied", "answered:exact", "2"], ["6", "check", "shell", "cmd=rm -rf /", "deny", "remembered:exact", ""], ["7", "check", "shell", "cmd=rm -rf /tmp", "ask", "risk:cmd", "3"], ["8", "receive", "user", "yes-exact 3", "applied", "answered:exact", "3"], ["9", "check", "shell", "cmd=rm -rf /tmp", "allow", "remembered:exact", ""], ["10", "check", "shell", "cmd=rm -rf /var", "ask", "risk:cmd", "4"], ["11", "receive", "user", "no-tool 4", "applied", "answered:tool", "4"], ["12", "check", "shell", "cmd=pwd", "deny", "remembered:tool", ""], ["13", "check", "shell", "cmd=rm -rf /tmp", "allow", "remembered:exact", ""]]]},
