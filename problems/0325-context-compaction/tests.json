  {"id": "h10", "level": 2, "note": "a replacement is made even when the summary costs more than what it replaces; the work stops when no unit is left to replace", "ops": ["ContextWindow", "setSummaries", "setCompaction", "addTurn", "addTurn", "addTurn", "compactions", "context", "addTurn", "compactions", "context"], "args": [[], [["a very long summary that costs far more than the turn it replaces by a wide margin"]], [20, 1], ["user", "one"], ["user", "two"], ["user", "three"], [], [], ["user", "four"], [], []], "expected": [null, null, null, 0, 1, 2, 0, [["user", "0", "5"], ["user", "1", "5"], ["user", "2", "6"]], 3, 1, [["summary", "0", "25"], ["user", "3", "5"]]]},
  {"id": "h11", "level": 2, "note": "a run of calls and results is replaced whole: the smallest replacement that fits ends between units, never inside a run", "ops": ["ContextWindow", "setSummaries", "setCompaction", "addTurn", "addCall", "addResult", "addCall", "addResult", "addTurn", "compactions", "context", "addTurn", "compactions", "context", "window", "window"], "args": [[], [["s1", "s2", "s3", "s4"]], [30, 1], ["user", "alpha beta gamma delta"], ["t", "lookup(alpha)"], ["t", "found alpha"], ["u", "lookup(beta)"], ["u", "found beta"], ["user", "epsilon"], [], [], ["assistant", "zeta eta theta iota"], [], [], [60, 100], [60, 2]], "expected": [null, null, null, 0, 1, 2, 3, 4, 5, 2, [["summary", "1", "5"], ["user", "5", "6"]], 6, 2, [["summary", "1", "5"], ["user", "5", "6"], ["assistant", "6", "9"]], [0, 1, 2, 3, 4, 5, 6], [5, 6]]},
