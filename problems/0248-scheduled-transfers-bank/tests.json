{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "transfer", "deposit"], "args": [[], [1, "ivy"], [2, "leo"], [3, "ivy"], [4, "ivy", 800], [5, "max", 50], [6, "ivy", "leo", 300], [7, "leo", "ivy", 400], [8, "leo", "leo", 10], [9, "ivy", "max", 10], [10, "leo", 25]], "expected": [null, true, true, false, 800, -1, 500, -1, -1, -1, 325]},
    {"id": "h1", "level": 1, "note": "transfers to self, to a missing account or from one change nothing; a transfer may empty the source", "ops": ["Bank", "createAccount", "deposit", "transfer", "transfer", "transfer", "deposit", "createAccount", "transfer", "transfer", "deposit"], "args": [[], [1, "a"], [2, "a", 100], [3, "a", "a", 50], [4, "a", "ghost", 50], [5, "ghost", "a", 50], [6, "a", 1], [7, "b"], [8, "a", "b", 101], [9, "a", "b", 1], [10, "b", 1]], "expected": [null, true, 100, -1, -1, -1, 101, true, 0, -1, 102]},
    {"id": "h2", "level": 1, "note": "balances go beyond 32-bit integers", "ops": ["Bank", "createAccount", "deposit", "deposit", "createAccount", "transfer", "deposit", "deposit"], "args": [[], [1, "big"], [2, "big", 10000000000], [3, "big", 10000000000], [4, "tiny"], [5, "big", "tiny", 15000000000], [6, "tiny", 1], [7, "nobody", 1]], "expected": [null, true, 10000000000, 20000000000, true, 5000000000, 15000000001, -1]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "transfer", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "dan"], [2, "eve"], [3, "fay"], [4, "dan", 500], [5, "eve", 500], [6, "dan", "eve", 200], [7, "eve", "fay", 350], [8, "dan", "fay", 100], [9, 2], [10, 5]], "expected": [null, true, true, true, 500, 500, 300, 350, 200, ["eve(350)", "dan(300)"], ["eve(350)", "dan(300)", "fay(0)"]]},
    {"id": "h3", "level": 2, "note": "equal totals go in ascending id order; a large deposit never counts as spending", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "deposit", "transfer", "transfer", "topSpenders", "topSpenders"], "args": [[], [1, "zoe"], [2, "abe"], [3, "mia"], [4, "zoe", 100], [5, "abe", 100], [6, "mia", 5000], [7, "zoe", "mia", 60], [8, "abe", "mia", 60], [9, 3], [10, 1]], "expected": [null, true, true, true, 100, 100, 5000, 40, 40, ["abe(60)", "zoe(60)", "mia(0)"], ["abe(60)"]]},
    {"id": "h4", "level": 2, "note": "n larger than the number of accounts returns them all; failed transfers do not count", "ops": ["Bank", "topSpenders", "createAccount", "createAccount", "deposit", "transfer", "topSpenders", "transfer", "topSpenders"], "args": [[], [1, 4], [2, "x"], [3, "y"], [4, "x", 10], [5, "x", "y", 20], [6, 10], [7, "x", "y", 10], [8, 10]], "expected": [null, [], true, true, 10, -1, ["x(0)", "y(0)"], 0, ["x(10)", "y(0)"]]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "deposit", "deposit", "cancelTransfer", "deposit", "topSpenders"], "args": [[], [1, "ana"], [2, "ben"], [3, "ana", 100], [4, "ana", "ben", 80, 20], [5, "ana", "ben", 50, 10], [6, "ben", "ana", 5, 100], [14, "ben", 1], [15, "ben", 1], [16, "ben", "transfer3"], [30, "ana", 1], [31, 2]], "expected": [null, true, true, 100, "transfer1", "transfer2", "transfer3", 1, 52, true, 51, ["ana(50)", "ben(0)"]]},
    {"id": "h5", "level": 3, "note": "scheduling needs two distinct existing accounts but not the funds; failures use no transfer number", "ops": ["Bank", "createAccount", "createAccount", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", "a", 1, 5], [4, "a", "zz", 1, 5], [5, "zz", "a", 1, 5], [6, "a", "b", 1000, 5], [7, "b", "a", 1, 5], [20, "a", 1], [21, 2]], "expected": [null, true, true, "", "", "", "transfer1", "transfer2", 1, ["a(0)", "b(0)"]]},
    {"id": "h6", "level": 3, "note": "two transfers due at the same time run in scheduling order, before the call at that time", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "transfer", "topSpenders", "deposit", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "a", 100], [10, "a", "b", 70, 10], [15, "a", "c", 60, 5], [20, "a", "b", 30], [21, 3], [22, "c", 1], [23, "b", 1]], "expected": [null, true, true, true, 100, "transfer1", "transfer2", 0, ["a(100)", "b(0)", "c(0)"], 1, 101]},
    {"id": "h7", "level": 3, "note": "a transfer due exactly at a call's timestamp lands before that call", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "transfer", "transfer", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "a", 50], [5, "a", "b", 50, 25], [29, "b", "c", 50], [30, "b", "c", 50], [31, "c", 1]], "expected": [null, true, true, true, 50, "transfer1", -1, 0, 51]},
    {"id": "h8", "level": 3, "note": "a later transfer with a shorter delay runs first and funds an earlier one", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "b", 100], [5, "a", "c", 100, 50], [6, "b", "a", 100, 10], [60, "c", 1], [61, 3]], "expected": [null, true, true, true, 100, "transfer1", "transfer2", 101, ["a(100)", "b(100)", "c(0)"]]},
    {"id": "h9", "level": 3, "note": "a transfer the source cannot pay at its due time is skipped and never retried", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "deposit", "deposit", "cancelTransfer", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", 10], [4, "a", "b", 50, 5], [9, "a", 100], [20, "b", 1], [21, "a", "transfer1"], [22, 2]], "expected": [null, true, true, 10, "transfer1", 110, 1, false, ["a(0)", "b(0)"]]},
    {"id": "h10", "level": 3, "note": "only the source cancels, once, and only while the transfer is pending", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "scheduleTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "cancelTransfer", "deposit", "deposit"], "args": [[], [1, "a"], [2, "b"], [3, "a", 100], [4, "a", "b", 30, 10], [5, "a", "b", 20, 10], [6, "b", "transfer1"], [7, "a", "transfer9"], [8, "zz", "transfer1"], [9, "a", "transfer1"], [10, "a", "transfer1"], [15, "a", "transfer2"], [16, "b", 1], [17, "a", 1]], "expected": [null, true, true, 100, "transfer1", "transfer2", false, false, false, true, false, false, 21, 81]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "mergeAccounts", "deposit", "deposit", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "topSpenders"], "args": [[], [1, "main"], [2, "side"], [3, "shop"], [4, "main", 100], [5, "side", 40], [6, "side", "shop", 30, 10], [7, "main", "side"], [8, "side", 1], [20, "shop", 1], [21, "main", 6], [22, "main", 7], [23, "main", 16], [24, "side", 6], [25, "side", 7], [26, 3]], "expected": [null, true, true, true, 100, 40, "transfer1", true, -1, 31, 100, 140, 110, 40, -1, ["main(30)", "shop(0)"]]},
    {"id": "h11", "level": 4, "note": "history records a scheduled transfer at its due time, not at the call that ran it", "ops": ["Bank", "createAccount", "createAccount", "deposit", "scheduleTransfer", "deposit", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [1, "a"], [2, "b"], [3, "a", 100], [4, "a", "b", 40, 6], [50, "b", 1], [51, "a", 9], [52, "a", 10], [53, "b", 10], [54, "b", 49], [55, "b", 50]], "expected": [null, true, true, 100, "transfer1", 41, 100, 60, 40, 40, 41]},
    {"id": "h12", "level": 4, "note": "a merge hands pending transfers to the kept account as source and as target", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "scheduleTransfer", "scheduleTransfer", "mergeAccounts", "cancelTransfer", "cancelTransfer", "deposit", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "b", 100], [5, "c", 100], [6, "b", "c", 10, 100], [7, "c", "b", 20, 100], [8, "b", "c", 30, 100], [9, "a", "b"], [10, "b", "transfer3"], [11, "a", "transfer3"], [200, "a", 1], [201, "c", 1], [202, 3]], "expected": [null, true, true, true, 100, 100, "transfer1", "transfer2", "transfer3", true, false, true, 111, 91, ["c(20)", "a(10)"]]},
    {"id": "h13", "level": 4, "note": "a pending transfer between two merged accounts becomes a self-transfer and is skipped", "ops": ["Bank", "createAccount", "createAccount", "deposit", "deposit", "scheduleTransfer", "scheduleTransfer", "mergeAccounts", "deposit", "topSpenders", "cancelTransfer", "getBalance"], "args": [[], [1, "a"], [2, "b"], [3, "a", 50], [4, "b", 50], [5, "a", "b", 20, 10], [6, "b", "a", 30, 10], [7, "a", "b"], [20, "a", 1], [21, 1], [22, "a", "transfer1"], [23, "a", 16]], "expected": [null, true, true, 50, 50, "transfer1", "transfer2", true, 101, ["a(0)"], false, 100]},
    {"id": "h14", "level": 4, "note": "invalid merges change nothing; a merged-away id is never created again", "ops": ["Bank", "createAccount", "createAccount", "mergeAccounts", "mergeAccounts", "mergeAccounts", "mergeAccounts", "createAccount", "deposit", "mergeAccounts", "deposit", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "a", "a"], [4, "a", "zz"], [5, "zz", "a"], [6, "b", "a"], [7, "a"], [8, "a", 5], [9, "a", "b"], [10, "b", 3], [11, 5]], "expected": [null, true, true, false, false, false, true, false, -1, false, 3, ["b(0)"]]},
    {"id": "h15", "level": 4, "note": "getBalance is -1 before creation and from the merge on, and answers for times before the merge", "ops": ["Bank", "createAccount", "createAccount", "deposit", "deposit", "mergeAccounts", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance", "getBalance"], "args": [[], [10, "a"], [20, "b"], [30, "a", 5], [40, "b", 7], [50, "a", "b"], [60, "a", 9], [61, "a", 10], [62, "a", 49], [63, "a", 50], [64, "b", 19], [65, "b", 49], [66, "b", 50], [67, "b", 66], [68, "nobody", 1]], "expected": [null, true, true, 5, 7, true, -1, 0, 5, 12, -1, 7, -1, -1, -1]},
    {"id": "h16", "level": 4, "note": "chained merges: a transfer scheduled by c runs from a after c into b and b into a", "ops": ["Bank", "createAccount", "createAccount", "createAccount", "createAccount", "deposit", "scheduleTransfer", "transfer", "mergeAccounts", "mergeAccounts", "topSpenders", "cancelTransfer", "deposit", "getBalance", "getBalance", "topSpenders"], "args": [[], [1, "a"], [2, "b"], [3, "c"], [4, "d"], [5, "c", 300], [6, "c", "d", 100, 1000], [7, "c", "a", 50], [8, "b", "c"], [9, "a", "b"], [10, 4], [11, "b", "transfer1"], [2000, "d", 1], [2001, "a", 1005], [2002, "a", 1006], [2003, 2]], "expected": [null, true, true, true, true, 300, "transfer1", 250, true, true, ["a(50)", "d(0)"], false, 101, 300, 200, ["a(150)", "d(0)"]]}
  ]
}
