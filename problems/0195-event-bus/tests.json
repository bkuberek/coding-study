{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["EventBus", "subscribe", "subscribe", "subscribe", "publish", "publish", "publish", "poll", "poll", "poll", "pending"], "args": [[], ["audit", "orders.*"], ["mailer", "orders.#"], ["ledger", "payments.created"], ["orders.created", "1"], ["orders.eu.created", "2"], ["orders", "3"], ["audit", 10], ["mailer", 2], ["mailer", 10], ["ledger"]], "expected": [null, true, true, true, 2, 1, 1, ["orders.created:1"], ["orders.created:1", "orders.eu.created:2"], ["orders:3"], 0]},
    {"id": "ex2", "visible": true, "ops": ["EventBus", "subscribe", "setInboxLimit", "publish", "publish", "publish", "unsubscribe", "publish", "deadLetters", "poll"], "args": [[], ["slow", "#"], ["slow", 1], ["x", "1"], ["y", "2"], ["z", "3"], ["slow", "#"], ["w", "4"], [10], ["slow", 5]], "expected": [null, true, true, 1, 0, 0, true, 0, ["slow:y:2", "slow:z:3", "-:w:4"], ["x:1"]]},
    {"id": "h1", "note": "duplicates and unknown subscribers are rejected", "ops": ["EventBus", "subscribe", "subscribe", "unsubscribe", "unsubscribe", "poll", "pending", "setInboxLimit", "subscribe", "pending"], "args": [[], ["a", "t"], ["a", "t"], ["a", "u"], ["b", "t"], ["b", 3], ["b"], ["b", 1], ["b", "t"], ["b"]], "expected": [null, true, false, false, false, [], -1, false, true, 0]},
    {"id": "h2", "note": "a subscriber whose patterns overlap receives an event once", "ops": ["EventBus", "subscribe", "subscribe", "subscribe", "publish", "pending", "poll"], "args": [[], ["a", "shop.*"], ["a", "shop.#"], ["a", "#"], ["shop.cart", "9"], ["a"], ["a", 5]], "expected": [null, true, true, true, 1, 1, ["shop.cart:9"]]},
    {"id": "h3", "note": "# may sit in the middle and match nothing; * needs exactly one segment", "ops": ["EventBus", "subscribe", "subscribe", "publish", "publish", "publish", "publish", "publish", "poll", "poll", "deadLetters"], "args": [[], ["mid", "a.#.z"], ["two", "*.*"], ["a.z", "1"], ["a.b.z", "2"], ["a.b.c.z", "3"], ["a.b", "4"], ["a", "5"], ["mid", 10], ["two", 10], [10]], "expected": [null, true, true, 2, 1, 1, 1, 0, ["a.z:1", "a.b.z:2", "a.b.c.z:3"], ["a.z:1", "a.b:4"], ["-:a:5"]]},
    {"id": "h4", "note": "unsubscribing one pattern keeps the others", "ops": ["EventBus", "subscribe", "subscribe", "unsubscribe", "publish", "publish", "poll", "unsubscribe"], "args": [[], ["s", "a.*"], ["s", "b.*"], ["s", "a.*"], ["a.x", "1"], ["b.x", "2"], ["s", 10], ["s", "a.*"]], "expected": [null, true, true, true, 0, 1, ["b.x:2"], false]},
    {"id": "h5", "note": "poll returns the oldest events first and at most the requested number", "ops": ["EventBus", "subscribe", "publish", "publish", "publish", "poll", "poll", "pending", "poll", "poll"], "args": [[], ["s", "t"], ["t", "1"], ["t", "2"], ["t", "3"], ["s", 0], ["s", 2], ["s"], ["s", 2], ["s", 2]], "expected": [null, true, 1, 1, 1, [], ["t:1", "t:2"], 1, ["t:3"], []]},
    {"id": "h6", "note": "dead letters drain oldest first", "ops": ["EventBus", "publish", "publish", "publish", "deadLetters", "deadLetters", "deadLetters"], "args": [[], ["a", "1"], ["b", "2"], ["c", "3"], [2], [2], [2]], "expected": [null, 0, 0, 0, ["-:a:1", "-:b:2"], ["-:c:3"], []]},
    {"id": "h7", "note": "within one publish, subscribers are served in ascending id order", "ops": ["EventBus", "subscribe", "subscribe", "subscribe", "setInboxLimit", "setInboxLimit", "publish", "deadLetters", "pending"], "args": [[], ["zed", "t"], ["amy", "t"], ["kim", "t"], ["zed", 0], ["amy", 0], ["t", "1"], [5], ["kim"]], "expected": [null, true, true, true, true, true, 1, ["amy:t:1", "zed:t:1"], 1]},
    {"id": "h8", "note": "a limit applies to later deliveries only; raising it lets events in again", "ops": ["EventBus", "subscribe", "publish", "publish", "setInboxLimit", "publish", "pending", "setInboxLimit", "publish", "poll", "deadLetters"], "args": [[], ["s", "t"], ["t", "1"], ["t", "2"], ["s", 1], ["t", "3"], ["s"], ["s", 3], ["t", "4"], ["s", 10], [10]], "expected": [null, true, 1, 1, true, 0, 2, true, 1, ["t:1", "t:2", "t:4"], ["s:t:3"]]},
    {"id": "h9", "note": "topics compare segment by segment and case-sensitively", "ops": ["EventBus", "subscribe", "subscribe", "publish", "publish", "publish", "poll", "pending"], "args": [[], ["s", "Orders.created"], ["all", "#"], ["orders.created", "1"], ["Orders.created", "2"], ["Orders.created.x", "3"], ["s", 5], ["all"]], "expected": [null, true, true, 1, 2, 1, ["Orders.created:2"], 3]},
    {"id": "h10", "note": "polling frees room in a bounded inbox", "ops": ["EventBus", "subscribe", "setInboxLimit", "publish", "publish", "publish", "poll", "publish", "poll", "deadLetters"], "args": [[], ["s", "q"], ["s", 2], ["q", "1"], ["q", "2"], ["q", "3"], ["s", 1], ["q", "4"], ["s", 5], [5]], "expected": [null, true, true, 1, 1, 0, ["q:1"], 1, ["q:2", "q:4"], ["s:q:3"]]}
  ]
}
