{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["ChatHistory", "append", "append", "append", "append", "getConversation", "getConversation", "getConversation"], "args": [[], [1, "u1", "c1", "hello there"], [2, "u1", "c1", "how do i bake bread"], [3, "u1", "c2", "plan a trip to rome"], [4, "u2", "c1", "a chat of another user"], [5, "u1", "c1"], [6, "u2", "c1"], [7, "u1", "c9"]], "expected": [null, 1, 2, 1, 1, ["hello there", "how do i bake bread"], ["a chat of another user"], []]},
    {"id": "h1", "level": 1, "note": "an empty history: conversations read as empty lists", "ops": ["ChatHistory", "getConversation", "append", "getConversation", "getConversation"], "args": [[], [1, "u", "c"], [2, "u", "c", "first words"], [3, "v", "c"], [4, "u", "c"]], "expected": [null, [], 1, [], ["first words"]]},
    {"id": "h2", "level": 1, "note": "each conversation numbers its own messages; equal texts are separate messages", "ops": ["ChatHistory", "append", "append", "append", "append", "getConversation", "getConversation"], "args": [[], [1, "u", "a", "same text"], [1, "u", "b", "other text"], [2, "u", "a", "more text"], [3, "u", "a", "same text"], [4, "u", "a"], [5, "u", "b"]], "expected": [null, 1, 1, 2, 3, ["same text", "more text", "same text"], ["other text"]]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["ChatHistory", "append", "append", "append", "append", "append", "search", "search", "search", "search"], "args": [[], [1, "u1", "trip", "flights to rome are cheap"], [2, "u1", "trip", "book a hotel in rome"], [3, "u1", "food", "best pasta in rome"], [4, "u1", "food", "how to cook pasta"], [5, "u1", "work", "quarterly report draft"], [6, "u1", "rome pasta"], [7, "u1", "hotel"], [8, "u1", "budget"], [9, "u2", "rome"]], "expected": [null, 1, 2, 1, 2, 1, ["food", "trip"], ["trip"], [], []]},
    {"id": "h3", "level": 2, "note": "the match count counts messages, not word hits: one message matching every term counts once", "ops": ["ChatHistory", "append", "append", "append", "search", "search"], "args": [[], [1, "u", "b", "red bike"], [2, "u", "b", "fast car"], [3, "u", "a", "red car red car"], [4, "u", "red car"], [5, "u", "red"]], "expected": [null, 1, 2, 1, ["b", "a"], ["a", "b"]]},
    {"id": "h4", "level": 2, "note": "recency is the latest matching message, not the latest message; equal times go by id in string order", "ops": ["ChatHistory", "append", "append", "append", "search", "append", "append", "search"], "args": [[], [1, "u", "x", "tea notes"], [2, "u", "y", "tea leaves"], [3, "u", "x", "unrelated chatter"], [4, "u", "tea"], [5, "u", "b2", "tea cup"], [5, "u", "b10", "tea pot"], [6, "u", "tea"]], "expected": [null, 1, 1, 2, ["y", "x"], 1, 1, ["b10", "b2", "y", "x"]]},
    {"id": "h5", "level": 2, "note": "terms match whole words of the user's own chats; a repeated query word is one term", "ops": ["ChatHistory", "append", "append", "search", "search", "search"], "args": [[], [1, "u", "a", "category theory"], [2, "v", "b", "cat videos"], [3, "u", "cat"], [4, "v", "cat cat"], [5, "v", "theory"]], "expected": [null, 1, 1, [], ["b"], []]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["ChatHistory", "append", "append", "append", "deleteMessage", "deleteMessage", "getConversation", "append", "search", "deleteConversation", "deleteConversation", "search", "append"], "args": [[], [1, "u1", "c1", "first note"], [2, "u1", "c1", "second note"], [3, "u1", "c1", "third note"], [4, "u1", "c1", 2], [5, "u1", "c1", 2], [6, "u1", "c1"], [7, "u1", "c1", "fourth note"], [8, "u1", "note"], [9, "u1", "c1"], [10, "u1", "c1"], [11, "u1", "note"], [12, "u1", "c1", "again"]], "expected": [null, 1, 2, 3, true, false, ["first note", "third note"], 4, ["c1"], true, false, [], -1]},
    {"id": "h6", "level": 3, "note": "numbers never shift after a deletion and are never reused", "ops": ["ChatHistory", "append", "append", "append", "append", "deleteMessage", "deleteMessage", "getConversation", "deleteMessage", "deleteMessage", "deleteMessage", "deleteMessage", "append", "getConversation"], "args": [[], [1, "u", "c", "one"], [2, "u", "c", "two"], [3, "u", "c", "three"], [4, "u", "c", "four"], [5, "u", "c", 1], [6, "u", "c", 4], [7, "u", "c"], [8, "u", "c", 5], [9, "u", "c", 0], [10, "u", "missing", 1], [11, "v", "c", 2], [12, "u", "c", "five"], [13, "u", "c"]], "expected": [null, 1, 2, 3, 4, true, true, ["two", "three"], false, false, false, false, 5, ["two", "three", "five"]]},
    {"id": "h7", "level": 3, "note": "deleted messages leave the match count and the recency; a chat with no live match leaves search", "ops": ["ChatHistory", "append", "append", "append", "append", "search", "deleteMessage", "search", "deleteMessage", "search", "getConversation", "search"], "args": [[], [1, "u", "a", "blue sky"], [2, "u", "a", "blue sea"], [3, "u", "b", "blue moon"], [4, "u", "b", "red sun"], [5, "u", "blue"], [6, "u", "a", 1], [7, "u", "blue"], [8, "u", "b", 1], [9, "u", "blue"], [10, "u", "b"], [11, "u", "sun"]], "expected": [null, 1, 2, 1, 2, ["a", "b"], true, ["b", "a"], true, ["a"], ["red sun"], ["b"]]},
    {"id": "h8", "level": 3, "note": "a deleted chat stays deleted; a chat whose messages were all deleted still takes new ones", "ops": ["ChatHistory", "append", "append", "deleteMessage", "getConversation", "append", "deleteConversation", "deleteMessage", "getConversation", "append", "deleteConversation", "deleteConversation", "getConversation", "append"], "args": [[], [1, "u", "a", "x one"], [2, "u", "b", "y one"], [3, "u", "b", 1], [4, "u", "b"], [5, "u", "b", "y two"], [6, "u", "a"], [7, "u", "a", 1], [8, "u", "a"], [9, "u", "a", "x two"], [10, "u", "zz"], [11, "v", "b"], [12, "u", "b"], [13, "v", "a", "x for v"]], "expected": [null, 1, 1, true, [], 2, true, false, [], -1, false, false, ["y two"], 1]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["ChatHistory", "append", "append", "append", "moveToProject", "moveToProject", "searchProject", "search", "moveToProject", "searchProject"], "args": [[], [1, "u1", "c1", "draft the launch email"], [2, "u1", "c2", "launch checklist review"], [3, "u1", "c3", "weekend hiking plans"], [4, "u1", "c1", "launch"], [5, "u1", "c2", "launch"], [6, "u1", "launch", "launch"], [7, "u1", "launch hiking"], [8, "u1", "c9", "launch"], [9, "u1", "travel", "hiking"]], "expected": [null, 1, 1, 1, true, true, ["c2", "c1"], ["c3"], false, []]},
    {"id": "h9", "level": 4, "note": "moving again leaves the old project; a deleted chat cannot move; projects belong to their user", "ops": ["ChatHistory", "append", "append", "moveToProject", "moveToProject", "searchProject", "searchProject", "search", "deleteConversation", "moveToProject", "search", "searchProject", "deleteConversation", "searchProject"], "args": [[], [1, "u", "a", "alpha task"], [2, "u", "b", "alpha bug"], [3, "u", "a", "p1"], [4, "u", "a", "p2"], [5, "u", "p1", "alpha"], [6, "u", "p2", "alpha"], [7, "u", "alpha"], [8, "u", "b"], [9, "u", "b", "p1"], [10, "u", "alpha"], [11, "v", "p2", "alpha"], [12, "u", "a"], [13, "u", "p2", "alpha"]], "expected": [null, 1, 1, true, true, [], ["a"], ["b"], true, false, [], [], true, []]},
    {"id": "h10", "level": 4, "note": "chats keep growing inside a project, and deleted messages leave the project search", "ops": ["ChatHistory", "append", "append", "moveToProject", "moveToProject", "searchProject", "append", "searchProject", "deleteMessage", "deleteMessage", "searchProject", "getConversation", "search"], "args": [[], [1, "u", "a", "db index"], [1, "u", "b", "db index"], [2, "u", "a", "p"], [2, "u", "b", "p"], [3, "u", "p", "index"], [4, "u", "b", "index again"], [5, "u", "p", "index"], [6, "u", "b", 1], [6, "u", "b", 2], [7, "u", "p", "index"], [8, "u", "b"], [9, "u", "index"]], "expected": [null, 1, 1, true, true, ["a", "b"], 2, ["b", "a"], true, true, ["a"], [], []]},
    {"id": "h11", "level": 4, "note": "a global search skips project chats even when they would rank first, and still ranks the rest", "ops": ["ChatHistory", "append", "append", "append", "append", "search", "moveToProject", "search", "searchProject", "moveToProject", "searchProject"], "args": [[], [1, "u", "a", "cloud cost cloud"], [2, "u", "a", "cloud bill"], [3, "u", "b", "cloud"], [4, "u", "c", "cost"], [5, "u", "cloud cost"], [6, "u", "a", "ops"], [7, "u", "cloud cost"], [8, "u", "ops", "cloud cost"], [9, "u", "a", "ops"], [10, "u", "ops", "bill"]], "expected": [null, 1, 2, 1, 1, ["a", "c", "b"], true, ["c", "b"], ["a"], true, ["a"]]}
  ]
}
