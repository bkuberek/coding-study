{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"s": "123"}, "expected": 3},
    {"id": "ex2", "visible": true, "input": {"s": "1020"}, "expected": 1},
    {"id": "ex3", "visible": true, "input": {"s": "301"}, "expected": 0},
    {"id": "h1", "input": {"s": "0"}, "expected": 0, "note": "a lone zero"},
    {"id": "h2", "input": {"s": "7"}, "expected": 1, "note": "a single digit"},
    {"id": "h3", "input": {"s": "10"}, "expected": 1, "note": "10 is a letter, 1 then 0 is not"},
    {"id": "h4", "input": {"s": "27"}, "expected": 1, "note": "27 is above 26: only 2, 7"},
    {"id": "h5", "input": {"s": "26"}, "expected": 2, "note": "26 is the largest letter"},
    {"id": "h6", "input": {"s": "100"}, "expected": 0, "note": "the second zero has nothing to pair with"},
    {"id": "h7", "input": {"s": "1111111111"}, "expected": 89, "note": "ten ones: a Fibonacci number of readings"},
    {"id": "h8", "input": {"s": "111111111111111111111111111111111111111111111"}, "expected": 1836311903, "note": "45 ones: 1836311903 readings, close to the 32-bit limit"},
    {"id": "h9", "input": {"s": "06"}, "expected": 0, "note": "leading zero"},
    {"id": "h10", "input": {"s": "2101"}, "expected": 1, "note": "2, 10, 1 only: 01 is not a letter"},
    {"id": "h11", "input": {"s": "999999"}, "expected": 1, "note": "no digit pairs with its neighbor"},
    {"id": "h12", "input": {"s": ""}, "expected": 1, "note": "maximum length, no two adjacent digits form a letter"},
    {"id": "h13", "input": {"s": ""}, "expected": 1, "note": "maximum length, every zero forces a pair"},
    {"id": "h14", "input": {"s": "1201234"}, "expected": 3},
    {"id": "h15", "input": {"s": "111111111111111111111111111111111111111111110"}, "expected": 701408733, "note": "the final zero must pair with the last 1"},
    {"id": "g1", "generate": {"n": 2000, "seed": 1}, "note": "longest string"},
    {"id": "g2", "generate": {"n": 2000, "seed": 4}},
    {"id": "g3", "generate": {"n": 1000, "seed": 6}}
  ]
}
