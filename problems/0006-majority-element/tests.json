{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [3, 8, 3, 3, 1]}, "expected": 3},
    {"id": "ex2", "visible": true, "input": {"nums": [-4, 6, 6, -4, 6, 6]}, "expected": 6},
    {"id": "h1", "input": {"nums": [42]}, "expected": 42, "note": "a single element is the majority"},
    {"id": "h2", "input": {"nums": [-7, -7]}, "expected": -7, "note": "two equal elements"},
    {"id": "h3", "input": {"nums": [1, 2, 1]}, "expected": 1, "note": "smallest array with another value"},
    {"id": "h4", "input": {"nums": [0, 5, 0, 5, 0]}, "expected": 0, "note": "alternating values, zero wins"},
    {"id": "h5", "input": {"nums": [3, 3, 3, 3]}, "expected": 3, "note": "all values equal"},
    {"id": "h6", "input": {"nums": [9, 9, 9, 1, 2]}, "expected": 9, "note": "majority block at the front"},
    {"id": "h7", "input": {"nums": [1, 2, 9, 9, 9]}, "expected": 9, "note": "majority block at the end"},
    {"id": "h8", "input": {"nums": [-1000000000, 1000000000, -1000000000]}, "expected": -1000000000, "note": "extreme values"},
    {"id": "h9", "input": {"nums": [4, 4, 5, 5, 5, 6, 5]}, "expected": 5, "note": "exactly n/2 + 1 occurrences in an odd-length array"},
    {"id": "h10", "input": {"nums": [2, 8, 2, 8, 8, 2, 2]}, "expected": 2, "note": "the vote candidate changes several times"},
    {"id": "h11", "input": {"nums": [6, 1, 6, 2, 6, 3, 6, 4, 6]}, "expected": 6, "note": "majority at every even position, other values distinct"},
    {"id": "h12", "input": {"nums": [7, 7, 5, 5, 5, 5, 7, 7, 7]}, "expected": 7, "note": "a strong runner-up with four copies"},
    {"id": "h13", "input": {"nums": [1, 2, 3, 4, 8, 8, 8, 8, 8]}, "expected": 8, "note": "distinct minority values first, sorted ascending"},
    {"id": "g1", "generate": {"n": 30000, "seed": 5}, "hang_guard_ms": 30000, "note": "large input: counting every candidate compares 10^8 or more pairs here"},
    {"id": "g2", "generate": {"n": 3000, "seed": 13}}
  ]
}
