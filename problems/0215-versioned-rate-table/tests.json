    {"id": "h2", "ops": ["RateTable", "publish", "rateAsOf", "rateAsOf", "rateAsOf", "versionAsOf", "versionAsOf"], "args": [[], ["2026-01-01", ["5403"], ["12.50"]], ["2025-12-31", "5403"], ["2026-01-01", "5403"], ["2026-01-02", "5403"], ["2025-12-31"], ["2026-01-01"]], "expected": [null, null, "-1", "12.5", "12.5", -1, 1], "note": "the day before, on, and after an effective date"},
    {"id": "h3", "ops": ["RateTable", "publish", "publish", "publish", "rateAsOf", "versionAsOf", "rateAsOf"], "args": [[], ["2026-03-01", ["5645"], ["18.00"]], ["2026-03-01", ["5645"], ["17.40"]], ["2026-03-01", ["5645"], ["17.45"]], ["2026-03-01", "5645"], ["2026-03-01"], ["2026-02-28", "5645"]], "expected": [null, null, null, null, "17.45", 3, "-1"], "note": "three publishes on one date: the last one published governs"},
