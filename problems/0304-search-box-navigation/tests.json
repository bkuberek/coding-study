{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["SearchBox", "resultsArrived", "highlightedText", "keydown", "keyup", "highlighted", "highlightedText", "keydown", "highlightedText", "keydown", "highlighted", "highlightedText"], "args": [[[]], [1, ["apple", "banana", "cherry"]], [2], [3, "ArrowDown"], [4, "ArrowDown"], [5], [6], [7, "ArrowDown"], [8], [9, "ArrowDown"], [10], [11]], "expected": [null, null, "apple", null, null, 1, "banana", null, "cherry", null, 0, "apple"]},
    {"id": "h1", "level": 1, "note": "ArrowUp from the first result wraps to the last; -1 % n is -1 in most languages", "ops": ["SearchBox", "resultsArrived", "keydown", "highlighted", "highlightedText", "keydown", "highlighted", "keydown", "keydown", "highlighted", "highlightedText"], "args": [[[]], [1, ["a1", "a2", "a3", "a4"]], [2, "ArrowUp"], [3], [4], [5, "ArrowUp"], [6], [7, "ArrowDown"], [8, "ArrowDown"], [9], [10]], "expected": [null, null, null, 3, "a4", null, 2, null, null, 0, "a1"]},
    {"id": "h2", "level": 1, "note": "keyup never moves the highlight, not even keyup of ArrowUp; a held key repeats keydown", "ops": ["SearchBox", "resultsArrived", "keyup", "highlighted", "keyup", "highlighted", "keydown", "keydown", "keydown", "keyup", "highlighted", "highlightedText", "keydown", "keyup", "highlighted"], "args": [[[]], [1, ["r0", "r1", "r2", "r3", "r4"]], [2, "ArrowUp"], [3], [4, "ArrowDown"], [5], [6, "ArrowDown"], [7, "ArrowDown"], [8, "ArrowDown"], [9, "ArrowDown"], [10], [11], [12, "ArrowUp"], [13, "ArrowUp"], [14]], "expected": [null, null, null, 0, null, 0, null, null, null, null, 3, "r3", null, null, 2]},
    {"id": "h3", "level": 1, "note": "only ArrowDown and ArrowUp move: PageDown, ArrowRight, Down, Tab and letters do not", "ops": ["SearchBox", "resultsArrived", "keydown", "keydown", "keydown", "keydown", "keydown", "keydown", "highlighted", "keydown", "keydown", "keydown", "keydown", "highlighted", "highlightedText"], "args": [[[]], [1, ["x", "y", "z"]], [2, "ArrowRight"], [3, "PageDown"], [4, "Down"], [5, "Tab"], [6, "j"], [7, "arrowdown"], [8], [9, "ArrowLeft"], [10, "PageUp"], [11, "Up"], [12, "k"], [13], [14]], "expected": [null, null, null, null, null, null, null, null, 0, null, null, null, null, 0, "x"]},
    {"id": "h4", "level": 1, "note": "an empty list has no highlight and the arrow keys do nothing; new results reset the highlight", "ops": ["SearchBox", "highlighted", "highlightedText", "results", "keydown", "keydown", "highlighted", "resultsArrived", "keydown", "highlighted", "resultsArrived", "highlighted", "highlightedText", "keydown", "highlightedText", "resultsArrived", "highlighted", "highlightedText", "results", "keydown", "highlighted"], "args": [[[]], [1], [2], [3], [4, "ArrowDown"], [5, "ArrowUp"], [6], [7, ["p", "q"]], [8, "ArrowDown"], [9], [10, ["s", "t", "u"]], [11], [12], [13, "ArrowUp"], [14], [15, []], [16], [17], [18], [19, "ArrowDown"], [20]], "expected": [null, -1, "", [], null, null, -1, null, null, 1, null, 0, "s", null, "u", null, -1, "", [], null, -1]},
    {"id": "h5", "level": 1, "note": "one result wraps onto itself; two results wrap at both ends", "ops": ["SearchBox", "resultsArrived", "keydown", "highlighted", "highlightedText", "keydown", "highlighted", "resultsArrived", "keydown", "highlighted", "keydown", "highlighted", "keydown", "highlighted", "highlightedText", "results"], "args": [[[]], [1, ["solo"]], [2, "ArrowDown"], [3], [4], [5, "ArrowUp"], [6], [7, ["left", "right"]], [8, "ArrowDown"], [9], [10, "ArrowDown"], [11], [12, "ArrowUp"], [13], [14], [15]], "expected": [null, null, null, 0, "solo", null, 0, null, null, 1, null, 0, null, 1, "right", ["left", "right"]]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["SearchBox", "search", "results", "highlightedText", "keydown", "highlightedText", "search", "results", "highlightedText", "search", "results", "highlighted"], "args": [[["Lima", "Berlin", "Lisbon", "Dublin", "Milan", "Islamabad"]], [1, "li"], [2], [3], [4, "ArrowDown"], [5], [6, " LIN "], [7], [8], [9, ""], [10], [11]], "expected": [null, null, ["Lima", "Berlin", "Lisbon", "Dublin"], "Lima", null, "Berlin", null, ["Berlin", "Dublin"], "Berlin", null, [], -1]},
    {"id": "h6", "level": 2, "note": "the query is plain text: a regular expression fails on c++, .js, (fast), *, ? and a*", "ops": ["SearchBox", "search", "results", "search", "results", "search", "results", "search", "results", "search", "results", "search", "results", "highlightedText"], "args": [[["C++ Primer", "C Programming", "Node.js Basics", "Nodejs Tips", "Learn (Fast)", "Fast Track", "A*Star Search", "Kotlin?", "Rust"]], [1, "c++"], [2], [3, ".js"], [4], [5, "(fast)"], [6], [7, "*"], [8], [9, "?"], [10], [11, "a*"], [12], [13]], "expected": [null, null, ["C++ Primer"], null, ["Node.js Basics"], null, ["Learn (Fast)"], null, ["A*Star Search"], null, ["Kotlin?"], null, ["A*Star Search"], "A*Star Search"]},
    {"id": "h7", "level": 2, "note": "case is ignored both ways, every match shows in the order of names, inner spaces count", "ops": ["SearchBox", "search", "results", "keydown", "highlightedText", "search", "results", "search", "results", "search", "highlightedText"], "args": [[["Ana Lima", "Juliana Costa", "ANAHI", "Bo", "Diana", "Mariana Anaya"]], [1, "ANA"], [2], [3, "ArrowUp"], [4], [5, " na co "], [6], [7, "a l"], [8], [9, "bo"], [10]], "expected": [null, null, ["Ana Lima", "Juliana Costa", "ANAHI", "Diana", "Mariana Anaya"], null, "Mariana Anaya", null, ["Juliana Costa"], null, ["Ana Lima"], null, "Bo"]},
    {"id": "h8", "level": 2, "note": "every name contains the empty string, so a blank query must show nothing", "ops": ["SearchBox", "search", "search", "results", "highlighted", "highlightedText", "keydown", "highlighted", "search", "results"], "args": [[["Ana Lima", "Juliana Costa", "ANAHI", "Bo", "Diana", "Mariana Anaya"]], [1, "ana"], [2, "   "], [3], [4], [5], [6, "ArrowDown"], [7], [8, ""], [9]], "expected": [null, null, null, [], -1, "", null, -1, null, []]},
    {"id": "h9", "level": 2, "note": "search replaces any list and resets the highlight; no match empties it", "ops": ["SearchBox", "resultsArrived", "keydown", "highlighted", "search", "highlighted", "keydown", "keydown", "highlightedText", "search", "results", "highlighted", "search", "results", "highlighted", "keydown", "highlighted", "resultsArrived", "highlightedText"], "args": [[["Oslo", "Osaka", "Ostrava"]], [1, ["one", "two"]], [2, "ArrowDown"], [3], [4, "os"], [5], [6, "ArrowDown"], [7, "ArrowDown"], [8], [9, "osa"], [10], [11], [12, "zz"], [13], [14], [15, "ArrowUp"], [16], [17, ["back"]], [18]], "expected": [null, null, null, 1, null, 0, null, null, "Ostrava", null, ["Osaka"], 0, null, [], -1, null, -1, null, "back"]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["SearchBox", "inputChanged", "inputChanged", "responseArrived", "results", "highlightedText", "responseArrived", "results", "inputText"], "args": [[[]], [1, "pa"], [2, "par"], [3, 2, ["Paris", "Parma"]], [4], [5], [6, 1, ["Panama", "Paris", "Parma"]], [7], [8]], "expected": [null, 1, 2, null, ["Paris", "Parma"], "Paris", null, ["Paris", "Parma"], "par"]},
    {"id": "h10", "level": 3, "note": "a response older than the latest request is stale even when nothing newer has arrived yet", "ops": ["SearchBox", "inputText", "inputChanged", "responseArrived", "results", "inputChanged", "inputChanged", "responseArrived", "results", "responseArrived", "results", "highlighted"], "args": [[[]], [1], [2, "b"], [3, 1, ["Bari", "Bern", "Bonn"]], [4], [5, "be"], [6, "ber"], [7, 2, ["Bern", "Berlin", "Bergamo"]], [8], [9, 3, ["Bern", "Berlin"]], [10], [11]], "expected": [null, "", 1, null, ["Bari", "Bern", "Bonn"], 2, 3, null, ["Bari", "Bern", "Bonn"], null, ["Bern", "Berlin"], 0]},
    {"id": "h11", "level": 3, "note": "clearing the input makes every pending request stale; spaces alone clear it", "ops": ["SearchBox", "inputChanged", "responseArrived", "keydown", "inputChanged", "results", "highlightedText", "inputChanged", "results", "highlighted", "inputText", "responseArrived", "results", "highlighted", "highlightedText"], "args": [[[]], [1, "lo"], [2, 1, ["Lodz", "London", "Lome"]], [3, "ArrowDown"], [4, "lon"], [5], [6], [7, "  "], [8], [9], [10], [11, 2, ["London"]], [12], [13], [14]], "expected": [null, 1, null, null, 2, ["Lodz", "London", "Lome"], "London", -1, [], -1, "  ", null, [], -1, ""]},
    {"id": "h12", "level": 3, "note": "the latest response resets the highlight; an empty one empties the list; a clear takes no id", "ops": ["SearchBox", "inputChanged", "responseArrived", "keydown", "highlightedText", "inputChanged", "highlightedText", "responseArrived", "highlighted", "highlightedText", "inputChanged", "inputChanged", "responseArrived", "results", "highlighted", "keydown", "highlighted", "inputText"], "args": [[[]], [1, "ma"], [2, 1, ["Madrid", "Malaga", "Manila"]], [3, "ArrowUp"], [4], [5, "mad"], [6], [7, 2, ["Madrid"]], [8], [9], [10, ""], [11, "mx"], [12, 3, []], [13], [14], [15, "ArrowDown"], [16], [17]], "expected": [null, 1, null, null, "Manila", 2, "Manila", null, 0, "Madrid", -1, 3, null, [], -1, null, -1, "mx"]},
    {"id": "h13", "level": 3, "note": "responses arriving in reverse order: only the latest request counts", "ops": ["SearchBox", "inputChanged", "inputChanged", "inputChanged", "responseArrived", "responseArrived", "responseArrived", "results", "keydown", "highlightedText", "search", "results", "inputText"], "args": [[["Sanaa", "Santos"]], [1, "s"], [2, "sa"], [3, "san"], [4, 3, ["San Jose", "Santiago"]], [5, 1, ["Seoul", "San Jose", "Santiago"]], [6, 2, ["Salvador"]], [7], [8, "ArrowDown"], [9], [10, "san"], [11], [12]], "expected": [null, 1, 2, 3, null, null, null, ["San Jose", "Santiago"], null, "Santiago", null, ["Sanaa", "Santos"], "san"]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["SearchBox", "inputChanged", "responseArrived", "keydown", "keydown", "keyup", "inputText", "results", "highlighted", "selections"], "args": [[[]], [1, "ro"], [2, 1, ["Rome", "Rotterdam", "Rosario"]], [3, "ArrowDown"], [4, "Enter"], [5, "Enter"], [6], [7], [8], [9]], "expected": [null, 1, null, null, null, null, "Rotterdam", [], -1, ["Rotterdam"]]},
    {"id": "h14", "level": 4, "note": "keyup of Enter never selects; a held Enter selects once; Enter on an empty list does nothing", "ops": ["SearchBox", "resultsArrived", "keyup", "selections", "results", "keydown", "keydown", "keyup", "selections", "inputText", "keydown", "keydown", "highlighted", "selections"], "args": [[[]], [1, ["Oslo", "Osaka"]], [2, "Enter"], [3], [4], [5, "Enter"], [6, "Enter"], [7, "Enter"], [8], [9], [10, "Enter"], [11, "ArrowDown"], [12], [13]], "expected": [null, null, null, [], ["Oslo", "Osaka"], null, null, null, ["Oslo"], "Oslo", null, null, -1, ["Oslo"]]},
    {"id": "h15", "level": 4, "note": "a response sent before the selection must not reopen the list", "ops": ["SearchBox", "inputChanged", "responseArrived", "inputChanged", "keydown", "keydown", "responseArrived", "results", "highlighted", "inputText", "keydown", "highlighted", "selections"], "args": [[[]], [1, "gr"], [2, 1, ["Graz", "Granada", "Grenoble"]], [3, "gra"], [4, "ArrowDown"], [5, "Enter"], [6, 2, ["Graz", "Granada"]], [7], [8], [9], [10, "ArrowDown"], [11], [12]], "expected": [null, 1, null, 2, null, null, null, [], -1, "Granada", null, -1, ["Granada"]]},
    {"id": "h16", "level": 4, "note": "typing after a selection starts over, and selections accumulate in order", "ops": ["SearchBox", "inputChanged", "responseArrived", "keydown", "keydown", "inputChanged", "inputText", "responseArrived", "highlightedText", "keydown", "selections", "inputText", "results"], "args": [[[]], [1, "ki"], [2, 1, ["Kigali", "Kingston", "Kinshasa"]], [3, "ArrowUp"], [4, "Enter"], [5, "kin"], [6], [7, 2, ["Kingston", "Kinshasa"]], [8], [9, "Enter"], [10], [11], [12]], "expected": [null, 1, null, null, null, 2, "kin", null, "Kingston", null, ["Kinshasa", "Kingston"], "Kingston", []]},
    {"id": "h17", "level": 4, "note": "Enter selects from a search list too, which makes the pending request stale", "ops": ["SearchBox", "inputChanged", "search", "keydown", "keydown", "inputText", "responseArrived", "results", "inputChanged", "responseArrived", "keydown", "selections", "results"], "args": [[["Accra", "Abuja", "Addis Ababa"]], [1, "ab"], [2, "a"], [3, "ArrowUp"], [4, "Enter"], [5], [6, 1, ["Abuja"]], [7], [8, "ac"], [9, 2, ["Accra"]], [10, "Enter"], [11], [12]], "expected": [null, 1, null, null, null, "Addis Ababa", null, [], 2, null, null, ["Addis Ababa", "Accra"], []]}
  ]
}
