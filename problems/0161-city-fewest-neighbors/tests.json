{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"n": 4, "edges": [[0, 1, 2], [1, 2, 3], [2, 3, 1], [0, 3, 7]], "distanceThreshold": 4}, "expected": 0},
    {"id": "ex2", "visible": true, "input": {"n": 3, "edges": [[0, 1, 5]], "distanceThreshold": 2}, "expected": 2},
    {"id": "h1", "input": {"n": 2, "edges": [[0, 1, 1]], "distanceThreshold": 1}, "expected": 1, "note": "two cities that reach each other: the tie goes to city 1"},
    {"id": "h2", "input": {"n": 2, "edges": [[0, 1, 2]], "distanceThreshold": 1}, "expected": 1, "note": "two cities out of each other's reach"},
    {"id": "h3", "input": {"n": 10, "edges": [[0, 1, 10], [1, 2, 10], [2, 3, 10], [3, 4, 10], [4, 5, 10], [5, 6, 10], [6, 7, 10], [7, 8, 10], [8, 9, 10]], "distanceThreshold": 10}, "expected": 9, "note": "a chain: both ends reach one city, the larger end wins"},
    {"id": "h4", "input": {"n": 10, "edges": [[0, 1, 10], [1, 2, 10], [2, 3, 10], [3, 4, 10], [4, 5, 10], [5, 6, 10], [6, 7, 10], [7, 8, 10], [8, 9, 10]], "distanceThreshold": 25}, "expected": 9, "note": "a chain with a wider threshold"},
    {"id": "h5", "input": {"n": 5, "edges": [[0, 1, 1], [0, 2, 1], [0, 3, 1], [0, 4, 1]], "distanceThreshold": 1}, "expected": 4, "note": "a star: the hub reaches everyone, each leaf only the hub"},
    {"id": "h6", "input": {"n": 5, "edges": [[0, 1, 1], [0, 2, 1], [0, 3, 1], [0, 4, 1]], "distanceThreshold": 2}, "expected": 4, "note": "a star where everyone reaches everyone: all tie"},
    {"id": "h7", "input": {"n": 4, "edges": [[0, 1, 4], [1, 2, 4], [0, 2, 9], [2, 3, 1]], "distanceThreshold": 8}, "expected": 3, "note": "a direct road longer than a two-road route"},
    {"id": "h8", "input": {"n": 6, "edges": [[0, 1, 3], [1, 2, 3], [3, 4, 3]], "distanceThreshold": 3}, "expected": 5, "note": "an isolated city reaches nobody"},
    {"id": "h9", "input": {"n": 5, "edges": [[0, 1, 10000], [1, 2, 10000], [2, 3, 10000], [3, 4, 10000]], "distanceThreshold": 10000}, "expected": 4, "note": "maximum road lengths and threshold"},
    {"id": "h10", "input": {"n": 4, "edges": [[0, 1, 1], [1, 2, 1], [2, 3, 1], [0, 3, 1]], "distanceThreshold": 1}, "expected": 3, "note": "a ring of four: every city reaches two"},
    {"id": "h11", "input": {"n": 5, "edges": [[0, 1, 2], [1, 2, 2], [2, 3, 2], [3, 4, 2], [0, 4, 1]], "distanceThreshold": 3}, "expected": 2, "note": "a ring with one short road"},
    {"id": "h12", "input": {"n": 4, "edges": [[0, 1, 5], [2, 3, 1]], "distanceThreshold": 4}, "expected": 1, "note": "cities 0 and 1 are too far apart to count each other; their tie goes to 1"},
    {"id": "g1", "generate": {"n": 100, "seed": 1}, "note": "100 cities, about 300 roads"},
    {"id": "g2", "generate": {"n": 100, "seed": 6}},
    {"id": "g3", "generate": {"n": 50, "seed": 3}}
  ]
}
