    {"id": "h1", "level": 1, "note": "segments arriving in reverse order are held and released together; an empty segment changes nothing", "ops": ["ReliableTransport", "receive", "ackNumber", "receive", "receive", "receive", "receive", "buffered", "receive", "buffered", "ackNumber", "receive", "receive"], "args": [[], [0, ""], [], [4, "e"], [3, "d"], [2, "c"], [1, "b"], [], [0, "a"], [], [], [5, ""], [9, ""]], "expected": [null, "", 0, "", "", "", "", 4, "abcde", 0, 5, "", ""]},
    {"id": "h2", "level": 1, "note": "out-of-order segments that overlap each other are held once per position", "ops": ["ReliableTransport", "receive", "receive", "buffered", "receive", "buffered", "receive", "buffered", "ackNumber"], "args": [[], [10, "klmno"], [12, "mnopq"], [], [5, "fghijk"], [], [0, "abcde"], [], []], "expected": [null, "", "", 7, "", 12, "abcdefghijklmnopq", 0, 17]},
    {"id": "h3", "level": 1, "note": "a segment entirely below the next expected byte is a duplicate and changes nothing; one far ahead waits", "ops": ["ReliableTransport", "receive", "receive", "receive", "buffered", "receive", "buffered", "ackNumber", "receive", "ackNumber", "buffered"], "args": [[], [0, "abcdef"], [2, "cd"], [0, "a"], [], [1000, "far"], [], [], [6, "g"], [], []], "expected": [null, "abcdef", "", "", 0, "", 3, 6, "g", 7, 3]},
    {"id": "h4", "level": 1, "note": "a segment that starts below the next expected byte, fills the gap and overlaps held bytes delivers only the new bytes once", "ops": ["ReliableTransport", "receive", "receive", "receive", "ackNumber", "buffered", "receive", "ackNumber"], "args": [[], [0, "ab"], [5, "fg"], [1, "bcdefgh"], [], [], [7, "hij"], []], "expected": [null, "ab", "", "cdefgh", 8, 0, "ij", 10]},
