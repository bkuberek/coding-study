    {"id": "h6", "level": 2, "note": "each timeout doubles the RTO up to the 60 second maximum, where it stays", "ops": ["ReliableTransport", "send", "tick", "tick", "tick", "tick", "tick", "tick", "tick", "tick", "timerState"], "args": [[], [500, 0], [1000], [3000], [7000], [15000], [31000], [63000], [123000], [183000], []], "expected": [null, [[0, 500, 0]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [[0, 500, 1]], [-1, -1, 60000, 243000]]},
    {"id": "h7", "level": 2, "note": "a send with the timer running leaves it alone; an ACK of new data restarts it with the current RTO; acknowledging everything stops it", "ops": ["ReliableTransport", "send", "timerState", "send", "timerState", "ack", "timerState", "ack", "timerState", "send", "timerState"], "args": [[], [1000, 0], [], [1000, 300], [], [1000, 600], [], [2000, 700], [], [1000, 5000], []], "expected": [null, [[0, 1000, 0]], [-1, -1, 1000, 1000], [[1000, 1000, 0]], [-1, -1, 1000, 1000], [], [600, 300, 1800, 2400], [], [600, 300, 1800, -1], [[2000, 1000, 0]], [600, 300, 1800, 6800]]},
