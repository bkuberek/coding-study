    {"id": "h9", "level": 2, "note": "an ACK below the oldest unacknowledged byte, a repeated one and one above anything sent change nothing", "ops": ["ReliableTransport", "send", "ack", "timerState", "ack", "ack", "ack", "timerState", "tick", "tick", "timerState"], "args": [[], [3000, 0], [2000, 400], [], [1000, 450], [2000, 460], [5000, 470], [], [1599], [1600], []], "expected": [null, [[0, 1000, 0], [1000, 1000, 0], [2000, 1000, 0]], [], [400, 200, 1200, 1600], [], [], [], [400, 200, 1200, 1600], [], [[2000, 1000, 1]], [400, 200, 2400, 4000]]},
    {"id": "h10", "level": 2, "note": "one call runs every expiry that is due, each at its own time", "ops": ["ReliableTransport", "send", "tick", "timerState", "ack", "timerState"], "args": [[], [1000, 0], [7000], [], [1000, 7001], []], "expected": [null, [[0, 1000, 0]], [[0, 1000, 1], [0, 1000, 1], [0, 1000, 1]], [-1, -1, 8000, 15000], [], [-1, -1, 8000, -1]]},
    {"id": "h11", "level": 2, "note": "only one segment is timed at a time: the first one sent while nothing is being timed", "ops": ["ReliableTransport", "send", "ack", "timerState", "ack", "timerState", "send", "ack", "timerState", "ack", "timerState"], "args": [[], [3000, 0], [1000, 300], [], [2000, 400], [], [1000, 500], [3000, 600], [], [4000, 1200], []], "expected": [null, [[0, 1000, 0], [1000, 1000, 0], [2000, 1000, 0]], [], [300, 150, 1000, 1300], [], [300, 150, 1000, 1400], [[3000, 1000, 0]], [], [300, 150, 1000, 1600], [], [350, 212, 1198, -1]]},
    {"id": "h28", "level": 2, "note": "an expiry due at the very time of a call runs before the call: the ACK at 1000 comes after the retransmission", "ops": ["ReliableTransport", "send", "ack", "timerState", "send", "ack", "timerState"], "args": [[], [1000, 0], [1000, 1000], [], [1000, 1100], [2000, 1600], []], "expected": [null, [[0, 1000, 0]], [[0, 1000, 1]], [-1, -1, 2000, -1], [[1000, 1000, 0]], [], [500, 250, 1500, -1]]},
