    },
    {
      "id": "h30",
      "level": 3,
      "fresh": true,
      "note": "a hold that ran out reads as expired",
      "before": [
        {
          "method": "POST",
          "path": "/reservations",
          "json": {
            "order": "h30",
            "items": [
              {
                "sku": "lamp",
                "quantity": 1
              }
            ],
            "hold_seconds": 0
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/reservations/h30"
      },
      "expected": {
        "status": 200,
        "body": {
          "order": "h30",
          "status": "expired",
          "items": [
            {
              "sku": "lamp",
              "quantity": 1
            }
          ]
        }
      }
    },
    {
      "id": "h31",
      "level": 3,
      "fresh": true,
      "note": "an expired reservation cannot be released",
      "before": [
        {
          "method": "POST",
          "path": "/reservations",
          "json": {
            "order": "h31",
            "items": [
              {
                "sku": "lamp",
                "quantity": 1
              }
            ],
            "hold_seconds": 0
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "path": "/reservations/h31"
      },
      "expected": {
        "status": 409,
        "body": {
          "error": "not_active"
        }
      }
    },
    {
      "id": "h32",
      "level": 3,
      "note": "a hold over an hour",
      "request": {
        "method": "POST",
        "path": "/reservations",
        "json": {
          "order": "h32",
          "items": [
            {
              "sku": "lamp",
              "quantity": 1
            }
          ],
          "hold_seconds": 3601
        }
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "invalid_request"
