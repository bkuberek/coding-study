{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["InMemoryDatabase", "set", "set", "get", "get", "set", "get", "remove", "remove", "get"], "args": [[], [1, "user1", "name", "ana"], [2, "user1", "city", "rome"], [3, "user1", "name"], [4, "user1", "age"], [5, "user1", "name", "bo"], [6, "user1", "name"], [7, "user1", "city"], [8, "user1", "city"], [9, "user1", "city"]], "expected": [null, null, null, "ana", "", null, "bo", true, false, ""]},
    {"id": "h1", "level": 1, "note": "empty database: reads find nothing, deletes report false", "ops": ["InMemoryDatabase", "get", "remove", "get"], "args": [[], [1, "a", "b"], [2, "a", "b"], [3, "a", "b"]], "expected": [null, "", false, ""]},
    {"id": "h2", "level": 1, "note": "records are independent even when they share field names", "ops": ["InMemoryDatabase", "set", "set", "remove", "get", "get", "remove"], "args": [[], [1, "r1", "f", "x"], [2, "r2", "f", "y"], [3, "r1", "f"], [4, "r1", "f"], [5, "r2", "f"], [6, "r2", "g"]], "expected": [null, null, null, true, "", "y", false]},
    {"id": "h3", "level": 1, "note": "a deleted field can be written again", "ops": ["InMemoryDatabase", "set", "remove", "set", "get", "set", "get", "remove", "remove"], "args": [[], [10, "k", "f", "v1"], [20, "k", "f"], [30, "k", "f", "v1"], [40, "k", "f"], [50, "k", "f", "v1"], [60, "k", "f"], [70, "k", "f"], [80, "k", "f"]], "expected": [null, null, true, null, "v1", null, "v1", true, false]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["InMemoryDatabase", "set", "set", "set", "scan", "scanByPrefix", "scanByPrefix", "scan"], "args": [[], [1, "car", "model", "z4"], [2, "car", "color", "red"], [3, "car", "colorcode", "r9"], [4, "car"], [5, "car", "col"], [6, "car", "x"], [7, "bike"]], "expected": [null, null, null, null, ["color(red)", "colorcode(r9)", "model(z4)"], ["color(red)", "colorcode(r9)"], [], []]},
    {"id": "h4", "level": 2, "note": "fields sort as strings, so a10 comes before a2", "ops": ["InMemoryDatabase", "set", "set", "set", "set", "scanByPrefix", "scan"], "args": [[], [1, "k", "a2", "two"], [2, "k", "a10", "ten"], [3, "k", "b", "bee"], [4, "k", "a1", "one"], [5, "k", "a"], [6, "k"]], "expected": [null, null, null, null, null, ["a1(one)", "a10(ten)", "a2(two)"], ["a1(one)", "a10(ten)", "a2(two)", "b(bee)"]]},
    {"id": "h5", "level": 2, "note": "deleted fields disappear from scans; a record with no fields scans empty", "ops": ["InMemoryDatabase", "set", "set", "remove", "scan", "remove", "scan", "scanByPrefix"], "args": [[], [1, "k", "x", "1"], [2, "k", "y", "2"], [3, "k", "x"], [4, "k"], [5, "k", "y"], [6, "k"], [7, "k", "y"]], "expected": [null, null, null, true, ["y(2)"], true, [], []]},
    {"id": "h6", "level": 2, "note": "a prefix equal to a whole field name matches it; the empty prefix matches all", "ops": ["InMemoryDatabase", "set", "set", "set", "scanByPrefix", "scanByPrefix", "scanByPrefix", "set", "scanByPrefix"], "args": [[], [1, "k", "ab", "1"], [2, "k", "abc", "2"], [3, "k", "b", "3"], [4, "k", "abc"], [5, "k", "ab"], [6, "k", ""], [7, "k", "ab", "9"], [8, "k", "a"]], "expected": [null, null, null, null, ["abc(2)"], ["ab(1)", "abc(2)"], ["ab(1)", "abc(2)", "b(3)"], null, ["ab(9)", "abc(2)"]]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["InMemoryDatabase", "setWithTtl", "set", "get", "get", "scan", "remove"], "args": [[], [10, "s1", "token", "abc", 5], [11, "s1", "user", "ana"], [14, "s1", "token"], [15, "s1", "token"], [16, "s1"], [17, "s1", "token"]], "expected": [null, null, null, "abc", "", ["user(ana)"], false]},
    {"id": "h7", "level": 3, "note": "a plain set removes the expiry; a new setWithTtl replaces it", "ops": ["InMemoryDatabase", "setWithTtl", "set", "get", "setWithTtl", "setWithTtl", "get", "get", "get"], "args": [[], [1, "k", "f", "a", 3], [2, "k", "f", "b"], [100, "k", "f"], [101, "k", "f", "c", 10], [105, "k", "f", "d", 2], [106, "k", "f"], [107, "k", "f"], [200, "k", "g"]], "expected": [null, null, null, "b", null, null, "d", "", ""]},
    {"id": "h8", "level": 3, "note": "visible until timestamp + ttl - 1; scans with a prefix skip expired fields", "ops": ["InMemoryDatabase", "setWithTtl", "setWithTtl", "set", "scanByPrefix", "scanByPrefix", "get", "get", "scan"], "args": [[], [1, "k", "aa", "1", 4], [2, "k", "ab", "2", 10], [3, "k", "ac", "3"], [4, "k", "a"], [5, "k", "a"], [11, "k", "ab"], [12, "k", "ab"], [13, "k"]], "expected": [null, null, null, null, ["aa(1)", "ab(2)", "ac(3)"], ["ab(2)", "ac(3)"], "2", "", ["ac(3)"]]},
    {"id": "h9", "level": 3, "note": "an expired field can be set again; deleting it while expired changes nothing", "ops": ["InMemoryDatabase", "setWithTtl", "remove", "get", "setWithTtl", "get", "remove", "get"], "args": [[], [5, "k", "f", "old", 1], [6, "k", "f"], [7, "k", "f"], [8, "k", "f", "new", 1000000000], [999999, "k", "f"], [1000000, "k", "f"], [1000001, "k", "f"]], "expected": [null, null, false, "", null, "new", true, ""]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["InMemoryDatabase", "set", "set", "setWithTtl", "remove", "getAt", "getAt", "getAt", "getAt", "scanAt", "scanAt"], "args": [[], [1, "acct", "plan", "free"], [5, "acct", "plan", "pro"], [6, "acct", "promo", "spring", 4], [9, "acct", "plan"], [12, "acct", "plan", 0], [13, "acct", "plan", 4], [14, "acct", "plan", 5], [15, "acct", "plan", 9], [16, "acct", 7], [17, "acct", 10]], "expected": [null, null, null, null, true, "", "free", "pro", "", ["plan(pro)", "promo(spring)"], []]},
    {"id": "h10", "level": 4, "note": "a field's TTL is judged at the requested moment, not now", "ops": ["InMemoryDatabase", "setWithTtl", "getAt", "getAt", "getAt", "get", "getAt"], "args": [[], [2, "k", "f", "v", 3], [10, "k", "f", 2], [11, "k", "f", 4], [12, "k", "f", 5], [13, "k", "f"], [14, "k", "f", 1]], "expected": [null, null, "v", "v", "", "", ""]},
    {"id": "h11", "level": 4, "note": "the moment may equal the current timestamp; unknown records read as absent", "ops": ["InMemoryDatabase", "set", "getAt", "getAt", "scanAt", "set", "getAt", "getAt"], "args": [[], [3, "k", "f", "a"], [4, "k", "f", 4], [5, "nope", "f", 3], [6, "nope", 6], [7, "k", "f", "b"], [8, "k", "f", 6], [9, "k", "f", 7]], "expected": [null, null, "a", "", [], null, "a", "b"]},
    {"id": "h12", "level": 4, "note": "scanAt rebuilds the whole record at a past moment, in field order", "ops": ["InMemoryDatabase", "set", "set", "remove", "set", "set", "setWithTtl", "scanAt", "scanAt", "scanAt", "scanAt", "scan"], "args": [[], [1, "r", "b", "1"], [2, "r", "a", "1"], [3, "r", "b"], [4, "r", "c", "1"], [5, "r", "b", "2"], [6, "r", "a", "2", 2], [10, "r", 2], [11, "r", 3], [12, "r", 6], [13, "r", 8], [14, "r"]], "expected": [null, null, null, true, null, null, null, ["a(1)", "b(1)"], ["a(1)"], ["a(2)", "b(2)", "c(1)"], ["b(2)", "c(1)"], ["b(2)", "c(1)"]]}
  ]
}
