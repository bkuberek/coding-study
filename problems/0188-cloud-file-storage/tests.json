{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["CloudStorage", "addFile", "addFile", "getFileSize", "getFileSize", "deleteFile", "deleteFile", "getFileSize"], "args": [[], [1, "/notes.txt", 100], [2, "/notes.txt", 50], [3, "/notes.txt"], [4, "/todo.txt"], [5, "/notes.txt"], [6, "/notes.txt"], [7, "/notes.txt"]], "expected": [null, true, false, 100, -1, 100, -1, -1]},
    {"id": "h1", "level": 1, "note": "an empty store has no files", "ops": ["CloudStorage", "getFileSize", "deleteFile"], "args": [[], [1, "/a"], [2, "/a"]], "expected": [null, -1, -1]},
    {"id": "h2", "level": 1, "note": "a deleted name can be reused with a new size", "ops": ["CloudStorage", "addFile", "deleteFile", "addFile", "getFileSize", "addFile"], "args": [[], [1, "/a", 10], [2, "/a"], [3, "/a", 20], [4, "/a"], [5, "/a", 20]], "expected": [null, true, 10, true, 20, false]},
    {"id": "h3", "level": 1, "note": "sizes go beyond 32-bit integers; names are case-sensitive", "ops": ["CloudStorage", "addFile", "addFile", "getFileSize", "getFileSize", "deleteFile", "getFileSize"], "args": [[], [1, "/big.iso", 5000000000], [2, "/Big.iso", 1], [3, "/big.iso"], [4, "/Big.iso"], [5, "/big.iso"], [6, "/Big.iso"]], "expected": [null, true, true, 5000000000, 1, 5000000000, 1]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["CloudStorage", "addFile", "addFile", "addFile", "addFile", "listLargest", "listLargest", "listLargest"], "args": [[], [1, "/docs/a.pdf", 300], [2, "/docs/b.pdf", 300], [3, "/docs/c.pdf", 900], [4, "/img/x.png", 500], [5, "/docs/", 2], [6, "/", 10], [7, "/video/", 3]], "expected": [null, true, true, true, true, ["/docs/c.pdf(900)", "/docs/a.pdf(300)"], ["/docs/c.pdf(900)", "/img/x.png(500)", "/docs/a.pdf(300)", "/docs/b.pdf(300)"], []]},
    {"id": "h4", "level": 2, "note": "ties are broken by name; deleted files disappear", "ops": ["CloudStorage", "addFile", "addFile", "addFile", "addFile", "listLargest", "deleteFile", "listLargest"], "args": [[], [1, "/z", 5], [2, "/m", 5], [3, "/a", 5], [4, "/q", 7], [5, "/", 3], [6, "/q"], [7, "/", 3]], "expected": [null, true, true, true, true, ["/q(7)", "/a(5)", "/m(5)"], 7, ["/a(5)", "/m(5)", "/z(5)"]]},
    {"id": "h5", "level": 2, "note": "a prefix that equals a whole name matches it; the empty prefix matches all", "ops": ["CloudStorage", "addFile", "addFile", "addFile", "listLargest", "listLargest", "listLargest"], "args": [[], [1, "/a/b", 1], [2, "/a/bc", 2], [3, "/ab", 3], [4, "/a/b", 5], [5, "/a", 5], [6, "", 1]], "expected": [null, true, true, true, ["/a/bc(2)", "/a/b(1)"], ["/ab(3)", "/a/bc(2)", "/a/b(1)"], ["/ab(3)"]]},
    {"id": "h6", "level": 2, "note": "an empty store lists nothing", "ops": ["CloudStorage", "listLargest", "addFile", "listLargest"], "args": [[], [1, "/", 3], [2, "/x", 1], [3, "/y", 3]], "expected": [null, [], true, []]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["CloudStorage", "addUser", "addUser", "addFileBy", "addFileBy", "addFileBy", "addFileBy", "deleteFile", "addFileBy"], "args": [[], [1, "ana", 1000], [2, "ana", 5], [3, "ana", "/ana/a", 600], [4, "ana", "/ana/b", 500], [5, "bob", "/bob/a", 1], [6, "ana", "/ana/b", 400], [7, "/ana/a"], [8, "ana", "/ana/c", 100]], "expected": [null, true, false, 400, -1, -1, 0, 600, 500]},
    {"id": "h7", "level": 3, "note": "shrinking a quota removes the largest files first, ties by name", "ops": ["CloudStorage", "addUser", "addFileBy", "addFileBy", "addFileBy", "addFileBy", "updateCapacity", "listLargest", "addFileBy", "addFileBy", "updateCapacity", "updateCapacity"], "args": [[], [1, "u", 100], [2, "u", "/u/a", 30], [3, "u", "/u/b", 30], [4, "u", "/u/c", 20], [5, "u", "/u/d", 10], [6, "u", 45], [7, "/u/", 10], [8, "u", "/u/e", 16], [9, "u", "/u/e", 15], [10, "u", 1000], [11, "zz", 1]], "expected": [null, true, 70, 40, 20, 10, 2, ["/u/c(20)", "/u/d(10)"], -1, 0, 0, -1]},
    {"id": "h8", "level": 3, "note": "files without an owner have no limit and share one namespace with user files", "ops": ["CloudStorage", "addFile", "addUser", "addFileBy", "addFileBy", "addFile", "listLargest", "updateCapacity", "getFileSize", "getFileSize"], "args": [[], [1, "/shared", 999999], [2, "u", 10], [3, "u", "/shared", 1], [4, "u", "/mine", 10], [5, "/mine", 1], [6, "/", 5], [7, "u", 0], [8, "/mine"], [9, "/shared"]], "expected": [null, true, true, -1, 0, false, ["/shared(999999)", "/mine(10)"], 1, -1, 999999]},
    {"id": "h9", "level": 3, "note": "a file must fit the remaining capacity exactly or less", "ops": ["CloudStorage", "addUser", "addFileBy", "addFileBy", "addFileBy", "deleteFile", "addFileBy", "addUser", "addFileBy"], "args": [[], [1, "u", 50], [2, "u", "/x", 51], [3, "u", "/x", 50], [4, "u", "/y", 1], [5, "/x"], [6, "u", "/y", 1], [7, "v", 0], [8, "v", "/z", 1]], "expected": [null, true, -1, 0, -1, 50, 49, true, -1]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["CloudStorage", "addUser", "addFileBy", "addFileBy", "backupUser", "deleteFile", "addFileBy", "restoreUser", "listLargest", "addFileBy"], "args": [[], [1, "kim", 100], [2, "kim", "/k/a", 40], [3, "kim", "/k/b", 30], [4, "kim"], [5, "/k/a"], [6, "kim", "/k/c", 50], [7, "kim"], [8, "/k/", 5], [9, "kim", "/k/d", 31]], "expected": [null, true, 60, 30, 2, 40, 20, 2, ["/k/a(40)", "/k/b(30)"], -1]},
    {"id": "h10", "level": 4, "note": "restore without a backup deletes the user's files; unknown users get -1", "ops": ["CloudStorage", "addUser", "addFileBy", "restoreUser", "getFileSize", "backupUser", "restoreUser", "backupUser", "addFileBy", "restoreUser", "getFileSize"], "args": [[], [1, "u", 10], [2, "u", "/a", 5], [3, "u"], [4, "/a"], [5, "nobody"], [6, "nobody"], [7, "u"], [8, "u", "/b", 10], [9, "u"], [10, "/b"]], "expected": [null, true, 5, 0, -1, -1, -1, 0, 0, 0, -1]},
    {"id": "h11", "level": 4, "note": "restore skips names now used by someone else", "ops": ["CloudStorage", "addUser", "addUser", "addFileBy", "addFileBy", "backupUser", "deleteFile", "deleteFile", "addFileBy", "addFile", "restoreUser", "listLargest"], "args": [[], [1, "u", 100], [2, "v", 100], [3, "u", "/a", 10], [4, "u", "/b", 10], [5, "u"], [6, "/a"], [7, "/b"], [8, "v", "/a", 1], [9, "/b", 2], [10, "u"], [11, "/", 5]], "expected": [null, true, true, 90, 80, 2, 10, 10, 99, true, 0, ["/b(2)", "/a(1)"]]},
    {"id": "h12", "level": 4, "note": "restore respects the current quota, in ascending name order; a new backup replaces the old", "ops": ["CloudStorage", "addUser", "addFileBy", "addFileBy", "addFileBy", "backupUser", "updateCapacity", "restoreUser", "listLargest", "deleteFile", "backupUser", "addFileBy", "restoreUser", "listLargest"], "args": [[], [1, "u", 100], [2, "u", "/c", 50], [3, "u", "/a", 30], [4, "u", "/b", 20], [5, "u"], [6, "u", 60], [7, "u"], [8, "/", 5], [9, "/a"], [10, "u"], [11, "u", "/d", 5], [12, "u"], [13, "/", 5]], "expected": [null, true, 50, 20, 0, 3, 1, 2, ["/a(30)", "/b(20)"], 30, 1, 35, 1, ["/b(20)"]]}
  ]
}
