{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"points": [[0, 0], [3, 1], [1, 4], [5, 5], [6, 0]]}, "expected": 18},
    {"id": "ex2", "visible": true, "input": {"points": [[-2, 3], [4, -1]]}, "expected": 10},
    {"id": "h1", "input": {"points": [[7, -7]]}, "expected": 0, "note": "a single point needs no cable"},
    {"id": "h2", "input": {"points": [[0, 0], [5, 0], [2, 0], [9, 0], [-4, 0]]}, "expected": 13, "note": "points on one line: the span of the line"},
    {"id": "h3", "input": {"points": [[0, 0], [1, 0], [0, 1], [1, 1]]}, "expected": 3, "note": "a unit square: many ties"},
    {"id": "h4", "input": {"points": [[-1000000, -1000000], [1000000, 1000000]]}, "expected": 4000000, "note": "opposite corners of the coordinate range"},
    {"id": "h5", "input": {"points": [[-1000000, -1000000], [1000000, 1000000], [-1000000, 1000000], [1000000, -1000000]]}, "expected": 6000000, "note": "all four corners of the range"},
    {"id": "h6", "input": {"points": [[0, 0], [1, 1], [100, 100], [101, 101]]}, "expected": 202, "note": "two tight pairs far apart"},
    {"id": "h7", "input": {"points": [[0, 0], [0, 1], [0, 2], [0, 3], [1, 0], [1, 1], [1, 2], [1, 3], [2, 0], [2, 1], [2, 2], [2, 3], [3, 0], [3, 1], [3, 2], [3, 3]]}, "expected": 15, "note": "a 4 by 4 lattice: every cable costs 1"},
    {"id": "h8", "input": {"points": [[0, 0], [10, 0], [5, 8]]}, "expected": 23, "note": "a triangle: the two cheapest sides"},
    {"id": "h9", "input": {"points": [[3, 3], [-3, -3], [3, -3], [-3, 3], [0, 0]]}, "expected": 24, "note": "a hub in the middle of a square"},
    {"id": "h10", "input": {"points": [[0, 0], [0, 7], [0, 3], [4, 3]]}, "expected": 11, "note": "a branch off a vertical line"},
    {"id": "h11", "input": {"points": [[-5, -5], [-4, -5], [-3, -5], [10, 10]]}, "expected": 30, "note": "negative coordinates and one outlier"},
    {"id": "h12", "input": {"points": [[2, 0], [0, 2], [-2, 0], [0, -2]]}, "expected": 12, "note": "a diamond: every side costs 4"},
    {"id": "g1", "generate": {"n": 1000, "seed": 1}, "note": "1000 points: half a million pairs"},
    {"id": "g2", "generate": {"n": 1000, "seed": 7}},
    {"id": "g3", "generate": {"n": 300, "seed": 3}}
  ]
}
