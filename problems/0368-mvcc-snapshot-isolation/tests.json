    {"id": "h9", "level": 3, "note": "a read-only transaction closes the cycle: the edge into the pivot comes from a reader that has already committed, so reads must outlive their transaction", "ops": ["MvccStore", "put", "put", "beginSerializable", "read", "read", "beginSerializable", "read", "write", "commit", "beginSerializable", "read", "read", "commit", "write", "antidependencies", "antidependencies", "antidependencies", "commit", "versions"], "args": [[], ["stock", "0"], ["reserve", "0"], [], [3, "stock"], [3, "reserve"], [], [4, "reserve"], [4, "reserve", "40"], [4], [], [6, "stock"], [6, "reserve"], [6], [3, "stock", "-6"], [3], [4], [6], [3], ["stock"]], "expected": [null, 1, 2, 3, "0", "0", 4, "0", true, "committed", 6, "0", "40", "committed", true, ["in:6", "out:4"], ["in:3"], ["out:3"], "dangerous-structure", ["1:0"]]},
    {"id": "h10", "level": 3, "note": "the pivot has committed: the transaction that would add the second edge is aborted at its write", "ops": ["MvccStore", "put", "put", "beginSerializable", "beginSerializable", "beginSerializable", "read", "read", "write", "antidependencies", "commit", "write", "status", "commit", "commit", "versions", "versions"], "args": [[], ["a", "1"], ["b", "1"], [], [], [], [3, "a"], [4, "b"], [3, "b", "2"], [3], [3], [5, "a", "3"], [5], [5], [4], ["a"], ["b"]], "expected": [null, 1, 2, 3, 4, 5, "1", "1", true, ["in:4"], "committed", false, "aborted", "not-active", "committed", ["1:1"], ["6:2", "2:1"]]},
