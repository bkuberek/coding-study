    {"id": "ex5", "visible": true, "level": 3, "ops": ["MvccStore", "put", "put", "begin", "begin", "read", "read", "read", "read", "write", "write", "commit", "commit", "begin", "read", "read"], "args": [[], ["east", "up"], ["west", "up"], [], [], [3, "east"], [3, "west"], [4, "east"], [4, "west"], [3, "east", "down"], [4, "west", "down"], [3], [4], [], [7, "east"], [7, "west"]], "expected": [null, 1, 2, 3, 4, "up", "up", "up", "up", true, true, "committed", "committed", 7, "down", "down"]},
