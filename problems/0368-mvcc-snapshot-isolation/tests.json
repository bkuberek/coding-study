    {"id": "h12", "level": 3, "note": "only serializable transactions take part: a plain transaction or a put neither makes nor receives an edge", "ops": ["MvccStore", "put", "put", "beginSerializable", "begin", "read", "read", "read", "read", "write", "write", "antidependencies", "antidependencies", "commit", "commit", "beginSerializable", "read", "put", "read", "antidependencies", "commit"], "args": [[], ["a", "1"], ["b", "1"], [], [], [3, "a"], [3, "b"], [4, "a"], [4, "b"], [3, "a", "s"], [4, "b", "p"], [3], [4], [4], [3], [], [7, "a"], ["a", "q"], [7, "a"], [7], [7]], "expected": [null, 1, 2, 3, 4, "1", "1", "1", "1", true, true, [], [], "committed", "committed", 7, "s", 8, "s", [], "committed"]},
