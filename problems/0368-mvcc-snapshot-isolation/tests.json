    {"id": "h6", "level": 2, "note": "a transaction reads its own latest write, others never see it before the commit, and a committed writer is visible only to snapshots that begin after its commit", "ops": ["MvccStore", "put", "begin", "write", "write", "read", "read", "write", "read", "begin", "read", "commit", "read", "read", "begin", "read", "read", "versions"], "args": [[], ["n", "0"], [], [2, "n", "1"], [2, "n", "2"], [2, "n"], [2, "m"], [2, "m", "x"], [2, "m"], [], [3, "n"], [2], [3, "n"], [3, "m"], [], [5, "n"], [5, "m"], ["n"]], "expected": [null, 1, 2, true, true, "2", "", true, "x", 3, "0", "committed", "0", "", 5, "2", "x", ["4:2", "1:0"]]},
    {"id": "h7", "level": 2, "note": "a writer that began after the other committed sees its version and does not conflict; read-only commits take a tick", "ops": ["MvccStore", "put", "begin", "write", "commit", "begin", "read", "write", "commit", "begin", "read", "commit", "put", "versions", "status", "status", "status", "abort", "write", "read"], "args": [[], ["q", "a"], [], [2, "q", "b"], [2], [], [4, "q"], [4, "q", "c"], [4], [], [6, "q"], [6], ["q", "d"], ["q"], [2], [4], [6], [4], [4, "q", "e"], [4, "q"]], "expected": [null, 1, 2, true, "committed", 4, "b", true, "committed", 6, "c", "committed", 8, ["8:d", "5:c", "3:b", "1:a"], "committed", "committed", "committed", false, false, ""]},
