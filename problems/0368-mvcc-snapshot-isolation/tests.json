    {"id": "h14", "level": 3, "note": "reading one's own write records nothing; a read meets a buffered write, a write meets an earlier read, and a later commit meets an earlier read", "ops": ["MvccStore", "put", "put", "beginSerializable", "beginSerializable", "write", "read", "read", "antidependencies", "read", "write", "write", "antidependencies", "commit", "commit", "status", "beginSerializable", "beginSerializable", "read", "write", "commit", "read", "antidependencies", "antidependencies"], "args": [[], ["a", "1"], ["b", "1"], [], [], [3, "a", "x"], [3, "a"], [4, "a"], [4], [3, "b"], [4, "b", "y"], [4, "a", "z"], [3], [3], [4], [4], [], [], [6, "a"], [7, "a", "w"], [7], [6, "b"], [6], [7]], "expected": [null, 1, 2, 3, 4, true, "x", "1", ["out:3"], "1", true, true, ["in:4", "out:4"], "dangerous-structure", "committed", "committed", 6, 7, "z", true, "committed", "y", ["out:7"], ["in:6"]]},
    {"id": "h15", "level": 3, "note": "a chain without a cycle: one edge in and none out, or one out and none in, commits; an aborted middle transaction drops its edges", "ops": ["MvccStore", "put", "put", "put", "beginSerializable", "beginSerializable", "beginSerializable", "read", "write", "read", "write", "antidependencies", "antidependencies", "antidependencies", "abort", "antidependencies", "antidependencies", "antidependencies", "commit", "commit", "antidependencies"], "args": [[], ["a", "1"], ["b", "1"], ["c", "1"], [], [], [], [4, "a"], [5, "a", "2"], [5, "b"], [6, "b", "2"], [4], [5], [6], [5], [4], [6], [5], [4], [6], [4]], "expected": [null, 1, 2, 3, 4, 5, 6, "1", true, "1", true, ["out:5"], ["in:4", "out:6"], ["in:5"], true, [], [], [], "committed", "committed", []]},
