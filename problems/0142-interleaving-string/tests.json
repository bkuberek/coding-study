{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"s1": "dog", "s2": "cat", "s3": "dcoagt"}, "expected": true},
    {"id": "ex2", "visible": true, "input": {"s1": "ab", "s2": "c", "s3": "bac"}, "expected": false},
    {"id": "h1", "input": {"s1": "", "s2": "", "s3": ""}, "expected": true, "note": "all three strings empty"},
    {"id": "h2", "input": {"s1": "a", "s2": "", "s3": ""}, "expected": false, "note": "s3 too short"},
    {"id": "h3", "input": {"s1": "ab", "s2": "cd", "s3": "abcde"}, "expected": false, "note": "lengths do not add up"},
    {"id": "h4", "input": {"s1": "", "s2": "xyz", "s3": "xyz"}, "expected": true, "note": "s1 empty, s2 equals s3"},
    {"id": "h5", "input": {"s1": "", "s2": "xyz", "s3": "xzy"}, "expected": false, "note": "s1 empty, s2 differs from s3"},
    {"id": "h6", "input": {"s1": "aa", "s2": "ab", "s3": "aaba"}, "expected": true, "note": "both strings start with the same letter"},
    {"id": "h7", "input": {"s1": "aab", "s2": "abb", "s3": "aababb"}, "expected": true, "note": "equal letters on both sides: the greedy choice of source can fail"},
    {"id": "h8", "input": {"s1": "aab", "s2": "abb", "s3": "ababba"}, "expected": false, "note": "same letters as a valid interleave, but no split of s3 works"},
    {"id": "h9", "input": {"s1": "abc", "s2": "abc", "s3": "aabbcc"}, "expected": true, "note": "identical strings"},
    {"id": "h10", "input": {"s1": "abc", "s2": "abc", "s3": "abcabc"}, "expected": true, "note": "one after the other"},
    {"id": "h11", "input": {"s1": "ab", "s2": "ba", "s3": "abba"}, "expected": true, "note": "palindrome-like interleave"},
    {"id": "h12", "input": {"s1": "ab", "s2": "ba", "s3": "baab"}, "expected": true, "note": "s2 goes first"},
    {"id": "h13", "input": {"s1": "abc", "s2": "def", "s3": "abdcfe"}, "expected": false, "note": "right letters, wrong order in s2"},
    {"id": "h14", "input": {"s1": "", "s2": "", "s3": ""}, "expected": true, "note": "maximum lengths, one letter"},
    {"id": "h15", "input": {"s1": "", "s2": "", "s3": ""}, "expected": false, "note": "maximum lengths: every state must be explored before failing"},
    {"id": "g1", "generate": {"n": 2000, "seed": 1}, "note": "s1 and s2 of about 1000 letters"},
    {"id": "g2", "generate": {"n": 2000, "seed": 2}, "note": "s1 and s2 of about 1000 letters"},
    {"id": "g3", "generate": {"n": 500, "seed": 3}}
  ]
}
