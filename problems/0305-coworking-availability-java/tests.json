{
  "version": 1,
  "cases": [
    {
      "id": "v1",
      "level": 1,
      "visible": true,
      "note": "a day on sale",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "2027-03-01"
        }
      },
      "expected": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "date": "2027-03-01",
          "available": 12
        }
      }
    },
    {
      "id": "v2",
      "level": 1,
      "visible": true,
      "note": "no date",
      "request": {
        "method": "GET",
        "path": "/desks"
      },
      "expected": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "date is required"
        }
      }
    },
    {
      "id": "h1",
      "level": 1,
      "note": "a day on sale with no desks left is a count, not an error",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "2027-03-07"
        }
      },
      "expected": {
        "status": 200,
        "body": {
          "date": "2027-03-07",
          "available": 0
        }
      }
    },
    {
      "id": "h2",
      "level": 1,
      "note": "the last day on sale",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "2027-03-31"
        }
      },
      "expected": {
        "status": 200,
        "body": {
          "date": "2027-03-31",
          "available": 7
        }
      }
    },
    {
      "id": "h3",
      "level": 1,
      "note": "an empty date is a missing one",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": ""
        }
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "date is required"
        }
      }
    },
    {
      "id": "h4",
      "level": 1,
      "note": "a word is not a day",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "soon"
        }
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "date must be a real day, as YYYY-MM-DD"
        }
      }
    },
    {
      "id": "h5",
      "level": 1,
      "note": "a day with no zero padding is not this form",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "2027-3-1"
        }
      },
      "expected": {
        "status": 400,
        "body": {
          "error": "date must be a real day, as YYYY-MM-DD"
        }
      }
    },
    {
      "id": "h6",
      "level": 1,
      "note": "the right form, on a day that does not exist",
      "request": {
        "method": "GET",
        "path": "/desks",
        "query": {
          "date": "2027-02-30"
        }
      },
      "expected": {
