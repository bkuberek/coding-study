{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["ForgettableIndex", "add", "add", "add", "search", "forget", "search", "forget"], "args": [[1.2, 0.75], ["trip", ["flight", "to", "lisbon", "in", "may"]], ["diet", ["vegan", "no", "nuts"]], ["pet", ["dog", "named", "rex", "likes", "lisbon", "parks"]], [["lisbon"], 5], ["trip"], [["lisbon"], 5], ["trip"]], "expected": [null, true, true, true, ["trip", "pet"], true, ["pet"], false]},
    {"id": "ex2", "visible": true, "ops": ["ForgettableIndex", "add", "add", "update", "search", "search", "update"], "args": [[1.2, 0.75], ["home", ["lives", "in", "porto"]], ["work", ["office", "in", "porto", "center"]], ["home", ["moved", "to", "faro"]], [["porto"], 5], [["faro"], 5], ["gym", ["mornings"]]], "expected": [null, true, true, true, ["work"], ["home"], false]},
    {"id": "ex3", "visible": true, "ops": ["ForgettableIndex", "add", "add", "add", "score", "forget", "score"], "args": [[1.2, 0.75], ["a", ["tea", "green"]], ["b", ["tea"]], ["c", ["coffee", "black", "strong", "hot"]], [["tea"], "b"], ["c"], [["tea"], "b"]], "expected": [null, true, true, true, 0.6133945669817229, true, 0.21110917102457905]},
    {"id": "h1", "note": "a forgotten document leaves no postings: no query finds it, and it scores 0", "ops": ["ForgettableIndex", "add", "add", "forget", "search", "search", "score", "score"], "args": [[1.2, 0.75], ["d1", ["alpha", "beta"]], ["d2", ["beta", "gamma"]], ["d1"], [["alpha"], 5], [["alpha", "beta"], 5], [["alpha"], "d1"], [["beta"], "d1"]], "expected": [null, true, true, true, [], ["d2"], 0.0, 0.0]},
    {"id": "h2", "note": "after a forget, N, the total length and df are those of an index that never held the document", "ops": ["ForgettableIndex", "add", "add", "add", "forget", "score", "score", "search"], "args": [[1.2, 0.75], ["x", ["red", "apple"]], ["y", ["red", "red", "car"]], ["z", ["apple", "pie", "hot", "fresh"]], ["z"], [["red", "apple"], "x"], [["red", "apple"], "y"], [["red", "apple"], 5]], "expected": [null, true, true, true, true, 0.9534808030587029, 0.2373416715660948, ["x", "y"]]},
    {"id": "h3", "note": "an update takes out the old words' postings and changes the length and df", "ops": ["ForgettableIndex", "add", "add", "update", "search", "score", "score", "search"], "args": [[1.2, 0.75], ["d1", ["alpha", "beta"]], ["d2", ["beta", "gamma", "delta"]], ["d1", ["gamma"]], [["alpha"], 5], [["gamma"], "d2"], [["beta"], "d2"], [["gamma", "beta"], 5]], "expected": [null, true, true, true, [], 0.15136129243271704, 0.5754429423516527, ["d2", "d1"]]},
    {"id": "h4", "note": "adding an id that is already there is refused and changes nothing; update and forget of a missing id return false", "ops": ["ForgettableIndex", "add", "add", "search", "search", "update", "forget", "score"], "args": [[1.2, 0.75], ["d", ["x"]], ["d", ["y"]], [["y"], 5], [["x"], 5], ["e", ["x"]], ["e"], [["x"], "d"]], "expected": [null, true, false, [], ["d"], false, false, 0.28768207245178085]},
    {"id": "h5", "note": "a forgotten id can be added again, as a new document", "ops": ["ForgettableIndex", "add", "forget", "add", "search", "search", "forget", "forget"], "args": [[1.2, 0.75], ["d", ["x", "y"]], ["d"], ["d", ["z"]], [["x"], 5], [["z"], 5], ["d"], ["d"]], "expected": [null, true, true, true, [], ["d"], true, false]},
    {"id": "h6", "note": "an empty index, empty documents and an empty query: nothing to divide by, and empty documents still count in N", "ops": ["ForgettableIndex", "search", "score", "add", "add", "search", "score", "add", "search", "score", "search"], "args": [[1.2, 0.75], [["a"], 5], [["a"], "d"], ["e1", []], ["e2", []], [["a"], 5], [["a"], "e1"], ["d", ["a"]], [["a"], 3], [["a"], "d"], [[], 5]], "expected": [null, [], 0.0, true, true, [], 0.0, true, ["d"], 0.5394560891564495, []]},
    {"id": "h7", "note": "equal scores go to the smaller id in string order, and topN cuts the list", "ops": ["ForgettableIndex", "add", "add", "add", "search", "search"], "args": [[1.2, 0.75], ["doc9", ["cat"]], ["doc10", ["cat"]], ["doc2", ["cat"]], [["cat"], 2], [["cat"], 5]], "expected": [null, true, true, true, ["doc10", "doc2"], ["doc10", "doc2", "doc9"]]},
    {"id": "h8", "note": "a repeated query word counts once, and tf counts the repeats in the document", "ops": ["ForgettableIndex", "add", "add", "add", "search", "score", "score"], "args": [[1.2, 0.75], ["a", ["rain", "rain"]], ["b", ["rain", "sun"]], ["c", ["snow", "wind"]], [["rain", "rain"], 5], [["rain", "rain"], "a"], [["rain"], "a"]], "expected": [null, true, true, true, ["a", "b"], 0.6462549902128865, 0.6462549902128865]},
    {"id": "h9", "note": "an update to no words keeps the document counted, but nothing finds it", "ops": ["ForgettableIndex", "add", "add", "update", "search", "search", "score"], "args": [[1.2, 0.75], ["a", ["x", "y"]], ["b", ["x"]], ["a", []], [["x"], 5], [["y"], 5], [["x"], "b"]], "expected": [null, true, true, true, ["b"], [], 0.4919109023328644]},
    {"id": "h10", "note": "df counts documents, not occurrences, and drops to nothing when the last holder goes", "ops": ["ForgettableIndex", "add", "add", "add", "score", "forget", "score", "forget", "search", "score"], "args": [[1.2, 0.75], ["a", ["z", "z", "z"]], ["b", ["z"]], ["c", ["q"]], [["z"], "b"], ["a"], [["z"], "b"], ["b"], [["z"], 5], [["q"], "c"]], "expected": [null, true, true, true, 0.561960861054684, true, 0.6931471805599453, true, [], 0.28768207245178085]},
    {"id": "h11", "note": "updating a document to the same words changes no score", "ops": ["ForgettableIndex", "add", "add", "score", "update", "score", "search"], "args": [[1.2, 0.75], ["a", ["p", "q"]], ["b", ["q"]], [["q"], "b"], ["a", ["p", "q"]], [["q"], "b"], [["p", "q"], 5]], "expected": [null, true, true, 0.21110917102457905, true, 0.21110917102457905, ["a", "b"]]},
    {"id": "h12", "note": "k1 and b come from the constructor: b = 0 ignores length, so this is a tie", "ops": ["ForgettableIndex", "add", "add", "search", "score"], "args": [[1.5, 0.0], ["a1", ["k", "a", "b", "c", "d", "e"]], ["z9", ["k"]], [["k"], 5], [["k"], "a1"]], "expected": [null, true, true, ["a1", "z9"], 0.1823215567939546]},
    {"id": "h13", "note": "k1 = 2 and b = 1 change every score", "ops": ["ForgettableIndex", "add", "add", "score", "score", "search"], "args": [[2.0, 1.0], ["a", ["m", "m", "n"]], ["b", ["m", "o", "o", "o"]], [["m"], "a"], [["m"], "b"], [["m", "o"], 5]], "expected": [null, true, true, 0.2945194378979267, 0.16646750837708899, ["b", "a"]]},
    {"id": "h14", "note": "a longer life: updates and forgets between searches, each against the index as it is", "ops": ["ForgettableIndex", "add", "add", "add", "add", "add", "search", "update", "forget", "search", "search", "add", "search", "score", "forget", "forget", "search"], "args": [[1.2, 0.75], ["m1", ["user", "prefers", "green", "tea", "in", "the", "morning"]], ["m2", ["user", "lives", "in", "porto"]], ["m3", ["dog", "is", "called", "rex"]], ["m4", ["user", "is", "allergic", "to", "nuts"]], ["m5", ["tea", "shop", "near", "the", "office"]], [["tea", "porto"], 3], ["m2", ["user", "moved", "to", "faro", "in", "may"]], ["m5"], [["tea", "porto"], 3], [["user", "faro"], 2], ["m6", ["user", "drinks", "tea", "tea", "every", "day"]], [["tea"], 5], [["tea"], "m1"], ["m1"], ["m6"], [["tea"], 5]], "expected": [null, true, true, true, true, true, ["m2", "m5", "m1"], true, true, ["m1"], ["m2", "m4"], true, ["m6", "m1"], 0.7942396792488989, true, true, []]}
  ]
}
