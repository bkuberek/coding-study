{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["VendingMachine", "stock", "loadCoins", "loadCoins", "service", "state", "insert", "state", "select", "collect", "stockOf", "state"], "args": [[[5, 10, 25, 100]], ["A1", 65, 2], [5, 5], [10, 5], [false], [], [100], [], ["A1"], [], ["A1"], []], "expected": [null, true, true, true, true, "IDLE", 100, "HAS_CREDIT", "DISPENSED", [10, 10, 10, 5], 1, "IDLE"]},
    {"id": "ex2", "visible": true, "ops": ["VendingMachine", "stock", "service", "insert", "select", "insert", "refund", "collect", "state"], "args": [[[25, 100]], ["B2", 75, 1], [false], [100], ["B2"], [3], [], [], []], "expected": [null, true, true, 100, "NO_CHANGE", -1, 100, [100, 3], "IDLE"]},
    {"id": "h1", "note": "in maintenance nothing can be bought, and coins come straight back", "ops": ["VendingMachine", "state", "insert", "select", "refund", "service", "stock", "loadCoins", "loadCoins", "collect", "collect"], "args": [[[10, 50]], [], [10], ["A"], [], [true], ["A", 30, 1], [20, 5], [10, 2], [], []], "expected": [null, "MAINTENANCE", -1, "OUT_OF_SERVICE", 0, false, true, false, true, [10], []]},
    {"id": "h2", "note": "service mode is entered only from IDLE; stocking needs service mode", "ops": ["VendingMachine", "service", "service", "stock", "loadCoins", "insert", "service", "refund", "service", "state", "stock", "collect"], "args": [[[10]], [false], [false], ["A", 10, 1], [10, 1], [10], [true], [], [true], [], ["A", 10, 1], []], "expected": [null, true, false, false, false, 10, false, 10, true, "MAINTENANCE", true, [10]]},
    {"id": "h3", "note": "checks run in order: slot, stock, credit; credit adds up", "ops": ["VendingMachine", "stock", "stock", "service", "select", "select", "insert", "select", "insert", "insert", "select", "select", "stockOf", "collect"], "args": [[[5, 10]], ["A", 20, 1], ["Z", 5, 1], [false], ["A"], ["Q"], [10], ["A"], [5], [5], ["A"], ["A"], ["A"], []], "expected": [null, true, true, true, "INSUFFICIENT_CREDIT", "UNKNOWN_SLOT", 10, "INSUFFICIENT_CREDIT", 15, 20, "DISPENSED", "SOLD_OUT", 0, []]},
    {"id": "h4", "note": "change uses the fewest coins even where taking the largest coin first fails", "ops": ["VendingMachine", "stock", "loadCoins", "service", "insert", "insert", "insert", "select", "collect"], "args": [[[1, 3, 4]], ["S", 6, 1], [3, 2], [false], [4], [4], [4], ["S"], []], "expected": [null, true, true, true, 4, 8, 12, "DISPENSED", [3, 3]]},
    {"id": "h5", "note": "among equally few coins, the larger coins are paid first", "ops": ["VendingMachine", "stock", "loadCoins", "loadCoins", "loadCoins", "service", "insert", "insert", "select", "collect", "insert", "insert", "select", "collect"], "args": [[[1, 5, 6, 10]], ["X", 9, 2], [1, 1], [5, 1], [6, 1], [false], [10], [10], ["X"], [], [10], [10], ["X"], []], "expected": [null, true, true, true, true, true, 10, 20, "DISPENSED", [10, 1], 10, 20, "DISPENSED", [6, 5]]},
    {"id": "h6", "note": "exact credit returns nothing", "ops": ["VendingMachine", "stock", "service", "insert", "insert", "select", "collect", "state", "refund"], "args": [[[25]], ["A", 50, 3], [false], [25], [25], ["A"], [], [], []], "expected": [null, true, true, 25, 50, "DISPENSED", [], "IDLE", 0]},
    {"id": "h7", "note": "a refund returns the credit with the fewest coins the machine holds", "ops": ["VendingMachine", "loadCoins", "service", "insert", "insert", "insert", "insert", "insert", "refund", "collect", "refund"], "args": [[[5, 25]], [25, 1], [false], [5], [5], [5], [5], [5], [], [], []], "expected": [null, true, true, 5, 10, 15, 20, 25, 25, [25], 0]},
    {"id": "h8", "note": "restocking adds items and sets the new price", "ops": ["VendingMachine", "stock", "stock", "stockOf", "stockOf", "service", "insert", "insert", "select", "stockOf"], "args": [[[10]], ["A", 30, 1], ["A", 20, 2], ["A"], ["B"], [false], [10], [10], ["A"], ["A"]], "expected": [null, true, true, 3, -1, true, 10, 20, "DISPENSED", 2]},
    {"id": "h9", "note": "coins paid in become change for later buyers; the last item sells out", "ops": ["VendingMachine", "stock", "service", "insert", "insert", "insert", "insert", "select", "insert", "insert", "select", "collect", "insert", "select", "refund", "collect"], "args": [[[10, 25]], ["A", 40, 2], [false], [10], [10], [10], [10], ["A"], [25], [25], ["A"], [], [25], ["A"], [], []], "expected": [null, true, true, 10, 20, 30, 40, "DISPENSED", 25, 50, "DISPENSED", [10], 25, "SOLD_OUT", 25, [25]]},
    {"id": "h10", "note": "after NO_CHANGE the credit stays and can buy something else", "ops": ["VendingMachine", "stock", "stock", "service", "insert", "select", "state", "insert", "select", "collect", "stockOf"], "args": [[[10, 50]], ["A", 40, 1], ["B", 60, 1], [false], [50], ["A"], [], [10], ["B"], [], ["A"]], "expected": [null, true, true, true, 50, "NO_CHANGE", "HAS_CREDIT", 60, "DISPENSED", [], 1]}
  ]
}
