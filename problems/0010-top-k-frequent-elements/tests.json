{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [4, 6, 4, 2, 6, 4, 9], "k": 2}, "expected": [4, 6]},
    {"id": "ex2", "visible": true, "input": {"nums": [2, 9, 2], "k": 2}, "expected": [2, 9]},
    {"id": "h1", "input": {"nums": [5], "k": 1}, "expected": [5], "note": "single element"},
    {"id": "h2", "input": {"nums": [1, 2], "k": 2}, "expected": [1, 2], "note": "k equals the number of distinct values, all counts tied"},
    {"id": "h3", "input": {"nums": [-1, -1, 2], "k": 1}, "expected": [-1], "note": "negative answer"},
    {"id": "h4", "input": {"nums": [0, 0, 0, 0], "k": 1}, "expected": [0], "note": "all values equal"},
    {"id": "h5", "input": {"nums": [3, 1, 3, 2, 3, 1, 4], "k": 2}, "expected": [3, 1], "note": "the answer values have different counts"},
    {"id": "h6", "input": {"nums": [7, 7, 8, 9, 9, 9], "k": 3}, "expected": [9, 7, 8], "note": "every distinct value is returned"},
    {"id": "h7", "input": {"nums": [-10000, 10000, -10000, 10000, -10000, 0], "k": 2}, "expected": [-10000, 10000], "note": "extreme values"},
    {"id": "h8", "input": {"nums": [1, 2, 2, 3, 3, 3, 4, 4, 4, 4], "k": 2}, "expected": [4, 3], "note": "sorted ascending, counts grow with the value"},
    {"id": "h9", "input": {"nums": [6, 6, 6, 6, 5, 5, 5, 4, 4, 3], "k": 3}, "expected": [6, 5, 4], "note": "sorted descending"},
    {"id": "h10", "input": {"nums": [1, 1, 2, 2, 3], "k": 2}, "expected": [1, 2], "note": "a tie inside the answer"},
    {"id": "h11", "input": {"nums": [-3, -3, -5, -5, -5, -7], "k": 1}, "expected": [-5], "note": "negative values only"},
    {"id": "h12", "input": {"nums": [10, 20, 30, 40, 50, 10], "k": 5}, "expected": [10, 20, 30, 40, 50], "note": "k includes values that occur once"},
    {"id": "h13", "input": {"nums": [8, 1, 8, 2, 8, 3, 9, 9], "k": 2}, "expected": [8, 9], "note": "the answer values are interleaved with others"},
    {"id": "g1", "generate": {"n": 100000, "seed": 4}, "note": "large input with thousands of distinct values"},
    {"id": "g2", "generate": {"n": 1000, "seed": 9}}
  ]
}
