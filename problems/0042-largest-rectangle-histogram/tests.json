{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"heights": [6, 2, 5, 4, 5, 1, 6]}, "expected": 12},
    {"id": "ex2", "visible": true, "input": {"heights": [4, 4, 0, 3, 3, 3]}, "expected": 9},
    {"id": "h1", "input": {"heights": [7]}, "expected": 7, "note": "a single bar"},
    {"id": "h2", "input": {"heights": [0]}, "expected": 0, "note": "a single bar of height 0"},
    {"id": "h3", "input": {"heights": [5, 5, 5, 5]}, "expected": 20, "note": "all bars equal: the whole histogram"},
    {"id": "h4", "input": {"heights": [1, 2, 3, 4, 5]}, "expected": 9, "note": "ascending: nothing pops until the end"},
    {"id": "h5", "input": {"heights": [5, 4, 3, 2, 1]}, "expected": 9, "note": "descending: every bar pops the previous one"},
    {"id": "h6", "input": {"heights": [5, 1, 5]}, "expected": 5, "note": "valley"},
    {"id": "h7", "input": {"heights": [1, 3, 1]}, "expected": 3, "note": "peak ties with the full width"},
    {"id": "h8", "input": {"heights": [10000, 10000]}, "expected": 20000, "note": "maximum heights"},
    {"id": "h9", "input": {"heights": [0, 0, 0]}, "expected": 0, "note": "all bars of height 0"},
    {"id": "h10", "input": {"heights": [2, 1, 2]}, "expected": 3, "note": "the lowest bar spans everything"},
    {"id": "h11", "input": {"heights": [1, 2, 3, 2, 1]}, "expected": 6, "note": "pyramid"},
    {"id": "h12", "input": {"heights": [4, 2, 0, 3, 2, 5]}, "expected": 6, "note": "a zero splits the histogram"},
    {"id": "h13", "input": {"heights": [3, 6, 6, 3, 1, 8, 8, 8, 1]}, "expected": 24, "note": "equal heights pop each other"},
    {"id": "g1", "generate": {"n": 5000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: every pair of end bars is about 1.25 * 10^7 steps"},
    {"id": "g2", "generate": {"n": 5000, "seed": 2}, "hang_guard_ms": 30000, "note": "large input"},
    {"id": "g3", "generate": {"n": 1000, "seed": 3}}
  ]
}
