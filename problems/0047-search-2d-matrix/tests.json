{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"matrix": [[2, 4, 7], [10, 13, 15], [21, 24, 30]], "target": 13}, "expected": true},
    {"id": "ex2", "visible": true, "input": {"matrix": [[1, 3, 5, 9], [11, 11, 14, 19]], "target": 12}, "expected": false},
    {"id": "h1", "input": {"matrix": [[5]], "target": 5}, "expected": true, "note": "one cell, present"},
    {"id": "h2", "input": {"matrix": [[5]], "target": -5}, "expected": false, "note": "one cell, absent"},
    {"id": "h3", "input": {"matrix": [[1, 4, 6, 9, 12, 20]], "target": 12}, "expected": true, "note": "a single row"},
    {"id": "h4", "input": {"matrix": [[1], [4], [6], [9], [12], [20]], "target": 4}, "expected": true, "note": "a single column"},
    {"id": "h5", "input": {"matrix": [[1], [4], [6], [9], [12], [20]], "target": 10}, "expected": false, "note": "a single column, absent"},
    {"id": "h6", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": -50}, "expected": true, "note": "the first cell"},
    {"id": "h7", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 71}, "expected": true, "note": "the last cell"},
    {"id": "h8", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": -51}, "expected": false, "note": "below every value"},
    {"id": "h9", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 72}, "expected": false, "note": "above every value"},
    {"id": "h10", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 9}, "expected": false, "note": "absent, in the gap between two rows"},
    {"id": "h11", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 19}, "expected": true, "note": "repeated value inside a row"},
    {"id": "h12", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 12}, "expected": true, "note": "first cell of a middle row"},
    {"id": "h13", "input": {"matrix": [[-50, -41, -33, -20], [-8, -2, 0, 6], [12, 19, 19, 27], [35, 44, 58, 71]], "target": 6}, "expected": true, "note": "last cell of a middle row"},
    {"id": "h14", "input": {"matrix": [[-1000000000, -1000000000, 0], [999999999, 1000000000, 1000000000]], "target": 1000000000}, "expected": true, "note": "extreme values with repeats"},
    {"id": "h15", "input": {"matrix": [[-1000000000, -1000000000, 0], [999999999, 1000000000, 1000000000]], "target": 1}, "expected": false, "note": "absent value between extremes"},
    {"id": "h16", "input": {"matrix": [[3, 3, 3, 3, 3]], "target": 3}, "expected": true, "note": "one row of equal values"},
    {"id": "g1", "generate": {"n": 100000, "seed": 19}, "note": "large input: a full scan reads at least three quarters of the cells"}
  ]
}
