     }
    },
    {
     "request": {
      "method": "POST",
      "path": "/notes",
      "headers": {
       "Authorization": "Bearer {{token}}"
      },
      "json": {
       "title": "Groceries",
       "body": ""
      }
     },
     "expected": {
      "status": 201
     },
