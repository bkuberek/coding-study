        "id": "{{b}}",
        "title": "Groceries"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "v9",
   "level": 4,
   "visible": true,
   "note": "signing in prints no session token",
   "steps": [
    {
     "use": "sign_up",
     "with": {
      "user": "v9-ana"
     }
    }
   ],
   "app_output": {
    "absent": [
     "{{token}}"
    ]
   }
  },
  {
   "id": "v10",
   "level": 4,
   "visible": true,
   "note": "a body that is not JSON answers 400 with its code and nothing more",
   "steps": [
    {
     "use": "sign_up",
     "with": {
      "user": "v10-ana"
     }
    },
    {
     "request": {
      "method": "POST",
      "path": "/notes",
      "headers": {
       "Authorization": "Bearer {{token}}",
       "Content-Type": "application/json"
      },
      "body": "{\"title\": \"Groceries\","
     },
     "expected": {
      "status": 400,
