   "steps": [
    {
     "use": "sign_up",
     "with": {
      "user": "h11-ana"
     }
    },
    {
     "request": {
      "method": "POST",
      "path": "/notes",
      "headers": {
       "Authorization": "Bearer {{token}}"
      },
      "json": {
       "title": "Rent",
       "body": ""
      }
     },
     "expected": {
      "status": 201
     },
