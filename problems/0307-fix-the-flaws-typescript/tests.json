      "path": "/notes",
      "headers": {
       "Authorization": "Bearer {{token}}"
      },
      "json": {
       "title": "Obrien draft",
       "body": ""
      }
     },
     "expected": {
      "status": 201
     }
    },
    {
     "request": {
      "method": "GET",
      "path": "/notes",
      "headers": {
       "Authorization": "Bearer {{token}}"
      },
      "query": {
       "q": "O'Brien"
      }
     },
     "expected": {
      "status": 200,
      "body": [
       {
        "id": "{{a}}",
        "title": "O'Brien contract"
       }
      ]
     }
    }
   ]
  },
