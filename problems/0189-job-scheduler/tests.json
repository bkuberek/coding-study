{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["JobScheduler", "submit", "submit", "submit", "submit", "runNext", "runNext", "status", "status", "queued", "runNext", "runNext", "status"], "args": [[], [1, "a", "acme", 1], [2, "b", "acme", 5], [3, "c", "zeta", 5], [4, "a", "zeta", 9], [5], [6], [7, "a"], [8, "b"], [9], [10], [11], [12, "zz"]], "expected": [null, true, true, true, false, "b", "c", "QUEUED", "RUNNING", 1, "a", "", ""]},
    {"id": "h1", "level": 1, "note": "an empty scheduler has nothing to run", "ops": ["JobScheduler", "runNext", "queued", "status"], "args": [[], [1], [2], [3, "x"]], "expected": [null, "", 0, ""]},
    {"id": "h2", "level": 1, "note": "equal priorities run in submission order; priorities may be negative", "ops": ["JobScheduler", "submit", "submit", "submit", "submit", "runNext", "runNext", "runNext", "runNext", "queued"], "args": [[], [1, "j3", "t", 0], [2, "j1", "t", 0], [3, "j2", "t", -4], [4, "j0", "t", 0], [5], [6], [7], [8], [9]], "expected": [null, true, true, true, true, "j3", "j1", "j0", "j2", 0]},
    {"id": "h3", "level": 1, "note": "an id stays taken after its job started", "ops": ["JobScheduler", "submit", "runNext", "submit", "status", "submit", "submit", "queued", "runNext"], "args": [[], [1, "x", "t", 3], [2], [3, "x", "t", 3], [4, "x"], [5, "y", "t", 2], [6, "z", "t", 4], [7], [8]], "expected": [null, true, "x", false, "RUNNING", true, true, 2, "z"]},
    {"id": "ex2", "visible": true, "level": 2, "ops": ["JobScheduler", "setRateLimit", "submit", "submit", "submit", "runNext", "runNext", "runNext", "status", "runNext"], "args": [[], [1, "acme", 1, 100], [2, "x1", "acme", 9], [3, "x2", "acme", 9], [4, "y1", "zeta", 1], [10], [20], [30], [40, "x2"], [110]], "expected": [null, null, true, true, true, "x1", "y1", "", "QUEUED", "x2"]},
    {"id": "h4", "level": 2, "note": "a start exactly one window ago no longer counts; one unit later it would", "ops": ["JobScheduler", "setRateLimit", "submit", "submit", "submit", "runNext", "runNext", "runNext", "runNext", "runNext"], "args": [[], [1, "t", 1, 50], [2, "a", "t", 1], [3, "b", "t", 1], [4, "c", "t", 1], [100], [149], [150], [199], [200]], "expected": [null, null, true, true, true, "a", "", "b", "", "c"]},
    {"id": "h5", "level": 2, "note": "starts before the limit was set count; a new limit replaces the old one", "ops": ["JobScheduler", "submit", "submit", "submit", "submit", "runNext", "runNext", "setRateLimit", "runNext", "setRateLimit", "runNext", "runNext"], "args": [[], [1, "a", "t", 1], [2, "b", "t", 1], [3, "c", "t", 1], [4, "d", "t", 1], [10], [11], [12, "t", 2, 1000], [13], [14, "t", 3, 1000], [15], [16]], "expected": [null, true, true, true, true, "a", "b", null, "", null, "c", ""]},
    {"id": "h6", "level": 2, "note": "a blocked tenant does not block others, even at lower priority", "ops": ["JobScheduler", "setRateLimit", "submit", "submit", "submit", "submit", "submit", "runNext", "runNext", "runNext", "runNext", "queued", "runNext", "runNext"], "args": [[], [1, "hot", 2, 10], [2, "h1", "hot", 50], [3, "h2", "hot", 50], [4, "h3", "hot", 50], [5, "c1", "cold", 1], [6, "c2", "cold", 1], [7], [8], [9], [10], [11], [17], [18]], "expected": [null, null, true, true, true, true, true, "h1", "h2", "c1", "c2", 1, "h3", ""]},
    {"id": "ex3", "visible": true, "level": 3, "ops": ["JobScheduler", "setRetryPolicy", "submit", "runNext", "fail", "status", "runNext", "runNext", "fail", "runNext", "fail", "status"], "args": [[], [1, "acme", 2, 100], [2, "job", "acme", 1], [3], [10, "job"], [11, "job"], [50], [110], [120, "job"], [320], [330, "job"], [340, "job"]], "expected": [null, null, true, "job", 110, "QUEUED", "", "job", 320, "job", 0, "FAILED"]},
    {"id": "h7", "level": 3, "note": "complete and fail only apply to running jobs; without a policy a failure is final", "ops": ["JobScheduler", "submit", "complete", "fail", "runNext", "complete", "complete", "status", "submit", "runNext", "fail", "status", "fail", "complete"], "args": [[], [1, "a", "t", 1], [2, "a"], [3, "a"], [4], [5, "a"], [6, "a"], [7, "a"], [8, "b", "t", 1], [9], [10, "b"], [11, "b"], [12, "b"], [13, "zz"]], "expected": [null, true, false, -1, "a", true, false, "DONE", true, "b", 0, "FAILED", -1, false]},
    {"id": "h8", "level": 3, "note": "a retried job keeps its priority and its original place among equals", "ops": ["JobScheduler", "setRetryPolicy", "submit", "submit", "submit", "runNext", "fail", "runNext", "runNext", "submit", "runNext", "runNext", "queued"], "args": [[], [1, "t", 1, 5], [2, "old", "t", 7], [3, "new", "t", 7], [4, "low", "t", 1], [5], [6, "old"], [7], [8], [9, "late", "t", 7], [11], [12], [13]], "expected": [null, null, true, true, true, "old", 11, "new", "low", true, "old", "late", 0]},
    {"id": "h9", "level": 3, "note": "retries count against the rate limit; a new policy applies to later failures", "ops": ["JobScheduler", "setRateLimit", "setRetryPolicy", "submit", "runNext", "fail", "runNext", "runNext", "setRetryPolicy", "fail", "runNext", "runNext", "fail", "queued"], "args": [[], [1, "t", 1, 100], [2, "t", 3, 10], [3, "a", "t", 1], [4], [5, "a"], [15], [104], [105, "t", 3, 1000], [106, "a"], [2105], [2106], [2107, "a"], [2108]], "expected": [null, null, null, true, "a", 15, "", "a", null, 2106, "", "a", 6107, 1]},
    {"id": "ex4", "visible": true, "level": 4, "ops": ["JobScheduler", "submit", "submitAfter", "submitAfter", "runNext", "runNext", "complete", "runNext", "cancel", "status", "complete", "runNext"], "args": [[], [1, "build", "ci", 1], [2, "test", "ci", 9, ["build"]], [3, "deploy", "ci", 9, ["test"]], [4], [5], [6, "build"], [7], [8, "deploy"], [9, "deploy"], [10, "test"], [11]], "expected": [null, true, true, true, "build", "", true, "test", 1, "CANCELLED", true, ""]},
    {"id": "h10", "level": 4, "note": "invalid dependencies reject the submission", "ops": ["JobScheduler", "submit", "submitAfter", "submitAfter", "runNext", "fail", "submitAfter", "submitAfter", "cancel", "submitAfter", "status", "queued"], "args": [[], [1, "a", "t", 1], [2, "b", "t", 1, ["nope"]], [3, "a", "t", 1, []], [4], [5, "a"], [6, "c", "t", 1, ["a"]], [7, "d", "t", 1, []], [8, "d"], [9, "e", "t", 1, ["d"]], [10, "b"], [11]], "expected": [null, true, false, false, "a", 0, false, true, 1, false, "", 0]},
    {"id": "h11", "level": 4, "note": "cancel cascades through queued dependents and counts them", "ops": ["JobScheduler", "submit", "submitAfter", "submitAfter", "submitAfter", "submit", "cancel", "cancel", "status", "runNext", "cancel", "cancel", "queued"], "args": [[], [1, "root", "t", 1], [2, "l", "t", 1, ["root"]], [3, "r", "t", 1, ["root"]], [4, "join", "t", 1, ["l", "r"]], [5, "other", "t", 1], [6, "root"], [7, "root"], [8, "join"], [9], [10, "other"], [11, "zz"], [12]], "expected": [null, true, true, true, true, true, 4, 0, "CANCELLED", "other", 0, 0, 0]},
    {"id": "h12", "level": 4, "note": "a final failure cancels the dependents; a done dependency is satisfied at once", "ops": ["JobScheduler", "submit", "submit", "runNext", "runNext", "complete", "submitAfter", "submitAfter", "submitAfter", "fail", "status", "status", "runNext", "runNext"], "args": [[], [1, "a", "t", 1], [2, "b", "t", 1], [3], [4], [5, "a"], [6, "c", "t", 1, ["a"]], [7, "d", "t", 1, ["b"]], [8, "e", "t", 1, ["a", "d"]], [9, "b"], [10, "d"], [11, "e"], [12], [13]], "expected": [null, true, true, "a", "b", true, true, true, true, 0, "CANCELLED", "CANCELLED", "c", ""]},
    {"id": "h13", "level": 4, "note": "a job waiting for its retry can be cancelled; dependencies outrank priority", "ops": ["JobScheduler", "setRetryPolicy", "submit", "runNext", "fail", "submitAfter", "submit", "runNext", "cancel", "status", "runNext", "queued"], "args": [[], [1, "t", 5, 100], [2, "a", "t", 1], [3], [4, "a"], [5, "b", "t", 99, ["a"]], [6, "c", "t", 0], [7], [8, "a"], [9, "b"], [200], [201]], "expected": [null, null, true, "a", 104, true, true, "c", 2, "CANCELLED", "", 0]}
  ]
}
