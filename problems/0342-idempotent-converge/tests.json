{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "level": 1, "ops": ["Converger", "addHost", "addHost", "addHost", "setState", "setState", "setState", "addTask", "addTask", "addTask", "run", "run", "state"], "args": [[], ["web1"], ["web2"], ["web1"], ["web1", "package", "nginx", "present"], ["web1", "file", "/etc/motd", "hello"], ["ghost", "file", "/x", "y"], ["motd", "file", "/etc/motd", "hello"], ["nginx", "package", "nginx", "present"], ["nginx-up", "service", "nginx", "running"], [], [], ["web2"]], "expected": [null, true, true, false, true, true, false, true, true, true, [["web1", "motd", "ok"], ["web2", "motd", "changed"], ["web1", "nginx", "ok"], ["web2", "nginx", "changed"], ["web1", "nginx-up", "changed"], ["web2", "nginx-up", "changed"]], [["web1", "motd", "ok"], ["web2", "motd", "ok"], ["web1", "nginx", "ok"], ["web2", "nginx", "ok"], ["web1", "nginx-up", "ok"], ["web2", "nginx-up", "ok"]], [["file", "/etc/motd", "hello"], ["package", "nginx", "present"], ["service", "nginx", "running"]]]},
    {"id": "ex2", "visible": true, "level": 1, "ops": ["Converger", "addHost", "setState", "setState", "setState", "addTask", "addTask", "addTask", "state", "run", "state", "run"], "args": [[], ["db1"], ["db1", "package", "telnet", "present"], ["db1", "service", "telnet", "running"], ["db1", "file", "/etc/app.conf", "port=1"], ["no-telnet", "package", "telnet", "absent"], ["conf", "file", "/etc/app.conf", "port=2"], ["conf", "file", "/etc/app.conf", "port=3"], ["db1"], [], ["db1"], []], "expected": [null, true, true, true, true, true, true, false, [["file", "/etc/app.conf", "port=1"], ["package", "telnet", "present"], ["service", "telnet", "running"]], [["db1", "no-telnet", "changed"], ["db1", "conf", "changed"]], [["file", "/etc/app.conf", "port=2"]], [["db1", "no-telnet", "ok"], ["db1", "conf", "ok"]]]},
    {"id": "h1", "level": 1, "note": "tasks in the order they were added, each over every host in the order the hosts were added, never sorted", "ops": ["Converger", "addHost", "addHost", "addHost", "setState", "addTask", "addTask", "run"], "args": [[], ["zeta"], ["alpha"], ["mid"], ["alpha", "file", "/f", "1"], ["z-last", "file", "/f", "1"], ["a-first", "file", "/g", "2"], []], "expected": [null, true, true, true, true, true, true, [["zeta", "z-last", "changed"], ["alpha", "z-last", "ok"], ["mid", "z-last", "changed"], ["zeta", "a-first", "changed"], ["alpha", "a-first", "changed"], ["mid", "a-first", "changed"]]]},
    {"id": "h2", "level": 1, "note": "removing a package removes its service, and a package installed again comes with a stopped service", "ops": ["Converger", "addHost", "setState", "setState", "addTask", "addTask", "addTask", "run", "state", "run"], "args": [[], ["h"], ["h", "package", "redis", "present"], ["h", "service", "redis", "running"], ["drop", "package", "redis", "absent"], ["back", "package", "redis", "present"], ["still-stopped", "service", "redis", "stopped"], [], ["h"], []], "expected": [null, true, true, true, true, true, true, [["h", "drop", "changed"], ["h", "back", "changed"], ["h", "still-stopped", "ok"]], [["package", "redis", "present"], ["service", "redis", "stopped"]], [["h", "drop", "changed"], ["h", "back", "changed"], ["h", "still-stopped", "ok"]]]},
    {"id": "h3", "level": 1, "note": "a task name added twice keeps the first task; setState on an unknown host adds nothing; state is sorted by kind, then target, by character code", "ops": ["Converger", "addHost", "addTask", "addTask", "setState", "setState", "setState", "setState", "setState", "setState", "setState", "setState", "run", "state", "state"], "args": [[], ["h"], ["t", "file", "/a", "one"], ["t", "file", "/a", "two"], ["nobody", "package", "x", "present"], ["h", "file", "/b", "1"], ["h", "file", "/A", "1"], ["h", "file", "/B", "1"], ["h", "file", "/a/b", "1"], ["h", "package", "zsh", "present"], ["h", "package", "bash", "present"], ["h", "service", "zsh", "running"], [], ["h"], ["nobody"]], "expected": [null, true, true, false, false, true, true, true, true, true, true, true, [["h", "t", "changed"]], [["file", "/A", "1"], ["file", "/B", "1"], ["file", "/a", "one"], ["file", "/a/b", "1"], ["file", "/b", "1"], ["package", "bash", "present"], ["package", "zsh", "present"], ["service", "bash", "stopped"], ["service", "zsh", "running"]], []]},
    {"id": "h4", "level": 1, "note": "file contents compare exactly as text, and each task changes a host only when the host differs", "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "setState", "setState", "addTask", "addTask", "run", "run", "state"], "args": [[], ["h1"], ["h2"], ["h1", "file", "/etc/hosts", "a"], ["h2", "file", "/etc/hosts", "A"], ["h1", "package", "ssh", "present"], ["h1", "service", "ssh", "running"], ["h2", "package", "ssh", "present"], ["hosts", "file", "/etc/hosts", "a"], ["ssh-down", "service", "ssh", "stopped"], [], [], ["h1"]], "expected": [null, true, true, true, true, true, true, true, true, true, [["h1", "hosts", "ok"], ["h2", "hosts", "changed"], ["h1", "ssh-down", "changed"], ["h2", "ssh-down", "ok"]], [["h1", "hosts", "ok"], ["h2", "hosts", "ok"], ["h1", "ssh-down", "ok"], ["h2", "ssh-down", "ok"]], [["file", "/etc/hosts", "a"], ["package", "ssh", "present"], ["service", "ssh", "stopped"]]]},
    {"id": "ex3", "visible": true, "level": 2, "ops": ["Converger", "addHost", "addTask", "addTask", "addTask", "check", "state", "run", "check"], "args": [[], ["web1"], ["motd", "file", "/etc/motd", "welcome"], ["nginx", "package", "nginx", "present"], ["nginx-up", "service", "nginx", "running"], [], ["web1"], [], []], "expected": [null, true, true, true, true, [["web1", "motd", "changed", "", "welcome"], ["web1", "nginx", "changed", "absent", "present"], ["web1", "nginx-up", "changed", "stopped", "running"]], [], [["web1", "motd", "changed"], ["web1", "nginx", "changed"], ["web1", "nginx-up", "changed"]], [["web1", "motd", "ok"], ["web1", "nginx", "ok"], ["web1", "nginx-up", "ok"]]]},
    {"id": "ex4", "visible": true, "level": 2, "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "addTask", "addTask", "check", "state"], "args": [[], ["app1"], ["app2"], ["app1", "file", "/etc/app.conf", "port=1"], ["app2", "file", "/etc/app.conf", "port=2"], ["app2", "package", "debug", "present"], ["conf", "file", "/etc/app.conf", "port=2"], ["no-debug", "package", "debug", "absent"], [], ["app2"]], "expected": [null, true, true, true, true, true, true, true, [["app1", "conf", "changed", "port=1", "port=2"], ["app2", "conf", "ok"], ["app1", "no-debug", "ok"], ["app2", "no-debug", "changed", "present", "absent"]], [["file", "/etc/app.conf", "port=2"], ["package", "debug", "present"], ["service", "debug", "stopped"]]]},
    {"id": "h5", "level": 2, "note": "a check sees what the earlier tasks would have done, so a second task on the same file starts from the first one's content, and the host stays as it was", "ops": ["Converger", "addHost", "setState", "addTask", "addTask", "addTask", "addTask", "addTask", "check", "check", "state"], "args": [[], ["h"], ["h", "file", "/f", "start"], ["first", "file", "/f", "middle"], ["second", "file", "/f", "end"], ["pkg", "package", "cron", "present"], ["cron-up", "service", "cron", "running"], ["cron-down", "service", "cron", "stopped"], [], [], ["h"]], "expected": [null, true, true, true, true, true, true, true, [["h", "first", "changed", "start", "middle"], ["h", "second", "changed", "middle", "end"], ["h", "pkg", "changed", "absent", "present"], ["h", "cron-up", "changed", "stopped", "running"], ["h", "cron-down", "changed", "running", "stopped"]], [["h", "first", "changed", "start", "middle"], ["h", "second", "changed", "middle", "end"], ["h", "pkg", "changed", "absent", "present"], ["h", "cron-up", "changed", "stopped", "running"], ["h", "cron-down", "changed", "running", "stopped"]], [["file", "/f", "start"]]]},
    {"id": "h6", "level": 2, "note": "only a changed row carries a diff, a missing file shows an empty before, and a check never takes the place of a run", "ops": ["Converger", "addHost", "setState", "setState", "addTask", "addTask", "addTask", "check", "run", "run", "check"], "args": [[], ["h"], ["h", "file", "/f", "x"], ["h", "package", "git", "present"], ["f", "file", "/f", "x"], ["g", "file", "/g", "y"], ["no-git", "package", "git", "absent"], [], [], [], []], "expected": [null, true, true, true, true, true, true, [["h", "f", "ok"], ["h", "g", "changed", "", "y"], ["h", "no-git", "changed", "present", "absent"]], [["h", "f", "ok"], ["h", "g", "changed"], ["h", "no-git", "changed"]], [["h", "f", "ok"], ["h", "g", "ok"], ["h", "no-git", "ok"]], [["h", "f", "ok"], ["h", "g", "ok"], ["h", "no-git", "ok"]]]},
    {"id": "ex5", "visible": true, "level": 3, "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "setState", "setState", "setState", "addTask", "addTask", "addHandler", "notifies", "notifies", "run", "run"], "args": [[], ["web1"], ["web2"], ["web1", "package", "nginx", "present"], ["web1", "service", "nginx", "running"], ["web1", "file", "/etc/nginx.conf", "v1"], ["web2", "package", "nginx", "present"], ["web2", "service", "nginx", "running"], ["web2", "file", "/etc/nginx.conf", "v2"], ["conf", "file", "/etc/nginx.conf", "v2"], ["nginx-up", "service", "nginx", "running"], ["restart-nginx", "service", "nginx", "restarted"], ["conf", "restart-nginx"], ["conf", "restart-nginx"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, false, [["web1", "conf", "changed"], ["web2", "conf", "ok"], ["web1", "nginx-up", "ok"], ["web2", "nginx-up", "ok"], ["web1", "restart-nginx", "changed"]], [["web1", "conf", "ok"], ["web2", "conf", "ok"], ["web1", "nginx-up", "ok"], ["web2", "nginx-up", "ok"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["Converger", "addHost", "addHost", "setState", "addTask", "addTask", "addTask", "addHandler", "notifies", "run", "state"], "args": [[], ["a"], ["b"], ["a", "package", "app", "present"], ["conf", "file", "/etc/app", "1"], ["app-up", "service", "app", "running"], ["motd", "file", "/etc/motd", "hi"], ["reload", "service", "app", "restarted"], ["conf", "reload"], [], ["b"]], "expected": [null, true, true, true, true, true, true, true, true, [["a", "conf", "changed"], ["b", "conf", "changed"], ["a", "app-up", "changed"], ["b", "app-up", "failed"], ["a", "motd", "changed"], ["a", "reload", "changed"]], [["file", "/etc/app", "1"]]]},
    {"id": "h7", "level": 3, "note": "a handler runs once per host however often it is notified, in the order handlers were added, and only where a task changed something", "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "addTask", "addTask", "addTask", "addHandler", "addHandler", "notifies", "notifies", "notifies", "notifies", "notifies", "notifies", "run", "run"], "args": [[], ["h"], ["k"], ["h", "package", "svc", "present"], ["k", "package", "svc", "present"], ["k", "file", "/one", "1"], ["one", "file", "/one", "1"], ["two", "file", "/two", "2"], ["three", "file", "/three", "3"], ["h-late", "file", "/late", "x"], ["h-early", "service", "svc", "restarted"], ["three", "h-early"], ["two", "h-late"], ["one", "h-late"], ["two", "h-early"], ["ghost", "h-early"], ["two", "nobody"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false, false, [["h", "one", "changed"], ["k", "one", "ok"], ["h", "two", "changed"], ["k", "two", "changed"], ["h", "three", "changed"], ["k", "three", "changed"], ["h", "h-late", "changed"], ["k", "h-late", "changed"], ["h", "h-early", "changed"], ["k", "h-early", "changed"]], [["h", "one", "ok"], ["k", "one", "ok"], ["h", "two", "ok"], ["k", "two", "ok"], ["h", "three", "ok"], ["k", "three", "ok"]]]},
    {"id": "h8", "level": 3, "note": "a handler can fail too, which stops its host for the rest of the run, while the other hosts go on", "ops": ["Converger", "addHost", "addHost", "setState", "addTask", "addHandler", "addHandler", "notifies", "notifies", "run", "state"], "args": [[], ["x"], ["y"], ["x", "package", "web", "present"], ["t", "file", "/t", "1"], ["bounce", "service", "web", "restarted"], ["after", "file", "/after", "1"], ["t", "bounce"], ["t", "after"], [], ["y"]], "expected": [null, true, true, true, true, true, true, true, true, [["x", "t", "changed"], ["y", "t", "changed"], ["x", "bounce", "changed"], ["y", "bounce", "failed"], ["x", "after", "changed"]], [["file", "/t", "1"]]]},
    {"id": "h9", "level": 3, "note": "a check runs the handlers too, on its copies, and a check run can fail and stop a host just like a real one", "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "addTask", "addTask", "addTask", "addTask", "addTask", "addHandler", "notifies", "check", "state"], "args": [[], ["p"], ["q"], ["q", "package", "db", "present"], ["q", "service", "db", "running"], ["q", "package", "cache", "present"], ["db", "package", "db", "present"], ["conf", "file", "/db.conf", "v2"], ["up", "service", "db", "running"], ["cache-up", "service", "cache", "running"], ["never", "file", "/never", "1"], ["restart-db", "service", "db", "restarted"], ["conf", "restart-db"], [], ["p"]], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, [["p", "db", "changed", "absent", "present"], ["q", "db", "ok"], ["p", "conf", "changed", "", "v2"], ["q", "conf", "changed", "", "v2"], ["p", "up", "changed", "stopped", "running"], ["q", "up", "ok"], ["p", "cache-up", "failed"], ["q", "cache-up", "changed", "stopped", "running"], ["q", "never", "changed", "", "1"], ["q", "restart-db", "changed", "running", "restarted"]], []]},
    {"id": "h10b", "level": 3, "note": "a removed package takes its service with it, so a later task on that service fails", "ops": ["Converger", "addHost", "addHost", "setState", "setState", "setState", "addTask", "addTask", "addTask", "run", "state"], "args": [[], ["h"], ["k"], ["h", "package", "agent", "present"], ["h", "service", "agent", "running"], ["k", "package", "agent", "present"], ["drop", "package", "agent", "absent"], ["agent-down", "service", "agent", "stopped"], ["after", "file", "/after", "1"], [], ["h"]], "expected": [null, true, true, true, true, true, true, true, true, [["h", "drop", "changed"], ["k", "drop", "changed"], ["h", "agent-down", "failed"], ["k", "agent-down", "failed"]], []]},
    {"id": "h10", "level": 3, "note": "a restart always reports changed and leaves the service running, so a restarting task never converges", "ops": ["Converger", "addHost", "setState", "addTask", "addTask", "addHandler", "notifies", "run", "run", "state"], "args": [[], ["h"], ["h", "package", "app", "present"], ["kick", "service", "app", "restarted"], ["conf", "file", "/conf", "1"], ["again", "service", "app", "restarted"], ["kick", "again"], [], [], ["h"]], "expected": [null, true, true, true, true, true, true, [["h", "kick", "changed"], ["h", "conf", "changed"], ["h", "again", "changed"]], [["h", "kick", "changed"], ["h", "conf", "ok"], ["h", "again", "changed"]], [["file", "/conf", "1"], ["package", "app", "present"], ["service", "app", "running"]]]},
    {"id": "ex7", "visible": true, "level": 4, "ops": ["Converger", "addHost", "addHost", "setFact", "setFact", "setFact", "setFact", "addTask", "onlyIf", "addTask", "onlyIf", "addTask", "run", "summary", "run", "summary"], "args": [[], ["web1"], ["db1"], ["web1", "role", "web"], ["db1", "role", "db"], ["web1", "memory_mb", "2048"], ["db1", "memory_mb", "512"], ["nginx", "package", "nginx", "present"], ["nginx", "role", "==", "web"], ["swap", "file", "/swapfile", "on"], ["swap", "memory_mb", "<", "1024"], ["motd", "file", "/etc/motd", "hi"], [], [], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, [["web1", "nginx", "changed"], ["db1", "nginx", "skipped"], ["web1", "swap", "skipped"], ["db1", "swap", "changed"], ["web1", "motd", "changed"], ["db1", "motd", "changed"]], [["web1", "0", "2", "0", "1"], ["db1", "0", "2", "0", "1"]], [["web1", "nginx", "ok"], ["db1", "nginx", "skipped"], ["web1", "swap", "skipped"], ["db1", "swap", "ok"], ["web1", "motd", "ok"], ["db1", "motd", "ok"]], [["web1", "2", "0", "0", "1"], ["db1", "2", "0", "0", "1"]]]},
    {"id": "ex8", "visible": true, "level": 4, "ops": ["Converger", "addHost", "addHost", "addHost", "addHost", "addHost", "addHost", "setBatchSize", "setState", "setState", "setState", "setState", "addTask", "addTask", "run", "summary"], "args": [[], ["web1"], ["web2"], ["web3"], ["web4"], ["web5"], ["web6"], [2], ["web1", "package", "app", "present"], ["web2", "package", "app", "present"], ["web5", "package", "app", "present"], ["web6", "package", "app", "present"], ["app-up", "service", "app", "running"], ["motd", "file", "/etc/motd", "hi"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, [["web1", "app-up", "changed"], ["web2", "app-up", "changed"], ["web1", "motd", "changed"], ["web2", "motd", "changed"], ["web3", "app-up", "failed"], ["web4", "app-up", "failed"]], [["web1", "0", "2", "0", "0"], ["web2", "0", "2", "0", "0"], ["web3", "0", "0", "1", "0"], ["web4", "0", "0", "1", "0"], ["web5", "0", "0", "0", "0"], ["web6", "0", "0", "0", "0"]]]},
    {"id": "h11", "level": 4, "note": "numbers compare as numbers, every condition of a task must hold, a skipped task notifies nothing, and a fact that is missing or not a number fails the task", "ops": ["Converger", "addHost", "addHost", "addHost", "setFact", "setFact", "setFact", "addHost", "addHost", "setFact", "setFact", "setFact", "setFact", "setFact", "addTask", "onlyIf", "addTask", "onlyIf", "onlyIf", "addTask", "addHandler", "notifies", "run", "summary"], "args": [[], ["a"], ["b"], ["c"], ["a", "cpus", "10"], ["b", "cpus", "9"], ["c", "cpus", "many"], ["d"], ["e"], ["d", "cpus", "12"], ["e", "cpus", "9"], ["e", "zone", "east"], ["a", "zone", "east"], ["b", "zone", "west"], ["big", "file", "/big", "1"], ["big", "cpus", ">", "9"], ["east-big", "file", "/east", "1"], ["east-big", "zone", "!=", "west"], ["east-big", "cpus", ">=", "10"], ["tail", "file", "/tail", "1"], ["h", "file", "/h", "1"], ["big", "h"], [], []], "expected": [null, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, [["a", "big", "changed"], ["b", "big", "skipped"], ["c", "big", "failed"], ["d", "big", "changed"], ["e", "big", "skipped"], ["a", "east-big", "changed"], ["b", "east-big", "skipped"], ["d", "east-big", "failed"], ["e", "east-big", "skipped"], ["a", "tail", "changed"], ["b", "tail", "changed"], ["e", "tail", "changed"], ["a", "h", "changed"]], [["a", "0", "4", "0", "0"], ["b", "0", "1", "0", "2"], ["c", "0", "0", "1", "0"], ["d", "0", "1", "1", "0"], ["e", "0", "1", "0", "2"]]]},
    {"id": "h12", "level": 4, "note": "each batch finishes its handlers before the next batch starts, a batch where only some hosts fail does not stop the run, and a batch larger than the hosts is one batch", "ops": ["Converger", "addHost", "addHost", "addHost", "setState", "setState", "setBatchSize", "setBatchSize", "addTask", "addTask", "addHandler", "notifies", "run", "setBatchSize", "run"], "args": [[], ["n1"], ["n2"], ["n3"], ["n2", "package", "svc", "present"], ["n3", "package", "svc", "present"], [2], [2], ["conf", "file", "/conf", "1"], ["up", "service", "svc", "running"], ["bounce", "service", "svc", "restarted"], ["conf", "bounce"], [], [5], []], "expected": [null, true, true, true, true, true, true, false, true, true, true, true, [["n1", "conf", "changed"], ["n2", "conf", "changed"], ["n1", "up", "failed"], ["n2", "up", "changed"], ["n2", "bounce", "changed"], ["n3", "conf", "changed"], ["n3", "up", "changed"], ["n3", "bounce", "changed"]], true, [["n1", "conf", "ok"], ["n2", "conf", "ok"], ["n3", "conf", "ok"], ["n1", "up", "failed"], ["n2", "up", "ok"], ["n3", "up", "ok"]]]},
    {"id": "h13", "level": 4, "note": "the summary counts handlers, keeps changed out of ok, describes only the latest run, ignores checks, and lists every host", "ops": ["Converger", "addHost", "summary", "setState", "addTask", "addTask", "addHandler", "notifies", "run", "summary", "addTask", "check", "summary", "addHost", "summary"], "args": [[], ["s1"], [], ["s1", "package", "web", "present"], ["conf", "file", "/conf", "1"], ["same", "file", "/conf", "1"], ["bounce", "service", "web", "restarted"], ["conf", "bounce"], [], [], ["more", "file", "/more", "1"], [], [], ["s2"], []], "expected": [null, true, [["s1", "0", "0", "0", "0"]], true, true, true, true, true, [["s1", "conf", "changed"], ["s1", "same", "ok"], ["s1", "bounce", "changed"]], [["s1", "1", "2", "0", "0"]], true, [["s1", "conf", "ok"], ["s1", "same", "ok"], ["s1", "more", "changed", "", "1"]], [["s1", "1", "2", "0", "0"]], true, [["s1", "1", "2", "0", "0"], ["s2", "0", "0", "0", "0"]]]},
    {"id": "h14", "level": 4, "note": "conditions belong to tasks only, facts to known hosts only, a fact set again replaces the old value, and +5 is not a whole number", "ops": ["Converger", "addHost", "addTask", "addHandler", "onlyIf", "onlyIf", "setFact", "setFact", "setFact", "onlyIf", "notifies", "setFact", "addTask", "onlyIf", "run", "setBatchSize", "setBatchSize"], "args": [[], ["h"], ["t", "file", "/t", "1"], ["hd", "file", "/hd", "1"], ["ghost", "k", "==", "v"], ["hd", "k", "==", "v"], ["nobody", "k", "v"], ["h", "k", "v"], ["h", "k", "w"], ["t", "k", "==", "w"], ["t", "hd"], ["h", "n", "+5"], ["plus", "file", "/plus", "1"], ["plus", "n", ">", "1"], [], [3], [3]], "expected": [null, true, true, true, false, false, false, true, false, true, true, true, true, true, [["h", "t", "changed"], ["h", "plus", "failed"]], true, false]},
