{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "ops": ["StreamReassembler", "delta", "delta", "delta", "status", "finish", "status", "text"], "args": [[], [1, "lo "], [0, "Hel"], [2, "world"], [], [2], [], []], "expected": [null, "", "Hello ", "world", "streaming", true, "complete", "Hello world"]},
    {"id": "ex2", "visible": true, "ops": ["StreamReassembler", "delta", "finish", "delta", "status", "missing", "delta", "delta", "status", "text", "missing"], "args": [[], [0, "a"], [2], [2, "c"], [], [], [0, "zzz"], [1, "b"], [], [], []], "expected": [null, "a", true, "", "streaming", [1], "", "bc", "complete", "abc", []]},
    {"id": "ex3", "visible": true, "ops": ["StreamReassembler", "delta", "delta", "close", "status", "text", "missing"], "args": [[], [0, "The answer "], [1, "is "], [], [], [], []], "expected": [null, "The answer ", "is ", null, "truncated", "The answer is ", []]},
    {"id": "ex4", "visible": true, "ops": ["StreamReassembler", "delta", "delta", "finish", "close", "status", "text", "missing"], "args": [[], [0, "a"], [2, "c"], [3], [], [], [], []], "expected": [null, "a", "", true, null, "truncated", "a", [1, 3]]},
    {"id": "h1", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "text", "missing", "delta", "text"], "args": [[], [4, "e"], [2, "c"], [3, "d"], [1, "b"], [], [], [0, "a"], []], "expected": [null, "", "", "", "", "", [0], "abcde", "abcde"], "note": "a fully reversed arrival: one call releases everything"},
    {"id": "h2", "ops": ["StreamReassembler", "finish", "status", "missing", "delta", "status", "delta", "status"], "args": [[], [1], [], [], [1, "b"], [], [0, "a"], []], "expected": [null, true, "streaming", [0, 1], "", "streaming", "ab", "complete"], "note": "finish arrives before any fragment"},
    {"id": "h3", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "delta", "finish", "status", "text", "missing"], "args": [[], [0, "a"], [2, "c"], [1, ""], [3, ""], [4, "e"], [4], [], [], []], "expected": [null, "a", "", "c", "", "e", true, "complete", "ace", []], "note": "an empty fragment fills its place, also when it is what the stream was waiting for"},
    {"id": "h4", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "text"], "args": [[], [1, "first"], [1, "second"], [0, "a"], [1, "third"], []], "expected": [null, "", "", "afirst", "", "afirst"], "note": "the first text wins, whether the fragment is held or released"},
    {"id": "h5", "ops": ["StreamReassembler", "delta", "delta", "close", "status", "text", "missing"], "args": [[], [1, "b"], [2, "c"], [], [], [], []], "expected": [null, "", "", null, "truncated", "", [0]], "note": "fragment 0 never arrives: nothing may be released"},
    {"id": "h6", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "finish", "close", "status", "text", "missing"], "args": [[], [0, "a"], [1, "b"], [3, "d"], [5, "f"], [6], [], [], [], []], "expected": [null, "a", "b", "", "", true, null, "truncated", "ab", [2, 4, 6]], "note": "the text stops at the first gap, and missing names every gap through the last sequence"},
    {"id": "h7", "ops": ["StreamReassembler", "delta", "close", "status", "text", "missing"], "args": [[], [0, "a"], [], [], [], []], "expected": [null, "a", null, "truncated", "a", []], "note": "no gap and no finish is still truncated"},
    {"id": "h8", "ops": ["StreamReassembler", "delta", "delta", "close", "delta", "finish", "status", "text", "missing", "close", "status"], "args": [[], [0, "a"], [2, "c"], [], [1, "b"], [2], [], [], [], [], []], "expected": [null, "a", "", null, "", false, "truncated", "a", [1], null, "truncated"], "note": "nothing changes after close, not even a fragment that fills the gap"},
    {"id": "h9", "ops": ["StreamReassembler", "finish", "status", "missing", "delta", "status", "text"], "args": [[], [0], [], [], [0, "only"], [], []], "expected": [null, true, "streaming", [0], "only", "complete", "only"], "note": "a last sequence of 0 is a real value"},
    {"id": "h10", "ops": ["StreamReassembler", "status", "missing", "text", "finish", "status", "text", "missing", "delta", "status", "text"], "args": [[], [], [], [], [-1], [], [], [], [0, "late"], [], []], "expected": [null, "streaming", [], "", true, "complete", "", [], "", "complete", ""], "note": "a stream with no fragments finishes with -1, and a fragment above it is ignored"},
    {"id": "h11", "ops": ["StreamReassembler", "delta", "finish", "status", "close", "status", "delta", "text"], "args": [[], [0, "a"], [0], [], [], [], [1, "b"], []], "expected": [null, "a", true, "complete", null, "complete", "", "a"], "note": "a complete stream stays complete when the connection closes"},
    {"id": "h12", "ops": ["StreamReassembler", "delta", "finish", "delta", "delta", "status", "missing", "text"], "args": [[], [0, "a"], [1], [2, "c"], [1, "b"], [], [], []], "expected": [null, "a", true, "", "b", "complete", [], "ab"], "note": "a fragment above the last sequence is ignored, and is not held"},
    {"id": "h13", "ops": ["StreamReassembler", "delta", "finish", "finish", "finish", "delta", "status"], "args": [[], [0, "a"], [1], [1], [5], [1, "b"], []], "expected": [null, "a", true, false, false, "b", "complete"], "note": "only the first finish counts, even if a later one repeats or changes it"},
    {"id": "h14", "ops": ["StreamReassembler", "delta", "finish", "status", "missing", "finish", "missing", "finish"], "args": [[], [5, "f"], [3], [], [], [5], [], [-1]], "expected": [null, "", false, "streaming", [0, 1, 2, 3, 4], true, [0, 1, 2, 3, 4], false], "note": "a finish below an arrived fragment is refused, and leaves room for a good one"},
    {"id": "h15", "ops": ["StreamReassembler", "missing", "delta", "missing", "delta", "missing", "finish", "missing"], "args": [[], [], [2, "c"], [], [0, "a"], [], [4], []], "expected": [null, [], "", [0, 1], "a", [1], true, [1, 3, 4]], "note": "without a finish, missing stops at the highest arrival; with one, at the last sequence"},
    {"id": "h16", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "text"], "args": [[], [0, "Hello"], [1, " "], [2, "world\n"], [3, "  "], []], "expected": [null, "Hello", " ", "world\n", "  ", "Hello world\n  "], "note": "fragments are kept exactly"},
    {"id": "h17", "ops": ["StreamReassembler", "delta", "finish", "status", "delta", "text"], "args": [[], [9999, "z"], [9999], [], [0, "a"], []], "expected": [null, "", true, "streaming", "a", "a"], "note": "the largest sequence"},
    {"id": "h18", "ops": ["StreamReassembler", "close", "status", "text", "missing", "delta", "finish", "status"], "args": [[], [], [], [], [], [0, "a"], [-1], []], "expected": [null, null, "truncated", "", [], "", false, "truncated"], "note": "closed before anything arrived"},
    {"id": "h19", "ops": ["StreamReassembler", "delta", "delta", "delta", "delta", "delta", "text", "finish", "finish", "status"], "args": [[], [0, "a"], [0, "a"], [1, "b"], [1, "b"], [2, "c"], [], [2], [2], []], "expected": [null, "a", "", "b", "", "c", "abc", true, false, "complete"], "note": "every event delivered twice"}
  ]
}
