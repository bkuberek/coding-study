{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"claims": [["iss", "https://login.example"], ["aud", "billing-api", "orders-api"], ["exp", "1789999970"], ["nbf", "1789990000"], ["scope", "orders:read", "orders:write"], ["sub", "user-1042"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok"},
    {"id": "ex2", "visible": true, "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1789999000"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:delete"]}, "expected": "expired"},
    {"id": "ex3", "visible": true, "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api-internal"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-audience"},
    {"id": "h1", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1789999940"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "expired", "note": "now == exp + skew is already expired"},
    {"id": "h2", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1789999941"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok", "note": "one second before exp + skew; subtracting the skew from exp fails this"},
    {"id": "h3", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000000"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 0, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "expired", "note": "no skew, and now == exp"},
    {"id": "h4", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", "1790000060"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok", "note": "now + skew == nbf is already valid"},
    {"id": "h5", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", "1790000061"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "not-yet-valid", "note": "one second beyond the skew"},
    {"id": "h6", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "a token without exp does not live forever"},
    {"id": "h7", "input": {"claims": [["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "no issuer"},
    {"id": "h8", "input": {"claims": [["iss", "https://login.example"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "no audience"},
    {"id": "h9", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "0"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "expired", "note": "exp of 0 is a value, not an absent claim"},
    {"id": "h10", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", "0"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok", "note": "nbf of 0 is long past"},
    {"id": "h11", "input": {"claims": [["iss", "https://login.example"], ["iss", "https://other.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "two issuers; keeping the first would accept it"},
    {"id": "h12", "input": {"claims": [["iss", "https://other.example"], ["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "two issuers; keeping the last would accept it"},
    {"id": "h13", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600abc"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "parseInt reads the leading digits"},
    {"id": "h14", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1.79e9"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "Number and float accept exponents"},
    {"id": "h15", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", " 1789990000"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "Number and int accept surrounding spaces"},
    {"id": "h16", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "１７９００００６００"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "full-width digits pass isdigit and int"},
    {"id": "h17", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600\n"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "a trailing newline passes a regular expression ending in $ in Python"},
    {"id": "h18", "input": {"claims": [["iss", "https://login.example/"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-issuer", "note": "a trailing slash is a different issuer"},
    {"id": "h19", "input": {"claims": [["iss", "https://login.example.attacker.test"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-issuer", "note": "starts with the trusted issuer"},
    {"id": "h20", "input": {"claims": [["iss", "HTTPS://LOGIN.EXAMPLE"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-issuer", "note": "issuers are compared exactly, not case-insensitively"},
    {"id": "h21", "input": {"claims": [["iss", "https://login.example"], ["aud", "billing-api", "reports-api", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok", "note": "the expected audience is the last of three"},
    {"id": "h22", "input": {"claims": [["iss", "https://login.example"], ["aud"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "an aud row with no value is malformed, not missing"},
    {"id": "h23", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api-internal", "requiredScopes": ["orders:read"]}, "expected": "wrong-audience", "note": "the token's audience is inside the expected one"},
    {"id": "h24", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "insufficient-scope", "note": "no scope row grants nothing"},
    {"id": "h25", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read", "orders:delete"]}, "expected": "insufficient-scope", "note": "every required scope, not any of them"},
    {"id": "h26", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": []}, "expected": "ok", "note": "nothing required and no scope row"},
    {"id": "h27", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read-all"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "insufficient-scope", "note": "a scope is not a substring of another"},
    {"id": "h28", "input": {"claims": [["aud", "orders-api"], ["exp", "soon"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "malformed before missing: exp is bad and iss is absent"},
    {"id": "h29", "input": {"claims": [["iss", "https://other.example"], ["exp", "1790000600"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "missing before wrong-issuer"},
    {"id": "h30", "input": {"claims": [["iss", "https://other.example"], ["aud", "billing-api"], ["exp", "1"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-issuer", "note": "issuer before audience and expiry"},
    {"id": "h31", "input": {"claims": [["iss", "https://login.example"], ["aud", "billing-api"], ["exp", "1"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "wrong-audience", "note": "audience before expiry"},
    {"id": "h32", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1"], ["nbf", "9999999999"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:delete"]}, "expected": "expired", "note": "expired before not-yet-valid and insufficient-scope"},
    {"id": "h33", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["EXP", "1790000600"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "claim names are case-sensitive"},
    {"id": "h34", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", "9999999999"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:delete"]}, "expected": "not-yet-valid", "note": "not-yet-valid before insufficient-scope"},
    {"id": "h35", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600", "1790000700"], ["scope", "orders:read", "orders:write"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "exp has two values"},
    {"id": "h36", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["sub", "user-1"], ["sub", "user-2"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "malformed-claim", "note": "a duplicate of a claim nobody reads is still a duplicate"},
    {"id": "h37", "input": {"claims": [], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "missing-claim", "note": "no claims at all"},
    {"id": "h38", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope", "orders:read", "orders:write"], ["nbf", "1790000000"]], "now": 1790000000, "clockSkewSeconds": 0, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": ["orders:read"]}, "expected": "ok", "note": "now == nbf with no skew is valid"},
    {"id": "h39", "input": {"claims": [["iss", "https://login.example"], ["aud", "orders-api"], ["exp", "1790000600"], ["scope"]], "now": 1790000000, "clockSkewSeconds": 60, "expectedIssuer": "https://login.example", "expectedAudience": "orders-api", "requiredScopes": []}, "expected": "ok", "note": "an empty scope row with nothing required"}
  ]
}
