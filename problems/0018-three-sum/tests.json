{
  "$schema": "../../schemas/tests.schema.json",
  "version": 1,
  "cases": [
    {"id": "ex1", "visible": true, "input": {"nums": [2, -5, 3, 0, -2, 5]}, "expected": [[-5, 0, 5], [-5, 2, 3], [-2, 0, 2]]},
    {"id": "ex2", "visible": true, "input": {"nums": [4, 4, -8, 4, -8]}, "expected": [[-8, 4, 4]]},
    {"id": "ex3", "visible": true, "input": {"nums": [1, 2, -4]}, "expected": []},
    {"id": "h1", "input": {"nums": [0, 0, 0]}, "expected": [[0, 0, 0]], "note": "minimum length, all zeros"},
    {"id": "h2", "input": {"nums": [0, 0, 0, 0, 0, 0]}, "expected": [[0, 0, 0]], "note": "many zeros give one triple"},
    {"id": "h3", "input": {"nums": [1, 2, 3]}, "expected": [], "note": "all positive: no triple"},
    {"id": "h4", "input": {"nums": [-3, -2, -1, -9]}, "expected": [], "note": "all negative: no triple"},
    {"id": "h5", "input": {"nums": [-1, -1, 2, 2]}, "expected": [[-1, -1, 2]], "note": "a repeated value used twice in one triple"},
    {"id": "h6", "input": {"nums": [5, -5, 0]}, "expected": [[-5, 0, 5]], "note": "zero in the middle of a triple"},
    {"id": "h7", "input": {"nums": [-100000, 50000, 50000]}, "expected": [[-100000, 50000, 50000]], "note": "extreme values"},
    {"id": "h8", "input": {"nums": [100000, 100000, -100000, -99999]}, "expected": [], "note": "extremes that miss zero"},
    {"id": "h9", "input": {"nums": [-2, 0, 1, 1, 2]}, "expected": [[-2, 0, 2], [-2, 1, 1]], "note": "two triples share the smallest value"},
    {"id": "h10", "input": {"nums": [0, 1, 1]}, "expected": [], "note": "a zero alone is not enough"},
    {"id": "h11", "input": {"nums": [7, -3, -4, 7, -3, -4]}, "expected": [[-4, -3, 7]], "note": "every value duplicated, one triple"},
    {"id": "h12", "input": {"nums": [1, -1, 0, 2, -2, 3, -3]}, "expected": [[-3, 0, 3], [-3, 1, 2], [-2, -1, 3], [-2, 0, 2], [-1, 0, 1]], "note": "symmetric values give many triples"},
    {"id": "h13", "input": {"nums": [-4, -2, -2, -2, 0, 1, 2, 2, 2, 3, 3, 4, 4, 6, 6]}, "expected": [[-4, -2, 6], [-4, 0, 4], [-4, 1, 3], [-4, 2, 2], [-2, -2, 4], [-2, 0, 2]], "note": "dense duplicates"},
    {"id": "h14", "input": {"nums": [3, 3, 3, -6, -6, 12, -6]}, "expected": [[-6, -6, 12], [-6, 3, 3]], "note": "two triples from three values"},
    {"id": "h15", "input": {"nums": [9, 8, 7, 6, 5, -4, -10, -15]}, "expected": [[-15, 6, 9], [-15, 7, 8]], "note": "descending input"},
    {"id": "h16", "input": {"nums": [-1, 0, 1, 0]}, "expected": [[-1, 0, 1]], "note": "a zero pairs with opposite values only once"},
    {"id": "g1", "generate": {"n": 1000, "seed": 1}, "hang_guard_ms": 30000, "note": "large input: checking every triple takes on the order of 10^8 steps here"}
  ]
}
