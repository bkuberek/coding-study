    {"id": "h6", "level": 2, "note": "a receive merges entry by entry and keeps what the receiver already knew; a smaller Lamport timestamp does not mean before", "ops": ["LogicalClocks", "local", "send", "receive", "send", "local", "local", "local", "receive", "send", "local", "receive", "vector", "vector", "compare", "compare", "compare", "compare", "compare", "compare"], "args": [[3], [2, "c1", 0], [2, "c2", 0], [0, "a1", "c2", 0], [0, "a2", 0], [1, "b1", 0], [1, "b2", 0], [1, "b3", 0], [1, "b4", "a2", 0], [1, "b5", 0], [2, "c3", 0], [2, "c4", "b5", 0], ["b4"], ["c4"], ["b3", "a1"], ["c1", "b4"], ["c3", "b5"], ["b5", "c4"], ["c4", "c3"], ["b1", "c3"]], "expected": [null, 1, 2, 3, 4, 1, 2, 3, 5, 6, 3, 7, [2, 4, 2], [2, 5, 4], "concurrent", "before", "concurrent", "before", "after", "concurrent"]},
    {"id": "h7", "level": 2, "note": "unknown names answer the empty string, even when both names are the same unknown one; a refused event has no vector", "ops": ["LogicalClocks", "local", "local", "vector", "compare", "compare", "compare", "compare", "vector", "local", "compare", "compare", "vector"], "args": [[2], [0, "a", 0], [5, "bad", 0], ["bad"], ["nope", "nope"], ["a", "a"], ["a", "nope"], ["nope", "a"], ["a"], [1, "b", 0], ["a", "b"], ["b", "a"], ["b"]], "expected": [null, 1, -1, [], "", "same", "", "", [1, 0], 1, "concurrent", "concurrent", [0, 1]]},
