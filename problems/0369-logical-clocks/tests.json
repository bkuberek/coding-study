    {"id": "ex8", "visible": true, "level": 4, "ops": ["LogicalClocks", "local", "local", "local", "send", "receive", "send", "receive", "hlc", "hlc", "hlc", "hlc", "maxOffset", "hlcOrder", "hlc"], "args": [[2], [0, "a1", 50], [0, "a2", 50], [0, "a3", 50], [1, "b1", 50], [0, "a4", "b1", 49], [0, "a5", 49], [1, "b2", "a5", 60], ["a3"], ["a4"], ["a5"], ["b2"], [], [], ["nope"]], "expected": [null, 1, 2, 3, 1, 4, 5, 6, [50, 2], [50, 3], [50, 4], [60, 0], 1, ["a1", "b1", "a2", "a3", "a4", "a5", "b2"], []]},
