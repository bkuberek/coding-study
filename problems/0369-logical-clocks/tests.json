    {"id": "h1", "level": 1, "note": "a receive takes the larger of its own clock and the message's stamp, plus one: once its own clock is ahead, once the message is ahead", "ops": ["LogicalClocks", "local", "local", "local", "local", "send", "receive", "send", "receive", "local", "send", "receive", "local", "totalOrder"], "args": [[3], [0, "p1", 0], [0, "p2", 0], [0, "p3", 0], [0, "p4", 0], [1, "q1", 0], [0, "p5", "q1", 0], [0, "p6", 0], [1, "q2", "p6", 0], [2, "r1", 0], [1, "q3", 0], [2, "r2", "q3", 0], [2, "r3", 0], []], "expected": [null, 1, 2, 3, 4, 1, 5, 6, 7, 1, 8, 9, 10, ["p1", "q1", "r1", "p2", "p3", "p4", "p5", "p6", "q2", "q3", "r2", "r3"]]},
    {"id": "h2", "level": 1, "note": "equal timestamps are ordered by process id as a number (2 before 10), not by event name, call order or the id as text", "ops": ["LogicalClocks", "local", "local", "local", "local", "local", "send", "receive", "local", "totalOrder"], "args": [[12], [10, "a", 1], [2, "b", 1], [11, "c", 1], [0, "d", 1], [9, "e", 1], [10, "f", 1], [2, "g", "f", 1], [1, "h", 1], []], "expected": [null, 1, 1, 1, 1, 1, 2, 3, 1, ["d", "h", "b", "e", "a", "c", "f", "g"]]},
    {"id": "h3", "level": 1, "note": "refused calls record nothing, tick no clock and leave the message waiting: a receive by the sender, a taken name, an unknown message, a local event as the message, a process out of range, a second receive", "ops": ["LogicalClocks", "send", "receive", "receive", "receive", "local", "receive", "local", "local", "receive", "receive", "local", "local", "totalOrder"], "args": [[2], [0, "m", 10], [0, "r", "m", 11], [1, "m", "m", 11], [1, "r", "nope", 11], [1, "l", 11], [0, "r", "l", 12], [-1, "z", 1], [2, "z", 1], [1, "r", "m", 12], [1, "r2", "m", 13], [1, "s", 14], [0, "t", 15], []], "expected": [null, 1, -1, -1, -1, 1, -1, -1, -1, 2, -1, 3, 2, ["m", "l", "t", "r", "s"]]},
    {"id": "h4", "level": 1, "note": "one process: the order before any event is empty, and a process cannot receive its own message", "ops": ["LogicalClocks", "totalOrder", "local", "send", "receive", "local", "totalOrder"], "args": [[1], [], [0, "only", 5], [0, "s", 4], [0, "r", "s", 3], [0, "after", 9], []], "expected": [null, [], 1, 2, -1, 3, ["only", "s", "after"]]},
    {"id": "h5", "level": 1, "note": "messages arrive out of order and late; the total order follows the timestamps, never the order of the calls or the wall readings", "ops": ["LogicalClocks", "send", "send", "send", "receive", "receive", "local", "send", "receive", "receive", "receive", "send", "receive", "totalOrder"], "args": [[4], [3, "d1", 7], [3, "d2", 8], [3, "d3", 9], [0, "a1", "d3", 1], [1, "b1", "d1", 2], [1, "b2", 3], [1, "b3", 4], [2, "c1", "d2", 5], [2, "c2", "b3", 6], [0, "a2", "b3", 7], [0, "a3", 8], [3, "d4", "a3", 10], []], "expected": [null, 1, 2, 3, 4, 2, 3, 4, 3, 5, -1, 5, 6, ["d1", "b1", "d2", "b2", "c1", "d3", "a1", "b3", "a3", "c2", "d4"]]},
