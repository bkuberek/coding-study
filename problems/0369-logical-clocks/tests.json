    {"id": "ex5", "visible": true, "level": 3, "ops": ["LogicalClocks", "write", "write", "read", "send", "receive", "read", "read", "concurrentWrites", "write", "read", "read", "concurrentWrites"], "args": [[2], [0, "w1", "cart", "apple", 0], [1, "w2", "cart", "pear", 0], [0, "cart"], [1, "s1", 0], [0, "r1", "s1", 0], [0, "cart"], [1, "cart"], ["cart"], [0, "w3", "cart", "apple+pear", 0], [0, "cart"], [1, "cart"], ["cart"]], "expected": [null, 1, 1, ["apple"], 2, 3, ["apple", "pear"], ["pear"], [["w1", "w2"]], 4, ["apple+pear"], ["pear"], [["w1", "w2"]]]},
    {"id": "ex6", "visible": true, "level": 3, "ops": ["LogicalClocks", "write", "write", "send", "receive", "write", "send", "receive", "read", "read", "read", "concurrentWrites", "read"], "args": [[3], [0, "a", "k", "red", 0], [1, "b", "k", "blue", 0], [0, "m1", 0], [2, "r1", "m1", 0], [2, "c", "k", "green", 0], [2, "m2", 0], [1, "r2", "m2", 0], [1, "k"], [2, "k"], [0, "k"], ["k"], [1, "other"]], "expected": [null, 1, 1, 2, 3, 4, 5, 6, ["blue", "green"], ["green"], ["red"], [["a", "b"], ["b", "c"]], []]},
    {"id": "h9", "level": 3, "note": "two concurrent writes of the same value are two siblings; siblings are sorted by value, not by event name, wall reading or timestamp; a newer write replaces only what its process had seen", "ops": ["LogicalClocks", "write", "write", "write", "send", "send", "receive", "receive", "read", "concurrentWrites", "read", "write", "read", "send", "receive", "read", "read"], "args": [[3], [0, "z1", "k", "same", 50], [1, "y1", "k", "same", 10], [2, "x1", "k", "alpha", 30], [0, "m0", 51], [1, "m1", 11], [2, "r0", "m0", 31], [2, "r1", "m1", 32], [2, "k"], ["k"], [0, "k"], [0, "z2", "k", "zeta", 52], [0, "k"], [0, "m2", 53], [2, "r2", "m2", 33], [2, "k"], [1, "k"]], "expected": [null, 1, 1, 1, 2, 2, 3, 4, ["alpha", "same", "same"], [["x1", "y1"], ["x1", "z1"], ["y1", "z1"]], ["same"], 3, ["zeta"], 4, 5, ["alpha", "same", "zeta"], ["same"]]},
    {"id": "h10", "level": 3, "note": "keys are independent; a refused write stores nothing; a process out of range reads nothing", "ops": ["LogicalClocks", "write", "write", "write", "write", "send", "receive", "read", "read", "read", "read", "read", "write", "read", "read", "concurrentWrites", "concurrentWrites", "concurrentWrites", "read"], "args": [[2], [0, "a", "x", "1", 0], [1, "b", "y", "2", 0], [0, "a", "y", "3", 0], [2, "c", "x", "4", 0], [1, "m", 0], [0, "r", "m", 0], [0, "x"], [0, "y"], [1, "x"], [-1, "x"], [2, "x"], [0, "d", "y", "5", 0], [0, "y"], [0, "x"], ["x"], ["y"], ["nokey"], [1, "y"]], "expected": [null, 1, 1, -1, -1, 2, 3, ["1"], ["2"], [], [], [], 4, ["5"], ["1"], [], [], [], ["2"]]},
    {"id": "h11", "level": 3, "note": "a process that has not heard of a write never lists it; a write that has seen two siblings replaces both but not a third it has not seen yet", "ops": ["LogicalClocks", "write", "write", "write", "send", "send", "send", "receive", "read", "receive", "read", "write", "receive", "read", "send", "receive", "read", "write", "read", "read", "read", "concurrentWrites"], "args": [[4], [0, "a1", "doc", "v-a", 0], [1, "b1", "doc", "v-b", 0], [2, "c1", "doc", "v-c", 0], [0, "a2", 0], [1, "b2", 0], [2, "c2", 0], [3, "d1", "a2", 0], [3, "doc"], [3, "d2", "b2", 0], [3, "doc"], [3, "d3", "doc", "v-ab", 0], [3, "d4", "c2", 0], [3, "doc"], [3, "d5", 0], [1, "b3", "d5", 0], [1, "doc"], [1, "b4", "doc", "v-all", 0], [1, "doc"], [0, "doc"], [2, "doc"], ["doc"]], "expected": [null, 1, 1, 1, 2, 2, 2, 3, ["v-a"], 4, ["v-a", "v-b"], 5, 6, ["v-ab", "v-c"], 7, 8, ["v-ab", "v-c"], 9, ["v-all"], ["v-a"], ["v-c"], [["a1", "b1"], ["a1", "c1"], ["b1", "c1"], ["c1", "d3"]]]},
